# Python
.venv/
__pycache__/
*.pyc
*.egg-info/

# Node
ui/node_modules/
ui/dist/
# Defensive: catch stray node_modules at the repo root, created when
# vitest / npm gets accidentally invoked outside ui/. Real packages
# always live under ui/node_modules/.
/node_modules/

# Build artifacts
bin/cortexsim-agent
# `make agent-dist` drops ~21 MB of cross-compiled beacons here; the image bakes
# its own copy from the Dockerfile agent-builder stage, so these are never tracked.
agent-dist/
core/static/assets/
core/static/index.html

# Data
data/
*.db

# Logs (including rotated logs: cortexsim.log.1, .2, ...)
logs/*.log
logs/*.log.*

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Environment
.env

# IaC generator
infra/blueprints/*
!infra/blueprints/.gitkeep

# pytest
.pytest_cache/

# Terraform (local validation artifacts — do not ship in bundles)
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*

# installer build artifacts
installer/dist/
installer/**/*.tar.gz
installer/**/*.zip

# Claude Code local worktrees (mirror of feature branches — local-only state)
.claude/worktrees/

# detection_scanner build output — regenerated by scripts/build-manifest.py
detection_scanner/manifest.json
installer/**/manifest.json
installer/**/SHA256SUMS

# detection_scanner scraper drafts — local-only landing zone, promoted by hand.
# Keep the directory (via .gitkeep) but never commit the candidate cards.
detection_scanner/ttps/_drafts/*
!detection_scanner/ttps/_drafts/.gitkeep

# Claude Code local settings (machine-specific)
.claude/settings.local.json
.claude/launch.json
ui/.claude/


