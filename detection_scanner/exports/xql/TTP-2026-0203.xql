# TTP-2026-0203 — LSASS Memory Dump Extraction via Process Copy
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Copy a process memory file
# severity: high
# Detection of a process memory dump file being copied to a non-system directory

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type = ENUM.FILE_COPY
| filter action_file_path contains 'lsass.dmp'
| filter actor_process_image_name = 'lsass.exe'
| filter action_file_path matches 'C:\\temp\\.*'

## ABIOC — Copy a process memory file (behavioral-ML, causality-anchored)
