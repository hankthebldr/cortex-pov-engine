# TTP-2026-0288 — Kerberos Traffic from Non-Standard Process
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Kerberos Traffic from Non-Standard Process
# severity: high
# Detection of Kerberos traffic initiated from a process not typically used for authentication

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_CONNECTION
| filter dst_port = 88
| filter actor_process_image_name != 'lsass.exe' and actor_process_image_name != 'klist.exe'
| filter action_remote_ip in (192.0.2.0/24)

## ABIOC — Unusual Kerberos Process Initiation (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name
# Behavioral deviation detected when a non-standard process initiates Kerberos traffic

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_CONNECTION
| filter dst_port = 88
| filter actor_process_image_name != 'lsass.exe' and actor_process_image_name != 'klist.exe'
| filter action_remote_ip in (192.0.2.0/24)
| comp by actor_process_image_name

## VALIDATION — Kerberos Traffic from Non-Standard Process Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_CONNECTION
| filter dst_port = 88
| filter actor_process_image_name != 'lsass.exe' and actor_process_image_name != 'klist.exe'
| filter action_remote_ip in (192.0.2.0/24)
| comp count() as cnt by actor_process_image_name, action_remote_ip
| comp count() as cnt by

