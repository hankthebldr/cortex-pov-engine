# TTP-2026-0223 — Compromised Process Accessing Rare Cloud Resource via PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Compromised Process Accessing Rare Cloud Resource
# severity: high
# A compromised process accesses a rare cloud resource via HTTP GET request

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter causality_actor_process_image_name = 'cmd.exe'
| filter action_remote_ip = '192.0.2.10'

## ABIOC — Unusual Cloud Access by Compromised Process (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name
# A compromised process accesses a rare cloud endpoint that is not typically accessed by normal processes

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.10'
| filter actor_process_image_name = 'powershell.exe'
| filter causality_actor_process_image_name = 'cmd.exe'

## VALIDATION — Detect Compromised Process Accessing Rare Cloud Resource
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.10'
| filter actor_process_image_name = 'powershell.exe'
| filter causality_actor_process_image_name = 'cmd.exe'
| comp count() by actor_process_image_name, action_remote_ip

