# TTP-2026-0399 — Execution of Malicious Payload from Temp Directory
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious Process Execution from Temp Folder
# severity: high
# Detects process execution originating from the Windows temp directory

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name contains 'Temp' and action_process_image_name contains '\\malware.exe'

## ABIOC — Suspicious Process Start from Temp Directory (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name
# Behavioral deviation where a process is started from a temporary directory, indicating potential exploitation or persistence

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name contains 'Temp' and action_process_image_name contains '\\malware.exe'

## VALIDATION — Process Start from Temp Directory
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name contains 'Temp' and action_process_image_name contains '\\malware.exe'

