# TTP-2026-0187 — AK47C2 Backdoor with X2ANYLOCK Ransomware Staging via DLL Side-Loading on Linux
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — DLL Side-Loading via LD_PRELOAD
# severity: high
# Detection of process starting with LD_PRELOAD environment variable and loading of suspicious DLL

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter process_env_vars contains 'LD_PRELOAD'
| filter process_image_path contains 'python3'
| filter process_image_path contains 'libcurl.so'

