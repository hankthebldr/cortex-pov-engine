# TTP-2026-0187 — ChainDrop npm Worm — CI-Runner Preinstall to Runner.Worker Scrape, IMDS Harvest, C2 Exfil and STS Reuse (T1195.002 / T1003.007 / T1552.005)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — MP-028 npm preinstall node setup.mjs spawns detached runtime with NODE_RUNTIME_INIT
# severity: high
# npm runs a preinstall script whose node child executes setup.mjs and spawns a second JavaScript runtime (node or bun) on math_init.js with _NODE_RUNTIME_INIT=1 in its environment.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name in ("npm", "npm-cli.js", "node")
| filter action_process_image_name in ("node", "bun")
| filter action_process_image_command_line contains "math_init.js" or action_process_image_command_line contains "Math_Symbol.js" or action_process_image_command_line contains "setup.mjs"
| fields agent_hostname, causality_actor_process_image_name, actor_process_image_command_line, action_process_image_command_line

## BIOC — MP-028 proc pid mem read of Runner.Worker process
# severity: critical
# A process that is not a debugger opens /proc/<pid>/maps and /proc/<pid>/mem where <pid> belongs to Runner.Worker — the CI memory scrape for OIDC tokens and masked secrets.

dataset = xdr_data
| filter event_type = ENUM.FILE and action_file_path ~= "^/proc/[0-9]+/(mem|maps)$"
| filter actor_process_image_name not in ("gdb", "lldb", "strace")
| join type = inner (dataset = xdr_data | filter event_type = ENUM.PROCESS and action_process_image_name = "Runner.Worker" | alter target_pid = to_string(action_process_os_pid) | fields agent_hostname, target_pid) as rw rw.agent_hostname = agent_hostname
| filter action_file_path in (concat("/proc/", rw.target_pid, "/mem"), concat("/proc/", rw.target_pid, "/maps"))
| fields agent_hostname, actor_process_image_name, actor_process_image_command_line, action_file_path

## BIOC — MP-028 npm lineage queries instance metadata token and IAM credentials endpoints
# severity: high
# A child process started under an npm or node causality actor carries a metadata token PUT (/latest/api/token) or an iam/security-credentials GET in its command line. Keyed on the child's command-line URI and the lineage, so it fires whether the target is the real metadata address or a lab stand-in.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name in ("npm", "node", "bun")
| filter action_process_image_command_line contains "/latest/api/token" or action_process_image_command_line contains "/latest/meta-data/iam/security-credentials"
| fields agent_hostname, causality_actor_process_image_name, actor_process_image_command_line, action_process_image_command_line

## BIOC — MP-028 vscode tasks folderOpen and claude SessionStart hook persistence written
# severity: high
# A node-lineage process writes .vscode/tasks.json and .claude/settings.json whose commands launch node setup.mjs — the ChainDrop developer-tooling persistence pair.

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_WRITE, ENUM.FILE_CREATE_NEW)
| filter action_file_path contains "/.vscode/tasks.json" or action_file_path contains "/.claude/settings.json" or action_file_path contains "/.vscode/setup.mjs" or action_file_path contains "/.claude/setup.mjs"
| comp count_distinct(action_file_path) as files by agent_hostname, causality_actor_process_image_name
| filter files >= 2

## BIOC — MP-028 encrypted bundle POST to router URI from CI lineage
# severity: high
# openssl pkeyutl with RSA-OAEP-SHA256 wraps a key, then a CI-lineage process POSTs an octet-stream body to a /router URI.

dataset = xdr_data
| filter event_type = ENUM.PROCESS
| filter (action_process_image_name = "openssl" and action_process_image_command_line contains "rsa_padding_mode:oaep") or (action_process_image_command_line contains "/router" and action_process_image_command_line contains "--data-binary")
| comp count_distinct(action_process_image_name) as stages by agent_hostname, causality_actor_process_image_name
| filter stages >= 2

## ABIOC — MP-028 CI runner large HTTPS upload to a rare domain (behavioral-ML, causality-anchored)
# severity: medium
# behavioral_profile: machine-learning
# causality_anchor: Learned per-host egress baseline -> first-seen destination plus outbound-volume deviation, anchored to src / endpoint_device_name.
# NGFW EAL behavioural alert: a CI runner opens a first-seen HTTPS session and then a large outbound upload to a fleet-rare domain (awqhnjewqjkl.icu in this chain).

dataset = panw_ngfw_traffic_raw
| filter app in ("ssl", "web-browsing") and dst_hostname != null
| comp sum(bytes_sent) as sent, count() as sessions by src, endpoint_device_name, dst_hostname
| filter sent >= 104857600

## ABIOC — MP-028 STS AssumeRole from a CI runner address after metadata harvest (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Learned per-role caller-address baseline -> first-seen runner address, bridged to the endpoint by IP -> host asset resolution.
# A caller identity calls sts:AssumeRole from a first-seen runner address (no prior STS call by that identity from that address in the history window) — a CI runner which, minutes earlier, read the metadata token endpoint.

dataset = cloud_audit_logs
| filter eventName = "AssumeRole" and eventSource = "sts.amazonaws.com"
| alter caller_ip = sourceIPAddress, role_arn = userIdentity.arn
| join type = left (dataset = cloud_audit_logs | filter _time < to_timestamp(current_time() - 3600) and eventSource = "sts.amazonaws.com" | comp count() as prior_calls by userIdentity.arn, sourceIPAddress | alter hist_arn = userIdentity.arn, hist_ip = sourceIPAddress | fields hist_arn, hist_ip, prior_calls) as hist hist.hist_arn = role_arn and hist.hist_ip = caller_ip
| filter prior_calls = null
| comp count() as calls by role_arn, caller_ip

## VALIDATION — MP-028 npm preinstall lineage validation in xdr_data
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter _time > to_timestamp(current_time() - 3600)
| filter causality_actor_process_image_name in ("npm", "node")
| filter action_process_image_command_line contains "setup.mjs" or action_process_image_command_line contains "math_init.js"
| comp count() as events by agent_hostname

## VALIDATION — MP-028 CI credential file reads under npm causality
# purpose: hunt
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.FILE
| filter action_file_path contains "serviceaccount/token" or action_file_path contains ".kube/config" or action_file_path contains "terraform.tfstate"
| filter causality_actor_process_image_name in ("npm", "node", "bun")
| comp count_distinct(action_file_path) as cred_files by agent_hostname

## VALIDATION — MP-028 ChainDrop WildFire verdicts landed in panw_ngfw_threat_raw
# purpose: validation
# dataset: panw_ngfw_threat_raw

dataset = panw_ngfw_threat_raw
| filter filedigest in ("54dc7ea54a1317cca0e890a2770630cf7fa6c97813e0cb9d2caa93012b350668", "fd3ca4007b225fdf8de7af4345a19179d5efa8c4bb9205f88cda806e5684b1eb", "9fc2570b7cef51c1b8df116d144d11ff4096357be7d2c4c6367cfc2509cf1bcc", "b27b82afa5f15512f3856e549fb83d873fd0049759a4b62ce64c8d7d4dc2c678")
| comp count_distinct(filedigest) as digests by endpoint_device_name, src
| filter digests >= 4

