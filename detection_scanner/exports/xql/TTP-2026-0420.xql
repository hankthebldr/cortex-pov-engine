# TTP-2026-0420 — Uncommon AppleScript Credential Grabbing via Script Editor
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon AppleScript Execution
# severity: high
# Detection of AppleScript execution via osascript with suspicious file paths or content

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'osascript'
| filter action_file_path like '%scratch%'

## ABIOC — AppleScript Credential Grabbing Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: osascript process start with credential-grabbing script
# Behavioral deviation where osascript is used to execute a script that attempts to gather user credentials

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'osascript'
| filter action_file_path like '%scratch%'

