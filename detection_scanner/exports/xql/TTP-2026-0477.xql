# TTP-2026-0477 — Unusual IMDS Access via PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unusual IMDS Access
# severity: high
# Detection of process accessing Instance Metadata Service (IMDS) endpoint

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '169.254.169.254'
| filter action_process_image_name = 'powershell.exe'
| filter dst_port = 80

## ABIOC — IMDS Access Anomaly (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: network-connection to 169.254.169.254
# Behavioral deviation of non-standard process accessing IMDS endpoint

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '169.254.169.254'
| filter action_process_image_name != 'aws.exe'
| filter action_process_image_name != 'ec2config.exe'

## VALIDATION — IMDS Network Access Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '169.254.169.254'
| filter action_process_image_name != 'aws.exe'
| filter action_process_image_name != 'ec2config.exe'
| comp count() by action_process_image_name, action_remote_ip

