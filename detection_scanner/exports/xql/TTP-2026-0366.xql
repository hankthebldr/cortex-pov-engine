# TTP-2026-0366 — Rundll32 Executes Rare Unsigned Module
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rundll32 Executes Rare Unsigned Module
# severity: high
# Detects rundll32.exe executing a rare or unsigned DLL module.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'rundll32.exe'
| filter action_file_path contains '.dll'
| comp count() as events by actor_process_image_name, agent_hostname
| sort desc events

## ABIOC — Suspicious Rundll32 Execution with Unsigned DLL (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: rundll32.exe process start
# Behavioral ABIOC detecting rundll32.exe executing an unsigned DLL, which is a common technique used in malicious payload delivery.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'rundll32.exe'
| filter action_file_path contains '.dll'
| filter action_file_signature_status = 'unsigned'

## VALIDATION — Detect Unsigned DLL Execution by Rundll32
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'rundll32.exe'
| filter action_file_path contains '.dll'
| filter action_file_signature_status = 'unsigned'

