## BIOC — Sql Dump Pii Staging
# severity: high
# Sql Dump Pii Staging

preset = xdr_data | filter event_type = 'FILE_WRITE' and action_file_name contains 'db_users_dump' and (action_file_path contains '/tmp/' or action_file_path contains 'AppData')

## BIOC — Compressed Staging Payload
# severity: high
# Compressed Staging Payload

preset = xdr_data | filter event_type = 'FILE_WRITE' and action_file_name contains 'staged_payload.gz'

## VALIDATION — Staged Database Exfiltration Cross-Channel
# purpose: hunt

dataset = xdr_data | filter (event_type = 'FILE_WRITE' and action_file_name contains '.sql') or (event_type = 'NETWORK' and action_process_image_name in ('curl', 'wget')) | comp count() as stages by agent_hostname, actor_process_username | filter stages >= 2

