# TTP-2026-0191 — PowerShell Attack with Defender Tampering and AMSI Patching
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Defender Tampering via PowerShell
# severity: high
# Detection of Set-MpPreference command disabling real-time monitoring

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_command_line contains 'DisableRealtimeMonitoring'

## BIOC — AMSI Memory Patching via Reflection
# severity: high
# Detection of PowerShell process attempting to patch AMSI using reflection

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_command_line contains 'amsiInitFailed'

## VALIDATION — PowerShell Disable Defender Monitoring
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_command_line contains 'DisableRealtimeMonitoring'

