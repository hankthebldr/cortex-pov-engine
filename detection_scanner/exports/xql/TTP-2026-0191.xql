# TTP-2026-0191 — BeyondTrust RS CVE-2026-1731 Post-Exploitation to SparkRAT / VShell — Appliance EDR + NGFW Stitch (T1190 / T1505.003)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — MP-032 BeyondTrust bomgar-scc Spawns a Shell Running Host Discovery
# severity: high
# A process image named bomgar-scc (the BeyondTrust Remote Support service) starts id, whoami, uname, hostname or os-release reads: injected commands running as the appliance site user (CVE-2026-1731).

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name = "bomgar-scc" or actor_process_image_name = "bomgar-scc"
| filter action_process_image_name in ("id", "whoami", "uname", "hostname", "cat", "ps")
| fields _time, agent_hostname, actor_effective_username, actor_process_image_name, action_process_image_name, action_process_image_command_line, causality_actor_process_image_name

## BIOC — MP-032 Python Under bomgar-scc Rewrites the Appliance Admin Hash Then Deletes Itself
# severity: high
# A Python interpreter in the bomgar-scc causality chain writes the appliance user database, then removes the script it was launched from: the report's temporary takeover of the user ID 1 admin account (hash backed up, replaced, restored).

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_WRITE, ENUM.FILE_REMOVE)
| filter causality_actor_process_image_name = "bomgar-scc" and actor_process_image_name contains "python"
| filter action_file_path contains "users.sqlite3" or action_file_path contains ".hash.bak" or action_file_path ~= "/\.[^/]+\.py$"
| comp count() as writes by agent_hostname, actor_process_instance_id
| filter writes >= 2

## BIOC — MP-032 bomgar-scc Descendant Writes PHP Files Into the Web Root
# severity: critical
# A shell in the bomgar-scc causality chain creates .php files (file_save.php, aws.php, maintenance.php) under the web root: the Remote Support service never authors PHP.

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_CREATE_NEW, ENUM.FILE_WRITE)
| filter causality_actor_process_image_name = "bomgar-scc"
| filter action_file_extension = "php"
| fields _time, agent_hostname, actor_process_image_name, actor_process_command_line, action_file_path

## BIOC — MP-032 Download Cradle Chains curl wget python and busybox Then Pipes to sh
# severity: high
# Under bomgar-scc, curl, wget, python urllib and busybox wget are tried in turn for one URL and sh executes a script read from a pipe: the report's blue.drx cradle.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name = "bomgar-scc"
| filter action_process_image_name in ("curl", "wget", "busybox", "python3", "sh")
| comp count_distinct(action_process_image_name) as tools by agent_hostname, causality_actor_process_instance_id
| filter tools >= 3

## BIOC — MP-032 Process Executed From a memfd With a Kernel-Thread argv0
# severity: critical
# A process image is executed from /memfd: with a command line that starts with a bracketed kernel-thread name ([kworker/...]) and a python3 parent: VShell's fileless execution and service masquerading.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_path contains "memfd:"
| filter action_process_image_command_line ~= "^\[k[a-z]+"
| fields _time, agent_hostname, actor_process_image_name, action_process_image_path, action_process_image_command_line, causality_actor_process_image_name

## BIOC — MP-032 bomgar-scc Descendant Opens a Reverse Shell Over dev tcp to Port 4444
# severity: high
# A shell in the bomgar-scc causality chain uses /dev/tcp to connect to port 4444 (default Meterpreter listener), the reverse-shell attempt the report and its Linux XQL call out.

dataset = xdr_data
| filter causality_actor_process_image_name = "bomgar-scc"
| filter (event_type = ENUM.PROCESS and action_process_image_command_line contains "/dev/tcp/") or (event_type = ENUM.NETWORK and action_remote_port = 4444)
| fields _time, agent_hostname, actor_process_image_name, action_process_image_command_line, action_remote_ip, action_remote_port

## BIOC — MP-032 RMM and Tunnel Binaries Launched Under the bomgar-scc Causality Chain
# severity: high
# Processes named cloudflared (tunnel run --token) or a ligolo-ng agent (-connect ... -ignore-cert), or a SimpleHelp Remote Access archive download, appear under bomgar-scc: remote-access and tunnelling tools staged from a compromised remote-access appliance.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name = "bomgar-scc"
| filter (action_process_image_name = "cloudflared" and action_process_image_command_line contains "tunnel") or (action_process_image_command_line contains "-connect" and action_process_image_command_line contains "-ignore-cert") or action_process_image_command_line contains "Remote%20Access-linux64" or action_process_image_command_line contains "ligolo-ng_agent"
| fields _time, agent_hostname, action_process_image_name, action_process_image_command_line

## BIOC — MP-032 Appliance Config and Database Dump Archived Then Uploaded by curl
# severity: high
# Under bomgar-scc, tar archives a config directory together with a .sql dump and curl POSTs the archive with --data-binary: staged configuration and PostgreSQL exfiltration.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name = "bomgar-scc"
| filter (action_process_image_name = "tar" and action_process_image_command_line contains ".sql") or (action_process_image_name = "curl" and action_process_image_command_line contains "--data-binary @")
| comp count_distinct(action_process_image_name) as tools by agent_hostname, causality_actor_process_instance_id
| filter tools >= 2

## ABIOC — MP-032 Appliance Service Process Sends Hex-Encoded Hostname as Chunked DNS Labels (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: statistical
# causality_anchor: Learned appliance baseline -> first-seen DNS query shape (hex labels) from the Remote Support service causality chain, anchored to causality_actor_process_instance_id.
# A descendant of bomgar-scc issues DNS queries whose leftmost label is a long lowercase hex string (hostname hex-encoded and split into 63-character labels; a hostname of 4+ characters yields a label of 8+ hex characters): out-of-band execution confirmation in the Burp-Collaborator / interactsh style the report documents.

dataset = xdr_data
| filter event_type = ENUM.NETWORK and dns_query_name != null
| filter causality_actor_process_image_name = "bomgar-scc"
| alter first_label = arrayindex(split(dns_query_name, "."), 0)
| filter first_label ~= "^[0-9a-f]{8,63}$"
| fields _time, agent_hostname, actor_process_image_name, dns_query_name, causality_actor_process_instance_id

## ABIOC — MP-032 NGFW Recurring Communications From the Appliance to a Rare External IP (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: statistical
# causality_anchor: Learned network baseline per endpoint_device_name -> recurring cadence to a destination rare across the fleet; anchored to the src_host every leg carries.
# NGFW EAL sessions from the appliance recur at a fixed cadence to one external destination that is rare across the fleet: SparkRAT C2 beaconing from a compromised remote-access appliance.

dataset = panw_ngfw_traffic_raw
| filter log_source_type = "eal"
| comp count() as sessions, count_distinct(_time) as ticks by endpoint_device_name, dst
| filter sessions >= 6

## VALIDATION — MP-032 bomgar-scc Causality With Post-Exploitation Child Processes
# purpose: hunt
# dataset: xdr_data

dataset = xdr_data
| filter _time > to_timestamp(current_time() - 3600)
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name = "bomgar-scc" or actor_process_image_name = "bomgar-scc"
| filter action_process_image_name in ("curl", "wget", "nc", "base64", "python3", "python", "php", "useradd", "crontab") or action_process_image_command_line contains "/dev/tcp/"
| comp count() as children, values(action_process_image_name) as tools by agent_hostname

## VALIDATION — MP-032 Webshell Drops and Apache Config Rewrite on the Run Host
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter _time > to_timestamp(current_time() - 3600)
| filter event_type = ENUM.FILE and causality_actor_process_image_name = "bomgar-scc"
| filter action_file_name in ("file_save.php", "aws.php", "maintenance.php", "site.conf")
| comp count_distinct(action_file_name) as files by agent_hostname
| filter files >= 4

## VALIDATION — MP-032 NGFW Traffic From the Run Host to Published CVE-2026-1731 Infrastructure
# purpose: validation
# dataset: panw_ngfw_traffic_raw

dataset = panw_ngfw_traffic_raw
| filter _time > to_timestamp(current_time() - 3600)
| filter dst in ("134.122.13.34", "45.61.150.96", "85.155.186.121")
| comp count() as sessions by endpoint_device_name, src, dst
| filter sessions >= 1

## VALIDATION — MP-032 SparkRAT and VShell WildFire Threat Records Landed in panw_ngfw_threat_raw
# purpose: validation
# dataset: panw_ngfw_threat_raw

dataset = panw_ngfw_threat_raw
| filter _time > to_timestamp(current_time() - 3600)
| filter filedigest in ("9f431d5549a03aee92cfd2bdbbe90f1c91e965c99e90a0c9ad5a001f4e80c350", "98a7b0900a9072bb40af579ec372da7b27af12b15868394df51fefe290ab176b")
| comp count() as records by endpoint_device_name, src, filedigest
| filter records >= 1

