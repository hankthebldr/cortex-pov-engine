# TTP-2026-0184 — Blinder Tunnel (CL-STA-1178) — Developer-Lure MSBuild Execution, GitHub-as-C2 and Chisel Tunnel (T1127 / T1574.014 / T1102.002 / T1572)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — MP-025 Build Engine Drops and Executes RuntimeBroker from User App-Data
# severity: high
# A build engine (MSBuild.exe or dotnet msbuild) running under the IDE creates Microsoft\RuntimeBrokers in the user's local app-data, copies binaries into it and launches RuntimeBroker.exe from there. A design-time target (GetFrameworkPaths) has no business installing and running a binary; this is the Blinder Tunnel T1127 execution primitive.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ("MSBuild.exe", "msbuild", "dotnet", "dotnet.exe", "sh")
| filter action_process_image_path contains "Microsoft\\RuntimeBrokers" or action_process_image_path contains "Microsoft/RuntimeBrokers"
| filter action_process_image_name = "RuntimeBroker.exe"
| comp count() as launches by agent_hostname, actor_process_image_name, action_process_image_path
| fields agent_hostname, actor_process_image_name, action_process_image_path, launches

## BIOC — MP-025 RuntimeBroker.exe Executed Outside System32
# severity: high
# A process named RuntimeBroker.exe starts from a path other than \Windows\System32 — here %LOCALAPPDATA%\Microsoft\RuntimeBrokers, where the report's renamed vshost.exe lives. Masquerading as the Windows Runtime Broker.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = "RuntimeBroker.exe"
| filter action_process_image_path not contains "System32"
| comp count() as starts by agent_hostname, action_process_image_path, actor_process_image_name
| fields agent_hostname, action_process_image_path, actor_process_image_name, starts

## BIOC — MP-025 AppDomainManager Config with ETW Disabled Beside User-Writable EXE
# severity: high
# A .exe.config is written next to an executable in a user-writable folder and declares appDomainManagerAssembly / appDomainManagerType together with etwEnable enabled=false — the AppDomainManager hijack that loads ShelbyLoader V2 while blinding .NET ETW.

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_CREATE_NEW, ENUM.FILE_WRITE)
| filter action_file_name contains ".exe.config"
| filter action_file_path contains "RuntimeBrokers" or action_file_path contains "AppData"
| comp count() as config_writes by agent_hostname, action_file_path, actor_process_image_name
| fields agent_hostname, action_file_path, actor_process_image_name, config_writes

## BIOC — MP-025 MicrosoftRuntime Autostart Pointing at App-Data RuntimeBroker
# severity: high
# An autostart value named MicrosoftRuntime (HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Run, or an XDG autostart entry on Linux) points at RuntimeBroker.exe under the user's app-data — the report's persistence value.

dataset = xdr_data
| filter (event_type = ENUM.REGISTRY and action_registry_key_name contains "CurrentVersion\\Run" and action_registry_value_name = "MicrosoftRuntime") or (event_type = ENUM.FILE and action_file_name = "MicrosoftRuntime.desktop")
| comp count() as autostart_writes by agent_hostname, actor_process_image_name
| fields agent_hostname, actor_process_image_name, autostart_writes

## BIOC — MP-025 Lic/Inf C2 Files Written Under RuntimeBrokers
# severity: medium
# A non-browser, non-git process descended from the build-engine lineage writes Lic.txt or Inf.txt under Microsoft\RuntimeBrokers — the machine-fingerprint and command files the implant mirrors to the attacker's GitHub repository.

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_CREATE_NEW, ENUM.FILE_WRITE)
| filter action_file_name in ("Lic.txt", "Inf.txt")
| filter action_file_path contains "RuntimeBrokers"
| comp count() as c2_file_writes by agent_hostname, actor_process_image_name, causality_actor_process_image_name
| fields agent_hostname, actor_process_image_name, causality_actor_process_image_name, c2_file_writes

## BIOC — MP-025 chisel-v3 WebSocket Upgrade from RuntimeBrokers Chain
# severity: high
# A process in the RuntimeBrokers causality chain writes Blackwood.dll.conf and opens an HTTP/1.1 WebSocket upgrade advertising Sec-WebSocket-Protocol chisel-v3 — Chisel reverse-SOCKS tunnel setup from a masqueraded host.

dataset = xdr_data
| filter (event_type = ENUM.FILE and action_file_name = "Blackwood.dll.conf") or (event_type = ENUM.PROCESS and action_process_image_command_line contains "chisel-v3")
| comp count() as tunnel_setup_events by agent_hostname, causality_actor_process_image_name
| fields agent_hostname, causality_actor_process_image_name, tunnel_setup_events

## ABIOC — MP-025 Recurring Fixed-Cadence GitHub API Sessions from a Non-Developer-Pattern Host (behavioral-ML, causality-anchored)
# severity: medium
# behavioral_profile: machine-learning
# causality_anchor: Learned per-host network-boundary usage baseline for GitHub (interactive, bursty) -> a burst of small API sessions to api.github.com from the same endpoint_device_name that runs the RuntimeBrokers lineage.
# A host whose GitHub usage is normally interactive (browser, git) starts a burst of small HTTPS sessions to api.github.com (an 8-session burst; the 63 s interval is the report's, not the record's) — the Blinder Tunnel GitHub contents-API C2 relay as the NGFW (App-ID) records it at the network boundary; no SaaS-audit leg exists (backlog). GitHub is legitimate, so no IOC matches; the ABIOC fires on the burst deviation for the host, anchored to endpoint_device_name so it stitches to the endpoint lineage.

dataset = panw_ngfw_traffic_raw
| filter log_source_type = "eal" and url_domain = "api.github.com" and action = "allow"
| comp count() as sessions, avg(bytes_sent) as avg_bytes by endpoint_device_name, src
| filter sessions >= 6 and avg_bytes < 8192
| sort desc sessions
| fields endpoint_device_name, src, sessions, avg_bytes

## ABIOC — MP-025 Recurring Tunnel Sessions to a Rare IP-Literal Destination (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Learned host egress baseline -> recurring sessions to a fleet-rare IP-literal destination from the endpoint_device_name that wrote Blackwood.dll.conf.
# The run host holds a recurring series of sessions to a destination reached by IP literal and seen from almost no other source in the fleet — the Chisel reverse-SOCKS tunnel to the report's endpoint. The ABIOC fires on cadence plus destination rarity; Unit 42 enrichment of the destination then names CL-STA-1178.

dataset = panw_ngfw_traffic_raw
| filter log_source_type = "eal" and action = "allow"
| filter url_domain = dst
| comp count() as recurring_sessions by endpoint_device_name, src, dst
| windowcomp count_distinct(src) as fleet_src_prevalence by dst
| filter recurring_sessions >= 6 and fleet_src_prevalence <= 2
| fields endpoint_device_name, src, dst, recurring_sessions, fleet_src_prevalence

## VALIDATION — MP-025 Coding-Test Lure Extracted into source/repos
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type = ENUM.FILE_CREATE_NEW
| filter action_file_path contains "DubaiAirport_Carrers_IT_Test"
| filter action_file_name in ("FlightManager.csproj", "DubaiAirport_Carrers_IT_Test.slnx", "RuntimeBroker.exe", "RuntimeBroker.exe.config", "DubaiAirport_Carrers_IT_Test.zip")
| comp count_distinct(action_file_name) as lure_files by agent_hostname
| filter lure_files >= 3
| fields agent_hostname, lure_files

## VALIDATION — MP-025 Design-Time Build to RuntimeBroker Lineage
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and action_process_image_name = "RuntimeBroker.exe"
| filter action_process_image_path contains "RuntimeBrokers"
| comp count() as starts, values(actor_process_image_name) as parents, values(causality_actor_process_image_name) as cgo by agent_hostname
| fields agent_hostname, starts, parents, cgo

## VALIDATION — MP-025 GitHub Contents-API Lic/Inf Polling from RuntimeBrokers Chain
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS
| filter action_process_image_command_line contains "/contents/" and (action_process_image_command_line contains "Lic.txt" or action_process_image_command_line contains "Inf.txt")
| comp count() as c2_requests by agent_hostname, causality_actor_process_image_name
| filter c2_requests >= 2
| fields agent_hostname, causality_actor_process_image_name, c2_requests

## VALIDATION — MP-025 GitHub API Recurring Sessions Landed for the Run Host
# purpose: validation
# dataset: panw_ngfw_traffic_raw

dataset = panw_ngfw_traffic_raw
| filter log_source_type = "eal" and url_domain = "api.github.com"
| comp count() as github_sessions by endpoint_device_name, src
| filter github_sessions >= 6
| fields endpoint_device_name, src, github_sessions

## VALIDATION — MP-025 Report Phishing Domains Resolved by the Run Host
# purpose: validation
# dataset: pan_dns

dataset = pan_dns
| filter dns_query_name in ("cloud.g-drive.cam", "googeldrive.cam", "drivegoogel.cam", "googelmeet.online", "meetonline.cam", "asdfafadafg.online")
| comp count_distinct(dns_query_name) as report_domains by source_ip
| filter report_domains >= 1
| fields source_ip, report_domains

