# TTP-2026-0060 — Cross-Plane Correlation MOAT — EDR + NDR + ITDR Stitch Into One Incident (T1078 / T1071.001 / T1110.003)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — MP-005 Interactive Bash From www-data Service Context
# severity: high
# XDR BIOC — interactive bash from www-data service context (process lineage anchor). The endpoint leg of the cross-plane stitch: an interactive shell under a non-login web service identity anchors the process lineage that the correlation rule joins to the network and identity signals.

preset = xdr_data
| filter event_type = ENUM.PROCESS
| filter event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ("bash", "sh")
| filter actor_effective_username in ("www-data", "nobody", "apache", "nginx")
| comp count() as proc_count by agent_hostname, action_local_ip, actor_effective_username
| filter proc_count >= 1
| fields agent_hostname, action_local_ip, actor_effective_username, proc_count

## BIOC — MP-005 NGFW Outbound HTTP Beacon To Known IOC Domain
# severity: high
# NDR BIOC — outbound HTTP beacon from the src_host to a known IOC domain (testmynids.org). The network leg of the cross-plane stitch, joined to the endpoint lineage by source host/IP.

dataset = panw_ngfw_traffic_raw
| filter app in ("web-browsing", "ssl", "http") or dst_port in (80, 443)
| filter dst_host = "testmynids.org"
| comp count() as beacon_hits by src_ip, dst_host
| filter beacon_hits >= 5
| fields src_ip, dst_host, beacon_hits

## BIOC — MP-005 Identity Kerberos PreAuth Failure Burst From One Client
# severity: high
# ITDR BIOC — Kerberos pre-auth (4768) failure burst against multiple seeded service accounts from one client_ip, with an IdP sign-in fallback across okta_sso / msft_azure_ad_signin. The identity leg of the cross-plane stitch, joined by source host/IP.

dataset = ad_audit
| filter event_id = 4768
| filter result_code != "0x0"
| comp count_distinct(target_user_name) as targeted_users, count() as failures by client_ip
| filter targeted_users >= 3
| fields client_ip, targeted_users, failures

## VALIDATION — MP-005 NGFW Outbound HTTP To Known IOC testmynids
# purpose: validation
# dataset: panw_ngfw_traffic_raw

dataset = panw_ngfw_traffic_raw
| filter _time > to_timestamp(current_time() - 1800)
| filter dst_host = "testmynids.org"
| filter app in ("web-browsing", "ssl", "http") or dst_port in (80, 443)
| comp count() as hits by src_ip, dst_host
| filter hits >= 5
| fields src_ip, dst_host, hits

## VALIDATION — MP-005 EDR Interactive Bash From Service Context
# purpose: validation
# dataset: xdr_data

preset = xdr_data
| filter _time > to_timestamp(current_time() - 1800)
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ("bash", "sh")
| filter actor_effective_username in ("www-data", "nobody", "apache", "nginx")
| fields _time, agent_hostname, action_local_ip, actor_effective_username, action_process_image_command_line

## VALIDATION — MP-005 ITDR Kerberos PreAuth Failure Burst Against Service Accounts
# purpose: validation
# dataset: ad_audit

dataset = ad_audit
| filter _time > to_timestamp(current_time() - 1800)
| filter event_id = 4768
| filter result_code != "0x0"
| comp count_distinct(target_user_name) as targeted_users, count() as failures by client_ip
| filter targeted_users >= 3
| fields client_ip, targeted_users, failures

## VALIDATION — MP-005 Cross-Plane Stitch Single Incident Spanning Multiple Products
# purpose: validation
# dataset: xdr_data

preset = xdr_data
| filter _time > to_timestamp(current_time() - 1800)
| comp count_distinct(_product) as plane_count, count_distinct(incident_id) as incident_count by action_local_ip
| filter plane_count >= 2 and incident_count = 1
| fields action_local_ip, plane_count, incident_count

