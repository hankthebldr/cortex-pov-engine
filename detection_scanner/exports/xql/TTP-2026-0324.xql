# TTP-2026-0324 — PowerShell Script Execution from Temporary Directory
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — PowerShell Execution from Temp Directory
# severity: high
# Detection of PowerShell process started from a temporary directory

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe' and action_file_path contains 'Temp'

## ABIOC — Suspicious PowerShell Execution from Temp (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name = 'powershell.exe'
# Behavioral deviation detected when PowerShell is executed from a temporary directory

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe' and action_file_path contains 'Temp'

## VALIDATION — PowerShell from Temp Directory Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe' and action_file_path contains 'Temp'
| fields agent_hostname, action_process_image_name, action_file_path

