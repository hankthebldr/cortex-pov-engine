# TTP-2026-0416 — AppleScript Credential Access via Command Line
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon AppleScript Execution
# severity: high
# Execution of osascript with unusual parameters or from unexpected locations

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'osascript'
| filter causality_actor_process_image_name != 'bash'
| filter causality_actor_process_image_name != 'zsh'
| filter causality_actor_process_image_name != 'sh'

## ABIOC — Uncommon AppleScript via Command Line (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Detection of AppleScript execution initiated directly from command line without shell context

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'osascript'
| filter causality_actor_process_image_name != 'bash'
| filter causality_actor_process_image_name != 'zsh'
| filter causality_actor_process_image_name != 'sh'

