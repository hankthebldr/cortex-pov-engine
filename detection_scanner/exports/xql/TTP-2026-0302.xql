# TTP-2026-0302 — Mimikatz Command-Line Execution with Credential Dumping
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Mimikatz Credential Dumping Process
# severity: high
# Detection of Mimikatz process started with credential dumping arguments

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'mimikatz.exe'
| filter action_file_path contains 'sekurlsa::logonpasswords'

## ABIOC — Suspicious Mimikatz Command-Line Usage (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: cmd.exe invoking mimikatz with credential extraction commands
# Behavioral deviation detected when Mimikatz is executed with credential dumping arguments

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'mimikatz.exe'
| filter action_file_path contains 'sekurlsa::logonpasswords'
| filter causality_actor_process_image_name = 'cmd.exe'

## VALIDATION — Mimikatz Process with Credential Arguments
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'mimikatz.exe'
| filter action_file_path contains 'sekurlsa::logonpasswords'

