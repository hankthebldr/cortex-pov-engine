# TTP-2026-0189 — Anomalous Outbound RDP Egress — Lateral Movement (ms-rdp)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — NDR-013 Outbound RDP From a Non-Server Endpoint
# severity: high
# A workstation-class host initiates an outbound RDP (ms-rdp / 3389) session — RDP from a host that normally only accepts it, consistent with interactive lateral movement.

dataset = panw_ngfw_traffic_raw
| filter app = "ms-rdp" or dst_port = 3389
| filter action = "allow"
| comp count() as rdp_sessions by src_ip, dst_ip, dst_port
| filter rdp_sessions >= 1

## VALIDATION — Outbound ms-rdp Egress on the NGFW Traffic Feed
# purpose: validation
# dataset: panw_ngfw_traffic_raw

dataset = panw_ngfw_traffic_raw
| filter _time > to_timestamp(current_time() - 1800)
| filter app = "ms-rdp" or dst_port = 3389
| comp count() as sessions by src_ip, dst_ip
| sort desc sessions

## VALIDATION — RDP To an Internal Host Never Previously Contacted
# purpose: hunt
# dataset: panw_ngfw_traffic_raw

dataset = panw_ngfw_traffic_raw
| filter dst_port = 3389 and app = "ms-rdp"
| comp count_distinct(dst_ip) as rdp_peers by src_ip
| filter rdp_peers >= 1

