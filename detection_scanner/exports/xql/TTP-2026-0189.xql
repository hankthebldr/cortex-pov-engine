# TTP-2026-0189 — Jumpy Pisces to Play Ransomware Hand-off — SMB Tool Transfer, Sliver C2, EDR Removal, Impact (T1021.002 / T1071.001 / T1562.001 / T1486)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — MP-030 Discovery Burst Staged into Public Music Folder
# severity: medium
# Account and host discovery binaries (whoami /all, net localgroup, quser, nltest) whose output is redirected into C:\Users\Public\Music — the staging folder the report and Adlumin tie to Play-affiliated intrusions (TokenPlayer and PsExec were found there).

preset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ("whoami.exe", "net.exe", "net1.exe", "quser.exe", "nltest.exe")
| filter actor_process_command_line contains "Public\\Music" or action_process_image_command_line contains "Public\\Music"
| comp count_distinct(action_process_image_name) as discovery_tools by agent_hostname, causality_actor_process_image_name, causality_id
| filter discovery_tools >= 2
| fields agent_hostname, causality_actor_process_image_name, causality_id, discovery_tools

## BIOC — MP-030 Admin Share C$ Mapped Then Executable Copied into Public Music
# severity: high
# cmd.exe runs 'net use \\<host>\C$' followed by 'copy' of an executable to \\<host>\C$\Users\Public\Music — the SMB transfer pattern the report describes for the Sliver and DTrack files.

preset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ("cmd.exe", "net.exe", "net1.exe")
| filter action_process_image_command_line contains "C$"
| filter action_process_image_command_line contains "net use" or action_process_image_command_line contains "copy"
| comp count() as share_ops, values(action_process_image_command_line) as cmdlines by agent_hostname, actor_effective_username, causality_id
| filter share_ops >= 1
| fields agent_hostname, actor_effective_username, causality_id, share_ops, cmdlines

## BIOC — MP-030 Renamed System Binary Executed from Public Music
# severity: high
# A process whose image path is under C:\Users\Public\Music runs with an original file name that does not match its on-disk name (a renamed Windows binary) — the implant-execution shape after the SMB copy.

preset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_path contains "\\Users\\Public\\Music\\"
| filter action_process_image_name != action_process_file_info->original_name
| fields _time, agent_hostname, action_process_image_path, action_process_file_info, causality_id

## BIOC — MP-030 Credential Dump Log KB0722.log Written to Windows Temp
# severity: critical
# A file named KB0722.log is written to C:\Windows\Temp — the customized Mimikatz credential-dump log path named in the report.

preset = xdr_data
| filter event_type = ENUM.FILE
| filter action_file_name = "KB0722.log"
| filter action_file_path contains "\\Windows\\Temp\\"
| fields _time, agent_hostname, actor_process_image_name, action_file_path, causality_id

## BIOC — MP-030 SAM Hive Registry Access by Command-Line Tool
# severity: high
# reg.exe queries or saves the HKLM\SAM hive from an interactive shell — the registry-dump precursor the report attributes to possible Impacket secretsdump use.

preset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = "reg.exe"
| filter action_process_image_command_line contains "HKLM\\SAM"
| fields _time, agent_hostname, action_process_image_command_line, causality_id

## BIOC — MP-030 PsExec-Shaped Service Runs cmd as LocalSystem
# severity: high
# A short-lived service is created whose binPath is cmd.exe /c, started, and deleted within minutes — the PsExec SYSTEM-escalation shape the report describes, with its output dropped into C:\Users\Public\Music.

preset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = "sc.exe"
| filter action_process_image_command_line contains "binPath" and action_process_image_command_line contains "cmd.exe /c"
| fields _time, agent_hostname, action_process_image_command_line, causality_id

## BIOC — MP-030 Local Account Created and Added to Administrators
# severity: high
# net user /add followed by net localgroup administrators /add for the same new account — the privileged-account creation tool the report saw on RDP-enabled hosts.

preset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ("net.exe", "net1.exe")
| filter action_process_image_command_line contains "/add"
| comp count() as adds, values(action_process_image_command_line) as cmdlines by agent_hostname, causality_id
| filter adds >= 2
| fields agent_hostname, causality_id, adds, cmdlines

## BIOC — MP-030 Security Sensor Service Stopped Disabled and Deleted
# severity: critical
# sc.exe stop, config start= disabled and delete against the same service in one causality chain — the EDR-sensor removal sequence the report saw just before Play deployment. Exercised against a cortexsim- prefixed dummy service, never a real security product.

preset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = "sc.exe"
| filter action_process_image_command_line contains "stop" or action_process_image_command_line contains "disabled" or action_process_image_command_line contains "delete"
| comp count_distinct(action_process_image_command_line) as tamper_ops by agent_hostname, causality_id
| filter tamper_ops >= 3
| fields agent_hostname, causality_id, tamper_ops

## BIOC — MP-030 Silent msiexec Product Uninstall
# severity: high
# msiexec.exe /x <product code> /qn from an administrative shell in the same chain as the service tampering — the mass-uninstall shape for EDR sensors.

preset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = "msiexec.exe"
| filter action_process_image_command_line contains "/x" and action_process_image_command_line contains "/qn"
| fields _time, agent_hostname, action_process_image_command_line, causality_id

## BIOC — MP-030 Mass File Rename to PLAY Extension with Ransom Note Drop
# severity: critical
# One process renames many files in a directory to a .PLAY extension and writes a ReadMe.txt alongside — the Play ransomware impact shape (CISA AA23-352A), exercised on a cortexsim- canary directory only.

preset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type = ENUM.FILE_RENAME
| filter action_file_name contains ".PLAY"
| comp count() as renames by agent_hostname, actor_process_image_name, causality_id
| filter renames >= 10
| fields agent_hostname, actor_process_image_name, causality_id, renames

## ABIOC — MP-030 Compromised Account Uncommon Administrative Share Access (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Learned per-user administrative-share baseline -> first-seen user-to-host C$ access with executable write, anchored to source_address (the victim src_host's IP) and the user principal.
# Inferred identity view (the report names the C$ share mapping by the compromised account, not an identity alert): a user account accesses a host's C$ administrative share for the first time and writes executables. Share events 5140/5145 land on the TARGET host, so the alert is keyed on source_address (the victim's IP) and user_name; with the default STAGE_HOST=127.0.0.1 the target is the victim itself and source_address is loopback.

dataset = msft_windows_security
| filter event_id in (5140, 5145)
| filter share_name contains "C$"
| comp count() as share_events, count_distinct(event_id) as event_kinds, values(host_name) as target_hosts by user_name, source_address
| filter event_kinds >= 2
| fields user_name, source_address, target_hosts, share_events, event_kinds

## ABIOC — MP-030 Sliver Recurring Beacon to Rare Domain (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: statistical
# causality_anchor: Learned source-host egress baseline -> recurring cadence to a rare destination, anchored to the source host (src / endpoint_device_name) the endpoint alerts name.
# The victim host produces a tight recurring burst of small ssl/443 sessions to a fleet-rare domain — the Sliver beaconing the report observed for months. With the report's C2 domain and IP in dst_hostname/dst, the case also enriches as the actor.

dataset = panw_ngfw_traffic_raw
| filter app = "ssl" and dst_port = 443
| comp count() as sessions, avg(bytes_sent) as avg_sent by src, endpoint_device_name, dst_hostname, dst
| filter sessions >= 8
| fields src, endpoint_device_name, dst_hostname, dst, sessions, avg_sent

## VALIDATION — MP-030 WildFire Verdict Records for Report Hashes Landed in panw_ngfw_threat_raw
# purpose: validation
# dataset: panw_ngfw_threat_raw

dataset = panw_ngfw_threat_raw
| filter subtype = "wildfire" and verdict = "malicious"
| filter filedigest in ("243ad5458706e5c836f8eb88a9f67e136f1fa76ed44868217dc995a8c7d07bf7", "2b254ae6690c9e37fa7d249e8578ee27393e47db1913816b4982867584be713a")
| comp count() as verdicts by endpoint_device_name, src, filedigest
| fields endpoint_device_name, src, filedigest, verdicts

## VALIDATION — MP-030 Sliver C2 Domain and IP Sessions Stitched to the Victim Host
# purpose: validation
# dataset: panw_ngfw_traffic_raw

dataset = panw_ngfw_traffic_raw
| filter dst_hostname = "americajobmail.site" or dst = "172.96.137.224"
| comp count() as sessions by endpoint_device_name, src, user
| filter sessions >= 1
| fields endpoint_device_name, src, user, sessions

