# TTP-2026-0216 — SSH Exfiltration of Compressed Data
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — SSH Exfiltration Process
# severity: high
# Process starts SCP with a file path to a remote IP

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'scp' and action_file_path = '/tmp/stage/data.tar.gz'
| filter action_remote_ip = '192.0.2.5'

## ABIOC — A compressed file was exfiltrated over SSH (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name = 'scp' and action_file_path contains '.tar.gz'
# Detection of a tar.gz file being sent over SSH to a remote IP

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter dst_port = 22 and action_remote_ip = '192.0.2.5'
| filter action_file_path contains '.tar.gz'
| filter action_process_image_name = 'scp'

## VALIDATION — SSH Exfiltration Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter dst_port = 22 and action_remote_ip = '192.0.2.5'
| filter action_file_path contains '.tar.gz'
| filter action_process_image_name = 'scp'
| fields agent_hostname, action_file_path, action_remote_ip, dst_port

