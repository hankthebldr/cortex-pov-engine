# TTP-2026-0411 — Time Provider Registration via Registry Modification
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious Time Provider Registered
# severity: high
# A registry key under W32Time\TimeProviders is modified with a custom name and DLL path

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'reg.exe'
| filter action_file_path contains 'W32Time\\TimeProviders'
| filter action_file_path contains 'DllName'
| filter action_file_path contains 'Name'
| filter action_file_path contains 'CustomTimeProvider'

## ABIOC — Suspicious Time Provider Registration (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: registry modification
# Detects registry modifications under W32Time\TimeProviders with custom DLL paths indicating persistence

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'reg.exe'
| filter action_file_path contains 'W32Time\\TimeProviders'
| filter action_file_path contains 'DllName'
| filter action_file_path contains 'CustomTimeProvider'

