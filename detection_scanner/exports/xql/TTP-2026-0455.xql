# TTP-2026-0455 — Uncommon Routing Table Listing via route.exe
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon routing table listing via route.exe
# severity: high
# Detection of route.exe being executed with print argument in an unusual context

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'route.exe'
| filter action_file_path = 'C:\\Windows\\System32\\route.exe'
| filter actor_process_image_name != 'cmd.exe' and actor_process_image_name != 'powershell.exe'

## ABIOC — Uncommon routing table listing behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: route.exe process start
# Detection of route.exe being used in an unexpected way, deviating from typical user behavior

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'route.exe'
| filter actor_process_image_name != 'cmd.exe' and actor_process_image_name != 'powershell.exe'
| filter causality_actor_process_image_name != 'explorer.exe'

## VALIDATION — Route.exe process start detection
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'route.exe'
| filter action_file_path = 'C:\\Windows\\System32\\route.exe'

