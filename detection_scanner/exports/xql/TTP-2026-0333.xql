# TTP-2026-0333 — Rare LOLBIN Process Execution by User
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rare LOLBIN Process Execution by User
# severity: high
# Detection of uncommon LOLBIN usage by a user process

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ('evil.exe')
| filter actor_process_image_name = 'explorer.exe'
| filter causality_actor_process_image_name = 'svchost.exe'

## ABIOC — Unusual LOLBIN Execution Chain (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Behavioral deviation from normal process execution patterns involving rare LOLBINs

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ('evil.exe')
| filter causality_actor_process_image_name = 'svchost.exe'
| filter actor_process_image_name = 'explorer.exe'

## VALIDATION — Detect Rare LOLBIN Usage
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ('evil.exe')
| filter actor_process_image_name = 'explorer.exe'
| filter causality_actor_process_image_name = 'svchost.exe'
| fields action_process_image_name, actor_process_image_name, causality_actor_process_image_name

