# TTP-2026-0214 — Reading bash history to harvest credentials
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Process Reading Bash History
# severity: high
# Process accessing .bash_history file for credential harvesting

dataset = xdr_data
| filter event_type = ENUM.FILE_ACCESS
| filter action_file_path = '/home/www-data/.bash_history'
| filter actor_process_image_name != 'bash'
| filter actor_process_image_name != 'sh'

## ABIOC — Reading bash command history file (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name
# Detection of non-interactive process accessing .bash_history file

dataset = xdr_data
| filter event_type = ENUM.FILE_ACCESS
| filter action_file_path = '/home/www-data/.bash_history'
| filter actor_process_image_name != 'bash'
| filter actor_process_image_name != 'sh'

## VALIDATION — Bash History File Access
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.FILE_ACCESS
| filter action_file_path = '/home/www-data/.bash_history'
| filter actor_process_image_name != 'bash'
| filter actor_process_image_name != 'sh'
| fields actor_process_image_name, action_file_path, agent_hostname

