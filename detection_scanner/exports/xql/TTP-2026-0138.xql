# TTP-2026-0138 — Shai-Hulud Self-Replicating npm Worm — preinstall TruffleHog Scrape → npm-Token Republish → Self-Hosted-Runner Persistence
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — KOI-008 TruffleHog Credential File Harvest Under npm Node CGO
# severity: high
# The detached install-hook child reads multiple credential-bearing files (.npmrc, cloud keys, SSH keys, .env) in a short window — the TruffleHog-style scrape. Keyed on the node/npm Causality Group Owner and its causality_actor_process_instance_id so the harvest is attributed to the SAME install chain, not a benign editor.

dataset = xdr_data
| filter event_type = ENUM.FILE
| filter event_sub_type in (ENUM.FILE_OPEN, ENUM.FILE_READ)
| filter causality_actor_process_image_name in ("node", "npm", "bun") or actor_process_image_name in ("trufflehog", "node")
| filter action_file_path contains_any (".npmrc", ".aws/credentials", ".config/gcloud", ".azure", ".ssh/id_rsa", ".git-credentials", ".env")
| comp count_distinct(action_file_path) as secret_files_read by agent_hostname, causality_id, causality_actor_process_instance_id, actor_process_image_name
| filter secret_files_read >= 3
| fields agent_hostname, causality_id, causality_actor_process_instance_id, actor_process_image_name, secret_files_read

## BIOC — KOI-008 npm Worm Exfil To webhook site And git Push To New Public Repo
# severity: high
# The install-hook chain opens outbound connections to webhook.site and to github.com repo-creation APIs — the double-exfil (webhook sink + public Shai-Hulud repo). Stitched to the node/git CGO by causality_id so it is the same worm chain, not a developer's normal git usage.

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter causality_actor_process_image_name in ("node", "npm", "bun", "git") or actor_process_image_name in ("node", "git", "curl")
| filter dst_action_external_hostname contains_any ("webhook.site", "github.com") or action_external_url contains_any ("/user/repos", "webhook.site")
| filter action_external_port in (443, 80)
| comp count() as exfil_conns by agent_hostname, causality_id, causality_actor_process_instance_id, dst_action_external_hostname
| filter exfil_conns >= 1
| fields agent_hostname, causality_id, causality_actor_process_instance_id, dst_action_external_hostname, exfil_conns

## BIOC — KOI-008 Self Hosted GitHub Actions Runner Registration SHA1HULUD
# severity: high
# The worm registers the infected dev/CI host as a self-hosted GitHub Actions runner (config.sh / Runner.Listener, discussion.yaml, --name SHA1HULUD) so the host becomes attacker-controlled compute and a persistence foothold. Anchored on the node CGO causality chain.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name in ("node", "bun", "bash", "sh") or actor_process_image_name in ("config.sh", "run.sh", "Runner.Listener")
| filter action_process_image_command_line contains_any ("actions-runner", "config.sh --url", "--runnergroup", "discussion.yaml") or action_process_image_command_line contains "SHA1HULUD"
| comp count() as runner_registrations by agent_hostname, causality_id, causality_actor_process_instance_id, action_process_image_command_line
| filter runner_registrations >= 1
| fields agent_hostname, causality_id, causality_actor_process_instance_id, action_process_image_command_line, runner_registrations

## ABIOC — KOI-008 npm Install Hook Spawns Detached Node Child Outliving Install (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: The npm/node install process (Causality Group Owner) and its causality_actor_process_instance_id; the deviation is a detached, unsigned child that outlives the install baseline for this developer/CI host.
# Behavioral-ML deviation: an npm/node lifecycle-hook process spawns a detached, unsigned node/bun child (bun_environment.js) that survives install completion — the worm's persistence-through-detachment. Anchors on the node Causality Group Owner and its causality_actor_process_instance_id so the detached child is provably descended from the install, not a normal build tool.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name in ("npm", "node", "bun") or actor_process_image_name in ("npm", "node")
| filter action_process_image_name in ("node", "bun") and action_process_image_command_line contains_any ("bun_environment.js", "setup_bun.js", "preinstall", "postinstall")
| filter action_process_signature_status != ENUM.SIGNED
| comp count() as child_spawns, values(action_process_instance_id) as child_pids by agent_hostname, causality_id, causality_actor_process_image_name, causality_actor_process_instance_id
| filter child_spawns >= 1
| fields agent_hostname, causality_id, causality_actor_process_image_name, causality_actor_process_instance_id, child_pids, child_spawns

## ABIOC — KOI-008 Stolen npm Token Republishes To Sibling Packages Self Replication (behavioral-ML, causality-anchored)
# severity: critical
# behavioral_profile: machine-learning
# causality_anchor: The node CGO causality_actor_process_instance_id shared with the credential-harvest stage; the deviation is a burst of npm publishes to sibling packages using a token read from disk moments earlier.
# Behavioral-ML deviation: within the same install-hook causality chain, an npm publish is invoked using an auth token harvested this session, pushing new versions to two or more sibling packages — the self-replication edge (exposure_exploit). Anchors on the node CGO causality_actor_process_instance_id so the republish is attributed to the worm, not a legitimate release.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name in ("node", "bun") or actor_process_image_name in ("npm", "node")
| filter action_process_image_command_line contains "publish" and action_process_image_command_line contains_any ("registry.npmjs.org/:_authToken", "npm publish", "--access public")
| comp count_distinct(action_process_image_command_line) as republished_packages by agent_hostname, causality_id, causality_actor_process_instance_id
| filter republished_packages >= 2
| fields agent_hostname, causality_id, causality_actor_process_instance_id, republished_packages

## VALIDATION — KOI-008 npm Preinstall Hook Executes bun environment js Payload
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter _time > to_timestamp(current_time() - 1800)
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ("npm", "node", "yarn", "pnpm")
| filter action_process_image_command_line contains_any ("preinstall", "postinstall", "bun_environment.js", "setup_bun.js")
| fields _time, agent_hostname, causality_id, causality_actor_process_image_name, causality_actor_process_instance_id, actor_process_image_name, action_process_image_command_line

