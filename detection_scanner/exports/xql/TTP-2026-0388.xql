# TTP-2026-0388 — Spring4Shell Exploitation via Malicious HTTP Request
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious Failed HTTP Request
# severity: high
# Detection of failed HTTP requests with suspicious headers indicating potential Spring4Shell exploitation attempts

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.50'
| filter action_protocol = 'HTTP'
| filter action_status = 'FAILED'
| filter action_request_headers contains 'Content-Type: application/x-www-form-urlencoded'
| filter action_request_headers contains 'User-Agent: Spring4Shell-Exploiter'

## ABIOC — Spring4Shell Exploitation Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: network-connection
# Detection of process behavior indicating exploitation of Spring4Shell vulnerability via crafted HTTP requests

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.50'
| filter action_protocol = 'HTTP'
| filter action_status = 'FAILED'
| filter action_request_headers contains 'Content-Type: application/x-www-form-urlencoded'
| filter action_request_headers contains 'User-Agent: Spring4Shell-Exploiter'
| filter causality_actor_process_image_name = 'java'

