# TTP-2026-0225 — Execution of Contained Malware from Mounted Share initiating Outbound Connection
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious Process Start from Mounted Share
# severity: high
# Detects a process started from a mounted network share path

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name like '/tmp/mounted_share/%'
| filter causality_actor_process_image_name like 'sh' or causality_actor_process_image_name like 'bash'

## ABIOC — Suspicious Outbound Network Connection from Mounted Share Process (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start_from_mounted_share
# Detects outbound network connection initiated by a process started from a mounted share

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.5'
| filter causality_actor_process_image_name like '/tmp/mounted_share/%'

## VALIDATION — Hunt for Processes Started from Mounted Shares
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name like '/tmp/mounted_share/%'

## VALIDATION — Hunt for Outbound Connections from Mounted Share Processes
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.5'
| filter causality_actor_process_image_name like '/tmp/mounted_share/%'

