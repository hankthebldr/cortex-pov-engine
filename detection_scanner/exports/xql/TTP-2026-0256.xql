# TTP-2026-0256 — IMDS Access Followed by Token Usage
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — IMDS Access followed by Token Usage
# severity: high
# Detection of process accessing IMDS followed by usage of retrieved credentials

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '169.254.169.254'
| filter causality_actor_process_image_name != null
| filter action_remote_ip != null
| comp count() as cnt by causality_actor_process_image_name
| filter count() > 0

## ABIOC — Cloud IMDS Access followed by Remote Token Usage (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process accessing IMDS
# Behavioral deviation where process accesses IMDS and then attempts to use tokens to access remote systems

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '169.254.169.254'
| filter causality_actor_process_image_name != null
| filter action_remote_ip != null
| comp count() as cnt by causality_actor_process_image_name
| filter count() > 0

