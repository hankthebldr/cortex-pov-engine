# TTP-2026-0406 — Suspicious SearchProtocolHost.exe Parent Process Behavior
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious SearchProtocolHost.exe parent process
# severity: high
# Detection of a process launched by SearchProtocolHost.exe, which is unusual and typically associated with malicious activity

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name = 'SearchProtocolHost.exe'
| filter action_process_image_name != 'SearchProtocolHost.exe'
| filter action_process_image_name != 'svchost.exe'

## ABIOC — Abnormal Parent-Child Process Chain (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: causality_actor_process_image_name = 'SearchProtocolHost.exe'
# Detection of a process chain where a benign system process like SearchProtocolHost.exe is used as a parent of a suspicious executable

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name = 'SearchProtocolHost.exe'
| filter action_process_image_name != 'SearchProtocolHost.exe'
| filter action_process_image_name != 'svchost.exe'

## VALIDATION — Suspicious Parent Process Chain
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name = 'SearchProtocolHost.exe'
| filter action_process_image_name != 'SearchProtocolHost.exe'
| filter action_process_image_name != 'svchost.exe'
| fields agent_hostname, causality_actor_process_image_name, action_process_image_name

