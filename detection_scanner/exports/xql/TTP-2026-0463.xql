# TTP-2026-0463 — Unpopular rsync Process Execution via Scheduled Task
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unpopular rsync process execution
# severity: high
# Detection of rsync being executed from an uncommon location or with unusual arguments

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'rsync'
| filter actor_process_image_name != 'cron'
| filter actor_process_image_name != 'systemd'
| filter not action_file_path startswith '/usr/bin/'

## ABIOC — Unusual rsync execution from non-system process (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: rsync process started by non-standard parent
# Detection of rsync being started by a non-system process like cron or systemd, which is unusual for legitimate use

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'rsync'
| filter causality_actor_process_image_name != 'systemd'
| filter causality_actor_process_image_name != 'cron'
| filter causality_actor_process_image_name != 'bash'
| filter causality_actor_process_image_name != 'sh'

## VALIDATION — Detect rsync execution with non-standard parent
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'rsync'
| filter causality_actor_process_image_name != 'systemd' and causality_actor_process_image_name != 'cron'
| fields agent_hostname, action_process_image_name, causality_actor_process_image_name

