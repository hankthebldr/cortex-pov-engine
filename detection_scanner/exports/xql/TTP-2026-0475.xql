# TTP-2026-0475 — Unusual AWS User Added to Group via CLI
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — AWS CLI User Group Membership Change
# severity: high
# Detection of AWS CLI process adding user to administrative group

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/tmp/aws/aws'
| filter action_process_command_line contains 'add-user-to-group'
| filter action_process_command_line contains 'admins'

## ABIOC — Unusual AWS User Group Membership (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: AWS CLI process execution with group membership modification
# Behavioral deviation in AWS user being added to administrative group outside normal patterns

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/tmp/aws/aws'
| filter action_process_command_line contains 'add-user-to-group'
| filter action_process_command_line contains 'admins'
| filter actor_process_image_name != 'sudo'
| filter actor_process_image_name != '/bin/bash'

## VALIDATION — AWS CLI Group Membership Changes
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/tmp/aws/aws'
| filter action_process_command_line contains 'add-user-to-group'
| filter action_process_command_line contains 'admins'
| filter not action_process_command_line contains 'sudo'
| fields action_process_image_name, action_process_command_line, agent_hostname

