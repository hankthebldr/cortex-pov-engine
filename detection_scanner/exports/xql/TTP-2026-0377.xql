# TTP-2026-0377 — SMB Traffic from Non-Standard Process
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — SMB Traffic from Non-Standard Process
# severity: high
# Detects SMB network connections originating from non-standard processes such as wget or custom binaries

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.50'
| filter dst_port = 445
| filter actor_process_image_name != 'svchost.exe' and actor_process_image_name != 'lsass.exe'
| filter actor_process_image_name != 'explorer.exe'

## ABIOC — Unusual SMB Connection from Custom Binary (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name
# Detects SMB traffic initiated by a binary not typically associated with SMB operations

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.50'
| filter dst_port = 445
| filter actor_process_image_name != 'svchost.exe' and actor_process_image_name != 'lsass.exe'
| filter actor_process_image_name != 'explorer.exe'
| filter actor_process_image_name contains '/tmp/'

## VALIDATION — Detect SMB From Non-Standard Process
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.50'
| filter dst_port = 445
| filter actor_process_image_name != 'svchost.exe' and actor_process_image_name != 'lsass.exe'
| filter actor_process_image_name != 'explorer.exe'

