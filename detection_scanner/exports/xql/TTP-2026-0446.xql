# TTP-2026-0446 — Uncommon net localgroup command execution on Windows endpoint
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon net localgroup command execution
# severity: high
# Detection of net.exe being executed with localgroup argument outside of expected context

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'C:\\Windows\\System32\\net.exe'
| filter action_file_path contains 'localgroup'
| filter not (causality_actor_process_image_name in ('explorer.exe', 'services.exe', 'svchost.exe'))

## ABIOC — Uncommon net localgroup behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Behavioral deviation indicating net.exe being used to manipulate local group memberships outside of normal administrative context

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'C:\\Windows\\System32\\net.exe'
| filter action_file_path contains 'localgroup'
| filter not (causality_actor_process_image_name in ('explorer.exe', 'services.exe', 'svchost.exe'))
| filter not (agent_hostname in ('admin-host-01', 'domain-controller-01'))

## VALIDATION — Hunt for net localgroup execution
# purpose: validation
