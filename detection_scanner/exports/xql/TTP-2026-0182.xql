# TTP-2026-0182 — Iranian APT Screening Serpens: AppDomainManager Hijacking & Living-Off-The-Land Defense Evasion
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — SIM-EDR-023 .NET AppDomainManager Config Drop and Host Execution
# Detects process start of a signed .NET binary referencing an AppDomain configuration file or AppDomainManager environment variable from an atypical user directory.

preset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_command_line contains "appdomain" or action_process_image_command_line contains "APPDOMAIN_MANAGER_ASM" or action_file_name endswith ".exe.config"
| fields _time, agent_hostname, actor_effective_username, action_process_image_name, action_process_image_command_line

## ABIOC — SIM-EDR-023 Anomalous .NET Host Process Spawning Shell Interpreter (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Learned baseline of Microsoft .NET runtime child process lineage per host and service account identity
# Behavioral analytics detects a trusted Microsoft .NET runtime host binary spawning an interactive command shell under a service or non-interactive account.

preset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ("caspol.exe", "powershell.exe", "dotnet", "mono") and action_process_image_name in ("cmd.exe", "powershell.exe", "sh", "bash")
| filter actor_effective_username in ("svc-account", "www-data", "administrator", "root")
| comp count() as spawn_count by agent_hostname, actor_process_image_name, action_process_image_name, actor_effective_username
| filter spawn_count >= 1
| fields agent_hostname, actor_process_image_name, action_process_image_name, actor_effective_username, spawn_count

## VALIDATION — SIM-EDR-023 Screening Serpens AppDomainManager Hijack Validation Query
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter _time > to_timestamp(current_time() - 1800)
| filter (action_process_image_command_line contains "appdomain" or action_process_image_command_line contains "sim_appdomain" or action_process_image_command_line contains "APPDOMAIN")
| comp count() as observed_events by agent_hostname, actor_effective_username
| filter observed_events >= 1
| fields agent_hostname, actor_effective_username, observed_events

