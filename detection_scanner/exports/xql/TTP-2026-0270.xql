# TTP-2026-0270 — Credential Extraction from Unix Files via Linux Shell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Extracting Credentials from Unix Files
# severity: high
# Process accessing password and shadow files for credential extraction

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/usr/bin/wget' and action_file_path IN ('/etc/passwd', '/etc/shadow')

## ABIOC — Unusual File Access for Credential Extraction (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: accessing sensitive credential files
# Process accessing sensitive Unix credential files outside of normal behavior

dataset = xdr_data
| filter event_type = ENUM.FILE_ACCESS
| filter action_file_path IN ('/etc/passwd', '/etc/shadow')
| filter actor_process_image_name != '/usr/sbin/cron'
| filter actor_process_image_name != '/usr/sbin/sshd'

## VALIDATION — Process Accessing Sensitive Unix Files
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.FILE_ACCESS
| filter action_file_path IN ('/etc/passwd', '/etc/shadow')
| filter actor_process_image_name != '/usr/sbin/cron'
| filter actor_process_image_name != '/usr/sbin/sshd'
| comp count() by actor_process_image_name, action_file_path

