# TTP-2026-0339 — Rare Process Execution via WMI and PowerShell in Organization
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rare Process Execution in Organization
# severity: high
# Detection of a PowerShell process initiating a command-line execution that is not typical for the organization

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe' and action_process_image_name = 'cmd.exe'
| filter causality_actor_process_image_name != 'explorer.exe'
| filter action_file_path contains 'cmd.exe'
| filter action_command_line contains 'whoami'

## ABIOC — Unusual PowerShell Command-Line Usage (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: PowerShell process initiating WMI-based command execution
# Behavioral deviation where PowerShell is used to invoke WMI methods with command-line arguments not seen in normal usage patterns

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_command_line contains 'Invoke-WmiMethod'
| filter action_command_line contains 'Win32_Process'
| filter action_command_line contains 'Create'
| filter causality_actor_process_image_name != 'explorer.exe'

## VALIDATION — Detect Rare PowerShell WMI Execution
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_command_line contains 'Invoke-WmiMethod'
| filter action_command_line contains 'Win32_Process'
| filter action_command_line contains 'Create'
| filter causality_actor_process_image_name != 'explorer.exe'
| comp count() as cnt by agent_hostname, action_command_line
| comp count() as cnt by > 1

