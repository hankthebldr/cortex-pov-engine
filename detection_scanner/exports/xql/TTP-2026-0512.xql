# TTP-2026-0512 — Cron Persistence on the Linux Syslog Feed
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## VALIDATION — Cron Job Executing a Piped Download
# purpose: validation
# dataset: linux_syslog

dataset = linux_syslog
| filter process = "cron" and (message contains "curl" or message contains "wget") and message contains "bash"
| comp count() as c by host, message
| filter c >= 1

