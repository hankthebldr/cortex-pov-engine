# TTP-2026-0250 — Unsigned Process Creates Scheduled Task and Performs Injection
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unsigned Process Created Scheduled Task
# severity: high
# Detection of unsigned process creating a scheduled task

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_file_path contains 'schtasks.exe'
| filter actor_process_signing_status = ENUM.UNSIGNED

## BIOC — Process Injection Detected
# severity: high
# Detection of process injection via CreateRemoteThread

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_INJECTION
| filter actor_process_image_name = 'powershell.exe'
| filter causality_actor_process_image_name = 'explorer.exe'

## ABIOC — Unsigned Process Injection After Scheduled Task Creation (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'powershell.exe' and action_file_path contains 'schtasks.exe'
# Behavioral deviation where an unsigned process creates a scheduled task and performs injection

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_file_path contains 'schtasks.exe'
| filter causality_actor_process_image_name = 'explorer.exe'
| filter action_process_image_name = 'inject.exe'

