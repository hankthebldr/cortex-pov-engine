# TTP-2026-0433 — Uncommon Kernel Module Load via insmod
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Kernel Module Load
# severity: high
# Detection of insmod being used with a non-standard or uncommon kernel module path

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'insmod'
| filter action_file_path != '/lib/modules/*'
| filter action_file_path != '/usr/lib/modules/*'

## ABIOC — Kernel Module Load Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: insmod process start with non-standard module path
# Behavioral deviation from standard insmod usage patterns, such as loading modules from non-standard paths

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'insmod'
| filter action_file_path not in ('/lib/modules/', '/usr/lib/modules/')

## VALIDATION — Kernel Module Load Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'insmod'
| filter action_file_path not in ('/lib/modules/', '/usr/lib/modules/')

