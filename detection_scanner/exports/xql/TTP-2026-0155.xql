# TTP-2026-0155 — AWS Credential & Secret Harvesting Behavioral Chain — CloudTrail (SIM-CDR-020)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## ABIOC — Suspicious secrets dump activity (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Anchored to the IAM identity's learned Secrets Manager access baseline (GetSecretValue call volume per identity per window); the ABIOC fires on the deviation, not a fixed threshold.
# ABIOC — behavioral-ML anomaly: a single IAM identity reads an unusually high volume of AWS Secrets Manager secrets in a short window (a 'secrets dump'), well above the identity's learned baseline. Keyed on the cloud_audit_logs dataset (AWS CloudTrail control-plane events normalised to the XDM cloud-audit schema).

dataset = cloud_audit_logs
| filter cloud_provider = "AWS"
| filter event_source = "secretsmanager.amazonaws.com"
| filter event_name in ("GetSecretValue", "BatchGetSecretValue", "ListSecrets")
| filter isnull(error_code)
| comp count() as retrieval_calls by user_identity_arn, source_ip_address
| filter retrieval_calls >= 20
| fields user_identity_arn, source_ip_address, retrieval_calls

## ABIOC — AWS SSM parameters retrieval (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Anchored to the IAM identity's learned SSM Parameter Store access baseline (with_decryption GetParameters call volume per identity per window); the deviation drives the alert.
# ABIOC — behavioral-ML anomaly: a single IAM identity retrieves an unusually high volume of SSM Parameter Store parameters (with_decryption=true, exposing tokens/keys held as SecureString) in a short window, above the identity's learned baseline. Keyed on the cloud_audit_logs dataset.

dataset = cloud_audit_logs
| filter cloud_provider = "AWS"
| filter event_source = "ssm.amazonaws.com"
| filter event_name in ("GetParameter", "GetParameters", "GetParametersByPath")
| filter with_decryption = true and isnull(error_code)
| comp count() as retrieval_calls by user_identity_arn, source_ip_address
| filter retrieval_calls >= 25
| fields user_identity_arn, source_ip_address, retrieval_calls

## VALIDATION — Cloud credential-store harvesting chain across SecretsManager and SSM
# purpose: hunt
# dataset: cloud_audit_logs

dataset = cloud_audit_logs
| filter cloud_provider = "AWS"
| filter event_source in ("secretsmanager.amazonaws.com", "ssm.amazonaws.com")
| filter event_name in ("GetSecretValue", "BatchGetSecretValue", "GetParameter", "GetParameters", "GetParametersByPath")
| filter isnull(error_code)
| comp count() as credential_reads, count_distinct(event_source) as services_touched by user_identity_arn, source_ip_address
| filter credential_reads >= 30 and services_touched >= 2
| fields user_identity_arn, source_ip_address, credential_reads, services_touched

## VALIDATION — SIM-CDR-020 validation — SecretsManager and SSM reads landed
# purpose: validation
# dataset: cloud_audit_logs

dataset = cloud_audit_logs
| filter _time > to_timestamp(current_time() - 900)
| filter event_source in ("secretsmanager.amazonaws.com", "ssm.amazonaws.com")
| filter event_name in ("GetSecretValue", "BatchGetSecretValue", "ListSecrets", "GetParameter", "GetParameters", "GetParametersByPath")
| comp count() as observed_events by event_source, event_name
| sort desc observed_events
| fields event_source, event_name, observed_events

