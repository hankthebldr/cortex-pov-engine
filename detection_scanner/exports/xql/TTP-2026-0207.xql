# TTP-2026-0207 — Windows Defender Exclusion Added for Payload Staging
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — New Defender Exclusion Added
# severity: high
# Detection of new Windows Defender exclusions added via Add-MpPreference

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe' and action_command_line contains 'Add-MpPreference'
| filter action_file_path contains 'payload.exe'

