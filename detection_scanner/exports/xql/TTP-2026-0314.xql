# TTP-2026-0314 — Unusual Ping Execution from Unsigned Parent Process
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Ping to localhost from an uncommon, unsigned parent process
# severity: high
# Detection of ping.exe execution initiated by an unsigned process

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'ping.exe'
| filter causality_actor_process_image_name not in ('explorer.exe', 'cmd.exe', 'powershell.exe')
| filter actor_process_image_name not in ('signed.exe', 'authenticode.exe')

## ABIOC — Unusual Ping Execution from Unsigned Parent (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name
# Behavioral deviation where ping.exe is launched from an unsigned, non-standard parent process

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'ping.exe'
| filter actor_process_image_name not in ('explorer.exe', 'cmd.exe', 'powershell.exe')
| filter causality_actor_process_image_name not in ('signed.exe', 'authenticode.exe')

