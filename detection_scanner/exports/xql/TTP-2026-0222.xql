# TTP-2026-0222 — Suspicious PowerShell Execution Connecting to Rare External IP
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — PowerShell with Hidden Window
# severity: high
# Detects PowerShell process started with hidden window, a common technique for avoiding detection

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe' and action_process_command_line contains '-WindowStyle Hidden'

## ABIOC — Commonly Abused Process Connected to Rare External Host (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'powershell.exe'
# Detects a commonly abused process (powershell.exe) making a connection to a rare external IP address

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter actor_process_image_name = 'powershell.exe'
| filter action_remote_ip in (select ip from rare_ips where count < 5)

## VALIDATION — PowerShell to Rare IP Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter actor_process_image_name = 'powershell.exe'
| filter action_remote_ip in (select ip from rare_ips where count < 5)
| fields actor_process_image_name, action_remote_ip, timestamp

