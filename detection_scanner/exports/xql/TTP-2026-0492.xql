# TTP-2026-0492 — WMI Execution via WmiPrvSe.exe with Rare Child Command Line
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — WmiPrvSe.exe Rare Child Command Line
# severity: high
# Detection of WmiPrvSe.exe spawning a child process with an uncommon command line pattern

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'WmiPrvSe.exe'
| filter action_command_line not in ['\'powershell.exe -EncodedCommand ...\'', '\'cmd.exe /c ...\'']
| filter action_command_line contains 'WindowStyle Hidden'

## ABIOC — WmiPrvSe.exe Unusual PowerShell Execution (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: WmiPrvSe.exe process spawning
# Detection of WmiPrvSe.exe executing PowerShell with unusual command line parameters

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'WmiPrvSe.exe'
| filter action_process_image_name = 'powershell.exe'
| filter action_command_line contains 'WindowStyle Hidden'
| filter action_command_line not in ['\'powershell.exe -EncodedCommand ...\'', '\'cmd.exe /c ...\'']

