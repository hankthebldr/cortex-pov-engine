# TTP-2026-0453 — Uncommon Remote Scheduled Task Creation via Schtasks
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Remote Scheduled Task Creation
# severity: high
# Detection of scheduled task creation on remote host using schtasks.exe with unusual parameters

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'schtasks.exe'
| filter action_file_path contains 'schtasks'
| filter causality_actor_process_image_name != 'services.exe'
| filter dst_ip = '192.0.2.10'

## ABIOC — Remote Scheduled Task Creation with Encoded Command (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: schtasks.exe process execution
# Behavioral deviation indicating creation of a scheduled task with encoded command on remote system

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'schtasks.exe'
| filter action_file_path contains 'schtasks'
| filter causality_actor_process_image_name != 'services.exe'
| filter dst_ip = '192.0.2.10'
| filter action_file_path contains '-EncodedCommand'

## VALIDATION — Scheduled Task Creation on Remote Host
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'schtasks.exe'
| filter dst_ip = '192.0.2.10'
| filter action_file_path contains '/s'
| filter action_file_path contains '/tr'
| filter action_file_path contains 'powershell.exe'

