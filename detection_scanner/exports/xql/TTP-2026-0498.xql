# TTP-2026-0498 — Rare SSH Session with C2 Communication
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — SSH Session with Unusual C2 Communication
# severity: high
# Detection of SSH session followed by outbound C2 communication

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'sshd'
| filter action_process_image_name = 'wget'
| filter action_remote_ip = '192.0.2.10'

## ABIOC — Rare SSH Session with C2 Communication (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: sshd process initiating network connection
# Detection of SSH session followed by outbound C2 communication that deviates from normal behavior

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.10'
| filter causality_actor_process_image_name = 'sshd'

## VALIDATION — SSH Sessions with C2 Communication
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.10'
| filter causality_actor_process_image_name = 'sshd'

