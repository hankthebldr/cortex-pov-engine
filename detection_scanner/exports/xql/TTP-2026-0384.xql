# TTP-2026-0384 — Disable Windows Firewall via netsh
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Firewall Disabled via Netsh
# severity: high
# Detection of netsh command executed with arguments to disable Windows Firewall

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'netsh.exe'
| filter action_process_command_line contains 'advfirewall set allprofiles state off'

## ABIOC — Suspicious Disablement of Windows Firewall (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start_netsh
# Behavioral ABIOC detecting suspicious disablement of Windows Firewall via netsh

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'netsh.exe'
| filter action_process_command_line contains 'advfirewall set allprofiles state off'

