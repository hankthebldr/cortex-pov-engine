# TTP-2026-0383 — Windows Endpoint: Suspicious Data Encryption via Ransomware-like Activity
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious Certutil Usage
# severity: high
# Detects usage of certutil.exe for file encryption/decryption

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'certutil.exe'
| filter action_command_line contains 'encrypt'
| filter action_command_line contains 'decrypt'

## ABIOC — Unusual File Encryption Process (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Detects process behavior involving file encryption using certutil and PowerShell

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'certutil.exe'
| filter action_command_line contains 'encrypt'
| filter action_command_line contains 'decrypt'
| filter causality_actor_process_image_name = 'powershell.exe'

## VALIDATION — Suspicious Certutil Execution
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'certutil.exe'
| filter action_command_line contains 'encrypt'
| filter action_command_line contains 'decrypt'

