# TTP-2026-0279 — Uncommon Root-Domain Port Combination by Common Process
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Globally Uncommon Root-Domain Port Combination by Common Process
# severity: high
# Detection of a common process initiating network connections to uncommon root domain and port combinations

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'cmd.exe'
| filter action_remote_ip = '192.0.2.100'
| filter dst_port = 80
| filter action_file_path contains 'malware.exe'

## ABIOC — Uncommon Port/Domain Combination by Common Process (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'cmd.exe' and action_remote_ip = '192.0.2.100' and dst_port = 80
# Behavioral deviation where a common Windows process connects to an uncommon root domain and port combination

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.100'
| filter dst_port = 80
| filter actor_process_image_name = 'cmd.exe'

## VALIDATION — Uncommon Root-Domain Port Combination
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.100'
| filter dst_port = 80
| filter actor_process_image_name = 'cmd.exe'
| filter action_file_path contains 'malware.exe'

