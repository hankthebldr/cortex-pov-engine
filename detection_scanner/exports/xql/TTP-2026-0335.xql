# TTP-2026-0335 — NTLM Relay Attack via SMB Client
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rare NTLM Access By User To Host
# severity: high
# Detects when a user performs an NTLM authentication to a remote host that is not typically accessed by that user.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'smbclient'
| filter action_remote_ip = '192.0.2.100'
| filter actor_process_image_name != 'lsass.exe'

## ABIOC — NTLM Authentication to Unusual Host (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: smbclient process execution
# Detects NTLM authentication attempts to a host that is not commonly accessed by the user.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'smbclient'
| filter action_remote_ip = '192.0.2.100'
| filter actor_process_image_name != 'lsass.exe'

## VALIDATION — SMB Client Access to Rare Host
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'smbclient'
| filter action_remote_ip = '192.0.2.100'

