# TTP-2026-0414 — AppleScript Obfuscation via Script Editor
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon AppleScript with Obfuscation
# severity: high
# Detection of AppleScript execution containing base64 encoded strings and dynamic execution patterns

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'osascript.exe'
| filter actor_process_image_name != 'Script Editor.exe'
| filter action_process_command_line contains 'base64'
| filter action_process_command_line contains 'eval'

## ABIOC — AppleScript Obfuscation Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: osascript.exe process start with obfuscated command line
# Detection of AppleScript execution with obfuscation techniques including base64 decoding and dynamic eval

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'osascript.exe'
| filter action_process_command_line contains 'base64'
| filter action_process_command_line contains 'eval'
| filter actor_process_image_name != 'Script Editor.exe'

## VALIDATION — AppleScript Obfuscation Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'osascript.exe'
| filter action_process_command_line contains 'base64'
| filter action_process_command_line contains 'eval'
| filter actor_process_image_name != 'Script Editor.exe'
| fields action_process_command_line, actor_process_image_name

