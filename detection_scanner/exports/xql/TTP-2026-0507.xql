# TTP-2026-0507 — Unusual SSH Activity via Automated Login and Command Execution
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — SSH Client Process Start
# severity: high
# Detection of SSH client process execution from non-standard location

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name contains '/tmp/.ssh/' and actor_process_image_name = 'sshd'

## ABIOC — Unusual SSH Activity Pattern (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: sshd process initiating execution of non-standard SSH client binary
# SSH client process launched from temporary directory after SSH login

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name contains '/tmp/.ssh/' and actor_process_image_name = 'sshd'
| filter causality_actor_process_image_name = 'sshd'

## VALIDATION — SSH Client Started from Temp Directory
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name contains '/tmp/.ssh/' and actor_process_image_name = 'sshd'
| fields agent_hostname, action_process_image_name, causality_actor_process_image_name

