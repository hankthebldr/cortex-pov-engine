# TTP-2026-0258 — Abusing WMI for Persistence via System Service
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Commonly Abused Process Launched as System Service
# severity: high
# Detection of wmiprvse.exe being started as a system service, a behavior often abused by attackers for persistence.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'wmiprvse.exe'
| filter action_process_image_name = 'sc.exe'
| filter causality_actor_process_image_name = 'system'

## ABIOC — Suspicious WMI Service Launch (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: system service creation using sc.exe
# Behavioral deviation where wmiprvse.exe is launched as a system service with a non-standard binary path, indicating potential abuse.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'wmiprvse.exe'
| filter action_process_image_name = 'sc.exe'
| filter causality_actor_process_image_name = 'system'
| filter action_file_path = 'C:\temp\malware.exe'

## VALIDATION — Detect WMI Service Creation
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'wmiprvse.exe'
| filter action_process_image_name = 'sc.exe'
| filter causality_actor_process_image_name = 'system'

