# TTP-2026-0278 — Signed Process Using Uncommon Root Domain for C2
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Globally Uncommon Root Domain from Signed Process
# severity: high
# Detection of network traffic to a root domain not commonly seen in the organization, originating from a signed process

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_OUTBOUND
| filter causality_actor_process_image_name = 'powershell.exe' and action_remote_ip = '192.0.2.1'
| filter not in(action_remote_ip, (select distinct action_remote_ip from xdr_data where causality_actor_process_image_name = 'powershell.exe' and event_type = ENUM.NETWORK_CONNECTION))

## ABIOC — Suspicious PowerShell Network Activity from Signed Binary (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Behavioral deviation where a signed Windows binary initiates network communication to an uncommon root domain

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_OUTBOUND
| filter causality_actor_process_image_name = 'powershell.exe'
| filter action_remote_ip = '192.0.2.1'
| filter not in(action_remote_ip, (select distinct action_remote_ip from xdr_data where causality_actor_process_image_name = 'powershell.exe' and event_type = ENUM.NETWORK_CONNECTION))

## VALIDATION — Uncommon Root Domain from Signed Process
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_OUTBOUND
| filter causality_actor_process_image_name = 'powershell.exe'
| filter action_remote_ip = '192.0.2.1'
| filter not in(action_remote_ip, (select distinct action_remote_ip from xdr_data where causality_actor_process_image_name = 'powershell.exe' and event_type = ENUM.NETWORK_CONNECTION))
| fields causality_actor_process_image_name, action_remote_ip, dst_port

