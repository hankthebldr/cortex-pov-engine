# TTP-2026-0365 — Kubelet Credential Retrieval via Windows PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — PowerShell Execution with Bypass Policy
# severity: high
# Detection of PowerShell execution with -ExecutionPolicy Bypass flag

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_process_command_line contains '-ExecutionPolicy Bypass'

## ABIOC — Suspicious File Access After PowerShell Execution (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: PowerShell Execution with Bypass Policy
# Detection of file access after PowerShell execution with bypass policy

dataset = xdr_data
| filter event_type = ENUM.FILE_ACCESS
| filter action_file_path = 'C:\temp\kubeletcreds.txt'
| filter causality_actor_process_image_name = 'powershell.exe'

## VALIDATION — PowerShell Execution with Bypass Policy
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_process_command_line contains '-ExecutionPolicy Bypass'

