# TTP-2026-0246 — SMB Scanning with Net.exe to Multiple Hosts
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Abnormal SMB scanning activity to multiple hosts
# severity: high
# Detection of multiple SMB share enumeration commands to distinct IP addresses

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'net.exe'
| filter action_file_path contains 'view'
| comp count() as cnt by action_remote_ip
| filter count() > 3

## ABIOC — Multiple SMB share enumeration to distinct IPs (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name = 'net.exe' and action_file_path contains 'view'
# Behavioral deviation detected when net.exe is used to enumerate SMB shares across multiple unique IP addresses

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip in ('192.0.2.100', '192.0.2.101', '192.0.2.102', '192.0.2.103')
| filter dst_port = 445
| comp count() as cnt by action_remote_ip
| filter count() > 3

## VALIDATION — Detect SMB scanning via net.exe
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'net.exe'
| filter action_file_path contains 'view'
| comp count() as cnt by causality_actor_process_image_name, action_remote_ip
| filter count() > 3

