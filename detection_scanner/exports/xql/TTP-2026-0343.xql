# TTP-2026-0343 — Execution of Signed Malware via Trusted Security Product
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rare security product signed executable executed in the network
# severity: high
# Detection of a process that is signed by a known security vendor but is running in an unexpected network context

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name contains 'security'
| filter action_process_image_name contains 'signed'
| filter action_remote_ip != '192.0.2.0/24'
| filter action_remote_ip != '10.0.0.0/8'
| filter action_remote_ip != '172.16.0.0/12'
| filter action_remote_ip != '127.0.0.0/8'

## ABIOC — Unusual signed binary network behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name contains 'security'
# An executable signed by a security vendor is observed making outbound network connections outside of expected trusted networks

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name contains 'security'
| filter action_process_image_name contains 'signed'
| filter action_remote_ip != '192.0.2.0/24'
| filter action_remote_ip != '10.0.0.0/8'
| filter action_remote_ip != '172.16.0.0/12'
| filter action_remote_ip != '127.0.0.0/8'

## VALIDATION — Signed binary executing with non-standard network behavior
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name contains 'security'
| filter action_process_image_name contains 'signed'
| filter action_remote_ip != '192.0.2.0/24'
| filter action_remote_ip != '10.0.0.0/8'
| filter action_remote_ip != '172.16.0.0/12'
| filter action_remote_ip != '127.0.0.0/8'

