# TTP-2026-0306 — Windows EDR Mimicking Linux Discovery Commands via PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Multiple Discovery Commands by Same Process
# severity: high
# Detection of multiple discovery commands executed by the same PowerShell process

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_image_name = 'powershell.exe'
| comp count() as cnt by causality_actor_process_image_name
| comp count(action_process_image_name) as cmd_count
| filter cmd_count > 1

## ABIOC — Windows PowerShell Executing Linux Discovery Commands (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'powershell.exe'
# Behavioral deviation where a Windows PowerShell process initiates multiple Linux discovery commands

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_image_name = 'powershell.exe'
| filter action_file_path contains 'malware.sh'
| filter action_process_command_line contains 'whoami;hostname;ls -la'
| filter action_process_command_line contains 'ps aux;netstat -an;df -h'

## VALIDATION — Hunt for PowerShell with Multiple Discovery Commands
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_command_line contains 'whoami;hostname;ls -la'
| filter action_process_command_line contains 'ps aux;netstat -an;df -h'
| comp count() as cnt by causality_actor_process_image_name
| comp count(action_process_command_line) as discovery_cmd_count
| filter discovery_cmd_count > 1

