# TTP-2026-0336 — Rare NTLM Usage by User - Lateral Movement via SMB
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rare NTLM Usage by User
# severity: high
# Detection of NTLM authentication attempts by a user outside of normal behavior patterns

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'ntlm_smb.exe'
| filter action_remote_ip in ('192.0.2.100', '192.0.2.101', '192.0.2.102')

## ABIOC — Unusual SMB Authentication Pattern (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Detection of NTLM authentication attempts from user account to multiple targets in short time window

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip in ('192.0.2.100', '192.0.2.101', '192.0.2.102')
| filter dst_port = 445
| filter actor_process_image_name = 'ntlm_smb.exe'

## VALIDATION — NTLM Authentication Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter dst_port = 445
| filter action_remote_ip in ('192.0.2.100', '192.0.2.101', '192.0.2.102')
| filter actor_process_image_name = 'ntlm_smb.exe'
| comp count() by actor_process_image_name, action_remote_ip

