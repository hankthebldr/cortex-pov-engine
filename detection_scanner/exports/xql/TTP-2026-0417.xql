# TTP-2026-0417 — AppleScript Cryptocurrency Wallet Access via Command Line
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon AppleScript Execution via Command Line
# severity: high
# Detection of AppleScript execution initiated directly from command line without GUI interaction

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'osascript'
| filter actor_process_image_name != 'Terminal' and actor_process_image_name != 'iTerm2'
| filter action_file_path contains '/usr/bin/osascript'

## ABIOC — Unusual AppleScript Behavior for Wallet Data Access (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: osascript process initiated from command line
# Behavioral deviation where AppleScript is used to access wallet application processes

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'osascript'
| filter action_file_path contains 'System Events'
| filter action_file_path contains 'WalletApp'

## VALIDATION — Detect AppleScript Access to Wallet Processes
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'osascript'
| filter action_file_path contains 'System Events'
| filter action_file_path contains 'WalletApp'
| filter actor_process_image_name != 'Terminal' and actor_process_image_name != 'iTerm2'

