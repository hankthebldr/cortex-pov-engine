# TTP-2026-0378 — CredWiz.exe Usage for Credential Export
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Stored Credentials Exported via CredWiz
# severity: high
# Detection of credwiz.exe process execution with export flag

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'credwiz.exe'
| filter action_process_command_line contains '/export'

## ABIOC — Suspicious CredWiz Execution Pattern (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: credwiz.exe process start with export flag
# Detection of credwiz.exe being executed with export flag from non-standard location

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'credwiz.exe'
| filter action_process_command_line contains '/export'
| filter actor_process_image_name != 'explorer.exe' and actor_process_image_name != 'cmd.exe'

## VALIDATION — CredWiz Export Activity
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'credwiz.exe'
| filter action_process_command_line contains '/export'
| comp count() by agent_hostname, action_process_command_line

