# TTP-2026-0484 — Unusual Process Execution via AWS Systems Manager
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unusual Process Execution by SSM
# severity: high
# Detection of PowerShell or cmd.exe launched by SSM agent

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'ssm-agent.exe'
| filter action_process_image_name = 'powershell.exe' or action_process_image_name = 'cmd.exe'

## ABIOC — SSM-Initiated PowerShell Execution (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: ssm-agent.exe
# Behavioral deviation where SSM agent triggers PowerShell execution

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'ssm-agent.exe'
| filter action_process_image_name = 'powershell.exe'
| filter causality_actor_process_image_name = 'ssm-agent.exe'

## VALIDATION — SSM Process Execution Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'ssm-agent.exe'
| filter action_process_image_name = 'powershell.exe' or action_process_image_name = 'cmd.exe'
| fields agent_hostname, actor_process_image_name, action_process_image_name, action_file_path

