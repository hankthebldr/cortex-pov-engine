# TTP-2026-0253 — AppleScript Process with Rare Command Line Execution
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — AppleScript Process with Rare Command Line
# severity: high
# Detection of osascript process with uncommon command line arguments indicating potential evasion

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'osascript'
| filter action_file_path contains 'script.scpt'
| filter action_command_line contains 'curl -s http://192.0.2.10:8080/attack'

## ABIOC — AppleScript Rare Command Line Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: osascript process start with rare command line
# Behavioral deviation detected when osascript is executed with a rare command line pattern

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'osascript'
| filter action_command_line contains 'curl -s http://192.0.2.10:8080/attack'

## VALIDATION — Hunt for AppleScript Rare Command Line
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'osascript'
| filter action_command_line contains 'curl -s http://192.0.2.10:8080/attack'
| fields agent_hostname, action_process_image_name, action_command_line

