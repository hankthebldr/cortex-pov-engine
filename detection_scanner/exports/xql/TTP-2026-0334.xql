# TTP-2026-0334 — Windows Update Traffic Over HTTP
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rare MS-Update traffic over HTTP
# severity: high
# Detection of unusual HTTP traffic originating from Windows Update components

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and action_remote_ip = '192.0.2.10' and dst_port = 80
| filter causality_actor_process_image_name = 'svchost.exe' or causality_actor_process_image_name = 'wuauclt.exe'
| filter action_process_image_name = 'powershell.exe'

## ABIOC — Suspicious PowerShell Usage with Update Mechanism (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# PowerShell executing download commands within a Windows Update context

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter causality_actor_process_image_name = 'svchost.exe' or causality_actor_process_image_name = 'wuauclt.exe'
| filter action_file_path contains 'update.exe'

## VALIDATION — Detect Rare MS-Update Traffic
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and action_remote_ip = '192.0.2.10' and dst_port = 80
| filter causality_actor_process_image_name = 'svchost.exe' or causality_actor_process_image_name = 'wuauclt.exe'
| filter action_process_image_name = 'powershell.exe'
| comp count() by agent_hostname

