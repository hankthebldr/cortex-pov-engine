# TTP-2026-0459 — Uncommon SQL-like Command Line Execution via PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon SQL-like Command Line Pattern
# severity: high
# Detection of PowerShell processes with command lines containing SQL-like syntax patterns

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| comp count() as events by actor_process_image_name, agent_hostname
| sort desc events

## ABIOC — SQL-like Command Line in PowerShell (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'powershell.exe'
# Behavioral deviation showing PowerShell command lines with SQL-like syntax patterns

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| comp count() as events by actor_process_image_name, agent_hostname
| sort desc events

## VALIDATION — Detect SQL-like PowerShell Commands
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| fields agent_hostname, actor_process_image_name, action_command_line
| comp count() as events by actor_process_image_name, agent_hostname
| sort desc events

