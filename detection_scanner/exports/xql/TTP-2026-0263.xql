# TTP-2026-0263 — Execution of Uncommon Process at Early Startup Stage
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Startup Process Execution
# severity: high
# Detection of a process starting from a non-standard location during early boot phase

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'svchost.exe' and action_process_image_name contains 'temp' and action_process_image_name contains '.exe'
| filter action_process_image_name != 'C:\\Windows\\System32\\svchost.exe'

## ABIOC — Early Startup Execution Anomaly (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Behavioral deviation from typical startup process execution patterns

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'svchost.exe' and action_process_image_name contains 'temp' and action_process_image_name contains '.exe'
| filter action_process_image_name != 'C:\\Windows\\System32\\svchost.exe'
| filter action_process_image_name != 'C:\\Windows\\SysWOW64\\svchost.exe'

## VALIDATION — Detect Uncommon Startup Processes
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'svchost.exe' and action_process_image_name contains 'temp' and action_process_image_name contains '.exe'
| filter action_process_image_name != 'C:\\Windows\\System32\\svchost.exe'
| comp count() as cnt by action_process_image_name
| comp count() as cnt by > 1

