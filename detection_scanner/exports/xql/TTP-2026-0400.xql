# TTP-2026-0400 — PowerShell Module Loading via Suspicious Process
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious PowerShell Module Load
# severity: high
# A process loads a known PowerShell module in an unusual context

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_file_path contains '.psd1'
| filter actor_process_image_name != 'explorer.exe'

## ABIOC — Unusual PowerShell Module Load (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name = 'powershell.exe'
# Behavioral deviation where a non-interactive process loads a PowerShell module

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_file_path contains '.psd1'
| filter actor_process_image_name != 'explorer.exe'
| filter action_process_image_name != 'powershell.exe'

## VALIDATION — PowerShell Module Load Detection
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_file_path contains '.psd1'
| filter actor_process_image_name != 'explorer.exe'
| comp count() by action_file_path

