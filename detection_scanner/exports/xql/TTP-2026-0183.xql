# TTP-2026-0183 — Screening Serpens: Edge Exploit to EDR AppDomain Hijack and AD Kerberoast Stitch
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — SIM-MP-023 Edge VPN Gateway Exploit Probe
# Detects anomalous exploit probing targeting edge VPN interfaces in NGFW threat logs.

preset = panw_ngfw_threat_raw
| filter threat_category = "vulnerability" or threat_name contains "VPN" or threat_name contains "GlobalProtect"
| filter action in ("alert", "block", "reset-both")
| fields _time, src_ip, dst_ip, threat_name, threat_category, app_id

## BIOC — SIM-MP-023 Endpoint AppDomainManager Execution Flow Hijack
# Detects execution of an AppDomainManager hijacked host process on the internal network following edge intrusion.

preset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_command_line contains "appdomain" or action_process_image_command_line contains "APPDOMAIN_MANAGER_ASM"
| fields _time, agent_hostname, actor_effective_username, action_process_image_name, action_process_image_command_line

## ABIOC — SIM-MP-023 Anomalous Endpoint Kerberos Service Ticket Burst (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Baseline of Kerberos ticket granting requests per workstation and service account
# Behavioral analytics identifies an anomalous volume of Kerberos TGS ticket requests with RC4 encryption originating from a compromised endpoint.

preset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_command_line contains "spn" or action_process_image_command_line contains "kerberoast" or action_process_image_command_line contains "RequestUserJScriptTicket"
| comp count() as ticket_burst by agent_hostname, actor_effective_username
| filter ticket_burst >= 1
| fields agent_hostname, actor_effective_username, ticket_burst

## VALIDATION — SIM-MP-023 C2 Exfiltration Session Validation
# purpose: validation
# dataset: panw_ngfw_traffic_raw

dataset = panw_ngfw_traffic_raw
| filter _time > to_timestamp(current_time() - 1800)
| filter app_id in ("ssl", "web-browsing") and bytes_sent > 1000
| comp count() as session_count by src_ip, dst_ip
| filter session_count >= 1
| fields src_ip, dst_ip, session_count

