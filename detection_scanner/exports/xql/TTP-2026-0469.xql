# TTP-2026-0469 — Unsigned Process Creates Scheduled Task via File Access
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unsigned Process Creates Scheduled Task
# severity: high
# Detects when an unsigned process creates a scheduled task via file access to the Windows Tasks directory

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_file_path = 'C:\\Windows\\Tasks\\malicious_task.xml'
| filter actor_process_image_name != 'signed_process.exe'

## ABIOC — Unsigned Process Accesses Windows Tasks Directory (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process creates file in Windows Tasks directory
# Behavioral deviation where an unsigned process accesses the Windows Tasks directory to create a scheduled task

dataset = xdr_data
| filter event_type = ENUM.FILE_ACCESS
| filter action_file_path = 'C:\\Windows\\Tasks\\'
| filter actor_process_image_name != 'signed_process.exe'
| filter causality_actor_process_image_name = 'powershell.exe'

## VALIDATION — Scheduled Task Creation via File Access
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.FILE_ACCESS
| filter action_file_path = 'C:\\Windows\\Tasks\\'
| filter actor_process_image_name != 'signed_process.exe'
| comp count() as cnt by action_process_image_name, action_file_path
| comp count() as cnt by

