# TTP-2026-0397 — Suspicious Process Accessing Google Masquerade
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious Process Accessed Google Masquerade
# severity: high
# Process accesses a site that masquerades as Google

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = '/tmp/evil_script'
| filter action_remote_ip = '192.0.2.10'

