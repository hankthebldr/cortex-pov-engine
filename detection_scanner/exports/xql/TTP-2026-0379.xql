# TTP-2026-0379 — MSBuild DLL Loading via Suspicious .NET Process
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious .NET Process Loads MSBuild DLL
# severity: high
# A .NET process loads an MSBuild DLL from a non-standard path

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'malware.exe'
| filter action_file_path contains 'output.dll'

## ABIOC — MSBuild DLL Loading from Non-Standard Path (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'malware.exe'
# Detects when a .NET process loads MSBuild DLL from unexpected directory

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'malware.exe'
| filter action_file_path contains 'output.dll'
| filter action_file_path not in ('C:\Windows\Microsoft.NET\', 'C:\Program Files\MSBuild\')

## VALIDATION — Detect Suspicious MSBuild DLL Load
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'malware.exe'
| filter action_file_path contains 'output.dll'
| filter action_file_path not in ('C:\Windows\Microsoft.NET\', 'C:\Program Files\MSBuild\')

