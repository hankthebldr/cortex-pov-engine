# TTP-2026-0427 — Windows Endpoint - Uncommon Communication to Instant Messaging Server
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Process Communication to Instant Messaging Server
# severity: high
# Detection of process initiating communication to an instant messaging server

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECTION_ESTABLISHED
| filter action_remote_ip = '192.0.2.10' and dst_port = 443
| filter actor_process_image_name != null
| filter actor_process_image_name contains 'powershell.exe'

## ABIOC — Behavioral Abnormal Communication to IM Server (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name
# Process behavior that deviates from normal communication patterns to instant messaging server

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECTION_ESTABLISHED
| filter action_remote_ip = '192.0.2.10' and dst_port = 443
| filter actor_process_image_name contains 'powershell.exe'
| filter actor_process_image_name != 'C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe'

## VALIDATION — Hunt for PowerShell with IM Communication
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECTION_ESTABLISHED
| filter action_remote_ip = '192.0.2.10' and dst_port = 443
| filter actor_process_image_name contains 'powershell.exe'
| comp count() as cnt by actor_process_image_name, action_remote_ip, dst_port

