# TTP-2026-0389 — Suspicious HTTP Parameters via PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — PowerShell with Suspicious HTTP Parameters
# severity: high
# PowerShell process started with command-line parameters indicating suspicious HTTP request

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_command_line contains '192.0.2.10'
| filter action_command_line contains 'param=123'
| filter action_command_line contains 'cmd=run'

## ABIOC — Suspicious HTTP Parameter Usage (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name
# Behavioral deviation detected in PowerShell process using HTTP with suspicious parameters

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_command_line contains '192.0.2.10'
| filter action_command_line contains 'param=123'
| filter action_command_line contains 'cmd=run'

