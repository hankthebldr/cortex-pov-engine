# TTP-2026-0396 — PowerShell Process Enumeration via Get-Process
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious PowerShell Enumeration of Running Processes
# severity: high
# Detection of PowerShell commands that enumerate running processes using Get-Process

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_image_name = 'powershell.exe'
| filter action_command_line contains 'Get-Process'

## ABIOC — PowerShell Process Enumeration Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'powershell.exe'
# Behavioral deviation detected when PowerShell is used to enumerate running processes

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_command_line contains 'Get-Process'

## VALIDATION — PowerShell Process Enumeration Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_command_line contains 'Get-Process'
| fields agent_hostname, actor_process_image_name, action_command_line

