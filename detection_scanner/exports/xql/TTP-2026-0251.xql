# TTP-2026-0251 — Exploitation of Internal Firewall Vulnerability via PowerShell Command Execution
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unusual PowerShell Execution with Bypass Flags
# severity: high
# Detection of PowerShell commands using -NoP, -NonI, -W Hidden, and -Exec Bypass flags

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_image_name = 'powershell.exe'
| filter action_process_command_line contains '-NoP' and action_process_command_line contains '-Exec Bypass'
| filter action_process_command_line contains '-W Hidden'

## BIOC — WMI Remote Execution via PowerShell
# severity: high
# PowerShell execution using WMI methods to perform remote command execution

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_command_line contains 'Get-WmiObject' and action_process_command_line contains 'Win32_OperatingSystem'
| filter action_remote_ip in ['192.0.2.20']

## ABIOC — Suspicious PowerShell Network Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'powershell.exe'
# PowerShell processes initiating outbound connections to 192.0.2.0/24

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_process_image_name = 'powershell.exe'
| filter action_remote_ip in ['192.0.2.10', '192.0.2.20', '192.0.2.30']

## VALIDATION — PowerShell with Bypass Flags
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_command_line contains '-NoP' and action_process_command_line contains '-Exec Bypass'
| filter action_process_command_line contains '-W Hidden'

