# TTP-2026-0294 — Netsh Helper DLL Registry Key Manipulation
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Netsh Helper DLL Registry Modification
# severity: high
# Detection of registry key changes to netsh helper DLL paths

dataset = xdr_data
| filter event_type = ENUM.REGISTRY and event_sub_type = ENUM.REGISTRY_SET_VALUE
| filter action_file_path contains "HKLM\\SYSTEM\\CurrentControlSet\\Services\\netsh"
| filter action_process_image_name = "reg.exe"

## ABIOC — Suspicious Netsh Process Execution (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: registry modification of netsh helper DLL
# Detection of netsh.exe executing a non-standard DLL via registry manipulation

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = "netsh.exe"
| filter causality_actor_process_image_name contains "reg.exe"

## VALIDATION — Registry Changes to Netsh Helper Keys
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.REGISTRY and event_sub_type = ENUM.REGISTRY_SET_VALUE
| filter action_file_path contains "HKLM\\SYSTEM\\CurrentControlSet\\Services\\netsh"
| filter action_process_image_name = "reg.exe"

