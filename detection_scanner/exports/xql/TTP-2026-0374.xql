# TTP-2026-0374 — Signed Process Creates Scheduled Task via File Access
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Signed Process Creates Scheduled Task
# severity: high
# Detects when a signed process creates a scheduled task via file access

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'schtasks.exe'
| filter action_file_path contains 'Temp'
| filter action_file_path contains '.xml'
| filter causality_actor_process_image_name = 'signed_process'

