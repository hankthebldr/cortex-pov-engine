# TTP-2026-0341 — VNC Server Execution via PowerShell with Remote Access
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rare process with VNC server capabilities started
# severity: high
# Detection of a rare process named like a VNC server being started

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'vncserver.exe'
| filter actor_process_image_name = 'powershell.exe'

## ABIOC — Unusual PowerShell execution followed by VNC process start (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: powershell.exe starting vncserver.exe
# PowerShell launching a VNC server process, which is rare and suspicious

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'vncserver.exe'
| filter actor_process_image_name = 'powershell.exe'
| filter causality_actor_process_image_name = 'cmd.exe'

## VALIDATION — Detect VNC process start from PowerShell
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'vncserver.exe'
| filter actor_process_image_name = 'powershell.exe'

