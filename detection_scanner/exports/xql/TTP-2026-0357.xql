# TTP-2026-0357 — Dynamic DNS Domain Access via PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Recurring Rare Domain Access
# severity: high
# Detection of repeated access to a dynamic DNS domain not seen in the environment

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.10'
| filter action_protocol = ENUM.TCP
| filter dst_port = 80
| comp count() by action_remote_ip, actor_process_image_name
| filter count > 1

## ABIOC — PowerShell Download and Execute from Dynamic DNS (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: powershell.exe process start with download and execute
# Behavioral deviation of PowerShell downloading and executing from a dynamic DNS domain

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter causality_actor_process_image_name like '%powershell.exe%'
| filter action_file_path like '%malware.exe%'
| filter action_remote_ip = '192.0.2.10'

## VALIDATION — Detect Rare Dynamic DNS Access
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.10'
| filter actor_process_image_name = 'powershell.exe'
| comp count() by action_remote_ip, actor_process_image_name
| filter count > 1

