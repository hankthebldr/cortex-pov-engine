# TTP-2026-0483 — PowerShell History File Access via Unusual Process
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unusual Process Accessed PowerShell History
# severity: high
# A process not typically associated with PowerShell history access attempts to read the history file.

dataset = xdr_data
| filter event_type = ENUM.FILE_ACCESS and action_file_path = 'C:\\Users\\user\\AppData\\Roaming\\Microsoft\\Windows\\PowerShell\\PSReadLine\\ConsoleHost_history.txt'
| filter actor_process_image_name != 'powershell.exe' and actor_process_image_name != 'cmd.exe'
| filter causality_actor_process_image_name != 'powershell.exe'

## ABIOC — Unusual Process Accessing PowerShell History File (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: file_access_to_power_shell_history
# Detection of a non-standard process accessing the PowerShell history file, which is typically accessed by legitimate PowerShell sessions.

dataset = xdr_data
| filter event_type = ENUM.FILE_ACCESS and action_file_path = 'C:\\Users\\user\\AppData\\Roaming\\Microsoft\\Windows\\PowerShell\\PSReadLine\\ConsoleHost_history.txt'
| filter actor_process_image_name != 'powershell.exe' and actor_process_image_name != 'cmd.exe'
| filter causality_actor_process_image_name != 'powershell.exe'

