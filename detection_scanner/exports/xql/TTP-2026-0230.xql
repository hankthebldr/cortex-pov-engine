# TTP-2026-0230 — Unicode Obfuscation via PowerShell for Lateral Movement
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — PowerShell Process with Unicode Obfuscation
# severity: high
# Detection of PowerShell processes that use Unicode character substitution in command line arguments

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_command_line contains '0x50006f007700650072005300680065006c006c002e006500780065'

## ABIOC — Unicode Substitution in PowerShell Command Line (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'powershell.exe'
# Behavioral deviation where PowerShell command line arguments contain Unicode-encoded strings indicating obfuscation

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_command_line matches '0x[0-9a-fA-F]{2,}'

## VALIDATION — Detect Unicode Obfuscated PowerShell Commands
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_command_line matches '0x[0-9a-fA-F]{2,}'

