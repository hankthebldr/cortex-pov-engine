# TTP-2026-0488 — Kerberos Ticket Request with Weak Encryption
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Weakly Encrypted Kerberos Ticket Requested
# severity: high
# Detection of a Kerberos ticket request with weak encryption settings

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'klist.exe'
| filter action_file_path contains 'klist.exe'

## ABIOC — Kerberos Ticket Request with Weak Encryption (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name = 'klist.exe'
# Behavioral deviation detected when a process requests a Kerberos ticket with weak encryption

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'klist.exe'
| filter action_file_path contains 'klist.exe'

## VALIDATION — Kerberos Weak Encryption Ticket Requests
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'klist.exe'
| filter action_file_path contains 'klist.exe'
| comp count() by action_process_image_name, action_file_path

