# TTP-2026-0487 — Weakly-Encrypted Kerberos TGT Response Attack
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Weakly-Encrypted Kerberos TGT Process
# severity: high
# Detection of process starting with weakly-encrypted Kerberos ticket handling

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'cmd.exe' and action_process_image_name = 'cmd.exe'
| filter action_file_path contains 'ticket.kirbi'

## ABIOC — Weakly-Encrypted Kerberos TGT Response (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'cmd.exe' and action_file_path contains 'ticket.kirbi'
# Behavioral deviation in Kerberos ticket handling using weak encryption

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'cmd.exe'
| filter action_file_path contains 'ticket.kirbi'
| filter action_remote_ip = '192.0.2.100'

## VALIDATION — Kerberos Ticket Handling Detection
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_file_path contains 'ticket.kirbi'
| filter action_remote_ip = '192.0.2.100'

