# TTP-2026-0197 — WMI Event Subscription Persistence via PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — WMI Event Filter Creation
# severity: high
# Detection of WMI event filter creation via PowerShell or WMIC

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe' or action_process_image_name = 'wmic.exe'
| filter action_process_command_line contains 'New-EventLog' or action_process_command_line contains 'SWbemFilter'
| filter causality_actor_process_image_name = 'powershell.exe' or causality_actor_process_image_name = 'wmic.exe'

