# TTP-2026-0197 — GlassWorm macOS Wave — Poisoned VS Code Extension → Keychain, LaunchAgent, Credential Staging and Archive Send
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — KOI-009 Keychain Access By IDE Descendant
# severity: high
# A child of the VS Code extension host runs the security utility against a keychain database file. Legitimate extensions do not read Keychain material; the report's macOS payload targets it directly. CortexSim points the call at a decoy *.keychain-db only.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name in ("Electron", "Code Helper (Plugin)", "Code Helper", "code")
| filter action_process_image_name = "security"
| filter action_process_image_command_line contains_any ("find-generic-password", "find-internet-password", "dump-keychain") and action_process_image_command_line contains ".keychain-db"
| comp count() as keychain_calls by agent_hostname, causality_id, causality_actor_process_instance_id, action_process_image_command_line
| filter keychain_calls >= 1
| fields agent_hostname, causality_id, causality_actor_process_instance_id, action_process_image_command_line, keychain_calls

## BIOC — KOI-009 LaunchAgent Written And Loaded From IDE Lineage
# severity: high
# A descendant of the IDE bootstraps a user LaunchAgent with launchctl, the persistence step in the macOS wave. The plist is written by the same lineage immediately before; the load command is the single-event anchor that carries the plist path.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name in ("Electron", "Code Helper (Plugin)", "Code Helper", "code")
| filter action_process_image_name = "launchctl"
| filter action_process_image_command_line contains "bootstrap" and action_process_image_command_line contains "/Library/LaunchAgents/"
| comp count() as agent_loads by agent_hostname, causality_id, causality_actor_process_instance_id, action_process_image_command_line
| filter agent_loads >= 1
| fields agent_hostname, causality_id, causality_actor_process_instance_id, action_process_image_command_line, agent_loads

## BIOC — KOI-009 Multi Credential File Read Under IDE CGO
# severity: high
# Three or more distinct credential-named files (npm token file, git credentials, SSH key, editor storage, keychain copy) are read in one window by a process in the IDE's causality chain. An extension that reads this set is stealing, not formatting. The list deliberately excludes VS Code's own global-storage files storage.json and state.vscdb: the IDE reads them at every launch, and the per-extension copies multiply the distinct-path count, so including them satisfies the >= 3 threshold with no attack present. The decoy run still yields exactly three distinct paths (.npmrc, .git-credentials, id_rsa), so the simulation keeps firing.

dataset = xdr_data
| filter event_type = ENUM.FILE
| filter event_sub_type in (ENUM.FILE_OPEN, ENUM.FILE_READ)
| filter causality_actor_process_image_name in ("Electron", "Code Helper (Plugin)", "Code Helper", "code")
| filter action_file_path contains_any (".npmrc", ".git-credentials", "id_rsa", "id_ed25519", ".keychain-db", "credentials.json")
| comp count_distinct(action_file_path) as secret_files_read by agent_hostname, causality_id, causality_actor_process_instance_id, actor_process_image_name
| filter secret_files_read >= 3
| fields agent_hostname, causality_id, causality_actor_process_instance_id, actor_process_image_name, secret_files_read

## ABIOC — KOI-009 IDE Extension Host Spawns Scripting Host For First Seen Publisher (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: The VS Code main/extension-host process (Causality Group Owner) and its causality_actor_process_instance_id; the deviation is a scripting-host child from a publisher first seen on this endpoint, against the baseline of extension hosts that spawn no interpreters.
# Behavioral-ML deviation: the VS Code extension host, from an extension whose publisher has no prior install on this endpoint, spawns a macOS scripting-interpreter child at activation. Extension hosts rarely spawn osascript; a first-seen publisher doing it in the first minute is the loader's activation shape.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name in ("Electron", "Code Helper (Plugin)", "Code Helper", "code")
| filter action_process_image_name in ("osascript", "sh", "bash", "zsh")
| filter action_process_signature_status != ENUM.SIGNED or action_process_image_name = "osascript"
| comp count() as script_spawns, values(action_process_image_command_line) as child_cmdlines by agent_hostname, causality_id, causality_actor_process_image_name, causality_actor_process_instance_id
| filter script_spawns >= 1
| fields agent_hostname, causality_id, causality_actor_process_image_name, causality_actor_process_instance_id, child_cmdlines, script_spawns

## VALIDATION — KOI-009 VS Code Extension Install Creates Unknown Publisher Extension Directory
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter _time > to_timestamp(current_time() - 1800)
| filter event_type = ENUM.FILE and event_sub_type = ENUM.FILE_CREATE_NEW
| filter action_file_path contains "/.vscode/extensions/cortexsim-canary.prettier-pro-canary"
| filter causality_actor_process_image_name in ("Electron", "Code Helper (Plugin)", "Code Helper", "code") or actor_process_image_name in ("Electron", "Code Helper (Plugin)", "Code Helper", "code")
| fields _time, agent_hostname, causality_id, actor_process_image_name, action_file_path

## VALIDATION — KOI-009 Staging Directory Created Under IDE Lineage
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter _time > to_timestamp(current_time() - 1800)
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_CREATE_NEW, ENUM.FILE_WRITE)
| filter causality_actor_process_image_name in ("Electron", "Code Helper (Plugin)", "Code Helper", "code")
| filter action_file_path contains_any ("/CORTEXSIM-KOI009-DECOY/staging/", "/ijewf/")
| fields _time, agent_hostname, causality_id, causality_actor_process_instance_id, action_file_path

## VALIDATION — KOI-009 Archive Sent From IDE Lineage To Non Marketplace Host
# purpose: hunt
# dataset: xdr_data

dataset = xdr_data
| filter _time > to_timestamp(current_time() - 1800)
| filter event_type = ENUM.NETWORK
| filter causality_actor_process_image_name in ("Electron", "Code Helper (Plugin)", "Code Helper", "code")
| filter dst_action_external_hostname = "cortexsim-canary.invalid" or action_external_hostname = "cortexsim-canary.invalid"
| filter action_total_upload > 0
| fields _time, agent_hostname, causality_id, causality_actor_process_instance_id, dst_action_external_hostname, action_remote_ip, action_external_port, action_total_upload

## VALIDATION — KOI-009 NGFW Session From IDE Host To Non Marketplace Destination
# purpose: hunt
# dataset: panw_ngfw_traffic_raw

dataset = panw_ngfw_traffic_raw
| filter _time > to_timestamp(current_time() - 1800)
| filter action = "allow"
| filter dst_host = "cortexsim-canary.invalid"
| filter action_total_upload > 0
| comp sum(action_total_upload) as bytes_out, count() as sessions by src_ip, dst_ip, dst_host
| fields src_ip, dst_ip, dst_host, sessions, bytes_out

