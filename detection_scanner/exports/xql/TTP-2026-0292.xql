# TTP-2026-0292 — LOLBAS executable injects into another process
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — LOLBAS Process Injection
# severity: high
# Detection of suspicious process injection via legitimate Windows binaries

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'rundll32.exe' or actor_process_image_name = 'wmic.exe' or actor_process_image_name = 'regsvr32.exe'
| filter action_process_image_name = 'inject.exe'

## ABIOC — Process Injection via LOLBAS (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name
# Behavioral deviation detected when a legitimate Windows binary injects into another process

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'rundll32.exe' or actor_process_image_name = 'wmic.exe' or actor_process_image_name = 'regsvr32.exe'
| filter action_process_image_name = 'inject.exe'
| filter causality_actor_process_image_name != 'inject.exe'

## VALIDATION — LOLBAS Process Injection Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'rundll32.exe' or actor_process_image_name = 'wmic.exe' or actor_process_image_name = 'regsvr32.exe'
| filter action_process_image_name = 'inject.exe'
| comp count() by actor_process_image_name, action_process_image_name

