# TTP-2026-0265 — Execution of Uncommon Process with User SID at Early Startup
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Process with Local/User SID at Startup
# severity: high
# Detection of an uncommon process being executed with a local or domain user SID during early startup stages

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'cmd.exe'
| filter action_process_image_name in ('powershell.exe', 'reg.exe', 'net.exe')
| filter causality_actor_process_image_name = 'services.exe' or causality_actor_process_image_name = 'svchost.exe'
| filter not action_file_path contains 'system32' or action_file_path contains 'Temp'

## ABIOC — Early Startup Execution with User Context (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: services.exe
# Behavioral deviation indicating execution of uncommon process with user SID at early startup stage

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'cmd.exe'
| filter action_process_image_name in ('powershell.exe', 'reg.exe', 'net.exe')
| filter causality_actor_process_image_name = 'services.exe' or causality_actor_process_image_name = 'svchost.exe'
| filter not action_file_path contains 'system32' or action_file_path contains 'Temp'
| filter action_process_image_name != 'explorer.exe'

## VALIDATION — Hunt for Early Startup Processes with User Context
