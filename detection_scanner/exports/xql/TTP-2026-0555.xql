# TTP-2026-0555 — sshpass Credential-Stuffing Burst Against an Unreachable Host
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## ABIOC — Suspicious sshpass command execution (behavioral-ML, causality-anchored)
# severity: low
# causality_anchor: Not published. In the lab the chain is the CortexSim beacon, the root operator shell, sshpass, then the OpenSSH client that sshpass starts.
# PANW built-in XDR Analytics BIOC. The name is the built-in alert name verbatim so the matcher keys on it. From its reference page (https://cortex-docs.paloaltonetworks.com/analytics-alerts/alerts-by-name/suspicious-sshpass-command-execution, fetched 2026-11-13): activation period 14 Days, training period 30 Days, test period N/A (single event), deduplication period 1 Day, required data XDR Agent, severity Low, ATT&CK Credential Access (TA0006) and Brute Force: Credential Stuffing (T1110.004). The page's description, verbatim: 'The sshpass command was executed, This could be an attempt to check for credential stuffing.' The page publishes no trigger predicate, threshold or field name. SIM-EDR-029 declares it on step-02 on that basis: a single-event detector whose described trigger the step performs for real, six times. It has not been observed in a lab run. Low issues never create or join a case. suppression_window_seconds carries the page's one-day deduplication period; the page does not say what the deduplication is keyed on. The logic below approximates the trigger for hunting; it is not the built-in's code.

dataset = xdr_data
| filter agent_os_type = ENUM.AGENT_OS_LINUX
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = "sshpass"

## VALIDATION — EDR-029 Candidate Pair List Written In The Sandbox
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 3600
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_CREATE_NEW, ENUM.FILE_WRITE)
| filter action_file_path = "/var/tmp/.cortexsim-sshpass/candidates.txt"
| fields _time, agent_hostname, actor_causality_id, actor_process_image_name, event_sub_type, action_file_path

## VALIDATION — EDR-029 Sshpass Starts Naming The Canary
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 3600
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = "sshpass" and action_process_image_command_line contains "cortexsim-canary.invalid"
| fields _time, agent_hostname, actor_causality_id, actor_process_image_name, action_process_image_command_line

## VALIDATION — EDR-029 OpenSSH Client Started By Sshpass
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 3600
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = "ssh" and actor_process_image_name = "sshpass"
| filter action_process_image_command_line contains "cortexsim-canary.invalid"
| fields _time, agent_hostname, actor_causality_id, actor_process_image_name, action_process_image_name, action_process_image_command_line

## VALIDATION — EDR-029 Candidate List And Password Files Removed
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 3600
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = "rm" and action_process_image_command_line contains "/var/tmp/.cortexsim-sshpass/candidates.txt"
| fields _time, agent_hostname, actor_causality_id, action_process_image_command_line

## VALIDATION — EDR-029 Read-Back — Sshpass Starts Per Password Form (one full run is three inline and three from a file)
# purpose: investigation
# dataset: xdr_data

dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 3600
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = "sshpass" and action_process_image_command_line contains "cortexsim-canary.invalid"
| alter password_form = if(action_process_image_command_line ~= "sshpass +-f ", "file", "inline")
| comp count() as starts, min(_time) as first_seen, max(_time) as last_seen by agent_hostname, agent_id, password_form

## VALIDATION — EDR-029 Hunt — Sshpass With The Password On The Command Line, Per Endpoint And Parent (7 days)
# purpose: hunt
# dataset: xdr_data

dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 604800
| filter agent_os_type = ENUM.AGENT_OS_LINUX
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = "sshpass" and action_process_image_command_line ~= "sshpass +-p"
| comp count() as starts, count_distinct(action_process_image_command_line) as distinct_lines, min(_time) as first_seen, max(_time) as last_seen by agent_hostname, agent_id, actor_process_image_name
| sort desc distinct_lines

## VALIDATION — EDR-029 Hunt — Remote-Access Clients Started By Sshpass Across The Fleet (7 days)
# purpose: hunt
# dataset: xdr_data

dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 604800
| filter agent_os_type = ENUM.AGENT_OS_LINUX
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = "sshpass" and action_process_image_name in ("ssh", "scp", "sftp", "rsync")
| comp count() as starts, count_distinct(action_process_image_command_line) as distinct_lines, min(_time) as first_seen, max(_time) as last_seen by agent_hostname, agent_id, action_process_image_name
| sort desc distinct_lines

