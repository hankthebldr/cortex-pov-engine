# TTP-2026-0516 — Container Breakout Enumeration via Staged DEEPCE
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Payload-Shelf Tool deepce.sh Executed From a Writable Path by a Service Account
# severity: high
# A non-root service account executes deepce.sh from /tmp/deepce.sh — a privilege-escalation/container-breakout tool staged into a writable path, distinct from normal admin tooling.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_path contains "/tmp/deepce.sh" or action_process_image_path contains "/tmp/deepce.sh"
| filter actor_effective_username != "root"
| comp count() as execs by agent_hostname, actor_effective_username, actor_process_image_path
| filter execs >= 1

## ABIOC — First-Seen Execution of a Privesc/Escape Tool From /tmp on This Host (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: payload-shelf file-write of /tmp/deepce.sh -> chmod +x -> first execution of deepce.sh by a service-account shell
# A host that has never run deepce.sh suddenly executes it from a writable path moments after the file is staged — the stage→chmod→exec chain of a deployed offensive tool.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name in ("sh","bash") and action_process_image_path contains "deepce.sh"
| comp count() as first_runs by agent_hostname, action_process_image_path

## VALIDATION — Staged deepce.sh Execution on the Endpoint Feed
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_path contains "deepce.sh"
| fields agent_hostname, actor_effective_username, action_process_image_path, action_process_command_line

