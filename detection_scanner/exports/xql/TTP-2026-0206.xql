# TTP-2026-0206 — 64-bit PowerShell spawning 32-bit PowerShell for evasion
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — PowerShell Process Spawning from SysWOW64
# severity: high
# Detection of 64-bit PowerShell spawning 32-bit PowerShell from SysWOW64 directory

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe' and action_process_image_name = 'powershell.exe' and action_file_path contains 'SysWOW64'
| filter causality_actor_process_image_name != 'powershell.exe'

