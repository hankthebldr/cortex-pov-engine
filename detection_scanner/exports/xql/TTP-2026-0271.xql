# TTP-2026-0271 — Fodhelper.exe UAC Bypass via Registry Modification
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Fodhelper UAC Bypass Registry Modification
# severity: high
# Detection of registry modifications targeting CLSID keys used by fodhelper.exe for UAC bypass

dataset = xdr_data
| filter event_type = ENUM.REGISTRY
| filter action_file_path contains 'HKCU\Software\Classes\CLSID'
| filter action_file_path contains 'InprocServer32'
| filter actor_process_image_name = 'reg.exe'
| filter action_process_image_name = 'reg.exe'

## ABIOC — Fodhelper.exe Unusual Execution with Registry Modification (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: registry modification followed by fodhelper.exe execution
# Behavioral deviation detecting fodhelper.exe execution following suspicious registry modification

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'fodhelper.exe'
| filter causality_actor_process_image_name = 'reg.exe'
| filter action_file_path contains 'HKCU\Software\Classes\CLSID'

## VALIDATION — Fodhelper UAC Bypass Registry Access
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.REGISTRY
| filter action_file_path contains 'HKCU\Software\Classes\CLSID'
| filter action_file_path contains 'InprocServer32'
| filter actor_process_image_name = 'reg.exe'
| filter action_process_image_name = 'reg.exe'
| comp count() by actor_process_image_name, action_file_path

