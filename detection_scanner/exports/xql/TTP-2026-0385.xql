# TTP-2026-0385 — Suspicious DNS Query for C2 Communication
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious DNS Query
# severity: high
# Detects DNS queries to IP addresses in the TEST-NET-1 range

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip in ('192.0.2.1')
| filter dst_port = 53
| filter action_process_image_name = 'nslookup.exe'

## ABIOC — Suspicious DNS Query Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name = 'nslookup.exe'
# Detects unusual DNS query patterns from process execution

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip in ('192.0.2.1')
| filter dst_port = 53
| filter action_process_image_name = 'nslookup.exe'

