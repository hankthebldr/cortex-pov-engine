# TTP-2026-0428 — DLL Sideloading from ISO via PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon DLL Sideloading from ISO
# severity: high
# Detects when a process loads a DLL from a logical CD-ROM or ISO device not typically used for such operations

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name contains '\malicious.exe'
| filter action_file_path contains 'malicious.dll'
| filter action_remote_ip in [192.0.2.0/24]
| filter actor_process_image_name contains 'powershell.exe'

## ABIOC — Suspicious DLL Load from Mounted ISO (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: powershell.exe loading DLL from mounted ISO
# Behavioral deviation where a process loads a DLL from a mounted ISO drive, which is not typical for legitimate software

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name contains '\malicious.exe'
| filter action_file_path contains 'malicious.dll'
| filter action_remote_ip in [192.0.2.0/24]
| filter actor_process_image_name contains 'powershell.exe'

## VALIDATION — Hunt for DLL Sideloading from ISO
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name contains '\malicious.exe'
| filter action_file_path contains 'malicious.dll'
| filter action_remote_ip in [192.0.2.0/24]
| filter actor_process_image_name contains 'powershell.exe'
| comp count() by actor_process_image_name, action_file_path

