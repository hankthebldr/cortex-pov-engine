# TTP-2026-0185 — Squidoor Backdoor DNS and ICMP Tunneling via LOLBAS
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Squidoor DNS TXT Beacon
# severity: high
# Detection of nslookup process making TXT record queries to C2 IP

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'nslookup'
| filter action_file_path contains 'TXT'
| filter action_remote_ip = '192.0.2.10'

## BIOC — Squidoor ICMP Tunneling
# severity: high
# Detection of ping command with custom payload to C2 IP

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'ping'
| filter action_file_path contains '-p 41424344'
| filter action_remote_ip = '192.0.2.10'

## BIOC — LOLBAS Execution
# severity: high
# Detection of LOLBAS binaries used for execution

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ('nslookup', 'ping')
| filter action_remote_ip = '192.0.2.10'

## VALIDATION — DNS TXT Beacon Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter dst_ip = '192.0.2.10'
| filter dst_port = 53
| filter action_file_path contains 'TXT'
| filter actor_process_image_name = 'nslookup'

## VALIDATION — ICMP Tunneling Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.10'
| filter action_file_path contains '-p 41424344'
| filter actor_process_image_name = 'ping'

