# TTP-2026-0185 — CL-STA-1020 HazyBeacon — mscorsvw.exe DLL Side-Load, AWS Lambda-URL C2 and Cloud-Storage Exfil (T1574.002 / T1102 / T1567.002)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — MP-026 mscorsvc.dll Written Beside a Relocated mscorsvw.exe
# severity: high
# A signed mscorsvw.exe is written outside %WINDIR%\Microsoft.NET and a DLL named mscorsvc.dll is written into the same directory by the same causality — the HazyBeacon side-load staging pair.

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_CREATE_NEW, ENUM.FILE_WRITE, ENUM.FILE_RENAME)
| filter lowercase(action_file_name) in ("mscorsvw.exe", "mscorsvc.dll", "libmscorsvc.so", "mscorsvw")
| filter lowercase(action_file_path) not contains "\\microsoft.net\\framework"
| alter dir = arrayindex(regextract(lowercase(action_file_path), "^(.*)[\\\\/][^\\\\/]+$"), 0)
| comp count_distinct(action_file_name) as pair, values(action_file_path) as paths by agent_hostname, causality_actor_process_instance_id, dir
| filter pair >= 2

## BIOC — MP-026 Service msdnetsvc Created for a Relocated mscorsvw.exe
# severity: high
# A service named msdnetsvc (or any service whose image is an mscorsvw.exe outside the .NET Framework directory) is created; on Linux the equivalent is a write of /etc/systemd/system/msdnetsvc.service — the report's persistence for the side-loaded DLL.

dataset = xdr_data
| filter (event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START and lowercase(action_process_image_name) = "sc.exe" and lowercase(action_process_image_command_line) contains " create " and (lowercase(action_process_image_command_line) contains "msdnetsvc" or (lowercase(action_process_image_command_line) contains "mscorsvw.exe" and lowercase(action_process_image_command_line) not contains "\\microsoft.net\\framework"))) or (event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_CREATE_NEW, ENUM.FILE_WRITE) and action_file_path = "/etc/systemd/system/msdnetsvc.service")
| fields _time, agent_hostname, actor_effective_username, actor_process_image_name, action_process_image_command_line, action_file_path, causality_actor_process_instance_id

## BIOC — MP-026 HazyBeacon Collector and Uploader Set Written Under ProgramData
# severity: high
# One causality writes three or more of igfx.exe, GoogleGet.exe, google.exe, GoogleDrive.exe, GoogleDriveUpload.exe and Dropbox.exe under C:\ProgramData — the report's collector and cloud-storage uploader set.

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_CREATE_NEW, ENUM.FILE_WRITE)
| filter lowercase(action_file_path) contains "programdata" or action_file_path contains "cortexsim-mp026"
| filter lowercase(action_file_name) in ("igfx.exe", "googleget.exe", "google.exe", "googledrive.exe", "googledriveupload.exe", "dropbox.exe", "igfx", "googleget", "google", "googledrive", "googledriveupload", "dropbox")
| comp count_distinct(action_file_name) as tools by agent_hostname, causality_actor_process_instance_id
| filter tools >= 3

## BIOC — MP-026 Host-Named Archive of Keyword-Matched Documents Split into Volumes
# severity: medium
# A causality creates an archive named after the host and then writes numbered volume files (.001/.002 or 7z -v) of it in the same directory — the igfx.exe + 7z.exe collection pattern.

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_CREATE_NEW, ENUM.FILE_WRITE)
| filter lowercase(action_file_name) ~= "\.(zip|tgz|7z)(\.[0-9]{3})?$"
| alter short_host = lowercase(arrayindex(split(agent_hostname, "."), 0))
| filter lowercase(action_file_name) contains short_host
| alter is_volume = if(action_file_name ~= "\.[0-9]{3}$", 1, 0)
| comp sum(is_volume) as volumes, count() as writes by agent_hostname, causality_actor_process_instance_id
| filter volumes >= 2

## BIOC — MP-026 Side-Load Causality Deletes Its Own Archives and Payloads
# severity: medium
# The causality that wrote the archive volumes and the collector/uploader executables deletes them — the report's post-exfil clean-up.

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type = ENUM.FILE_REMOVE
| filter lowercase(action_file_name) ~= "\.(zip|tgz|7z)\.[0-9]{3}$" or lowercase(action_file_name) in ("igfx.exe", "googleget.exe", "google.exe", "googledrive.exe", "googledriveupload.exe", "dropbox.exe", "igfx", "googleget", "google", "googledrive", "googledriveupload", "dropbox")
| comp count() as deletions, count_distinct(action_file_name) as distinct_files by agent_hostname, causality_actor_process_instance_id
| filter distinct_files >= 3

## ABIOC — MP-026 Recurring Web Egress from the mscorsvw.exe Side-Load Causality (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Learned mscorsvw.exe service-process baseline (no outbound HTTP) -> recurring single-destination web egress from the side-load causality, anchored on causality_actor_process_instance_id.
# A process whose causality chain is rooted in mscorsvw.exe (never an HTTP client in its learned baseline) opens a tight recurring series of outbound web sessions to one destination. Keys on behaviour, not the redacted Lambda URL.

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_STREAM_CONNECT
| filter lowercase(causality_actor_process_image_name) in ("mscorsvw.exe", "mscorsvw") or causality_actor_process_image_path contains "cortexsim-mp026" or lowercase(actor_process_image_name) in ("powershell.exe", "pwsh.exe", "curl", "curl.exe")
| filter action_remote_port in (80, 443, 8080)
| comp count() as sessions, count_distinct(action_remote_ip) as dests, values(actor_process_image_name) as egress_procs by agent_hostname, causality_actor_process_instance_id
| filter sessions >= 3 and dests = 1

## ABIOC — MP-026 NGFW Recurring HTTPS Beacon from the Side-Load Host (behavioral-ML, causality-anchored)
# severity: medium
# behavioral_profile: statistical
# causality_anchor: Learned per-source-host egress baseline -> recurring rare-destination HTTPS cadence on the same src_host as the endpoint side-load chain.
# NGFW EAL behavioural alert: the side-load host (src_host) makes a tight recurring burst of small HTTPS sessions to one fleet-rare destination. The destination is a preset because the report redacts the Lambda URL; the record stitches on src_host.

dataset = panw_ngfw_traffic_raw
| filter app in ("ssl", "web-browsing") and dst_port = 443
| comp count() as sessions, avg(bytes_sent) as avg_bytes, count_distinct(dst) as dests by src, endpoint_device_name, url_domain
| filter sessions >= 6 and dests = 1 and avg_bytes < 4096

## ABIOC — MP-026 Staged Archive Volumes Uploaded to Cloud-Storage API Paths (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Read of host-named archive volumes followed by outbound upload sessions inside one side-load causality_actor_process_instance_id.
# A process descended from the side-load causality reads split archive volumes and POSTs them to Google Drive / Dropbox upload API paths.

dataset = xdr_data
| filter causality_actor_process_image_path contains "cortexsim-mp026" or lowercase(causality_actor_process_image_name) in ("mscorsvw.exe", "mscorsvw") or lowercase(actor_process_image_name) in ("powershell.exe", "pwsh.exe", "curl", "curl.exe")
| filter (event_type = ENUM.FILE and lowercase(action_file_name) ~= "\.(zip|tgz|7z)\.[0-9]{3}$") or (event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_STREAM_CONNECT)
| alter is_read = if(event_type = ENUM.FILE, 1, 0), is_conn = if(event_type = ENUM.NETWORK, 1, 0)
| comp sum(is_read) as volume_reads, sum(is_conn) as uploads by agent_hostname, causality_actor_process_instance_id
| filter volume_reads >= 1 and uploads >= 2

## VALIDATION — MP-026 HazyBeacon Toolkit sha256s Landed in panw_ngfw_threat_raw
# purpose: validation
# dataset: panw_ngfw_threat_raw

dataset = panw_ngfw_threat_raw
| filter _time > to_timestamp(current_time() - 3600)
| filter lowercase(filedigest) in ("279e60e77207444c7ec7421e811048267971b0db42f4b4d3e975c7d0af7f511e", "d961aca6c2899cc1495c0e64a29b85aa226f40cf9d42dadc291c4f601d6e27c3", "d20b536c88ecd326f79d7a9180f41a2e47a40fcf2cc6a2b02d68a081c89eaeaa", "304c615f4a8c2c2b36478b693db767d41be998032252c8159cc22c18a65ab498", "f0c9481513156b0cdd216d6dfb53772839438a2215d9c5b895445f418b64b886", "3255798db8936b5b3ae9fed6292413ce20da48131b27394c844ecec186a1e92f")
| filter action in ("alert", "allow")
| comp count_distinct(filedigest) as hashes by endpoint_device_name, src
| filter hashes >= 6

