# TTP-2026-0381 — Suspicious Certutil AD CS Contact
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious Certutil AD CS Contact
# severity: high
# Detection of certutil downloading a file from an AD CS server

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'certutil.exe'
| filter action_file_path contains 'payload.bin'
| filter action_remote_ip = '192.0.2.100'

## ABIOC — Certutil AD CS Download Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: certutil.exe process start with AD CS IP
# Behavioral deviation indicating certutil downloading from AD CS server

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'certutil.exe'
| filter action_remote_ip = '192.0.2.100'

## VALIDATION — Certutil AD CS Network Contact
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.100'
| filter action_process_image_name = 'certutil.exe'

