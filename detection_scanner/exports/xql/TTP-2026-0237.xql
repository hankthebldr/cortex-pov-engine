# TTP-2026-0237 — Windows PowerShell with Rare TLS/HTTP User Agent Combination
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — PowerShell Process with Custom User-Agent
# severity: high
# Detection of PowerShell process starting with a rare combination of TLS and HTTP User-Agent headers

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_image_name = 'powershell.exe'
| filter action_remote_ip = '192.0.2.10'
| filter dst_port = 80

## ABIOC — Abnormal TLS/HTTP User-Agent Communication (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: powershell.exe process start with custom HTTP headers
# Detects a rare combination of TLS and HTTP User-Agent headers used in communication

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.10'
| filter dst_port = 80
| filter action_process_image_name = 'powershell.exe'
| comp count() as events by action_remote_ip, agent_hostname
| sort desc events

## VALIDATION — PowerShell with Custom User-Agent
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_remote_ip = '192.0.2.10'
| filter dst_port = 80

