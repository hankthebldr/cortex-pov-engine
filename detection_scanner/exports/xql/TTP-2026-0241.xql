# TTP-2026-0241 — Meterpreter Reverse Shell via PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Abnormal Process Connection to Meterpreter Port
# severity: high
# A process makes an outbound connection to port 4444, which is the default Meterpreter C2 port

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_CONNECTION
| filter dst_port = 4444
| filter action_remote_ip = '192.0.2.50'
| filter causality_actor_process_image_name != 'svchost.exe'
| filter causality_actor_process_image_name != 'explorer.exe'

## ABIOC — Unusual Process Connection to Default Meterpreter Port (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: causality_actor_process_image_name
# Behavioral deviation where a non-system process connects to the default Meterpreter C2 port

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_CONNECTION
| filter dst_port = 4444
| filter causality_actor_process_image_name not in ('svchost.exe', 'explorer.exe', 'wsmprovhost.exe')

## VALIDATION — Detect Outbound Connection to Meterpreter Port
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_CONNECTION
| filter dst_port = 4444
| filter action_remote_ip = '192.0.2.50'
| filter causality_actor_process_image_name != 'svchost.exe'
| filter causality_actor_process_image_name != 'explorer.exe'
| fields agent_hostname, causality_actor_process_image_name, dst_ip, dst_port

