# TTP-2026-0289 — Kerberos User Enumeration via AS-REQ Requests
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Kerberos AS-REQ Enumeration
# severity: high
# Detection of repeated AS-REQ requests to domain controller with user enumeration

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_CONNECTION
| filter dst_port = 88 and dst_ip = '192.0.2.10'
| filter action_remote_ip != null
| filter action_process_image_name contains 'krb5_user_enum'

## ABIOC — Kerberos AS-REQ User Enumeration Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name
# Machine learning model detecting anomalous Kerberos AS-REQ patterns from unknown processes

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name contains 'krb5_user_enum'
| filter causality_actor_process_image_name != null
| filter action_remote_ip = '192.0.2.10'
| filter dst_port = 88

## VALIDATION — Kerberos Enum Network Traffic
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_CONNECTION
| filter dst_port = 88 and dst_ip = '192.0.2.10'
| filter action_remote_ip != null
| filter action_process_image_name contains 'krb5_user_enum'
| comp count() by action_process_image_name, dst_ip, dst_port

