# TTP-2026-0186 — Slow Pisces Coding-Challenge Lure to RN Loader / RN Stealer — Developer Workstation EDR + NGFW Stitch (T1204.002 / T1555.001)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — MP-027 Python Writes init py Into the Home Public Folder
# severity: high
# A Python interpreter creates __init__.py inside the user's home Public folder: the drop path of the Slow Pisces YAML deserialisation payload that stages RN Loader.

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_CREATE_NEW, ENUM.FILE_WRITE)
| filter actor_process_image_name contains "python"
| filter action_file_path ~= "/(home|Users)/[^/]+/Public/__init__\.py$"
| fields _time, agent_hostname, actor_effective_username, actor_process_image_name, actor_process_command_line, action_file_path, causality_actor_process_image_name

## BIOC — MP-027 dockerd Launched From a Temp Path by a Python Interpreter
# severity: high
# A process image named dockerd starts outside its install path with a Python interpreter as its parent and docker-init as its argument: RN Loader command 3 masquerading as the Docker daemon.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = "dockerd"
| filter actor_process_image_name contains "python"
| filter action_process_image_path not in ("/usr/bin/dockerd", "/usr/local/bin/dockerd", "/Applications/Docker.app/Contents/Resources/bin/dockerd")
| filter action_process_image_command_line contains "docker-init"
| fields _time, agent_hostname, actor_process_image_name, action_process_image_path, action_process_image_command_line, causality_actor_process_image_name

## BIOC — MP-027 Python Opens Keychain SSH Key and Cloud CLI Credential Files
# severity: high
# One Python process opens the login keychain, SSH private keys and AWS, Kubernetes or gcloud credential files within a short window: the RN Stealer collection set.

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type = ENUM.FILE_OPEN
| filter actor_process_image_name contains "python"
| filter action_file_path contains "login.keychain-db" or action_file_path contains "login.keyring" or action_file_path contains "/.ssh/id_" or action_file_path contains "/.aws/credentials" or action_file_path contains "/.kube/config" or action_file_path contains "/gcloud/"
| comp count_distinct(action_file_path) as cred_paths by agent_hostname, actor_process_instance_id, causality_actor_process_image_name
| filter cred_paths >= 3

## ABIOC — MP-027 Self-Deleting Python Script Executed From the Home Public Folder (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: statistical
# causality_anchor: Learned developer workstation baseline -> python3 descendant of a cloned project executes then deletes a script in ~/Public, anchored to causality_actor_process_instance_id.
# A Python child process runs ~/Public/__init__.py and deletes that file seconds after starting: RN Loader moving to memory. Anchored on the coding-challenge python3 causality chain.

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type = ENUM.FILE_REMOVE
| filter actor_process_image_name contains "python"
| filter action_file_path ~= "/Public/__init__\.py$"
| filter actor_process_command_line contains "/Public/__init__.py"
| fields _time, agent_hostname, actor_process_instance_id, causality_actor_process_image_name, causality_actor_process_command_line, action_file_path

## ABIOC — MP-027 Developer Project Python Polls One External Host at a Fixed Interval (behavioral-ML, causality-anchored)
# severity: medium
# behavioral_profile: statistical
# causality_anchor: Per-host interpreter egress baseline -> first-seen fixed-interval polling from the coding-challenge python3 lineage, anchored to actor_process_instance_id.
# A Python process descended from a cloned project posts to the same external host at a fixed interval, a destination that interpreter has never contacted before: RN Loader polling for commands.

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_STREAM_CONNECT
| filter actor_process_image_name contains "python"
| comp count() as connects, min(_time) as first_seen, max(_time) as last_seen by agent_hostname, actor_process_instance_id, action_remote_ip, action_remote_port
| filter connects >= 3

## ABIOC — MP-027 NGFW Recurring Rare-Domain Communications From a Developer Workstation (behavioral-ML, causality-anchored)
# severity: medium
# behavioral_profile: machine-learning
# causality_anchor: Learned NGFW EAL egress baseline per source host -> recurring cadence to a fleet-rare destination, anchored to endpoint_device_name (src_host).
# NGFW EAL shows recurring small HTTPS sessions from one workstation to a domain rare across the fleet: the RN Loader command channel seen from the network.

dataset = panw_ngfw_traffic_raw
| filter app = "ssl" and dst_port = 443
| comp count() as sessions, avg(bytes_sent) as avg_sent, count_distinct(src) as hosts by endpoint_device_name, dst_hostname, dst
| filter sessions >= 5 and avg_sent < 8192
| fields endpoint_device_name, dst_hostname, dst, sessions, avg_sent

## VALIDATION — MP-027 Lure Project Python Fetches symbols sp500 and Caches the Reply
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter _time > to_timestamp(current_time() - 3600)
| filter actor_process_image_name contains "python"
| filter (event_type = ENUM.FILE and action_file_path contains "stocks-pattern-analyzer/.cache/sp500.yaml") or event_type = ENUM.NETWORK
| comp count() as events by agent_hostname, actor_process_instance_id, event_type
| filter events >= 1

## VALIDATION — MP-027 Slow Pisces Lure Domain DNS Lookups From the Workstation
# purpose: hunt
# dataset: xdr_data

dataset = xdr_data
| filter _time > to_timestamp(current_time() - 3600)
| filter dns_query_name in ("en.stockslab.org", "getstockprice.com", "cdn.clubinfo.io")
| comp count() as lookups by agent_hostname, dns_query_name
| filter lookups >= 1

## VALIDATION — MP-027 RN Stealer Credential File Access on the Run Host
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter _time > to_timestamp(current_time() - 3600)
| filter event_type = ENUM.FILE and actor_process_image_name contains "python"
| filter action_file_path contains "login.keychain-db" or action_file_path contains "login.keyring" or action_file_path contains "/.ssh/id_" or action_file_path contains "/.aws/" or action_file_path contains "/.kube/config" or action_file_path contains "/gcloud/" or action_file_path contains "rn-stealer-manifest.xor"
| comp count_distinct(action_file_path) as paths by agent_hostname, causality_actor_process_image_name
| filter paths >= 3

## VALIDATION — MP-027 NGFW Traffic to Published Slow Pisces Infrastructure From the Run Host
# purpose: validation
# dataset: panw_ngfw_traffic_raw

dataset = panw_ngfw_traffic_raw
| filter _time > to_timestamp(current_time() - 3600)
| filter dst in ("91.103.140.191", "70.34.245.118") or dst_hostname in ("en.stockslab.org", "getstockprice.com")
| comp count() as sessions by endpoint_device_name, src, user, dst_hostname, dst
| filter sessions >= 1

