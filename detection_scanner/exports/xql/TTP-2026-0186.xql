# TTP-2026-0186 — TinyRCT Backdoor Establishes VPN Tunnel and Dumps Credentials
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — VPN Tunnel Process Creation
# severity: high
# Detection of SoftEther process start for VPN tunneling

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/tmp/softether'

## BIOC — C2 Network Connection
# severity: high
# Detection of outbound connection to C2 IP

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_CONNECT
| filter action_remote_ip = '192.0.2.100'

## VALIDATION — VPN Process Start Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/tmp/softether'
| fields actor_process_image_name, action_process_image_name, causality_actor_process_image_name

## VALIDATION — C2 Connection Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_CONNECT
| filter action_remote_ip = '192.0.2.100'
| fields dst_ip, dst_port, action_remote_ip

