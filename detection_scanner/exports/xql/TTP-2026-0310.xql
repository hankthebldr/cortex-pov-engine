# TTP-2026-0310 — Kerberoasting with Rubeus to Request Weakly-Encrypted Tickets
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rubeus Kerberoast Execution
# severity: high
# Detection of Rubeus.exe being executed with kerberoast command

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'rubeus.exe'
| filter action_process_command_line contains 'kerberoast'

## ABIOC — Multiple Weakly-Encrypted Tickets Requested (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Rubeus kerberoast command execution
# Detection of multiple weakly-encrypted Kerberos tickets requested in short time window

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.1'
| filter dst_port = 88
| filter action_protocol = 'kerberos'
| comp count() by actor_process_image_name
| filter count() > 1

## VALIDATION — Detect Weakly Encrypted Tickets
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.1'
| filter dst_port = 88
| filter action_protocol = 'kerberos'
| comp count() by actor_process_image_name
| filter count() > 1

