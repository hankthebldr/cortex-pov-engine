# TTP-2026-0291 — Windows Endpoint Mimicking Linux GitHub URL Execution
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — PowerShell with Rare GitHub URL
# severity: high
# PowerShell process executing command that downloads from a rare GitHub URL

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_command_line contains 'raw.githubusercontent.com'

## ABIOC — Rare GitHub URL Execution (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_command_line
# Execution of a process downloading from a rare GitHub URL

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_command_line contains 'raw.githubusercontent.com'
| filter action_remote_ip = '192.0.2.1'

## VALIDATION — Detect Rare GitHub URL Usage
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_command_line contains 'raw.githubusercontent.com'
| filter action_remote_ip = '192.0.2.1'

