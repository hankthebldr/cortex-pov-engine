# TTP-2026-0479 — Unusual DB Process Spawning a Shell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unusual DB process spawning a shell
# severity: high
# Detects when a database process such as mysqld spawns a shell process

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'mysqld' and action_process_image_name = '/tmp/scratch/db_shell'
| filter causality_actor_process_image_name = 'mysqld'

## ABIOC — Unusual DB process spawning a shell (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: mysqld spawning shell
# Machine learning model detecting abnormal behavior of database processes spawning shells

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'mysqld' and action_process_image_name = '/tmp/scratch/db_shell'
| filter causality_actor_process_image_name = 'mysqld'

