# TTP-2026-0257 — Masquerading as Common Software with Suspicious Process Creation
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Process Masquerading as Common Utility
# severity: high
# Detection of process creation where the executable name mimics a legitimate system utility like 'explorer.exe' but originates from an unusual path

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name contains 'explorer.exe'
| filter actor_process_image_name not contains 'Windows\System32\explorer.exe'
| filter actor_process_image_name not contains 'Program Files\Windows\explorer.exe'

## ABIOC — Suspicious Process Start from Temp Directory (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name
# Detection of process execution from a temporary directory with a name mimicking a legitimate system utility

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name contains '/tmp/'
| filter action_process_image_name contains 'explorer.exe'
| filter actor_process_image_name not contains 'Windows\System32'

## VALIDATION — Detect Masqueraded Explorer Process
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name contains 'explorer.exe'
| filter actor_process_image_name not contains 'Windows\System32\explorer.exe'
| filter actor_process_image_name not contains 'Program Files\Windows\explorer.exe'

