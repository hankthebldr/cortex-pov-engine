# TTP-2026-0276 — Suspicious Network Activity from Common Process Using Uncommon IP
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Globally Uncommon IP Address by Common Process
# severity: high
# Detection of a common Windows process (e.g., powershell.exe) connecting to a globally uncommon IP address.

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_process_image_name = 'powershell.exe'
| filter action_remote_ip in (select ip from uncommon_ips)
| filter not action_remote_ip in (select ip from known_good_ips)

## ABIOC — Unusual Network Behavior from Common Process (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name = 'powershell.exe'
# Behavioral deviation where a common Windows process initiates a connection to an IP address not previously seen in the environment.

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_process_image_name = 'powershell.exe'
| filter action_remote_ip not in (select distinct action_remote_ip from xdr_data where event_type = ENUM.NETWORK_CONNECTION and actor_process_image_name = 'powershell.exe' and timestamp > now() - 30d)
| filter action_remote_ip in (select ip from uncommon_ips)

## VALIDATION — Hunt for PowerShell connecting to uncommon IPs
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_process_image_name = 'powershell.exe'
| filter action_remote_ip in (select ip from uncommon_ips)
| filter not action_remote_ip in (select ip from known_good_ips)

