# TTP-2026-0312 — Office Process Spawning Suspicious Command-Line Arguments
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Office Process Spawned Suspicious CommandLine
# severity: high
# Detection of Office process (e.g., winword.exe) launching a process with suspicious command-line arguments such as encoded PowerShell commands

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'winword.exe'
| filter action_process_image_name = 'powershell.exe' and action_command_line contains '-e'

## ABIOC — Suspicious Office Process Command-Line Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'winword.exe'
# Detects a pattern where an Office application (e.g., Word) launches a process with encoded command-line arguments indicative of PowerShell execution

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'winword.exe'
| filter action_command_line contains '-e' and action_command_line contains 'powershell'

## VALIDATION — Office Process with Suspicious CommandLine Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'winword.exe'
| filter action_command_line contains '-e'

