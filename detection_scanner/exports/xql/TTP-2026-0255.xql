# TTP-2026-0255 — Cached Credentials Discovery via cmdkey
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Cached Credentials Discovery with cmdkey
# severity: high
# Detection of cmdkey.exe being executed with /list flag to enumerate cached credentials

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'cmdkey.exe'
| filter action_process_command_line contains '/list'

## ABIOC — Suspicious cmdkey usage for credential enumeration (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: cmdkey.exe process start with /list flag
# Behavioral deviation where cmdkey is used to list cached credentials without typical user context

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'cmdkey.exe'
| filter action_process_command_line contains '/list'
| filter actor_process_image_name != 'explorer.exe'
| filter actor_process_image_name != 'cmd.exe'

## VALIDATION — Hunt for cmdkey credential enumeration
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'cmdkey.exe'
| filter action_process_command_line contains '/list'
| fields agent_hostname, action_process_command_line, actor_process_image_name

