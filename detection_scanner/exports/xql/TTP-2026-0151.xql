# TTP-2026-0151 — Scattered Spider Pre-Attack OSINT + Help-Desk Profiling Stitched to External Footprint — Vishing-Precursor Recon Correlation
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Cortex ASM Discovery of Externally-Exposed Federated-Identity and App/CSP Surface
# severity: medium
# Cortex ASM/Xpanse product capability: discovery of the target org's OWN externally-exposed SaaS applications, cloud-service-provider tenants, and federated-identity login portal — the public attack surface that supplies a vishing operator the pretext material (which IdP, which help desk). This is a defensive exposure-management finding over the org's public footprint, NOT attacker-attributed enumeration: ASM independently surfaces what is externally reachable. An org exposing three or more distinct federated-identity/app services publicly is the exposure signal that feeds the identity-takeover pretext. Every discovered service is a legitimate public endpoint, so this is a behavioural/exposure BIOC, not an IOC match.

dataset = asm_findings
| filter finding_category in ("federated_idp_portal", "saas_app_discovery", "csp_tenant_discovery")
| filter exposure_state = "externally_exposed"
| comp count_distinct(discovered_service) as exposed_services by target_org
| filter exposed_services >= 3
| sort desc exposed_services
| fields target_org, exposed_services

## ABIOC — Anomalous Inbound Account-Recovery Cadence on Externally-Exposed Personnel (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Learned per-identity help-desk account-recovery baseline (rare, self-initiated) -> a burst of help-desk-mediated recovery events on identities ASM independently flagged as externally exposed, anchored to the exposure flag and the recovery cadence deviation.
# An auto-tuned behavioural deviation: help-desk-mediated account-recovery / MFA-reset events cluster against identities that Cortex ASM flagged as externally exposed, at a cadence that exceeds the learned per-identity help-desk-contact baseline. Muddled Libra makes repeated low-pressure calls, each time impersonating a locked-out employee, so the tell is a burst of recovery events on exposed privileged personnel — not any single reset, which is routine. The ABIOC anchors the deviation to the identity's learned recovery baseline plus the ASM exposure flag rather than to a known-bad value.

dataset = okta_sso
| filter eventtype in ("user.account.unlock", "user.mfa.factor.reset", "help_desk.account_recovery")
| filter target_user_exposure_flag = true
| comp count() as recovery_events by client_org, target_user, bin(_time, 30m)
| filter recovery_events >= 2
| sort desc recovery_events
| fields client_org, target_user, recovery_events

## VALIDATION — ASM Key-Personnel External Footprint Exposure
# purpose: hunt
# dataset: asm_findings

dataset = asm_findings
| filter finding_category in ("exposed_identity", "credential_exposure", "social_media_persona", "federated_idp_portal")
| filter asset_owner_privilege in ("privileged", "executive", "it_admin", "helpdesk")
| comp count() as exposed_findings by target_org, asset_owner_username, finding_category
| filter exposed_findings >= 1
| sort desc exposed_findings
| fields target_org, asset_owner_username, finding_category, exposed_findings

## VALIDATION — Help-Desk Account-Recovery Reconnaissance Burst
# purpose: hunt
# dataset: okta_sso

dataset = okta_sso
| filter eventtype in ("user.account.unlock", "user.mfa.factor.reset", "system.sms.send_factor_verify_message", "help_desk.account_recovery")
| filter actor_type = "help_desk_agent"
| comp count() as recovery_contacts by client_org, target_user, bin(_time, 1h)
| filter recovery_contacts >= 4
| sort desc recovery_contacts
| fields client_org, target_user, recovery_contacts

## VALIDATION — TIM Attribution — Muddled Libra Recon Tradecraft Match
# purpose: validation
# dataset: threat_intel

dataset = threat_intel
| filter indicator_type in ("actor_ttp", "campaign_pattern")
| filter threat_actor in ("Muddled Libra", "Scattered Spider", "UNC3944")
| filter ttp_fingerprint in ("linkedin_persona_verification_bypass", "repeated_helpdesk_profiling", "mfa_reset_takeover_precursor")
| comp count() as attribution_hits by target_org, threat_actor
| filter attribution_hits >= 1
| fields target_org, threat_actor, attribution_hits

