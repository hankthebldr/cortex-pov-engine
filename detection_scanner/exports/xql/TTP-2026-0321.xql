# TTP-2026-0321 — RDP Session Hijacking via tscon.exe
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious tscon.exe Usage
# severity: high
# Detection of tscon.exe being executed with parameters that redirect to console

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'tscon.exe'
| filter action_process_command_line contains '/dest:console'

## ABIOC — Unusual RDP Session Hijacking Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: explorer.exe initiating tscon.exe
# Detection of a process attempting to hijack an RDP session using tscon.exe

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'tscon.exe'
| filter action_process_command_line contains '/dest:console'
| filter causality_actor_process_image_name = 'explorer.exe'

## VALIDATION — Detect RDP Session Hijacking via tscon
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'tscon.exe'
| filter action_process_command_line contains '/dest:console'
| comp count() by agent_hostname, action_process_command_line

