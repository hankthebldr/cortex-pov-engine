# TTP-2026-0167 — NGFW EAL Rare-Domain Beacon then Large/Massive HTTPS Upload Exfil — Cortex Network Analytics / ABIOC (T1071.001 / T1048 / T1567)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## ABIOC — NGFW EAL — Abnormal Recurring Communications to a Rare Domain (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Learned host NGFW EAL egress baseline (few destinations, ordinary bursty web volume) -> a single domain that is rare across the fleet (low distinct-source prevalence) contacted at a recurring interval with small stable payloads, anchored to the source host (src) and that rare destination domain.
# A source host produces a tight, recurring burst of small HTTPS (ssl/443) sessions to a single domain that is rare across the fleet (few distinct sources ever contact it) — the rare-domain C2-beacon shape. Every destination is legitimate-looking and rotates, so no IOC matches; the ABIOC fires on the recurring-cadence-plus-destination-rarity deviation from the host's learned NGFW EAL egress baseline, anchored to the source host (src) and the rare destination domain rather than to a known-bad indicator.

dataset = panw_ngfw_traffic_raw
| filter log_source_type = "eal" and app = "ssl" and dst_port = 443
| filter action = "allow"
| comp count() as recurring_sessions, avg(bytes_sent) as avg_bytes by src, url_domain
| windowcomp count_distinct(src) as fleet_src_prevalence by url_domain
| filter recurring_sessions >= 6 and avg_bytes < 8192 and fleet_src_prevalence <= 2
| sort desc recurring_sessions
| fields src, url_domain, recurring_sessions, avg_bytes, fleet_src_prevalence

## ABIOC — NGFW EAL — Large Upload (HTTPS) to a Rare Domain (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: statistical
# causality_anchor: Learned host outbound-volume baseline over 443 -> a single session whose bytes_sent is a large positive deviation to a fleet-rare domain, anchored to the source host (src) and destination domain.
# A single HTTPS (ssl/443) session carries a bytes_sent volume that is anomalously large versus the host's learned outbound-volume baseline, to a domain that is rare across the fleet. The statistical ABIOC fires on the outbound-byte-volume deviation, the first stage of the exfiltration that follows the rare-domain beacon, anchored to the source host (src) and the rare destination domain.

dataset = panw_ngfw_traffic_raw
| filter log_source_type = "eal" and app = "ssl" and dst_port = 443 and action = "allow"
| filter bytes_sent > 1073741824
| comp sum(bytes_sent) as uploaded_bytes, count() as sessions by src, url_domain
| windowcomp count_distinct(src) as fleet_src_prevalence by url_domain
| filter uploaded_bytes > 1073741824 and fleet_src_prevalence <= 2
| sort desc uploaded_bytes
| fields src, url_domain, uploaded_bytes, sessions, fleet_src_prevalence

## ABIOC — NGFW EAL — Massive Upload to a Rare Storage or Mail Domain (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Recurring rare-domain beacon under the source host (src) -> a massive bytes_sent upload to a fleet-rare storage or mail domain from that same source host, anchored to the src egress chain that generated the beacon.
# The same source host uploads a massive bytes_sent volume to a storage / mail domain that is rare across the fleet over HTTPS — the exfiltration terminal of the beacon-then-exfil chain. The ABIOC fires on the massive-outbound-volume-to-a-rare-domain deviation from the learned baseline, anchored to the same source host (src) that carried the earlier recurring beacon.

dataset = panw_ngfw_traffic_raw
| filter log_source_type = "eal" and dst_port = 443 and action = "allow"
| filter bytes_sent > 10737418240
| comp sum(bytes_sent) as uploaded_bytes, count() as sessions by src, url_domain
| windowcomp count_distinct(src) as fleet_src_prevalence by url_domain
| filter uploaded_bytes > 10737418240 and fleet_src_prevalence <= 2
| sort desc uploaded_bytes
| fields src, url_domain, uploaded_bytes, fleet_src_prevalence

## VALIDATION — NGFW EAL — Recurring Rare-Domain Beacon Landed in panw_ngfw_traffic_raw
# purpose: validation
# dataset: panw_ngfw_traffic_raw

dataset = panw_ngfw_traffic_raw
| filter _time > to_timestamp(current_time() - 900)
| filter log_source_type = "eal" and app = "ssl" and dst_port = 443
| comp count() as recurring_sessions, avg(bytes_sent) as avg_bytes by src, url_domain
| filter recurring_sessions >= 6
| fields src, url_domain, recurring_sessions, avg_bytes

## VALIDATION — NGFW EAL — Large and Massive HTTPS Upload Landed in panw_ngfw_traffic_raw
# purpose: validation
# dataset: panw_ngfw_traffic_raw

dataset = panw_ngfw_traffic_raw
| filter _time > to_timestamp(current_time() - 900)
| filter log_source_type = "eal" and dst_port = 443 and action = "allow"
| filter bytes_sent > 1073741824
| comp max(bytes_sent) as peak_upload_bytes, sum(bytes_sent) as total_upload_bytes by src, url_domain
| sort desc peak_upload_bytes
| fields src, url_domain, peak_upload_bytes, total_upload_bytes

