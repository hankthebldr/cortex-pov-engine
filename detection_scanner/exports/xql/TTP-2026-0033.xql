# TTP-2026-0033 — Linux Reverse Shell — Multi-Method C2 Callback (T1059.004)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — EDR-002 Bash devtcp Reverse Shell Redirection
# severity: critical
# Bash reverse shell pattern — /dev/tcp redirection detected by XDR Agent behavioral rule. bash -i is launched with its stdio redirected to a /dev/tcp socket.

preset = xdr_data
| filter event_type = ENUM.PROCESS
| filter event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ("bash", "sh")
| filter action_process_image_command_line contains "/dev/tcp/"
| filter action_process_image_command_line contains_any (">&", "0>&1", "0<&")

## BIOC — EDR-002 Interactive Bash From Service Account With Network Redirect
# severity: critical
# Interactive bash spawned from service account with network redirect — C2 callback pattern. An interactive shell with a socket redirect runs under a non-login service identity.

preset = xdr_data
| filter event_type = ENUM.PROCESS
| filter event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ("bash", "sh")
| filter action_process_image_command_line contains "-i"
| filter action_process_image_command_line contains "/dev/tcp/"
| filter actor_effective_username in ("www-data", "nobody", "node", "apache", "nginx")
| filter causality_actor_process_image_name in ("apache2", "httpd", "nginx", "php-fpm", "node")
| fields _time, agent_hostname, actor_effective_username, action_process_image_command_line, causality_actor_process_image_name, causality_actor_process_instance_id

## BIOC — EDR-002 Python Socket Subprocess Reverse Shell
# severity: high
# Python reverse shell pattern — socket+subprocess import with connect call from service account. python3 -c imports socket and subprocess and calls connect().

preset = xdr_data
| filter event_type = ENUM.PROCESS
| filter event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ("python", "python3")
| filter action_process_image_command_line contains "socket"
| filter action_process_image_command_line contains_any ("subprocess", "pty", ".connect(")

## BIOC — EDR-002 Netcat Shell Exec Flag Reverse Shell
# severity: critical
# Netcat with -e flag — classic reverse shell pattern detected by endpoint BIOC rule. nc/ncat is invoked with -e/-c to pipe a shell.

preset = xdr_data
| filter event_type = ENUM.PROCESS
| filter event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ("nc", "ncat", "netcat")
| filter action_process_image_command_line contains_any ("-e /bin/sh", "-e /bin/bash", " -e ", "-c /bin/sh")

## BIOC — EDR-002 Perl Socket Reverse Shell One-Liner
# severity: high
# Perl socket-based reverse shell pattern — one-liner execution from service account. perl -e contains Socket/connect/sockaddr_in.

preset = xdr_data
| filter event_type = ENUM.PROCESS
| filter event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = "perl"
| filter action_process_image_command_line contains "Socket"
| filter action_process_image_command_line contains_any ("sockaddr_in", "connect(", "inet_aton")

## BIOC — EDR-002 OpenSSL s_client Encrypted C2 From Service Account
# severity: high
# OpenSSL s_client invoked from non-interactive service account — encrypted C2 channel attempt. openssl s_client opens an outbound TLS channel from a service identity.

preset = xdr_data
| filter event_type = ENUM.PROCESS
| filter event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = "openssl"
| filter action_process_image_command_line contains "s_client"
| filter actor_effective_username in ("www-data", "nobody", "node", "apache", "nginx")
| filter causality_actor_process_image_name in ("apache2", "httpd", "nginx", "php-fpm", "node")
| fields _time, agent_hostname, actor_effective_username, action_process_image_command_line, causality_actor_process_image_name, causality_actor_process_instance_id

## VALIDATION — EDR-002 Analytics Interactive Shell Network Redirect
# purpose: validation
# dataset: xdr_data

preset = xdr_data
| filter _time > to_timestamp(current_time() - 1800)
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ("bash", "sh")
| filter action_process_image_command_line contains "/dev/tcp/"
| fields _time, agent_hostname, actor_effective_username, action_process_image_command_line, causality_actor_process_image_name

## VALIDATION — EDR-002 Analytics Python Socket Ops By Service Account
# purpose: validation
# dataset: xdr_data

preset = xdr_data
| filter _time > to_timestamp(current_time() - 1800)
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ("python", "python3")
| filter action_process_image_command_line contains "socket"
| filter actor_effective_username != "root"
| fields _time, agent_hostname, actor_effective_username, action_process_image_command_line

## VALIDATION — EDR-002 Analytics Network Utility Shell Flag
# purpose: validation
# dataset: xdr_data

preset = xdr_data
| filter _time > to_timestamp(current_time() - 1800)
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ("nc", "ncat", "netcat")
| filter action_process_image_command_line contains "-e"
| fields _time, agent_hostname, actor_effective_username, action_process_image_command_line

## VALIDATION — EDR-002 Analytics Multi-Method Reverse Shell Sequence
# purpose: validation
# dataset: xdr_data

preset = xdr_data
| filter _time > to_timestamp(current_time() - 1800)
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ("bash", "sh", "python", "python3", "nc", "ncat", "perl", "openssl")
| filter action_process_image_command_line contains_any ("/dev/tcp/", "socket", "-e /bin/", "sockaddr_in", "s_client")
| comp count_distinct(actor_process_image_name) as method_count by agent_hostname, causality_actor_process_instance_id
| filter method_count >= 2

