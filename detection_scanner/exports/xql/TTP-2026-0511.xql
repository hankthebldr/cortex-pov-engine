# TTP-2026-0511 — Backdoor UID-0 Account Created on the Linux Syslog Feed
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## VALIDATION — New UID-0 User Added via useradd
# purpose: validation
# dataset: linux_syslog

dataset = linux_syslog
| filter process = "useradd" and message contains "UID=0"
| comp count() as adds by host, message
| filter adds >= 1

## VALIDATION — New Account Added to the sudo Group
# purpose: validation
# dataset: linux_syslog

dataset = linux_syslog
| filter process = "usermod" and message contains "sudo"
| comp count() as c by host
| filter c >= 1

