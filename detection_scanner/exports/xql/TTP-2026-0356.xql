# TTP-2026-0356 — Unsigned Process Accessing Rare Domains
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Recurring Rare Domain Access from Unsigned Process
# severity: high
# Detects unsigned processes accessing rare domains repeatedly

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name like '*/scratch/malware'
| filter action_remote_ip = '192.0.2.10'
| filter action_file_path = '/etc/hosts'
| filter causality_actor_process_image_name not like '%signed%'

## ABIOC — Unsigned Process Accessing Rare Domains (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name
# Behavioral deviation where unsigned process accesses rare domains

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.10'
| filter actor_process_image_name like '*/scratch/malware'
| filter causality_actor_process_image_name not like '%signed%'

## VALIDATION — Unsigned Process Accessing Rare Domains
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.10'
| filter actor_process_image_name like '*/scratch/malware'
| filter causality_actor_process_image_name not like '%signed%'

