# TTP-2026-0346 — Rare SMTP/S Session via Windows PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — PowerShell SMTP/S Session
# severity: high
# PowerShell script execution initiating an SMTP/S session to a non-standard port

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_remote_ip = '192.0.2.10' and dst_port = 25

## ABIOC — Rare SMTP/S Session Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'powershell.exe'
# Detects rare SMTP/S session initiated by PowerShell process, outside of normal behavior

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.10' and dst_port = 25
| filter actor_process_image_name = 'powershell.exe'

## VALIDATION — SMTP/S PowerShell Session Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.10' and dst_port = 25
| filter actor_process_image_name = 'powershell.exe'
| comp count() by actor_process_image_name, action_remote_ip

