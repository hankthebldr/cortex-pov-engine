# TTP-2026-0266 — Uncommon Process Execution by System Binary at Startup
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Process with User SID at Early Startup
# severity: high
# Detection of a process started by a system binary with a non-system user SID during early system startup

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'svchost.exe'
| filter action_process_image_name = '/tmp/scratch/malware.bin'
| filter process_user_sid contains 'S-1-5-21'
| filter process_start_time < '00:10:00'

## ABIOC — Suspicious Process Start by System Binary (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'svchost.exe'
# Detection of an uncommon process started by a system binary with a local user SID at early startup

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'svchost.exe'
| filter action_process_image_name = '/tmp/scratch/malware.bin'
| filter process_user_sid contains 'S-1-5-21'
| filter process_start_time < '00:10:00'

## VALIDATION — Process Start by System Binary with User SID
