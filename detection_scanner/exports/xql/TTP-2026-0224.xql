# TTP-2026-0224 — Compromised Process Accessing Rare External Host
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Compromised Process Accessed Rare External Host
# severity: high
# A process that is not typically seen accessing a rare external IP

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and action_remote_ip = '192.0.2.100'
| filter causality_actor_process_image_name != 'svchost.exe'
| filter causality_actor_process_image_name != 'explorer.exe'

