# TTP-2026-0369 — Scrcons.exe Rare Child Process Behavior
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Scrcons.exe Rare Child Process
# severity: high
# scrcons.exe starts an uncommon child process

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'scrcons.exe'
| filter action_process_image_name not in ('explorer.exe', 'cmd.exe', 'powershell.exe', 'svchost.exe')

## ABIOC — Scrcons.exe Unusual Child Process (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: scrcons.exe process start
# scrcons.exe starts a non-standard child process that deviates from normal behavior

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'scrcons.exe'
| filter action_process_image_name not in ('explorer.exe', 'cmd.exe', 'powershell.exe', 'svchost.exe')

## VALIDATION — Detect Scrcons.exe Rare Child Process
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'scrcons.exe'
| filter action_process_image_name not in ('explorer.exe', 'cmd.exe', 'powershell.exe', 'svchost.exe')
| fields agent_hostname, actor_process_image_name, action_process_image_name

