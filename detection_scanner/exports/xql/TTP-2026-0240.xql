# TTP-2026-0240 — Abnormal HTTP Communication with Rare User Agent and Server Combination
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rare HTTP User-Agent and Server Header Combination
# severity: high
# Detection of unusual combination of User-Agent and Server headers in HTTP traffic

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter dst_ip = '192.0.2.50'
| filter http_user_agent = 'Mozilla/5.0 (compatible; MSIE 9.0; Windows NT 6.1; Trident/5.0)'
| filter http_server = 'nginx/1.10.3 (Ubuntu)'
| filter http_request_method = 'GET'

## ABIOC — Abnormal Network Communication with Rare HTTP Headers (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: network-connection
# Behavioral deviation in HTTP communication characterized by rare User-Agent and Server header combinations

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter dst_ip = '192.0.2.50'
| filter http_user_agent = 'Mozilla/5.0 (compatible; MSIE 9.0; Windows NT 6.1; Trident/5.0)'
| filter http_server = 'nginx/1.10.3 (Ubuntu)'
| filter http_request_method = 'GET'

## VALIDATION — Detect Rare HTTP Header Combinations
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter dst_ip = '192.0.2.50'
| filter http_user_agent = 'Mozilla/5.0 (compatible; MSIE 9.0; Windows NT 6.1; Trident/5.0)'
| filter http_server = 'nginx/1.10.3 (Ubuntu)'
| filter http_request_method = 'GET'
| comp count() as cnt by http_user_agent, http_server
| comp count() as cnt by agent_hostname 

