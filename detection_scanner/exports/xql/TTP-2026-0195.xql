# TTP-2026-0195 — BITS Job Abuse via bitsadmin for Persistent Payload Delivery
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — BITS Job Creation
# severity: high
# Detection of bitsadmin.exe creating a job with notify command line

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'bitsadmin.exe'
| filter action_file_path contains '/create'
| filter action_file_path contains '/SetNotifyCmdLine'

