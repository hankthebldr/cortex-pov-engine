# TTP-2026-0195 — PAN-OS CVE-2026-0257 Foothold — GlobalProtect Bypass to RMM, RDP/SMB, ESXi and VMDK Credential Theft (T1556 / T1003.003)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — MP-036 GlobalProtect Gateway Session Without Preceding Authentication
# severity: high
# A GlobalProtect gateway-connected success authenticated by cookie with no preceding portal/gateway authentication for the same user and public_ip — the CVE-2026-0257 bypass core. Returns private_ip (the tunnel address the attacker's machine received), which is the stitch entity for everything the foothold does next.

dataset = panw_ngfw_globalprotect_raw
| filter eventid = "gateway-connected" and status = "success"
| filter preceding_auth_event = "NONE"
| fields _time, public_ip, private_ip, srcuser, machine_name, endpoint_mac, auth_method, preceding_auth_event

## BIOC — MP-036 RMM Installer Written to Temp and Executed with Relay Arguments
# severity: medium
# A ScreenConnect-named installer is written into a temp path by a download tool and executed from there with relay-style arguments (e=Access, h=<relay>, p=8041), and a ScreenConnect.ClientService process starts from a temp subdirectory. The report says dual-use RMM tools without naming one; ScreenConnect is the representative shape.

preset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter (action_process_image_command_line contains "ScreenConnect.ClientSetup" and action_process_image_command_line contains "e=Access") or (action_process_image_name = "ScreenConnect.ClientService" and action_process_image_path contains "/tmp/")
| fields agent_hostname, agent_ip_addresses, causality_actor_process_image_name, actor_process_image_name, action_process_image_path, action_process_image_command_line, causality_id

## BIOC — MP-036 Internal Discovery and Admin Port Sweep Including Veeam 9401
# severity: medium
# One causality chain runs neighbour/ARP enumeration and then nc connection tests against one internal host on several administrative ports including 9401 (Veeam Backup Service), or smbclient -L (on Windows, nltest /dclist:, net view, arp -a and one child powershell.exe Test-NetConnection per port, so the ports are on process command lines) — the report's RMM-driven internal reconnaissance.

preset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ("nc", "ncat", "smbclient", "arp", "ip", "nltest.exe", "net.exe", "arp.exe", "powershell.exe")
| filter action_process_image_command_line contains " -zv " or action_process_image_command_line contains "Test-NetConnection" or action_process_image_command_line contains " -L " or action_process_image_command_line contains "neigh" or action_process_image_command_line contains "/dclist" or action_process_image_command_line contains " view" or action_process_image_name in ("arp", "arp.exe")
| comp count_distinct(action_process_image_command_line) as discovery_cmds, values(action_process_image_command_line) as cmds by agent_hostname, agent_ip_addresses, causality_id
| alter cmd_text = arraystring(cmds, " ")
| filter discovery_cmds >= 4 and cmd_text contains "9401"
| fields agent_hostname, agent_ip_addresses, causality_id, discovery_cmds, cmds

## BIOC — MP-036 Admin Share Listing and RDP Attempt from One Shell
# severity: high
# One causality chain reaches the same host on both SMB (445) and RDP (3389): smbclient against a C$ share and xfreerdp when installed, otherwise nc -zv on 445 and 3389 (a clean Ubuntu 22.04 ships neither tool); on Windows, net use \\<host>\C$ followed by mstsc /v:<host>. Counts distinct target ports per causality_id rather than tool names, so the fallback path satisfies it. Admin-share access plus RDP from one tree is the report's RDP/SMB lateral movement.

preset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter (action_process_image_name = "smbclient" and action_process_image_command_line contains "C$") or action_process_image_name in ("xfreerdp", "mstsc.exe") or (action_process_image_name in ("nc", "ncat") and (action_process_image_command_line contains " 445" or action_process_image_command_line contains " 3389")) or (action_process_image_name = "net.exe" and action_process_image_command_line contains "C$")
| alter target_port = if(action_process_image_name in ("xfreerdp", "mstsc.exe") or action_process_image_command_line contains " 3389", "3389", "445")
| comp count_distinct(target_port) as lateral_ports by agent_hostname, agent_ip_addresses, causality_id
| filter lateral_ports >= 2
| fields agent_hostname, agent_ip_addresses, causality_id, lateral_ports

## BIOC — MP-036 vCenter REST Session Request from Foothold
# severity: medium
# A command-line HTTP client POSTs to the vCenter REST session endpoint (/rest/com/vmware/cis/session) — vCenter authentication attempted from a workstation-class host rather than an admin jump server.

preset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ("curl", "curl.exe", "wget") and action_process_image_command_line contains "/rest/com/vmware/cis/session"
| fields agent_hostname, agent_ip_addresses, action_process_image_command_line, causality_id

## BIOC — MP-036 SSH Command Disables ESXi execInstalledOnly
# severity: high
# An ssh client whose remote command sets /VMkernel/Boot/execInstalledOnly to 0 with esxcli — the report's disabling of the ESXi protection that blocks unsigned binaries. The command line is the key; the lab session cannot authenticate.

preset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ("ssh", "ssh.exe", "plink.exe")
| filter action_process_image_command_line contains "execInstalledOnly" and action_process_image_command_line contains "esxcli"
| fields agent_hostname, agent_ip_addresses, action_process_image_command_line, causality_id

## BIOC — MP-036 Datastore Browser VMDK Download to Temp
# severity: high
# A download tool requests a *-flat.vmdk through the vSphere datastore browser (/folder/<vm>/<vm>-flat.vmdk with dcPath and dsName) — copying a VM's raw disk off the hypervisor, the precursor to offline credential dumping.

preset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ("curl", "curl.exe", "wget", "powershell.exe")
| filter action_process_image_command_line contains "/folder/" and action_process_image_command_line contains "-flat.vmdk" and action_process_image_command_line contains "dsName="
| fields agent_hostname, agent_ip_addresses, action_process_image_command_line, causality_id

## BIOC — MP-036 Secretsdump Offline NTDS Parse
# severity: critical
# secretsdump run against local files with -ntds and -system and the LOCAL target — an offline NTDS.dit parse on a host that is not a domain controller. In SIM-MP-036 it is conditional: the step runs secretsdump.py only when the TOOL-IMPACKET pip install succeeded, which a default-deny network blocks.

preset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_command_line contains "secretsdump" and action_process_image_command_line contains "-ntds" and action_process_image_command_line contains "-system" and action_process_image_command_line contains "LOCAL"
| fields agent_hostname, agent_ip_addresses, action_process_image_command_line, causality_id

## BIOC — MP-036 Veeam Backup Service Credential Method Request
# severity: high
# A process connects to TCP 9401 and an HTTP client sends a request naming CredentialsDbScopeGetAllCreds to the Veeam Backup Service — the CVE-2023-27532 credential-retrieval shape (the lab request carries no exploit payload).

preset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter (action_process_image_command_line contains "CredentialsDbScopeGetAllCreds") or (action_process_image_name in ("nc", "ncat") and action_process_image_command_line contains "9401")
| fields agent_hostname, agent_ip_addresses, action_process_image_name, action_process_image_command_line, causality_id

## ABIOC — MP-036 Rare SSH Session from VPN Pool Host to ESXi Management (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Learned per-source management-plane baseline -> first-seen SSH to an ESXi address from a GlobalProtect pool address, joined on src to the GlobalProtect private_ip.
# A remote-access (GlobalProtect pool) address opens an SSH session to an ESXi management address it has not used before, in the same window as an ssl/443 session to vCenter — hypervisor management reached from a VPN client.

dataset = panw_ngfw_traffic_raw
| filter log_source_type = "eal"
| filter (app = "ssh" and dst_port = 22) or (app = "ssl" and dst_port = 443 and process_name = "curl")
| comp count_distinct(dst_port) as mgmt_ports, values(dst) as targets by src, endpoint_device_name, user
| filter mgmt_ports >= 2
| fields src, endpoint_device_name, user, targets, mgmt_ports

## ABIOC — MP-036 NTDS and SYSTEM Hive Pair Carved from a VMDK on a Non-DC Host (behavioral-ML, causality-anchored)
# severity: critical
# behavioral_profile: machine-learning
# causality_anchor: Learned per-host credential-store baseline -> ntds.dit + SYSTEM materialised next to a VMDK on a host that is not a domain controller, anchored to the causality_id that downloaded the VMDK.
# File events in one causality chain write a *-flat.vmdk (curl, or a dd placeholder) and then files named ntds.dit and SYSTEM beside it (a carve) — a DC credential store materialised from a VM disk on a host that is not a domain controller, outside the guest where the DC's in-guest EDR would see it. Keys on the file writes alone; the secretsdump parse is the separate, conditional BIOC.

preset = xdr_data
| filter event_type = ENUM.FILE
| filter action_file_name in ("ntds.dit", "SYSTEM", "DC01-flat.vmdk") or action_file_name contains "-flat.vmdk"
| comp count_distinct(action_file_name) as carved, values(action_file_path) as paths by agent_hostname, agent_ip_addresses, causality_id
| filter carved >= 3
| fields agent_hostname, agent_ip_addresses, causality_id, carved, paths

## VALIDATION — MP-036 Hunt GlobalProtect Sessions from CVE-2026-0257 Exploitation IPs
# purpose: hunt
# dataset: panw_ngfw_globalprotect_raw

dataset = panw_ngfw_globalprotect_raw
| filter eventid = "gateway-connected" and status = "success"
| filter public_ip in ("104.207.144.154", "146.19.216.120", "146.19.216.125", "179.43.172.213", "198.12.106.60", "202.144.192.47")
| comp count() as sessions, values(public_ip) as exploit_ips, values(machine_name) as machines by private_ip, srcuser
| sort desc sessions
| fields private_ip, srcuser, exploit_ips, machines, sessions

## VALIDATION — MP-036 VPN Pool Host RDP and SMB Sessions to Internal Servers
# purpose: validation
# dataset: panw_ngfw_traffic_raw

dataset = panw_ngfw_traffic_raw
| filter log_source_type = "eal"
| filter (dst_port = 3389 and app = "ms-rdp") or (dst_port = 445 and app = "ms-ds-smb")
| filter incidr(dst, "10.0.0.0/8") or incidr(dst, "172.16.0.0/12") or incidr(dst, "192.168.0.0/16")
| comp count() as sessions, values(process_name) as processes, values(dst) as targets by src, endpoint_device_name, user
| fields src, endpoint_device_name, user, processes, targets, sessions

## VALIDATION — MP-036 VPN Pool Host Session to Veeam Backup Service Port 9401
# purpose: validation
# dataset: panw_ngfw_traffic_raw

dataset = panw_ngfw_traffic_raw
| filter log_source_type = "eal" and dst_port = 9401
| comp count() as sessions, values(dst) as backup_servers, values(process_name) as processes by src, endpoint_device_name, user
| fields src, endpoint_device_name, user, backup_servers, processes, sessions

