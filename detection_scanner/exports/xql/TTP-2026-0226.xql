# TTP-2026-0226 — Unusual Process Executes Contained Executable
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unusual Process Executes Contained Binary
# severity: high
# Detects when an unexpected parent process executes a contained binary from a temporary directory

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/tmp/evil'
| filter actor_process_image_name != 'bash' and actor_process_image_name != 'sh'
| filter causality_actor_process_image_name != 'bash'

## ABIOC — A Contained Executable Was Executed By An Unusual Process (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Behavioral deviation where a contained executable is executed by a process not typically seen running such binaries

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/tmp/evil'
| filter actor_process_image_name != 'bash' and actor_process_image_name != 'sh'
| filter causality_actor_process_image_name != 'bash'

## VALIDATION — Hunt for Unexpected Process Execution
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/tmp/evil'
| filter actor_process_image_name != 'bash'
