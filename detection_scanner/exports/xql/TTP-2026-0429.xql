# TTP-2026-0429 — Uncommon DotNet Module Load via PowerShell with C2 Communication
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon DotNet module load relationship
# severity: high
# Detection of PowerShell loading a .NET assembly from an uncommon or non-standard path

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_image_name contains '.NET'
| filter action_file_path not in ('C:\Windows\Microsoft.NET\', 'C:\Program Files\')

## ABIOC — PowerShell load of .NET module with C2 (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'powershell.exe'
# Behavioral deviation where PowerShell loads a .NET module and initiates C2 communication

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_file_path contains '.NET'
| filter action_remote_ip = '192.0.2.10'
| filter dst_port = 8080

## VALIDATION — Detect PowerShell loading .NET modules
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_file_path contains '.NET'
| filter action_file_path not in ('C:\Windows\Microsoft.NET\', 'C:\Program Files\')

