# TTP-2026-0075 — Active Directory Offline-Roasting Credential Harvest — AS-REP Roast + Kerberoast (T1558.004 / T1558.003)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — ITDR-006 AS-REQ For Pre-Auth-Disabled Account (AS-REP Roast)
# severity: high
# ITDR - a Kerberos AS-REQ / 4768 is observed for a domain account whose userAccountControl has DoesNotRequirePreAuth set. Requesting an AS-REP for such an account returns a crackable hash with no prior authentication — the AS-REP Roasting fingerprint (T1558.004).

dataset = xdr_data
| filter event_type = ENUM.ACTIVE_DIRECTORY
| filter event_id = 4768
| filter pre_authentication_type = 0
| filter src_host not in ("DC01", "DC02")
| fields _time, account_name, src_host, pre_authentication_type

## BIOC — ITDR-006 LDAP SPN Sweep From Non-Typical Host
# severity: medium
# ITDR - LDAP search filter (servicePrincipalName=*) from a host that is not a domain controller and not an established admin workstation — the enumeration that precedes Kerberoasting (T1558.003).

dataset = xdr_data
| filter event_type = ENUM.ACTIVE_DIRECTORY
| filter operation_name in ("LDAP_SEARCH", "DirectorySearch")
| filter lower(search_filter) contains "serviceprincipalname"
| filter src_host not in ("DC01", "DC02")
| filter actor_effective_username not in ("Administrator", "svc-bloodhound")
| fields _time, src_host, actor_effective_username, search_filter

## BIOC — ITDR-006 Kerberos TGS-REQ RC4 Burst For Multiple SPNs
# severity: high
# ITDR - a single source requests RC4-encrypted (etype 0x17) TGS service tickets (4769) for three or more distinct service principals in a short window — the Kerberoasting ticket-harvest fingerprint (T1558.003). RC4 is requested because its TGS is the easiest to crack offline.

dataset = xdr_data
| filter event_type = ENUM.ACTIVE_DIRECTORY
| filter event_id = 4769
| filter ticket_encryption_type = "0x17"
| bin _time span=5m
| comp count_distinct(service_name) as spn_count by src_host, actor_effective_username, _time
| filter spn_count >= 3
| fields _time, src_host, actor_effective_username, spn_count

## VALIDATION — ITDR-006 Validate AS-REP Roast AS-REQ For Pre-Auth-Disabled Account
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter _time > to_timestamp(current_time() - 1800)
| filter event_type = ENUM.ACTIVE_DIRECTORY
| filter event_id = 4768 and pre_authentication_type = 0
| comp count() as asrep_requests by account_name, src_host
| filter asrep_requests >= 1
| fields account_name, src_host, asrep_requests

## VALIDATION — ITDR-006 Validate Kerberoast TGS-REQ RC4 Burst
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter _time > to_timestamp(current_time() - 1800)
| filter event_type = ENUM.ACTIVE_DIRECTORY
| filter event_id = 4769 and ticket_encryption_type = "0x17"
| comp count_distinct(service_name) as spn_count by src_host, actor_effective_username
| filter spn_count >= 3
| fields src_host, actor_effective_username, spn_count

## VALIDATION — ITDR-006 NGFW Kerberos Port 88 Traffic Spike From Operator Host
# purpose: validation
# dataset: panw_ngfw_traffic_raw

dataset = panw_ngfw_traffic_raw
| filter _time > to_timestamp(current_time() - 1800)
| filter dst_port = 88
| filter app in ("kerberos", "ms-kerberos") or proto in ("tcp", "udp")
| comp count(session_id) as kerb_sessions by source_ip, dest_ip
| filter kerb_sessions >= 5
| fields source_ip, dest_ip, kerb_sessions

## VALIDATION — ITDR-006 Hunt All Roastable Principals Targeted From One Source
# purpose: hunt
# dataset: xdr_data

dataset = xdr_data
| filter _time > to_timestamp(current_time() - 86400)
| filter event_type = ENUM.ACTIVE_DIRECTORY
| filter event_id in (4768, 4769)
| comp count_distinct(service_name) as spns_targeted, count_distinct(account_name) as accounts_targeted by src_host
| sort desc spns_targeted
| fields src_host, spns_targeted, accounts_targeted

