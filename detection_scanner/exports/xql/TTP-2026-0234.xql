# TTP-2026-0234 — Uncommon AppID Access via PowerShell Command Execution
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon AppID Access
# severity: high
# Detection of a user accessing an uncommon AppID during process execution

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_image_name = 'malware.exe'
| filter causality_actor_process_image_name != 'explorer.exe'

## ABIOC — Uncommon AppID Access Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: powershell.exe -> malware.exe
# Behavioral deviation detected when a PowerShell process accesses an uncommon AppID during execution

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_image_name = 'malware.exe'
| filter causality_actor_process_image_name != 'explorer.exe'

