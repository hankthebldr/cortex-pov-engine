# TTP-2026-0359 — Registry Credentials Extraction via Reg.exe
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Registry Credentials Extraction Process
# severity: high
# Detection of reg.exe process execution with arguments that query sensitive registry paths

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'reg.exe'
| filter action_process_command_line contains 'query'
| filter action_process_command_line contains 'SAM'
| filter action_process_command_line contains 'SYSTEM'

## ABIOC — Registry Access for Credential Extraction (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: cmd.exe launching reg.exe with credential query arguments
# Behavioral deviation detecting registry queries for SAM and SYSTEM hives indicative of credential dumping

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'reg.exe'
| filter action_process_command_line contains 'query'
| filter action_process_command_line contains 'SAM'
| filter action_process_command_line contains 'SYSTEM'
| filter causality_actor_process_image_name = 'cmd.exe'

