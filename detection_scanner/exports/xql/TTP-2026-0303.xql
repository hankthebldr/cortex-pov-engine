# TTP-2026-0303 — Mshta.exe with Suspicious Arguments Launch
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Mshta Suspicious Arguments
# severity: high
# Detection of mshta.exe launched with suspicious arguments such as remote scriptlet execution

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'mshta.exe'
| filter action_file_path contains '.hta'
| filter action_file_path contains 'http://'

## ABIOC — Mshta Suspicious Execution Pattern (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: cmd.exe or powershell.exe launching mshta with remote scriptlet
# Behavioral deviation of mshta.exe launching a remote scriptlet via HTTP

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'mshta.exe'
| filter action_file_path contains 'http://'
| filter causality_actor_process_image_name = 'cmd.exe' or causality_actor_process_image_name = 'powershell.exe'

## VALIDATION — Detect Mshta Suspicious Arguments
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'mshta.exe'
| filter action_file_path contains '.hta'
| filter action_file_path contains 'http://'

