# TTP-2026-0316 — DLL Search Order Hijacking via Malicious DLL Placement
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious DLL Load from Non-Standard Directory
# severity: high
# Process starts and loads a DLL from a non-standard directory that is searched before system directories

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'C:\\Windows\\System32\\cmd.exe'
| filter action_file_path contains 'temp_dll'

## ABIOC — Process Load of Hijacked DLL (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start_with_non_standard_dll_load
# A process loads a DLL from a directory that is not in the standard system path, indicating potential DLL hijacking

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_file_path contains 'temp_dll'
| filter actor_process_image_name = 'C:\\Windows\\System32\\cmd.exe'

## VALIDATION — Detect Process Loading Hijacked DLL
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_file_path contains 'temp_dll'
| filter actor_process_image_name = 'C:\\Windows\\System32\\cmd.exe'
| fields actor_process_image_name, action_file_path

