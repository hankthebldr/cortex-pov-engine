# TTP-2026-0481 — Kubernetes Pod Exfiltrates Data via wget to C2
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unusual Pod Network Communication
# severity: high
# A pod makes an outbound network connection to a remote IP not typically seen in normal operations

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.50'
| filter actor_process_image_name like '%pod%'

## ABIOC — Pod Executes Suspicious Script (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: pod process start
# A pod executes a script downloaded from a remote C2 server

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/tmp/malware.sh'
| filter causality_actor_process_image_name like '%pod%'

## VALIDATION — Detect Outbound C2 Connection from Pod
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.50'
| filter actor_process_image_name like '%pod%'

