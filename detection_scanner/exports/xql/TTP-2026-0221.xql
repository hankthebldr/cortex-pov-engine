# TTP-2026-0221 — Abused Process Connecting to Rare Cloud Resource
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Abused Process Connecting to Rare Cloud Resource
# severity: high
# Detects when a commonly abused process like PowerShell connects to a rare or uncommon IP address

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_remote_ip = '192.0.2.100'

## ABIOC — Rare Cloud Resource Connection by Abused Process (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name = 'powershell.exe' and action_remote_ip = '192.0.2.100'
# Detects abnormal behavior when a commonly abused process makes a network connection to a rare cloud resource

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_process_image_name = 'powershell.exe'
| filter action_remote_ip = '192.0.2.100'
| filter action_remote_port = 80

## VALIDATION — Detect Rare IP Connection by PowerShell
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_process_image_name = 'powershell.exe'
| filter action_remote_ip = '192.0.2.100'

