# TTP-2026-0502 — Kubernetes Pod Reconnaissance for Container Enumeration
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious K8s Pod Reconnaissance Process
# severity: high
# Execution of a binary that queries Kubernetes pod and node metadata

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/tmp/kube-info'
| filter causality_actor_process_image_name = 'sh'

## ABIOC — Container Reconnaissance Behavioral Pattern (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start /tmp/kube-info
# Behavioral deviation of process execution followed by DNS resolution to Kubernetes service endpoints

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/tmp/kube-info'
| filter causality_actor_process_image_name = 'sh'
| join with dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.100'
| filter dst_port = 53

## VALIDATION — K8s Reconnaissance Process Chain
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/tmp/kube-info'
| filter causality_actor_process_image_name = 'sh'
| fields actor_process_image_name, action_process_image_name, causality_actor_process_image_name

