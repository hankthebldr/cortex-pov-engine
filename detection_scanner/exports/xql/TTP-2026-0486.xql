# TTP-2026-0486 — Weak Authentication via PowerShell with Credential Dumping
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unusual PowerShell Authentication
# severity: high
# PowerShell execution with credential dumping modules

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter causality_actor_process_image_name = 'cmd.exe'
| filter action_file_path contains 'Invoke-Mimikatz.ps1'

