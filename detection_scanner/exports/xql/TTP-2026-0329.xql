# TTP-2026-0329 — Rare Binary Connecting to Rare Cloud Resource
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rare Binary Connected to Rare Cloud Resource
# severity: high
# Detection of a rare binary (based on file hash) connecting to a rare cloud resource (based on IP reputation)

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = "/tmp/scratch/malware"
| filter action_remote_ip = "192.0.2.10"
| filter action_remote_ip in (select ip from cloud_ip_reputation where is_rare = true)
| filter action_process_image_name in (select file_hash from rare_binary_list where is_rare = true)

## ABIOC — Rare Binary to Rare Cloud Resource Connection (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name
# Behavioral deviation where a rare binary connects to a rare cloud resource, indicating potential C2 communication

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = "192.0.2.10"
| filter action_process_image_name in (select file_hash from rare_binary_list where is_rare = true)
| filter action_remote_ip in (select ip from cloud_ip_reputation where is_rare = true)

## VALIDATION — Rare Binary to Rare Cloud Resource Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip in (select ip from cloud_ip_reputation where is_rare = true)
| filter action_process_image_name in (select file_hash from rare_binary_list where is_rare = true)
| filter action_remote_ip = "192.0.2.10"

