# TTP-2026-0352 — RDP Connection to Localhost with Remote Command Execution
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — RDP Connection to Localhost
# severity: high
# Detection of RDP connection to localhost (127.0.0.1)

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '127.0.0.1' and dst_port = 3389
| filter causality_actor_process_image_name = 'mstsc.exe'

## ABIOC — RDP to Localhost followed by PowerShell Execution (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: RDP Connection to localhost
# Behavioral deviation where an RDP connection to localhost is followed by PowerShell execution

dataset = xdr_data
| filter event_type = ENUM.NETWORK and action_remote_ip = '127.0.0.1' and dst_port = 3389
| filter event_type = ENUM.PROCESS and action_process_image_name = 'powershell.exe'
| join by causality_actor_process_image_name

## VALIDATION — Detect RDP to Localhost
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '127.0.0.1' and dst_port = 3389
| filter causality_actor_process_image_name = 'mstsc.exe'

## VALIDATION — Detect PowerShell Execution after RDP
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and action_process_image_name = 'powershell.exe'
| filter causality_actor_process_image_name = 'mstsc.exe'

