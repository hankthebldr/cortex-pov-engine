# TTP-2026-0437 — Windows EDR Simulation of Uncommon Linux Remote Shell Command Execution
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Linux Remote Shell Command Execution
# severity: high
# Detection of unusual shell command execution patterns that are commonly seen in lateral movement or remote access scenarios

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/tmp/shell.sh'
| filter action_remote_ip = '192.0.2.10'

## ABIOC — Uncommon Linux Remote Shell Command Execution (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Behavioral deviation detected when a process executes an uncommon Linux shell command with network connectivity to a test-net IP

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/tmp/shell.sh'
| filter action_remote_ip = '192.0.2.10'

## VALIDATION — Detect Uncommon Linux Shell Execution
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/tmp/shell.sh'
| filter action_remote_ip = '192.0.2.10'
| fields actor_process_image_name, action_process_image_name, action_remote_ip

