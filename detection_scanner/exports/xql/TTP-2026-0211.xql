# TTP-2026-0211 — Repeated Failed Sudo Authentications Followed by Success
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Sudo Brute Force Attempt
# severity: high
# Multiple failed sudo authentication attempts followed by a successful one within a short time window

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'sudo'
| filter actor_process_image_name = 'bash'
| filter action_file_path contains 'sudo'
| filter action_remote_ip = '192.0.2.1'

## ABIOC — Possible brute force on sudo user (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: sudo process execution with repeated failed auth attempts
# Detects repeated failed sudo authentications followed by a successful one, indicating brute force behavior

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'sudo'
| filter actor_process_image_name = 'bash'
| filter action_file_path contains 'sudo'
| filter action_remote_ip = '192.0.2.1'

## VALIDATION — Sudo Brute Force Hunt Query
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'sudo'
| filter actor_process_image_name = 'bash'
| filter action_file_path contains 'sudo'
| filter action_remote_ip = '192.0.2.1'
| comp count() as cnt by action_remote_ip, actor_process_image_name
| comp count() as cnt by agent_hostname 

