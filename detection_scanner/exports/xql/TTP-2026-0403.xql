# TTP-2026-0403 — Proxy Environment Variable Manipulation for Lateral Movement
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious Proxy Environment Variable Setting
# severity: high
# Detection of environment variables being set to redirect traffic through a non-standard proxy

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'bash'
| filter action_file_path contains 'export'
| filter action_file_path contains 'http_proxy'
| filter action_file_path contains '192.0.2.5'

## ABIOC — Proxy Environment Variable Manipulation (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name
# Behavioral deviation where a process modifies environment variables to route traffic through a known malicious IP

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'bash'
| filter action_file_path contains 'export'
| filter action_file_path contains 'http_proxy'
| filter action_remote_ip = '192.0.2.5'

## VALIDATION — Find Processes Setting Proxy Variables
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_file_path contains 'export'
| filter action_file_path contains 'http_proxy'
| filter action_remote_ip = '192.0.2.5'

