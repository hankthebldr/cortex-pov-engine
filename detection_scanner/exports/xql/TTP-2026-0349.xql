# TTP-2026-0349 — Unsigned Process Spawned by Office Under Suspicious Directory
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rare Unsigned Process Spawned by Office Process Under Suspicious Directory
# severity: high
# Detection of unsigned processes launched by Office applications from non-standard directories.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'winword.exe'
| filter action_process_image_name != null
| filter action_process_image_name !~ '.*\.exe'
| filter action_file_path contains 'C:\\Users\\Public\\'
| filter action_file_path !~ '.*\\AppData\\.*'

## ABIOC — Suspicious Unsigned Process From Office Under Public Directory (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'winword.exe'
# Behavioral deviation where unsigned executables are launched from public directories by Office processes.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'winword.exe'
| filter action_process_image_name != null
| filter action_file_path contains 'C:\\Users\\Public\\'
| filter action_process_image_name !~ '.*\.exe'
| filter action_file_path !~ '.*\\AppData\\.*'

