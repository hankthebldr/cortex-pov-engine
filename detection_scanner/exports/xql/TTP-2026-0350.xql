# TTP-2026-0350 — WinRM Remote Management Activity with PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rare Windows Remote Management (WinRM) HTTP Activity
# severity: high
# Detection of unusual WinRM HTTP activity originating from a host

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECTION_ESTABLISHED
| filter dst_port = 5985 and action_remote_ip in ('192.0.2.10')
| filter causality_actor_process_image_name != 'winrm.exe'
| filter actor_process_image_name != 'powershell.exe'

## ABIOC — Unusual PowerShell with WinRM Connection (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: PowerShell initiating WinRM connection
# PowerShell process initiating WinRM HTTP connection without typical WinRM parent

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECTION_ESTABLISHED
| filter dst_port = 5985 and action_remote_ip in ('192.0.2.10')
| filter actor_process_image_name = 'powershell.exe'
| filter causality_actor_process_image_name != 'winrm.exe'

## VALIDATION — WinRM HTTP Connection Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECTION_ESTABLISHED
| filter dst_port = 5985 and action_remote_ip in ('192.0.2.10')
| filter actor_process_image_name != 'winrm.exe'
| filter causality_actor_process_image_name != 'powershell.exe'

