# TTP-2026-0363 — Uncommon Remote Service Start via WMI
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Remote Service Start from Uncommon Source
# severity: high
# Detection of a service start initiated from an unexpected source process (e.g., wmic.exe)

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'wmic.exe'
| filter action_process_image_name = 'sc.exe'
| filter causality_actor_process_image_name != 'services.exe'

## ABIOC — Unusual WMI Service Start (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'wmic.exe'
# Behavioral deviation where WMI is used to initiate a service start from an uncommon process chain

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'wmic.exe'
| filter action_process_image_name = 'sc.exe'
| filter causality_actor_process_image_name != 'services.exe'
| filter not (action_file_path contains 'services.exe')

## VALIDATION — Detect WMI Service Start
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'wmic.exe'
| filter action_process_image_name = 'sc.exe'
| filter causality_actor_process_image_name != 'services.exe'
| fields agent_hostname, actor_process_image_name, action_process_image_name, causality_actor_process_image_name

