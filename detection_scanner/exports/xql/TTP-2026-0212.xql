# TTP-2026-0212 — Masquerading as crond process from non-standard path
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Masquerading as crond process
# severity: high
# Process starts with name 'crond' but from non-standard path

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'crond'
| filter action_file_path != '/usr/sbin/crond' and action_file_path != '/sbin/crond'
| filter action_file_path != '/bin/crond'

## ABIOC — Masquerading as Linux crond process (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Detects process masquerading as crond from non-standard path using behavioral ML

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'crond'
| filter action_file_path != '/usr/sbin/crond' and action_file_path != '/sbin/crond'
| filter action_file_path != '/bin/crond'
| filter causality_actor_process_image_name != 'init'

## VALIDATION — Detect crond masquerading
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'crond'
| filter action_file_path != '/usr/sbin/crond' and action_file_path != '/sbin/crond'
| filter action_file_path != '/bin/crond'
| fields agent_hostname, action_file_path, actor_process_image_name

