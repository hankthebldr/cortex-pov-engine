# TTP-2026-0465 — Unsigned Unpopular Process Performs DLL Injection
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unsigned and Unpopular Process DLL Injection
# severity: high
# A process that is not signed or well-known performs a DLL injection into another process

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'python3'
| filter action_file_path contains '/tmp/malicious.dll'
| filter causality_actor_process_image_name = 'python3'

## ABIOC — Suspicious DLL Injection by Unsigned Process (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Behavioral deviation detected when unsigned or unpopular process performs DLL injection

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'python3'
| filter action_file_path contains '/tmp/malicious.dll'
| filter causality_actor_process_image_name = 'python3'

