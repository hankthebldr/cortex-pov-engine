# TTP-2026-0364 — Remote WMI Process Execution via PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — WMI Remote Process Execution
# severity: high
# Detection of WMI process execution via remote connection

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_file_path contains 'wmic.exe' or action_file_path contains 'Get-WmiObject'

## ABIOC — Suspicious PowerShell WMI Execution (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name = 'powershell.exe'
# Behavioral deviation from normal PowerShell usage involving WMI calls

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_file_path contains 'Get-WmiObject' or action_file_path contains 'Invoke-WmiMethod'
| filter action_remote_ip = '192.0.2.100'

## VALIDATION — WMI Remote Process Execution Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_file_path contains 'Get-WmiObject'
| filter action_remote_ip = '192.0.2.100'

