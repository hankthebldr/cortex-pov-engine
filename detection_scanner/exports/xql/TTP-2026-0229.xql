# TTP-2026-0229 — Windows Process Connecting to Rare External Host
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Process Connected to Rare External Host
# severity: high
# A process connects to an IP address that is not commonly seen in the environment

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip != null
| filter action_remote_ip not in (SELECT DISTINCT action_remote_ip FROM xdr_data WHERE event_type = ENUM.NETWORK_CONNECTION AND agent_hostname = 'target-host')
| filter action_remote_ip in (SELECT DISTINCT action_remote_ip FROM xdr_data WHERE event_type = ENUM.NETWORK_CONNECTION AND agent_hostname = 'target-host' AND action_remote_ip != '192.0.2.100')

## ABIOC — Rare External Host Connection (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name
# Detects when a process connects to an IP address that is not commonly seen in the environment

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip != null
| filter action_remote_ip not in (SELECT DISTINCT action_remote_ip FROM xdr_data WHERE event_type = ENUM.NETWORK_CONNECTION AND agent_hostname = 'target-host')

## VALIDATION — Detect Rare Network Connections
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip != null
| filter action_remote_ip not in (SELECT DISTINCT action_remote_ip FROM xdr_data WHERE event_type = ENUM.NETWORK_CONNECTION AND agent_hostname = 'target-host')
| comp count() by action_remote_ip

