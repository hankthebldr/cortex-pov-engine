# TTP-2026-0358 — Uncommon .NET Service Registration via Regsvcs.exe
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon .NET Service Registration
# severity: high
# Detection of regsvcs.exe being used to register a .NET assembly as a service

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'regsvcs.exe'
| filter causality_actor_process_image_name = 'cmd.exe' or causality_actor_process_image_name = 'powershell.exe'
| filter action_file_path contains '.dll'
| filter action_file_path contains 'temp'

## ABIOC — Suspicious .NET Assembly Registration (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name = 'regsvcs.exe'
# Detection of a non-standard .NET assembly being registered via regsvcs.exe

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'regsvcs.exe'
| filter action_file_path contains '.dll'
| filter action_file_path not in ('C:\Windows\Microsoft.NET\assembly\GAC_64\System.EnterpriseServices\', 'C:\Windows\Microsoft.NET\assembly\GAC_32\System.EnterpriseServices\')

## VALIDATION — Detect Uncommon Regsvcs Usage
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'regsvcs.exe'
| filter action_file_path contains '.dll'
| filter action_file_path not in ('C:\Windows\Microsoft.NET\assembly\GAC_64\System.EnterpriseServices\', 'C:\Windows\Microsoft.NET\assembly\GAC_32\System.EnterpriseServices\')
| filter causality_actor_process_image_name = 'cmd.exe' or causality_actor_process_image_name = 'powershell.exe'

