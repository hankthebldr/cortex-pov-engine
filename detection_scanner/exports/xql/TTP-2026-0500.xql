# TTP-2026-0500 — Sudoedit Brute Force Attack via Automated Script
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Sudoedit Brute Force Attempt
# severity: high
# Detects repeated sudoedit process starts with invalid passwords

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'sudoedit'
| filter actor_process_image_name = 'bash'
| filter causality_actor_process_image_name = 'www-data'
| comp count() as cnt by by action_process_image_name

## ABIOC — Repeated Sudoedit Process Launches (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Repeated sudoedit process starts
# Behavioral deviation where sudoedit is launched repeatedly without success

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'sudoedit'
| filter actor_process_image_name = 'bash'
| comp count() as cnt by by action_process_image_name

