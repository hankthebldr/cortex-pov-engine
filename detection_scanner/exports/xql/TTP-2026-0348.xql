# TTP-2026-0348 — Unsigned Process Execution via Scheduled Task
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rare unsigned process execution by scheduled task
# severity: high
# Detection of unsigned process execution triggered by schtasks.exe

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'schtasks.exe'
| filter action_process_image_name != 'signed.exe'
| filter action_file_path contains 'malware.exe'

## ABIOC — Unusual unsigned process start from scheduled task (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'schtasks.exe'
# Behavioral deviation where an unsigned executable is started by schtasks.exe

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'schtasks.exe'
| filter action_process_image_name != 'signed.exe'
| filter action_file_path contains 'malware.exe'

## VALIDATION — Scheduled Task with Unsigned Binary Execution
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'schtasks.exe'
| filter action_process_image_name != 'signed.exe'
| filter action_file_path contains 'malware.exe'

