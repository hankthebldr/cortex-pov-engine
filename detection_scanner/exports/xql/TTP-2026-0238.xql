# TTP-2026-0238 — Dormant Host Reconnaissance via Newly Seen Endpoint
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Abnormal Dormant Host Connection
# severity: high
# A newly seen endpoint makes an outbound connection to a dormant host that has not previously been contacted.

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.50'
| filter actor_process_image_name != null
| filter not exists (select * from xdr_data where event_type = ENUM.NETWORK_CONNECTION and action_remote_ip = '192.0.2.50' and agent_hostname = agent_hostname)
| filter agent_hostname != null

## ABIOC — New Endpoint Connecting to Dormant Host (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: network-connection
# Detects when a new endpoint makes an outbound network connection to a host that has not previously been contacted by any endpoint.

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.50'
| filter actor_process_image_name != null
| filter not exists (select * from xdr_data where event_type = ENUM.NETWORK_CONNECTION and action_remote_ip = '192.0.2.50' and agent_hostname != agent_hostname)
| filter agent_hostname != null

## VALIDATION — Detect Dormant Host Connections
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.50'
| filter not exists (select * from xdr_data where event_type = ENUM.NETWORK_CONNECTION and action_remote_ip = '192.0.2.50' and agent_hostname = agent_hostname)
| comp count() as cnt by agent_hostname, action_remote_ip
| comp count() as cnt by agent_hostname 

