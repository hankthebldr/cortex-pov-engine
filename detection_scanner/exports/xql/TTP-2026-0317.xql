# TTP-2026-0317 — RDP Brute-Force via Windows Command Line Tools
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — RDP Brute Force Attempt
# severity: high
# Multiple failed RDP connection attempts from same host

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'net.exe'
| filter action_file_path contains 'net.exe'
| filter action_remote_ip = '192.0.2.10'
| filter dst_port = 445

## ABIOC — Unusual RDP Access Pattern (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Unexpected use of net.exe to attempt RDP connection to a remote host

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'net.exe'
| filter action_file_path contains 'net.exe'
| filter action_remote_ip = '192.0.2.10'
| filter dst_port = 445

