# TTP-2026-0409 — RDP Connection to Localhost with Credential Harvesting
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious RDP Connection to Localhost
# severity: high
# Detection of RDP connection initiated to localhost (127.0.0.1) with non-local IP address

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECT
| filter action_remote_ip = '127.0.0.1' and dst_port = 3389
| filter causality_actor_process_image_name != 'svchost.exe'

## ABIOC — RDP Session with Non-Standard Process (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: RDP connection to localhost
# RDP connection followed by process execution not typically associated with RDP sessions

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECT
| filter action_remote_ip = '127.0.0.1' and dst_port = 3389
| join with process_start on session_id
| filter action_process_image_name != 'mstsc.exe' and action_process_image_name != 'svchost.exe'

## VALIDATION — Detect RDP to Localhost
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECT
| filter action_remote_ip = '127.0.0.1' and dst_port = 3389
| filter causality_actor_process_image_name != 'svchost.exe'
| fields agent_hostname, action_remote_ip, dst_port, causality_actor_process_image_name

