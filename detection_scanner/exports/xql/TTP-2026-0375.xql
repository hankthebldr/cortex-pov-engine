# TTP-2026-0375 — Signed Process DLL Injection via Rundll32
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Signed Process DLL Injection
# severity: high
# A signed process such as rundll32.exe performs an uncommon DLL injection into a target process

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name IN ('rundll32.exe', 'msiexec.exe')
| filter action_file_path CONTAINS '.dll'
| filter action_file_path NOT IN ('C:\\Windows\\System32\\', 'C:\\Windows\\SysWOW64\\')

## ABIOC — Unpopular DLL Injection by Signed Process (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'rundll32.exe'
# Detection of a signed process performing a DLL injection that is not typical for that process

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name IN ('rundll32.exe', 'msiexec.exe')
| filter action_file_path CONTAINS '.dll'
| filter action_file_path NOT IN ('C:\\Windows\\System32\\', 'C:\\Windows\\SysWOW64\\')
| comp count() as events by actor_process_image_name, agent_hostname
| sort desc events

## VALIDATION — Signed Process DLL Injection Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name IN ('rundll32.exe', 'msiexec.exe')
| filter action_file_path CONTAINS '.dll'
| filter action_file_path NOT IN ('C:\\Windows\\System32\\', 'C:\\Windows\\SysWOW64\\')
| comp count() as cnt by actor_process_image_name, action_file_path
| comp count() as cnt by agent_hostname 

