# TTP-2026-0127 — BadSuccessor dMSA Privilege Escalation (Windows Server 2025) — Create + Dual-Attribute Write + Privileged-TGT Lineage ABIOC
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — ITDR-013 Write-Property 4662 On dMSA Object-Type By Non-Admin
# severity: high
# Deterministic audit-log catch: Windows Security event 4662 with access mask 0x20 (Write Property) against the msDS-DelegatedManagedServiceAccount object-type GUID 0feb936f-47b3-49f2-9386-1dedc2c23765, performed by a non-administrative subject. This is the direct signature of a low-privileged identity mutating dMSA attributes — the BadSuccessor write step — complementing the behavioral ABIOC with an evidence-grade rule keyed to the exact object type and access mask from the Unit 42 disclosure.

dataset = msft_windows_security
| filter event_id = 4662
| filter properties contains "0feb936f-47b3-49f2-9386-1dedc2c23765"
| filter access_mask = "0x20"
| filter subject_user_name not in ("Administrator", "SYSTEM")
| comp count() as write_property_events by host_name, subject_user_name, object_name
| filter write_property_events >= 1
| fields host_name, subject_user_name, object_name, write_property_events

## ABIOC — ITDR-013 dMSA Created Outside Managed Service Accounts Container By Non-Privileged Identity (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Learned identity baseline (never provisions managed-service accounts) -> the same identity creates a dMSA object outside the default CN=Managed Service Accounts container, anchored to the originating subject_logon_id.
# An identity whose learned Cortex profile never provisions managed-service accounts creates a delegated MSA (Security event 5137) outside the default CN=Managed Service Accounts container. The ABIOC anchors the deviation to the learned per-identity provisioning baseline rather than to any bad command — dMSA creation is a legitimate operation, so the catch comes from WHO is doing it and WHERE, the opening move of the BadSuccessor chain.

dataset = msft_windows_security
| filter event_id = 5137
| filter object_class = "msDS-DelegatedManagedServiceAccount"
| filter object_dn not contains "CN=Managed Service Accounts"
| filter subject_user_name not in ("Administrator", "SYSTEM")
| comp count() as dmsa_creations by host_name, subject_user_name, subject_logon_id, object_dn
| filter dmsa_creations >= 1
| fields host_name, subject_user_name, subject_logon_id, object_dn, dmsa_creations

## ABIOC — ITDR-013 dMSA Dual Privileged-Attribute Write Lineage In One Logon Session (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: dMSA creation event (5137) -> two privileged-attribute writes (State=2 + PrecededByLink to a DA distinguished name) under the same subject_logon_id within seconds, the create-and-modify lineage no legitimate migration exhibits from a non-admin identity.
# Within one logon session the acting identity writes BOTH msDS-DelegatedMSAState=2 (migration complete) and msDS-ManagedAccountPrecededByLink pointing at a privileged DN on the freshly created dMSA (two Security event 5136 records on GUIDs 2f5c138a-bd38-4016-88b4-0ec87cbb4919 and a0945b2b-57a2-43bd-b327-4d112a4e8bd1). The ABIOC fires on this create-and-modify LINEAGE — a genuine dMSA migration is performed by an administrator over time, not by a non-admin who just created the object seconds earlier — anchoring the two attribute writes to the same subject_logon_id as the creation.

dataset = msft_windows_security
| filter event_id = 5136
| filter attribute_ldap_display_name in ("msDS-DelegatedMSAState", "msDS-ManagedAccountPrecededByLink")
| filter (attribute_ldap_display_name = "msDS-DelegatedMSAState" and attribute_value = "2") or attribute_ldap_display_name = "msDS-ManagedAccountPrecededByLink"
| comp count_distinct(attribute_ldap_display_name) as attrs_written, values(attribute_value) as written_values by host_name, subject_logon_id, object_dn
| filter attrs_written >= 2
| fields host_name, subject_logon_id, object_dn, attrs_written, written_values

## VALIDATION — ITDR-013 Validate dMSA Creation Outside Managed Service Accounts Container
# purpose: validation
# dataset: msft_windows_security

dataset = msft_windows_security
| filter _time > to_timestamp(current_time() - 900)
| filter event_id = 5137
| filter object_class = "msDS-DelegatedManagedServiceAccount"
| filter object_dn not contains "CN=Managed Service Accounts"
| comp count() as dmsa_created by host_name, subject_user_name, object_dn
| filter dmsa_created >= 1
| fields host_name, subject_user_name, object_dn, dmsa_created

## VALIDATION — ITDR-013 Validate Dual Privileged-Attribute Write On dMSA
# purpose: validation
# dataset: msft_windows_security

dataset = msft_windows_security
| filter _time > to_timestamp(current_time() - 900)
| filter event_id = 5136
| filter attribute_ldap_display_name in ("msDS-DelegatedMSAState", "msDS-ManagedAccountPrecededByLink")
| comp count_distinct(attribute_ldap_display_name) as attrs by host_name, subject_logon_id
| filter attrs >= 2
| fields host_name, subject_logon_id, attrs

## VALIDATION — ITDR-013 Hunt dMSA Privileged TGT And Inherited-Privilege Logon
# purpose: hunt
# dataset: msft_windows_security

dataset = msft_windows_security
| filter _time > to_timestamp(current_time() - 3600)
| filter event_id in (2946, 4624)
| filter account_name = "websvc-dmsa$"
| comp count() as inherited_priv_events by host_name, account_name, event_id
| filter inherited_priv_events >= 1
| fields host_name, account_name, event_id, inherited_priv_events

