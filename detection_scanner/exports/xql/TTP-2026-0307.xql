# TTP-2026-0307 — Multiple Discovery Commands on Windows Host by Same Process
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Multiple Discovery Commands by Process
# severity: high
# Detection of multiple discovery commands executed by the same process

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ('cmd.exe', 'whoami.exe', 'net.exe', 'ipconfig.exe')
| comp count() as cnt by actor_process_image_name
| comp count() as cmd_count
| filter cmd_count > 3

## ABIOC — Multiple Discovery Commands Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name
# Detects a single process executing multiple discovery commands in sequence

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ('cmd.exe', 'whoami.exe', 'net.exe', 'ipconfig.exe')
| comp count() as cnt by actor_process_image_name
| comp count() as cmd_count
| filter cmd_count > 3

