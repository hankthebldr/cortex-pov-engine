# TTP-2026-0235 — Abnormal Login with Remote Command Execution
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unusual Login with PowerShell
# severity: high
# User login from abnormal country followed by PowerShell execution

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'svchost.exe'
| filter action_process_image_name = 'powershell.exe'
| filter causality_actor_process_image_name != 'explorer.exe'

## ABIOC — Anomalous Login with PowerShell Execution (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Unusual login from abnormal country
# Detection of login from abnormal ASN followed by PowerShell process start

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter causality_actor_process_image_name = 'svchost.exe'
| filter action_remote_ip in ('192.0.2.10')

## VALIDATION — Unusual Login with PowerShell
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter causality_actor_process_image_name = 'svchost.exe'
| filter action_remote_ip in ('192.0.2.10')

