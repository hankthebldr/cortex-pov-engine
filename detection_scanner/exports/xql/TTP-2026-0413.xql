# TTP-2026-0413 — Svchost.exe loads rare unsigned module via DllLoad
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Svchost loads rare unsigned module
# severity: high
# Detection of svchost.exe loading an unsigned module not typically seen in normal operations

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'svchost.exe'
| filter action_file_path contains '.dll'
| filter action_file_signature_status = 'unsigned'
| comp count() as events by actor_process_image_name, agent_hostname
| sort desc events

## ABIOC — Unusual svchost DLL load behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'svchost.exe'
# Behavioral deviation where svchost.exe loads an unsigned DLL not commonly seen in baseline

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'svchost.exe'
| filter action_file_path contains '.dll'
| filter action_file_signature_status = 'unsigned'
| comp count() as cnt by action_file_path
| filter count() > 1

## VALIDATION — Detect unsigned DLL load by svchost
