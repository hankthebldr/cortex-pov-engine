# TTP-2026-0325 — PowerShell Suspicious Flags Execution
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — PowerShell Suspicious Flags
# severity: high
# PowerShell process started with -WindowStyle Hidden and -EncodedCommand flags

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_image_name = 'powershell.exe'
| filter action_process_command_line contains '-WindowStyle Hidden' and action_process_command_line contains '-EncodedCommand'

## ABIOC — PowerShell Suspicious Command Line Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'powershell.exe'
# Detection of PowerShell process with suspicious command-line arguments indicating obfuscation and hidden execution

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_command_line contains '-WindowStyle Hidden' and action_process_command_line contains '-EncodedCommand'

## VALIDATION — PowerShell Suspicious Flags Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_command_line contains '-WindowStyle Hidden' and action_process_command_line contains '-EncodedCommand'
| fields agent_hostname, actor_process_image_name, action_process_command_line

