# TTP-2026-0344 — Signed Executable Delivery and Execution via PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rare signature signed executable executed in the network
# severity: high
# Detection of rare signed executable being executed within the network

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name contains '.exe'
| filter actor_process_image_name contains 'powershell.exe'
| filter action_file_path contains '/tmp/'

## ABIOC — Signed Executable Network Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Detection of signed executable execution followed by outbound network communication

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name contains '.exe'
| filter actor_process_image_name contains 'powershell.exe'
| filter action_file_path contains '/tmp/'
| join with network_events on action_process_image_name
| filter dst_ip = '192.0.2.10'

## VALIDATION — Signed Executable Network Activity
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name contains '.exe'
| filter actor_process_image_name contains 'powershell.exe'
| join with network_events on action_process_image_name
| filter dst_ip = '192.0.2.10'

