# TTP-2026-0439 — Uncommon Local Scheduled Task Creation via schtasks.exe
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Local Scheduled Task Creation
# severity: high
# Detection of a scheduled task created locally with schtasks.exe that is not commonly seen in the environment

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'schtasks.exe'
| filter action_command_line contains '/create'
| filter action_command_line contains '/tn'
| filter action_command_line contains '/tr'
| filter action_command_line contains 'powershell.exe'
| filter action_command_line contains 'Invoke-WebRequest'
| filter action_command_line contains '192.0.2.50'

## ABIOC — Uncommon Local Scheduled Task Creation via schtasks.exe (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: schtasks.exe process start with specific command line arguments
# Detection of a scheduled task created via schtasks.exe with a PowerShell command that downloads a binary from a test-net IP address

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'schtasks.exe'
| filter action_command_line contains '/create'
| filter action_command_line contains '/tn'
| filter action_command_line contains '/tr'
| filter action_command_line contains 'powershell.exe'
| filter action_command_line contains 'Invoke-WebRequest'
| filter action_command_line contains '192.0.2.50'

