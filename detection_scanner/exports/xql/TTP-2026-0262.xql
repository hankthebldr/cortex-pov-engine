# TTP-2026-0262 — Use of certutil to Decode and Execute Encoded Payload
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Encoded Information Using Certificate Management Tool
# severity: high
# Detection of certutil being used to decode base64 encoded data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'certutil.exe'
| filter action_file_path contains '-decode'

## ABIOC — Suspicious Certutil Usage with Decode Flag (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name = 'certutil.exe'
# Detects when certutil is used with the -decode flag, which is commonly used to decode base64 encoded files

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'certutil.exe'
| filter action_file_path contains '-decode'

## VALIDATION — Detect Certutil Decode Usage
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'certutil.exe'
| filter action_file_path contains '-decode'

