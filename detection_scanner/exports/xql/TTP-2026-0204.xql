# TTP-2026-0204 — Domain Credential Theft via ntdsutil Shadow Copy
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious Shadow Copy Creation with ntdsutil or vssadmin
# severity: high
# Detection of vssadmin or ntdsutil being used to create a shadow copy for credential theft

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter (actor_process_image_name = 'ntdsutil.exe' or actor_process_image_name = 'vssadmin.exe')
| filter action_process_command_line contains 'create shadow'
| filter action_process_command_line contains 'ntds'

## ABIOC — Suspicious dump of ntds.dit using Shadow Copy with ntdsutil or vssadmin (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Behavioral deviation indicating use of shadow copy to extract ntds.dit for credential theft

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'vssadmin.exe' or actor_process_image_name = 'ntdsutil.exe'
| filter action_process_command_line contains 'create shadow'
| filter action_process_command_line contains 'ntds'
| filter action_file_path contains '\\?\GLOBALROOT\Device\HarddiskVolumeShadowCopy'

## VALIDATION — Hunt for ntdsutil or vssadmin shadow copy creation
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter (actor_process_image_name = 'ntdsutil.exe' or actor_process_image_name = 'vssadmin.exe')
| filter action_process_command_line contains 'create shadow'
| filter action_process_command_line contains 'ntds'
| fields actor_process_image_name, action_process_command_line, action_file_path

