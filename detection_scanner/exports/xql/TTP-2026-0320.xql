# TTP-2026-0320 — Network Service Discovery via Command-Line Tools
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unusual Network Service Discovery Process Execution
# severity: high
# Detection of net.exe, nbtstat.exe, or netstat.exe execution from unexpected locations or with unusual arguments

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ('net.exe', 'nbtstat.exe', 'netstat.exe')
| filter actor_process_image_name not in ('explorer.exe', 'cmd.exe', 'powershell.exe')

## ABIOC — Suspicious Service Discovery Command-Line Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name
# Detection of process execution with service discovery commands in an unexpected context

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ('net.exe', 'nbtstat.exe', 'netstat.exe')
| filter actor_process_image_name not in ('cmd.exe', 'powershell.exe', 'explorer.exe')

## VALIDATION — Detect Network Discovery Tools
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ('net.exe', 'nbtstat.exe', 'netstat.exe')
| filter actor_process_image_name not in ('cmd.exe', 'powershell.exe', 'explorer.exe')
| comp count() by action_process_image_name, actor_process_image_name

