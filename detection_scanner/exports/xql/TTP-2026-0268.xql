# TTP-2026-0268 — DLLHost Execution with Empty Command Line
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Execution of dllhost.exe with empty command line
# severity: high
# Detection of dllhost.exe being executed with no arguments, which is highly suspicious and often used in malicious contexts.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'dllhost.exe' and action_process_command_line = ''

## ABIOC — Suspicious dllhost.exe execution with empty command line (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Behavioral deviation where dllhost.exe is executed without arguments, indicating a potential attempt at code execution or evasion.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'dllhost.exe' and action_process_command_line = ''

