# TTP-2026-0485 — Nginx Pod Command Execution via Malicious Script
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unusual Process Spawned by Nginx
# severity: high
# Detection of a process started by the Nginx binary that is not typical for ingress-nginx

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'nginx'
| filter action_process_image_name != 'nginx'
| filter action_process_image_name != 'bash'
| filter action_process_image_name != 'sh'
| filter action_process_image_name != 'sleep'
| filter action_process_image_name != 'curl'
| filter action_process_image_name != 'wget'

## ABIOC — Unusual Process Spawned by Nginx in Ingress Pod (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: ingress-nginx process spawning new process
# Behavioral deviation where a non-standard process is spawned by Nginx in an ingress pod context

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'nginx'
| filter causality_actor_process_image_name contains 'ingress-nginx'

## VALIDATION — Ingress Nginx Unusual Process Start
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'nginx'
| filter causality_actor_process_image_name contains 'ingress-nginx'
| filter action_process_image_name != 'nginx'
| filter action_process_image_name != 'bash'
| filter action_process_image_name != 'sh'
| filter action_process_image_name != 'sleep'

