# TTP-2026-0199 — Linux Identity Persistence — Sudo Backdoor Account, SSH Key and a Self-Expiring Systemd Timer
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — EDR-024 Local Account Created In Sudo Group By Root Shell
# severity: medium
# A shell runs useradd/adduser/usermod with a group list that includes sudo, wheel or admin. Matched read-only in the lab tenant 2026-11-11 against a real useradd -G sudo event on pov-target-01. Operator-installed: create this as a BIOC rule in the tenant with EXACTLY this name (the matcher's strongest key is alert name == card name), severity Medium, from the XQL below. CortexSim never writes it to the tenant. Category: persistence.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ("useradd", "adduser", "usermod")
| filter action_process_image_command_line ~= "(-G|--groups|-aG)[ =]?[^ ]*(sudo|wheel|admin)"
| filter actor_process_image_name in ("sh", "bash", "dash", "zsh", "python3", "perl")

## BIOC — EDR-024 SSH Authorized Keys Written For Local Account
# severity: medium
# A shell or file utility writes an authorized_keys file. sshd and ssh-copy-id are not in the actor list. Operator-installed: create this as a BIOC rule in the tenant with EXACTLY this name (the matcher's strongest key is alert name == card name), severity Medium, from the XQL below. CortexSim never writes it to the tenant. Category: persistence.

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_CREATE_NEW, ENUM.FILE_WRITE)
| filter action_file_path ~= "/[.]ssh/authorized_keys2?$"
| filter actor_process_image_name in ("sh", "bash", "dash", "zsh", "tee", "cp", "mv", "cat", "python3", "perl")

## BIOC — EDR-024 Systemd Unit Written Under etc systemd system By Shell
# severity: medium
# A shell or file utility (not the package manager) writes a .service or .timer unit under /etc, /lib or /usr/lib systemd/system. Operator-installed: create this as a BIOC rule in the tenant with EXACTLY this name (the matcher's strongest key is alert name == card name), severity Medium, from the XQL below. CortexSim never writes it to the tenant. Category: persistence.

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_CREATE_NEW, ENUM.FILE_WRITE)
| filter action_file_path ~= "^/(etc|lib|usr/lib)/systemd/system/[^/]+[.](service|timer)$"
| filter actor_process_image_name in ("sh", "bash", "dash", "zsh", "tee", "cp", "mv", "cat", "python3", "perl")

## BIOC — EDR-024 Systemd Service Runs Payload From Hidden Var Tmp Directory
# severity: medium
# A systemd-started process runs something from a dot-directory under /var/tmp. On systemd 255 the service's parent records as "9" with path /proc/self/fd/9; the actor clause was matched read-only in the lab tenant against the sysstat service's sa1 starts. Operator-installed: create this as a BIOC rule in the tenant with EXACTLY this name (the matcher's strongest key is alert name == card name), severity Medium, from the XQL below. CortexSim never writes it to the tenant. Category: persistence.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ("systemd", "9") or actor_process_image_path ~= "^/proc/self/fd/[0-9]+$"
| filter action_process_image_command_line ~= "/var/tmp/[.][^/ ]+/" or action_process_image_path ~= "^/var/tmp/[.]"

## BIOC — EDR-024 Immutable Attribute Set On Persistence Artifact
# severity: medium
# chattr +i on an SSH key, a systemd unit, a cron file or a hidden /var/tmp artefact — locking persistence in place. Operator-installed: create this as a BIOC rule in the tenant with EXACTLY this name (the matcher's strongest key is alert name == card name), severity Medium, from the XQL below. CortexSim never writes it to the tenant. Category: evasion.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = "chattr"
| filter action_process_image_command_line ~= "[+]i"
| filter action_process_image_command_line ~= "(authorized_keys|/etc/systemd/system/|/etc/cron|/var/tmp/[.])"

## ABIOC — Suspicious access to shadow file (behavioral-ML, causality-anchored)
# severity: low
# behavioral_profile: statistical
# causality_anchor: The unpopular process opening /etc/shadow (useradd, chpasswd) and its causality chain; how rarely that process touches shadow across the tenant decides whether it fires.
# PANW built-in XDR Analytics BIOC (Low; Low issues never create or join a case). Observed on pov-target-01 2026-11-11 (issues 1500417, 1500418) on useradd and chpasswd, mapped by the tenant to T1003. The name is the built-in alert name verbatim so the matcher keys on it. The logic below is an approximation of the trigger for hunting, not the built-in's code; it matched those lab events read-only.

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type = ENUM.FILE_OPEN
| filter action_file_path = "/etc/shadow"
| filter actor_process_image_name in ("useradd", "chpasswd", "usermod", "passwd")

## VALIDATION — EDR-024 Systemd Timer Foothold Fired After Boot
# purpose: hunt
# dataset: xdr_data

dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 86400
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ("systemd", "9") or actor_process_image_path ~= "^/proc/self/fd/[0-9]+$"
| filter action_process_image_command_line ~= "/var/tmp/[.][^/ ]+/"
| comp count() as runs, min(_time) as first_run, max(_time) as last_run by agent_hostname, agent_id
| fields agent_hostname, agent_id, runs, first_run, last_run

