# TTP-2026-0199 — Uncommon DLL Side-Loaded into Microsoft Process via Search-Order Hijack
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — A rare DLL signed by an uncommon vendor was hijacked into a Microsoft process
# severity: high
# Detection of a DLL with uncommon signing authority loaded into a Microsoft process via search-order hijack

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name contains 'Microsoft'
| filter action_file_path contains 'spool/drivers/color'
| filter action_file_path contains 'msvcr120.dll'
| filter action_file_path contains 'C:\\Windows\\System32\\spool\\drivers\\color\\msvcr120.dll'

