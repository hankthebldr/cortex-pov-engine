# TTP-2026-0340 — Rare Process Spawned by srvany.exe
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rare process spawned by srvany.exe
# severity: high
# Detection of a process launched directly by srvany.exe, which is not typical behavior

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name = 'srvany.exe'
| filter action_process_image_name != 'cmd.exe' and action_process_image_name != 'powershell.exe'
| filter not action_file_path contains 'Windows\\System32\\'

## ABIOC — Unusual Process Launch from srvany.exe (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: srvany.exe
# Detection of a non-standard process being launched from srvany.exe, indicating potential abuse of the service wrapper

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name = 'srvany.exe'
| filter not action_process_image_name in ('cmd.exe', 'powershell.exe', 'wmic.exe')

## VALIDATION — Detect srvany.exe launching non-standard processes
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name = 'srvany.exe'
| filter not action_process_image_name in ('cmd.exe', 'powershell.exe', 'wmic.exe')
| fields actor_process_image_name, action_process_image_name, causality_actor_process_image_name

