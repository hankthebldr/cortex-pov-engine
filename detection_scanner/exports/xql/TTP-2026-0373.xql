# TTP-2026-0373 — Service Execution via sc.exe
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious Service Creation
# severity: high
# Detection of service creation via sc.exe with suspicious binary path

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'sc.exe'
| filter action_file_path contains 'malware.exe'

## ABIOC — Unusual Service Execution via sc.exe (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: sc.exe process start with temp binary
# Behavioral deviation where sc.exe is used to start a new service with non-standard binary path

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'sc.exe'
| filter action_file_path contains 'temp\\'
| filter causality_actor_process_image_name != 'services.exe'

## VALIDATION — Detect Service Creation via sc.exe
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'sc.exe'
| filter action_file_path contains 'malware.exe'
| filter causality_actor_process_image_name = 'cmd.exe'

