# TTP-2026-0431 — Uncommon ODBCConf Execution for Lateral Movement
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon ODBCConf Execution
# severity: high
# Detection of odbcconf.exe execution with custom DllPath parameter

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'odbcconf.exe'
| filter action_process_command_line contains 'DllPath'

## ABIOC — ODBCConf Lateral Movement Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name = 'odbcconf.exe'
# Detection of unusual odbcconf.exe behavior with DLL loading from non-standard paths

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'odbcconf.exe'
| filter action_process_command_line contains 'DllPath'
| filter action_process_command_line contains 'kernel32.dll'

## VALIDATION — ODBCConf Process Start
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'odbcconf.exe'

