# TTP-2026-0398 — High Integrity Process Execution via Task Scheduler
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious Process Executed with High Integrity Level
# severity: high
# A process was started with SYSTEM integrity level that was initiated by a scheduled task

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'C:\\Windows\\System32\\schtasks.exe'
| filter action_process_integrity_level = ENUM.HIGH

## ABIOC — Unusual Scheduled Task Execution with Elevated Privileges (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'C:\\Windows\\System32\\schtasks.exe'
# Detection of scheduled task execution that results in a process with SYSTEM integrity level

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'C:\\Windows\\System32\\schtasks.exe'
| filter action_process_integrity_level = ENUM.HIGH

## VALIDATION — Detect High Integrity Process from Scheduled Task
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'C:\\Windows\\System32\\schtasks.exe'
