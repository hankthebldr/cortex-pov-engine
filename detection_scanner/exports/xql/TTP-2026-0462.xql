# TTP-2026-0462 — Uncommon WPAD Query Execution via PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon WPAD Query Process
# severity: high
# Detection of a process performing an uncommon WPAD query

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_image_name = 'powershell.exe'
| filter action_file_path contains 'wpad'

## ABIOC — Uncommon WPAD Query Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: powershell.exe initiating network connection to C2 server
# Behavioral deviation of PowerShell querying WPAD settings in an uncommon context

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter dst_port = 80
| filter dst_ip = '192.0.2.50'
| filter action_process_image_name = 'powershell.exe'
| filter action_file_path contains 'wpad'

## VALIDATION — Detect WPAD Query from PowerShell
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter dst_port = 80
| filter action_process_image_name = 'powershell.exe'
| filter action_file_path contains 'wpad'

