# TTP-2026-0309 — Rare Process Execution Chain via PowerShell and WMI
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Multiple Rare Process Executions in Organization
# severity: high
# Detection of multiple rare processes being executed in a short time window within the organization

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe' or actor_process_image_name = 'wmic.exe'
| comp count() as cnt by agent_hostname, action_process_image_name
| comp count() as cnt by
| filter count > 1

## ABIOC — Unusual PowerShell and WMI Execution Sequence (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: powershell.exe -> wmic.exe
# Behavioral deviation indicating rare sequence of PowerShell followed by WMI process execution

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe' and action_process_image_name = 'wmic.exe'
| comp count() as cnt by agent_hostname
| comp count() as cnt by
| filter count > 1

## VALIDATION — PowerShell to WMI Execution Chain
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe' and action_process_image_name = 'wmic.exe'
| comp count() as cnt by agent_hostname, actor_process_image_name
| comp count() as cnt by
| filter count > 1

