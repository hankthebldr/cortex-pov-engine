# TTP-2026-0208 — Windows Endpoint: Hidden File Attribute Set via attrib Command
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Process Start with attrib Command
# severity: high
# Detection of the 'attrib' process execution with arguments that set hidden and system flags

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name contains 'attrib.exe'
| filter action_process_command_line contains '+h' and action_process_command_line contains '+s'

## ABIOC — Hidden Attribute Set Using attrib (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name
# Detection of file attribute changes using attrib command that sets hidden and system flags

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type = ENUM.FILE_ATTRIBUTE_CHANGED
| filter action_file_attributes contains 'HIDDEN'
| filter action_process_image_name contains 'attrib.exe'

## VALIDATION — Detect Hidden File Attribute Changes
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type = ENUM.FILE_ATTRIBUTE_CHANGED
| filter action_file_attributes contains 'HIDDEN'
| filter action_process_image_name contains 'attrib.exe'
| fields agent_hostname, action_file_path, action_file_attributes, action_process_image_name

