# TTP-2026-0322 — NAA Account Credential Extraction via SCCM
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — PowerShell Hidden Execution
# severity: high
# Detection of PowerShell process started with -w hidden flag

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe' and action_process_image_name = 'powershell.exe'
| filter action_process_command_line contains '-w hidden'

## ABIOC — SCCM Credential Extraction via PowerShell (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'powershell.exe'
# Behavioral deviation detecting PowerShell script executing SCCM credential retrieval commands

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_command_line contains 'Get-SCCMCredentials' or action_process_command_line contains 'Invoke-SCCMQuery'

## VALIDATION — SCCM Credential Access Detection
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_command_line contains 'Get-SCCMCredentials' or action_process_command_line contains 'Invoke-SCCMQuery'
| fields actor_process_image_name, action_process_command_line, agent_hostname

