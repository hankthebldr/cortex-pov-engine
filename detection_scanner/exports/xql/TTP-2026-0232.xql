# TTP-2026-0232 — Disabling Windows Security Services via Command Line
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Service Disabled via Sc Command
# severity: high
# Detection of service disablement using the sc.exe utility

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'sc.exe' and action_file_path contains 'config' and action_file_path contains 'start= disabled'

## ABIOC — Security Service Disablement Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Behavioral deviation indicating disabling of system security services

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'sc.exe' and action_file_path contains 'config' and action_file_path contains 'start= disabled'

## VALIDATION — Detect Service Disable Commands
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'sc.exe' and action_file_path contains 'config' and action_file_path contains 'start= disabled'

