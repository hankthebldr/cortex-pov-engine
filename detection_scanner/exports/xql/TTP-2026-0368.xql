# TTP-2026-0368 — Rundll32.exe spawns conhost.exe via malicious DLL
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rundll32 spawns conhost
# severity: high
# Detection of rundll32.exe spawning conhost.exe process

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'rundll32.exe' and action_process_image_name = 'conhost.exe'

## ABIOC — Suspicious Rundll32 to Conhost Chain (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: rundll32.exe process start
# Behavioral deviation where rundll32.exe spawns conhost.exe without typical user interaction

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'rundll32.exe' and action_process_image_name = 'conhost.exe'
| filter causality_actor_process_image_name != 'explorer.exe'

## VALIDATION — Detect Rundll32 spawning conhost
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'rundll32.exe' and action_process_image_name = 'conhost.exe'
| comp count() by actor_process_image_name, action_process_image_name

