# TTP-2026-0450 — Uncommon RDP Connection via mstsc.exe
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon RDP Connection
# severity: high
# Detection of RDP connection to an IP not typically seen in the environment

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_process_image_name = 'mstsc.exe'
| filter dst_port = 3389
| filter action_remote_ip != '192.0.2.0/24'
| filter action_remote_ip != '10.0.0.0/8'
| filter action_remote_ip != '172.16.0.0/12'
| filter action_remote_ip != '127.0.0.0/8'
| filter action_remote_ip != '169.254.0.0/16'

## ABIOC — RDP Connection From Unknown Host (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: mstsc.exe process start
# RDP connection initiated from a host that does not typically make such connections

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_process_image_name = 'mstsc.exe'
| filter dst_port = 3389
| filter causality_actor_process_image_name != 'explorer.exe'
| filter causality_actor_process_image_name != 'svchost.exe'

## VALIDATION — Detect RDP Connections to Non-Standard IPs
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_process_image_name = 'mstsc.exe'
| filter dst_port = 3389
| filter action_remote_ip != '192.0.2.0/24'
| filter action_remote_ip != '10.0.0.0/8'
| filter action_remote_ip != '172.16.0.0/12'
| filter action_remote_ip != '127.0.0.0/8'
| filter action_remote_ip != '169.254.0.0/16'

