# TTP-2026-0137 — TeamPCP Weaponized-Scanner Supply Chain — CI Runner /proc Memory Scrape to Cloud-Cred Theft to K8s DaemonSet Cluster-Brick
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — MP-018 CI-Runner Weaponized-Scanner Action Spawns Credential-Harvest Child
# severity: high
# The process_lineage root. A trusted CI security scanner (trivy / kics) is the Causality Group Owner, but instead of only running the scan it spawns a bash/python child (kamikaze.sh / kube.py) that immediately touches credential surfaces. The BIOC keys on causality_actor_process_image_name + causality_actor_process_instance_id (the CGO = the scanner action, running as the runner account) AND on the unexpected interpreter child, so the harvest binds to the SAME weaponized-action foothold rather than an incidental build subprocess. This is the anchor the F-chain correlation opens on.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name in ("trivy", "kics", "trivy-action") and actor_effective_username = "runner"
| filter action_process_image_name in ("bash", "sh", "python", "python3", "curl") or action_process_command_line contains "kamikaze" or action_process_command_line contains "kube.py"
| comp min(_time) as first_spawn, count() as child_spawns by agent_hostname, causality_actor_process_image_name, causality_actor_process_instance_id, causality_id, action_process_image_name
| filter child_spawns >= 1
| fields agent_hostname, causality_actor_process_image_name, causality_actor_process_instance_id, causality_id, action_process_image_name, first_spawn, child_spawns

## BIOC — MP-018 /proc PID mem Scrape of runner.worker Bypasses GitHub Secret Masking
# severity: high
# The shared_entity pivot on the runner PID. The weaponized action's child opens /proc/<pid>/mem of the Runner.Worker process and reads it, lifting plaintext PATs and cloud tokens straight from RAM — GitHub's secret masking only redacts log output, never memory. The BIOC keys on causality_actor_process_* (still the scanner CGO) AND an action_file_path under /proc that ends in /mem, tying the memory scrape into the same causality chain as the child-spawn above.

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_OPEN, ENUM.FILE_READ)
| filter action_file_path contains "/proc/" and action_file_path contains "/mem"
| filter causality_actor_process_image_name in ("trivy", "kics", "bash", "python", "python3") or action_process_command_line contains "runner.worker" or action_process_command_line contains "Runner.Worker"
| comp min(_time) as first_scrape, count() as mem_reads by agent_hostname, causality_actor_process_image_name, causality_actor_process_instance_id, causality_id, actor_process_image_name, action_file_path
| filter mem_reads >= 1
| fields agent_hostname, causality_actor_process_image_name, causality_actor_process_instance_id, causality_id, actor_process_image_name, action_file_path, first_scrape, mem_reads

## BIOC — MP-018 Privileged DaemonSet Applied from Compromised CI Credentials
# severity: critical
# The exposure_exploit pivot. Using the stolen cluster-admin secrets, kube.py creates a privileged DaemonSet (CanisterWorm's destructive stager), guaranteeing a pod with a host-mount and privileged securityContext lands on every node. The BIOC keys on a k8s-audit create of a daemonsets object whose pod spec requests privileged: true or a hostPath mount, from a user-agent / service account consistent with the compromised CI runner.

dataset = cloud_audit_logs
| filter cloud_provider = "kubernetes" and event_operation = "create" and resource_type = "daemonsets"
| filter request_body contains "\"privileged\":true" or request_body contains "hostPath" or request_body contains "/host"
| comp min(_time) as first_apply, count() as daemonset_applies by cluster_name, resource_namespace, identity_name, user_agent
| filter daemonset_applies >= 1
| fields cluster_name, resource_namespace, identity_name, user_agent, first_apply, daemonset_applies

## ABIOC — MP-018 Kubernetes Secrets Enumeration Burst from CI-Runner Process (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Learned per-runner baseline of distinct kube-apiserver secret-path requests originating from the causality_actor_process (the CI scanner action CGO); the ABIOC fires on the sudden fan-out of /api/v1/namespaces/*/secrets calls from one runner-owned process.
# The endpoint_network_stitch that pivots ANALYTICS<->CDR. kube.py uses the harvested service-account token to sweep the Kubernetes control plane — /api/v1/namespaces, /api/v1/nodes, and repeatedly /api/v1/namespaces/*/secrets — producing a burst of kube-apiserver connections from a single CI-runner-owned process that no legitimate scanner emits. The ABIOC anchors its deviation on the causality_actor_process (the scanner CGO) and learns the per-runner baseline of distinct kube-apiserver secret-path requests, flagging the sudden fan-out; keeping the causality actor in the group binds the network burst back to the same weaponized-action chain rather than treating it as anonymous API traffic.

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_CONNECTION
| filter action_remote_port in (6443, 443, 8443) and (action_process_command_line contains "/api/v1/" or dns_query_name contains "kubernetes.default" or action_remote_ip = "10.96.0.1")
| filter causality_actor_process_image_name in ("trivy", "kics", "python", "python3") and actor_effective_username = "runner"
| comp count() as apiserver_calls, count_distinct(action_process_command_line) as distinct_paths by agent_hostname, causality_actor_process_image_name, causality_actor_process_instance_id, causality_id
| filter apiserver_calls >= 4 and distinct_paths >= 2
| fields agent_hostname, causality_actor_process_image_name, causality_actor_process_instance_id, causality_id, apiserver_calls, distinct_paths

## ABIOC — MP-018 Recursive Destructive Wipe Across Cluster Nodes (behavioral-ML, causality-anchored)
# severity: critical
# behavioral_profile: machine-learning
# causality_anchor: Learned per-host baseline of file-removal / truncate volume; the ABIOC fires on the anomalous recursive deletion sweep spawned inside a privileged container, keyed on the causality_actor_process of the DaemonSet pod.
# The exploit_impact terminal. The privileged DaemonSet pods execute a recursive destructive wipe against the mounted host filesystems to brick the cluster (or recursive file deletion on non-containerized hosts). The ABIOC learns the normal per-host rate of file-unlink / truncate operations and flags the anomalous high-volume recursive deletion sweep, anchored on the process that a privileged container spawned — the causality chain distinguishing a wiper from a routine cleanup job.

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_REMOVE, ENUM.FILE_WRITE)
| filter action_process_image_name in ("rm", "dd", "shred", "find", "busybox") or action_process_command_line contains "rm -rf" or action_process_command_line contains "dd if=/dev/zero"
| filter causality_actor_process_causality_type = "container" or actor_process_image_name = "runc" or action_process_command_line contains "/host"
| comp count() as destructive_ops by agent_hostname, causality_actor_process_image_name, causality_actor_process_instance_id, causality_id
| filter destructive_ops >= 50
| fields agent_hostname, causality_actor_process_image_name, causality_actor_process_instance_id, causality_id, destructive_ops

## VALIDATION — MP-018 CI Runner Steals Cloud IAM Credentials via IMDS 169.254.169.254
# purpose: hunt
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = "169.254.169.254"
| filter causality_actor_process_image_name in ("trivy", "kics", "bash", "sh", "python", "python3", "curl") and actor_effective_username = "runner"
| filter action_process_command_line contains "security-credentials" or action_process_command_line contains "meta-data/iam" or action_process_command_line = null
| comp min(_time) as first_imds, count() as imds_hits by agent_hostname, causality_actor_process_image_name, causality_actor_process_instance_id, causality_id, actor_effective_username
| filter imds_hits >= 1
| sort desc imds_hits
| fields agent_hostname, causality_actor_process_image_name, causality_actor_process_instance_id, causality_id, actor_effective_username, first_imds, imds_hits

## VALIDATION — MP-018 Supply-Chain CI Compromise Chain Observed
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter _time > to_timestamp(current_time() - 1200)
| filter causality_actor_process_image_name in ("trivy", "kics") and actor_effective_username = "runner"
| filter action_process_image_name in ("bash", "sh", "python", "python3", "curl") or action_file_path contains "/proc/" or action_remote_ip = "169.254.169.254"
| comp count() as chain_events, count_distinct(event_sub_type) as distinct_stages by agent_hostname, causality_id
| filter chain_events >= 1
| fields agent_hostname, causality_id, chain_events, distinct_stages

