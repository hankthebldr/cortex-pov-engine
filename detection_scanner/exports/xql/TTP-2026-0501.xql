# TTP-2026-0501 — Suspicious Container Orchestration Job Execution
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious Orchestration Job Execution
# severity: high
# Detection of a process starting with download and execution of a binary in a temporary directory

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'wget' and action_process_image_name = '/tmp/extracted/malware'
| filter causality_actor_process_image_name = 'bash'

## ABIOC — Suspicious Temp Directory Job Execution (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'wget' and action_process_image_name = '/tmp/extracted/malware'
# Detection of process execution from a temporary directory with download and execution behavior

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name contains '/tmp/' and actor_process_image_name = 'wget'
| filter causality_actor_process_image_name = 'bash'

## VALIDATION — Orchestration Job Process Behavior
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name contains '/tmp/' and actor_process_image_name = 'wget'
| filter causality_actor_process_image_name = 'bash'
| comp count() as cnt by action_process_image_name, actor_process_image_name, causality_actor_process_image_name

