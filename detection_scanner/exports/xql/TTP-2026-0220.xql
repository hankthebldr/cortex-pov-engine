# TTP-2026-0220 — Suspicious curl beacon with empty User-Agent to rare C2 host
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious curl user agent
# severity: high
# Detection of curl process making outbound connections with empty or suspicious User-Agent header

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = '/tmp/scratch/curl_sample'
| filter action_process_image_name = '/usr/bin/curl'
| filter action_remote_ip = '192.0.2.10'
| filter action_file_path = '/tmp/scratch/curl_sample'

## ABIOC — Suspicious curl user agent (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: curl process starting with empty User-Agent header
# Behavioral deviation modeling curl beaconing with empty User-Agent header to rare C2 host

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.10'
| filter dst_port = 8080
| filter action_process_image_name = '/usr/bin/curl'
| filter action_file_path = '/tmp/scratch/curl_sample'
| filter actor_process_image_name = '/tmp/scratch/curl_sample'

## VALIDATION — Curl beacon with empty User-Agent
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.10'
| filter dst_port = 8080
| filter action_process_image_name = '/usr/bin/curl'
| filter action_file_path = '/tmp/scratch/curl_sample'
| filter actor_process_image_name = '/tmp/scratch/curl_sample'
| filter action_user_agent = ''

