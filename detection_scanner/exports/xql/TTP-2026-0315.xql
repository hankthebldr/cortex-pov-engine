# TTP-2026-0315 — DLL Hijack into Microsoft Process via Malicious DLL Loading
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious DLL Load from System32
# severity: high
# Detects a process loading a DLL from the Windows System32 directory that is not part of the expected Microsoft process behavior

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'C:\\Windows\\System32\\svchost.exe'
| filter action_file_path contains 'System32\\temp\\legit.dll'

## ABIOC — Unusual DLL Load Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Detects an unexpected DLL load behavior from a Microsoft process that is not part of normal system operation

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'C:\\Windows\\System32\\svchost.exe'
| filter action_file_path contains 'System32\\temp\\legit.dll'
| filter causality_actor_process_image_name = 'C:\\Windows\\System32\\svchost.exe'

## VALIDATION — Process Loading Suspicious DLL
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'C:\\Windows\\System32\\svchost.exe'
| filter action_file_path contains 'System32\\temp\\legit.dll'
| comp count() by actor_process_image_name, action_file_path

