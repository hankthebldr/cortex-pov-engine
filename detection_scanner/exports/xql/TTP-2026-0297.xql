# TTP-2026-0297 — Malicious HTML Application Execution via CMD/PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Microsoft HTML Application Host spawns from CMD or PowerShell
# severity: high
# Detection of mshta.exe being launched directly from cmd.exe or powershell.exe without intermediate parent processes

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'mshta.exe'
| filter causality_actor_process_image_name in ('cmd.exe', 'powershell.exe')

## ABIOC — Unusual mshta execution from shell context (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: causality_actor_process_image_name
# Behavioral deviation where mshta.exe is executed directly from shell without typical user interaction patterns

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'mshta.exe'
| filter causality_actor_process_image_name in ('cmd.exe', 'powershell.exe')
| filter not (action_process_image_name contains 'explorer.exe' or action_process_image_name contains 'svchost.exe')

## VALIDATION — Detect mshta from shell
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'mshta.exe'
| filter causality_actor_process_image_name in ('cmd.exe', 'powershell.exe')
| fields agent_hostname, actor_process_image_name, action_process_image_name, causality_actor_process_image_name

