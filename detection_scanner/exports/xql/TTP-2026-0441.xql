# TTP-2026-0441 — Windows PowerShell-based C2 Communication with Rare External Host
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon PowerShell Process Communication
# severity: high
# PowerShell process spawning child processes and connecting to rare external IP

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_remote_ip in ('192.0.2.101')
| filter action_process_image_name = 'powershell.exe'

## ABIOC — Rare External Host Communication via PowerShell (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'powershell.exe'
# Behavioral deviation of PowerShell process communicating with rare external host

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip in ('192.0.2.101')
| filter actor_process_image_name = 'powershell.exe'

## VALIDATION — PowerShell Process to Rare IP
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter actor_process_image_name = 'powershell.exe'
| filter action_remote_ip in ('192.0.2.101')

