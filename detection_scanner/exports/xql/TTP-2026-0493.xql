# TTP-2026-0493 — Wscript/Cscript loads .NET DLLs via PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Wscript/Cscript loads .NET DLL
# severity: high
# Detection of wscript.exe or cscript.exe loading .NET DLLs

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ('wscript.exe', 'cscript.exe')
| filter action_file_path contains '.dll'
| filter action_file_path contains '.NET'

## ABIOC — Suspicious .NET DLL Load via Script Host (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'wscript.exe' or 'cscript.exe'
# Behavioral deviation where script hosts (wscript/cscript) load .NET DLLs from non-standard paths

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ('wscript.exe', 'cscript.exe')
| filter action_file_path contains '.dll'
| filter action_file_path not in ('C:\\Windows\\Microsoft.NET\\', 'C:\\Windows\\System32\\')

## VALIDATION — Detect .NET DLL Load by Script Host
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ('wscript.exe', 'cscript.exe')
| filter action_file_path contains '.dll'
| filter action_file_path contains '.NET'
| comp count() by actor_process_image_name, action_file_path

