# TTP-2026-0210 — Scheduled Task Executes mshta with Remote Payload
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon LOLBin Execution by Scheduled Task
# severity: high
# Detection of mshta.exe being executed by a scheduled task with a remote URL argument

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'mshta.exe'
| filter actor_process_image_name = 'schtasks.exe'
| filter action_file_path contains 'http://'
| filter causality_actor_process_image_name = 'svchost.exe'

