# TTP-2026-0490 — Windows CGO with Anomalous Actor Process Behavior
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious PowerShell Execution
# severity: high
# PowerShell process starts with hidden window and downloads file from external IP

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter process_command_line contains 'Hidden' and process_command_line contains 'DownloadFile'
| filter action_remote_ip = '192.0.2.50'

## ABIOC — Anomalous CGO Process Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name
# PowerShell process performs suspicious download and execution without user interaction

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_file_path = 'C:\temp\malware.exe'
| filter action_remote_ip = '192.0.2.50'
| filter process_command_line contains 'Hidden' and process_command_line contains 'DownloadFile'
| filter causality_actor_process_image_name = 'powershell.exe'

## VALIDATION — Detect Suspicious PowerShell Activity
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter process_command_line contains 'DownloadFile'
| filter action_remote_ip = '192.0.2.50'

