# TTP-2026-0451 — Uncommon Recurring Rare External Host Access via PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Recurring Rare External Host Access
# severity: high
# Detection of process accessing rare external IP address repeatedly

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| comp count() as events by actor_process_image_name, agent_hostname
| sort desc events

## ABIOC — Rare External Host Access via PowerShell (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_remote_ip
# Behavioral deviation of PowerShell accessing uncommon external IP address

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECT
| filter actor_process_image_name = 'powershell.exe'
| comp count() as events by actor_process_image_name, agent_hostname
| sort desc events

## VALIDATION — Detect Rare External Host Access
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECT
| filter actor_process_image_name = 'powershell.exe'
| comp count() as events by actor_process_image_name, agent_hostname
| sort desc events

