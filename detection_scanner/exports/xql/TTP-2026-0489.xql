# TTP-2026-0489 — Web Server CGO Executes Uncommon Process via PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon PowerShell Execution from Web Server
# severity: high
# Detection of PowerShell process started by a web server process (w3wp.exe)

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'w3wp.exe' and action_process_image_name = 'powershell.exe'
| filter action_process_command_line contains 'powershell.exe' and action_process_command_line contains '-EncodedCommand'

## ABIOC — CGO Web Server Executes PowerShell with Encoded Command (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'w3wp.exe'
# Behavioral deviation where a web server process spawns PowerShell with encoded command line arguments

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'w3wp.exe' and action_process_image_name = 'powershell.exe'
| filter action_process_command_line contains '-EncodedCommand' and action_process_command_line contains 'http://192.0.2.50'

## VALIDATION — Detect PowerShell from Web Server
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'w3wp.exe' and action_process_image_name = 'powershell.exe'
| filter action_process_command_line contains '-EncodedCommand'

