# TTP-2026-0290 — LDAP Traffic from Non-Standard Process
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — LDAP traffic from non-standard process
# severity: high
# Detects LDAP traffic initiated by a process not typically associated with LDAP operations

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter dst_port = 389
| filter actor_process_image_name != 'lsass.exe' and actor_process_image_name != 'dllhost.exe'
| filter action_remote_ip != '192.0.2.10'

## ABIOC — Non-standard LDAP process behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name
# Behavioral deviation where a non-standard process initiates LDAP traffic

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter dst_port = 389
| filter actor_process_image_name != 'lsass.exe'
| filter actor_process_image_name != 'dllhost.exe'
| filter actor_process_image_name != 'svchost.exe'

## VALIDATION — Detect LDAP traffic from non-standard process
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter dst_port = 389
| filter actor_process_image_name != 'lsass.exe' and actor_process_image_name != 'dllhost.exe'
| comp count() by actor_process_image_name

