# TTP-2026-0313 — Phantom DLL Loading via Process Hollowing
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Phantom DLL Loading Behavior
# severity: high
# Detection of a legitimate process accessing a suspicious DLL file path

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'svchost.exe'
| filter action_file_path contains 'inject.dll'
| filter causality_actor_process_image_name = 'svchost.exe'

