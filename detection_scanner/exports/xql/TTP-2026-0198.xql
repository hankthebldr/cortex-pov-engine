# TTP-2026-0198 — Masquerading Malware Dropping svchost.exe/lsass.exe in Non-System Path
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Process Masquerading as svchost.exe
# severity: high
# A process named svchost.exe is started from a non-system directory

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'svchost.exe'
| filter action_file_path != 'C:\\Windows\\System32\\svchost.exe'
| filter causality_actor_process_image_name != 'svchost.exe'

## ABIOC — A process is masquerading as a common Microsoft product (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name
# Detection of a process masquerading as a common Microsoft product such as svchost.exe or lsass.exe

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ('svchost.exe', 'lsass.exe')
| filter action_file_path not in ('C:\\Windows\\System32\\svchost.exe', 'C:\\Windows\\System32\\lsass.exe')

## VALIDATION — Detect Masquerading svchost.exe Process
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'svchost.exe'
| filter action_file_path != 'C:\\Windows\\System32\\svchost.exe'
| fields actor_process_image_name, action_process_image_name, action_file_path

