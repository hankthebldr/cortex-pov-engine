# TTP-2026-0198 — Linux Cron Foothold — WildFire Test ELF Dropper Re-Executed on a Schedule
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — EDR-023 Cron Drop-In Written By Shell Outside Package Manager
# severity: medium
# A shell or file utility (not dpkg/apt) creates or writes a file under /etc/cron.* or the cron spool. Package installs write these through the package manager; a shell writing one is an operator planting persistence. Operator-installed: create this as a BIOC rule in the tenant with EXACTLY this name (the matcher's strongest key is alert name == card name), severity Medium, from the XQL below. CortexSim never writes it to the tenant. Category: persistence.

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_CREATE_NEW, ENUM.FILE_WRITE)
| filter action_file_path ~= "^/etc/cron[.](d|hourly|daily|weekly|monthly)/" or action_file_path ~= "^/var/spool/cron/"
| filter actor_process_image_name in ("sh", "bash", "dash", "zsh", "tee", "cp", "mv", "cat", "python3", "perl")

## BIOC — EDR-023 Cron Runs Payload From Hidden Var Tmp Directory
# severity: medium
# cron itself spawns a command that runs something from a dot-directory under /var/tmp. Fires on every re-execution of the foothold, and only on cron's direct child, so it raises one issue per cron run. Operator-installed: create this as a BIOC rule in the tenant with EXACTLY this name (the matcher's strongest key is alert name == card name), severity Medium, from the XQL below. CortexSim never writes it to the tenant. Category: persistence.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = "cron"
| filter action_process_image_command_line ~= "/var/tmp/[.][^/ ]+/"

## BIOC — EDR-023 Persistence Artifact Timestomped With Touch Reference
# severity: medium
# touch with -r, -t or -d (or --reference / --date) rewrites the timestamps of a cron file, a systemd unit or a hidden /var/tmp artefact. Operator-installed: create this as a BIOC rule in the tenant with EXACTLY this name (the matcher's strongest key is alert name == card name), severity Medium, from the XQL below. CortexSim never writes it to the tenant. Category: evasion.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = "touch"
| filter action_process_image_command_line ~= "[ ]-(r|t|d)[ ]" or action_process_image_command_line ~= "--(reference|date)"
| filter action_process_image_command_line ~= "(/etc/cron|/etc/systemd/system/|/var/tmp/[.])"

## ABIOC — UNIX LOLBIN process connected to a rare external host (behavioral-ML, causality-anchored)
# severity: low
# behavioral_profile: statistical
# causality_anchor: The process making the connection (curl) and its causality chain; rarity of the destination across the tenant decides whether it fires.
# PANW built-in XDR Analytics BIOC (Low; Low issues never create or join a case). Observed on pov-target-01 2026-11-11 as issue 1500447, raised by SIM-CDR-012's curl of the same WildFire URL. The name is the built-in alert name verbatim so the matcher keys on it. The logic below is an approximation of the trigger for hunting, not the built-in's code.

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_STREAM_CONNECT
| filter actor_process_image_name in ("curl", "wget")
| filter action_external_hostname != null

## VALIDATION — EDR-023 WildFire Test ELF Retrieved Into Hidden Var Tmp Directory
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 3600
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = "curl" and action_process_image_command_line contains "wildfire.paloaltonetworks.com/publicapi/test/elf"
| filter action_process_image_command_line ~= "/var/tmp/[.][^/ ]+/"
| fields _time, agent_hostname, actor_causality_id, actor_process_image_name, action_process_image_command_line

## VALIDATION — EDR-023 Dropped ELF Executed From Hidden Var Tmp Directory
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 3600
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_path ~= "^/var/tmp/[.][^/]+/"
| fields _time, agent_hostname, actor_causality_id, causality_actor_process_image_name, action_process_image_path, action_process_image_sha256

## VALIDATION — EDR-023 Cron Foothold Re-Executions Across A Reboot
# purpose: hunt
# dataset: xdr_data

dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 86400
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = "cron" and action_process_image_command_line ~= "/var/tmp/[.][^/ ]+/"
| comp count() as runs, min(_time) as first_run, max(_time) as last_run by agent_hostname, agent_id
| fields agent_hostname, agent_id, runs, first_run, last_run

