# TTP-2026-0525 — Offensive Tooling: pypykatz (adapter-deployed)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Pypykatz Executed by a Service Account on the Endpoint
# severity: high
# A non-interactive service account runs pypykatz — an offensive TOOL-PYPYKATZ-wired tool not part of normal operations on this host.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name contains "pypykatz.exe" or action_process_command_line contains "pypykatz"
| comp count() as runs by agent_hostname, actor_effective_username
| filter runs >= 1

## ABIOC — First-Seen Execution of pypykatz on This Host (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: adapter deploy/stage of pypykatz -> first execution by a service-account shell
# A host that has never run pypykatz executes it shortly after it is staged/installed — the deploy-then-run chain of an offensive tool.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_command_line contains "pypykatz"
| comp count() as first_runs by agent_hostname

## VALIDATION — Pypykatz Execution Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_command_line contains "pypykatz"
| fields agent_hostname, actor_effective_username, action_process_image_name, action_process_command_line

