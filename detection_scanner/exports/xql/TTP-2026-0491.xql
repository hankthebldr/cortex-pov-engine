# TTP-2026-0491 — Windows LOLBIN connected to rare external host
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — LOLBIN Process with Rare Network Connection
# severity: high
# Detection of a LOLBIN process initiating a network connection to an IP address not commonly seen in the environment.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ('powershell.exe', 'wmic.exe', 'rundll32.exe')
| filter action_remote_ip not in (known_ips)
| filter action_remote_ip != '127.0.0.1'
| filter action_remote_ip != '::1'
| filter dst_port = 80 or dst_port = 443

## ABIOC — PowerShell LOLBIN connecting to rare external host (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'powershell.exe' and action_remote_ip = '192.0.2.100'
# Behavioral deviation where a PowerShell process initiates a network connection to a rare external IP address, indicating potential command and control communication.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_remote_ip not in (known_ips)
| filter action_remote_ip != '127.0.0.1'
| filter action_remote_ip != '::1'
| filter dst_port = 80 or dst_port = 443

