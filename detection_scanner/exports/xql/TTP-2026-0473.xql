# TTP-2026-0473 — Unusual ADFS Remote Synchronization from Non-ADFS Server
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unusual ADFS Sync Process
# severity: high
# Detection of PowerShell process starting from non-ADFS server attempting ADFS sync

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter causality_actor_process_image_name != 'lsass.exe'
| filter action_file_path contains 'adfs'

## ABIOC — ADFS Remote Sync from Non-ADFS Host (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: non-adfs host initiating adfs sync
# Behavioral deviation when a non-ADFS server initiates ADFS synchronization

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.10'
| filter causality_actor_process_image_name != 'lsass.exe'
| filter action_file_path contains 'adfs'

## VALIDATION — Unusual ADFS Sync Network Activity
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.10'
| filter causality_actor_process_image_name != 'lsass.exe'
| filter action_file_path contains 'adfs'
| comp count by agent_hostname, action_remote_ip

