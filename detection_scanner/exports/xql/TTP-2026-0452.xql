# TTP-2026-0452 — Uncommon Remote Monitoring Tool Execution via PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Remote Monitoring Tool Execution
# severity: high
# Detection of execution of PsExec or similar tools from non-standard locations

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'psexec.exe' and actor_process_image_name = 'powershell.exe'
| filter action_file_path contains 'Temp' or action_file_path contains 'Windows\\System32'

## ABIOC — Suspicious PowerShell Process Launching Remote Tool (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'powershell.exe'
# Behavioral deviation where PowerShell launches an uncommon remote monitoring tool from Temp directory

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe' and action_process_image_name = 'psexec.exe'
| filter action_file_path contains 'Temp'

## VALIDATION — Detect PsExec Execution from Temp Directory
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'psexec.exe' and action_file_path contains 'Temp'
| filter actor_process_image_name = 'powershell.exe'

