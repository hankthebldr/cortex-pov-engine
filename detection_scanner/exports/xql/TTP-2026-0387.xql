# TTP-2026-0387 — External RDP Login with Credential Harvesting
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — External RDP Login
# severity: high
# Detection of RDP login from external IP address

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECTION_ESTABLISHED
| filter action_remote_ip != 192.168.0.0/16 and dst_port = 3389
| filter causality_actor_process_image_name = 'svchost.exe'

## ABIOC — Suspicious RDP Credential Harvesting (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: External RDP Login
# External RDP login followed by credential extraction process

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'C:\\temp\\mimikatz.exe'
| filter causality_actor_process_image_name = 'svchost.exe'
| filter action_remote_ip != 192.168.0.0/16 and dst_port = 3389

## VALIDATION — External RDP Login Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECTION_ESTABLISHED
| filter action_remote_ip != 192.168.0.0/16 and dst_port = 3389
| filter causality_actor_process_image_name = 'svchost.exe'
| comp count() as cnt by action_remote_ip, dst_ip, dst_port
| comp count() as cnt by

