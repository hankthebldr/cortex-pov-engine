# TTP-2026-0254 — Remote Command Execution via PsExec
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — PsExec Remote Execution Process
# severity: high
# Detection of PsExec.exe process execution with remote host parameters

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'psexec.exe'
| filter action_command_line contains 'targethost'

## ABIOC — PsExec Remote Command Execution (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Behavioral deviation detected when PsExec is used to execute commands on a remote host

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'psexec.exe'
| filter action_command_line contains 'targethost'
| filter action_remote_ip = '192.0.2.10'

## VALIDATION — PsExec Remote Execution Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'psexec.exe'
| filter action_command_line contains 'targethost'
| filter action_remote_ip = '192.0.2.10'

