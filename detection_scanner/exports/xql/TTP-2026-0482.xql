# TTP-2026-0482 — InstallUtil.exe Spawning Unusual Lolbins for Execution
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unusual Lolbins Process Spawned by InstallUtil.exe
# severity: high
# Detects when InstallUtil.exe spawns uncommon lolbins like regsvr32 or mshta

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'InstallUtil.exe'
| filter action_process_image_name in ('regsvr32.exe', 'mshta.exe')
| filter action_file_path not contains 'Windows\\System32'

## ABIOC — Lolbin Process Chain from InstallUtil (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: InstallUtil.exe process start
# Detects anomalous execution chain starting from InstallUtil.exe to uncommon lolbins

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'InstallUtil.exe'
| filter action_process_image_name in ('regsvr32.exe', 'mshta.exe')
| filter causality_actor_process_image_name = 'InstallUtil.exe'

## VALIDATION — InstallUtil Spawned Lolbins Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'InstallUtil.exe'
| filter action_process_image_name in ('regsvr32.exe', 'mshta.exe')
| fields agent_hostname, actor_process_image_name, action_process_image_name, action_file_path

