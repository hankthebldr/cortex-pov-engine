# TTP-2026-0432 — Uncommon IP Configuration via ipconfig.exe
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon IP Configuration Listing
# severity: high
# Detection of ipconfig.exe being executed with flags that list network configuration details outside of normal usage patterns

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'C:\\Windows\\System32\\ipconfig.exe'
| filter action_process_command_line contains '/all' or action_process_command_line contains '/showclassid'
| filter causality_actor_process_image_name != 'C:\\Windows\\System32\\cmd.exe'

## ABIOC — Suspicious ipconfig.exe Usage (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name = 'C:\\Windows\\System32\\ipconfig.exe'
# Behavioral deviation where ipconfig.exe is invoked with uncommon flags without typical parent process context

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'C:\\Windows\\System32\\ipconfig.exe'
| filter action_process_command_line contains '/all' or action_process_command_line contains '/showclassid'
| filter causality_actor_process_image_name != 'C:\\Windows\\System32\\cmd.exe'
| filter causality_actor_process_image_name != 'C:\\Windows\\System32\\powershell.exe'

