# TTP-2026-0503 — Kubernetes Pod Container Runtime Connection via Local Socket
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious container runtime connection from within a Kubernetes Pod
# severity: high
# Detects a process connecting to a container runtime socket from within a Kubernetes Pod environment

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.1'
| filter dst_port = 10250
| filter actor_process_image_name contains 'kubelet'
| filter causality_actor_process_image_name contains 'pod'

## ABIOC — Suspicious container runtime socket access from Pod (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: container runtime socket access
# Detects a behavioral deviation where a process within a Kubernetes Pod attempts to access container runtime socket without typical pod-level access patterns

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.1'
| filter dst_port = 10250
| filter actor_process_image_name contains 'kubelet'
| filter causality_actor_process_image_name contains 'pod'

## VALIDATION — Detect suspicious container runtime socket access
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.1'
| filter dst_port = 10250
| filter actor_process_image_name contains 'kubelet'
| filter causality_actor_process_image_name contains 'pod'
| comp count() by actor_process_image_name, dst_port

