# TTP-2026-0277 — Signed Process Connecting to Uncommon External IP
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Globally Uncommon IP Connection from Signed Process
# severity: high
# Detection of a signed process initiating a network connection to an IP address that is not commonly seen in the organization's network traffic.

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_process_image_name != null
| filter action_remote_ip != null
| filter action_process_image_name matches '.*signed.*'
| comp count() as events by action_remote_ip, agent_hostname
| sort desc events

## ABIOC — Unusual Network Behavior from Trusted Process (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name
# Detects when a signed/legitimate process makes an outbound connection to an IP address not typically seen in the environment, indicating potential compromise or lateral movement.

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_process_image_name != null
| filter action_remote_ip != null
| filter action_process_image_name matches '.*signed.*'
| comp count() as events by action_remote_ip, agent_hostname
| sort desc events

