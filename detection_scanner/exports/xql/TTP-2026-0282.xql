# TTP-2026-0282 — Process Injection via rundll32.exe
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious rundll32.exe Injection
# severity: high
# Detection of rundll32.exe being invoked with suspicious parameters indicating injection behavior

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'rundll32.exe'
| filter action_command_line contains 'C:\Windows\Temp\malware.exe'

## ABIOC — Behavioral Injection Pattern (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name = 'rundll32.exe'
# Detection of anomalous process behavior where rundll32.exe is used to inject code into memory

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'rundll32.exe'
| filter action_command_line contains 'C:\Windows\Temp\malware.exe'

## VALIDATION — Hunt for rundll32 Injection
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'rundll32.exe'
