# TTP-2026-0470 — Unsigned Process Injecting into Windows System Binary
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unsigned Process Injecting Into System Binary
# severity: high
# Detects unsigned process injecting into a Windows system binary with no command line

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name != null and action_process_image_name = 'svchost.exe'
| filter causality_actor_process_image_name = 'explorer.exe'
| filter actor_process_image_name contains 'malware.exe'
| filter action_command_line = ''

## ABIOC — Behavioral ABIOC for Unsigned Process Injection (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: explorer.exe launching an unsigned process
# Detects a pattern of unsigned process injecting into system binaries without command line

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name contains 'malware.exe'
| filter action_process_image_name = 'svchost.exe'
| filter action_command_line = ''
| filter causality_actor_process_image_name = 'explorer.exe'

## VALIDATION — Hunt for Unsigned Process Injection
