# TTP-2026-0456 — Uncommon Service Creation via sc.exe for Persistence
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Service Create/Config
# severity: high
# Detection of a process creating or configuring a Windows service not typically seen in normal operations

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'services.exe' and action_process_image_name = 'sc.exe'
| filter action_command_line contains 'create' or action_command_line contains 'config'
| filter action_command_line contains 'MyService'

## ABIOC — Uncommon Service Creation Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: sc.exe process creation with service config args
# Behavioral deviation from typical service creation patterns, identified via ML on service creation events

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'services.exe' and action_process_image_name = 'sc.exe'
| filter action_command_line contains 'create' or action_command_line contains 'config'
| filter action_command_line contains 'MyService'
| filter not action_command_line contains 'binPath'

## VALIDATION — Service Creation Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'services.exe' and action_process_image_name = 'sc.exe'
| filter action_command_line contains 'create' or action_command_line contains 'config'
| filter action_command_line contains 'MyService'

