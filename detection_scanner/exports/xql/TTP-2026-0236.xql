# TTP-2026-0236 — Windows Endpoint - Rare Domain Communication via PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — PowerShell Download and Execute Rare Domain
# severity: high
# Detection of PowerShell downloading and executing a file from a rare domain

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_file_path contains 'malware.exe'
| filter action_remote_ip = '192.0.2.100'

## ABIOC — Abnormal Communication to Rare Domain (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_remote_ip
# Behavioral deviation indicating communication to a rare domain not seen in historical data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.100'
| filter action_remote_hostname = '192.0.2.100'
| filter not action_remote_hostname in (SELECT DISTINCT action_remote_hostname FROM xdr_data WHERE event_type = ENUM.NETWORK_CONNECTION AND timestamp > now() - 30d)

## VALIDATION — Rare Domain Network Connections
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.100'
| filter not action_remote_hostname in (SELECT DISTINCT action_remote_hostname FROM xdr_data WHERE event_type = ENUM.NETWORK_CONNECTION AND timestamp > now() - 30d)

