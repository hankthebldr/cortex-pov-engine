# TTP-2026-0274 — Signed Process Image Load with Uncommon Execution Path
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Image Load from Signed Process
# severity: high
# Detection of unsigned binaries being loaded by a signed Windows process from an uncommon execution path

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'C:\\Windows\\System32\\svchost.exe'
| filter action_file_path contains 'Temp'
| filter action_file_path not contains 'Windows\\System32'
| filter action_file_path not contains 'Windows\\SysWOW64'

## ABIOC — Behavioral Deviation in Signed Process Load (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'C:\\Windows\\System32\\svchost.exe'
# ML-based detection of signed process loading binaries from non-standard paths

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'C:\\Windows\\System32\\svchost.exe'
| filter action_file_path contains 'Temp'
| filter action_file_path not contains 'Windows\\System32'
| filter action_file_path not contains 'Windows\\SysWOW64'

