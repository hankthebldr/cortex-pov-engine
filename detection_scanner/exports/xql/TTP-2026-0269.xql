# TTP-2026-0269 — Masqueraded PowerShell Execution via WMI
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Masqueraded Third-Party Utility Execution
# severity: high
# Detection of legitimate utility (wmi.exe) being used to execute malicious code

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'wmi.exe'
| filter action_process_image_name != 'wmi.exe'

## ABIOC — Suspicious Masquerade Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'wmi.exe'
# Detection of process execution where a legitimate utility is used to launch an unexpected child process

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'wmi.exe'
| filter action_process_image_name != 'wmi.exe'
| filter causality_actor_process_image_name = 'cmd.exe'

## VALIDATION — Masquerade Process Start Detection
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'wmi.exe'
| filter action_process_image_name != 'wmi.exe'

