# TTP-2026-0480 — Unusual Internal Access to Network Device Management Interface
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unusual Internal Access to Management Interface
# severity: high
# Detection of a process accessing a network device management interface from an internal host

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_remote_ip = '192.0.2.50'
| filter dst_port = 23

## ABIOC — Unusual PowerShell Network Access (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name = 'powershell.exe'
# Behavioral deviation of PowerShell accessing network device management interfaces

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_remote_ip = '192.0.2.50'
| filter dst_port = 23

