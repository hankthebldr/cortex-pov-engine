# TTP-2026-0330 — Rare Binary Connecting to Rare External Host
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rare Binary Connected to Rare External Host
# severity: high
# Detection of a rare binary connecting to a rare external host

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = '/tmp/scratch/malware.exe'
| filter action_remote_ip in (select remote_ip from rare_hosts)
| filter action_file_path in (select file_path from rare_binaries)

## ABIOC — Rare Binary Connecting to Rare External Host (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = '/tmp/scratch/malware.exe'
# Behavioral deviation where a rare binary makes a network connection to a rare external host

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip in (select remote_ip from rare_hosts)
| filter actor_process_image_name in (select file_path from rare_binaries)
| filter causality_actor_process_image_name = '/tmp/scratch/malware.exe'

## VALIDATION — Rare Binary to Rare Host Network Connection
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip in (select remote_ip from rare_hosts)
| filter actor_process_image_name in (select file_path from rare_binaries)
| filter causality_actor_process_image_name = '/tmp/scratch/malware.exe'

