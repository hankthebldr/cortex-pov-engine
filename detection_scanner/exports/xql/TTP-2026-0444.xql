# TTP-2026-0444 — Remote MSI Execution via msiexec
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon msiexec remote execution
# severity: high
# Detection of msiexec process starting with a remote file path

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'msiexec.exe'
| filter action_file_path contains 'http://'
| filter causality_actor_process_image_name != 'explorer.exe'

## ABIOC — msiexec remote file execution pattern (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: msiexec.exe process start with remote file
# Detects msiexec executing a remote file, which is an uncommon behavior for typical user sessions

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'msiexec.exe'
| filter action_file_path contains 'http://'
| filter causality_actor_process_image_name != 'explorer.exe'
| filter not action_file_path contains 'C:\\Windows\\System32\\'

## VALIDATION — msiexec remote execution hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'msiexec.exe'
| filter action_file_path contains 'http://'
| filter causality_actor_process_image_name != 'explorer.exe'
| comp count() by action_file_path, causality_actor_process_image_name

