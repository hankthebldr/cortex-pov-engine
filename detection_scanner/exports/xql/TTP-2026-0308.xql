# TTP-2026-0308 — Multiple Rare LOLBIN Process Executions by User
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Multiple Rare LOLBIN Process Executions
# severity: high
# Detection of multiple rare LOLBINs executed by a single user within a short time window

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ['mshta.exe', 'wmic.exe', 'rundll32.exe']
| comp count() as cnt by actor_user_name, action_process_image_name
| comp count() as cnt by
| filter count > 1

## ABIOC — Abnormal LOLBIN Usage Pattern (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: user process execution
# Behavioral deviation from normal user process execution using rare LOLBINs

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ['mshta.exe', 'wmic.exe', 'rundll32.exe']
| filter actor_user_name != 'SYSTEM'
| comp count() as cnt by actor_user_name, action_process_image_name
| comp count() as cnt by
| filter count > 1

## VALIDATION — Detect Rare LOLBIN Usage
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ['mshta.exe', 'wmic.exe', 'rundll32.exe']
| comp count() as cnt by actor_user_name, action_process_image_name
| comp count() as cnt by
| filter count > 1

