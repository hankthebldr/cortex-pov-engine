# TTP-2026-0178 — Sensitive Data Local Staging and Password-Protected Archive Compression
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Sensitive Data Staging Tmp
# severity: high
# Sensitive Data Staging Tmp

preset = xdr_data | filter event_type = 'FILE_WRITE' and action_file_name contains 'customer_pii' and (action_file_path contains '/tmp/' or action_file_path contains 'AppData')

## BIOC — Archive Password Encryption
# severity: high
# Archive Password Encryption

preset = xdr_data | filter action_process_image_name in ('zip', '7z', '7za', 'rar', 'tar') and (action_process_command_line contains '-p' or action_process_command_line contains '-P' or action_process_command_line contains '--password') | filter action_process_command_line contains 'exfil' or action_process_command_line contains 'archive'

## VALIDATION — Password Protected Archive Command Analysis
# purpose: hunt

dataset = xdr_data | filter event_type = 'PROCESS_EXEC' and action_process_image_name in ('zip', '7z', '7za', 'rar') and (action_process_command_line contains '-P' or action_process_command_line contains '-p') | comp count() as execs by agent_hostname, actor_process_username | filter execs >= 1

