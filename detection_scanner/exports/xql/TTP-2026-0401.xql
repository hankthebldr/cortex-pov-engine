# TTP-2026-0401 — Malicious PowerShell Execution via Adobe Reader
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious Process Spawned by Adobe Reader
# severity: high
# Detects when a process is started by Adobe Reader, which is often used by attackers to execute malicious code.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'AcroRd32.exe' and action_process_image_name in ('powershell.exe', 'cmd.exe', 'wscript.exe', 'cscript.exe')

## ABIOC — Adobe Reader Process Spawn with PowerShell (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Adobe Reader process initiating PowerShell execution
# Detects anomalous behavior where Adobe Reader spawns PowerShell with suspicious command-line arguments, indicating potential exploitation.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'AcroRd32.exe' and action_process_image_name = 'powershell.exe'
| filter action_process_command_line contains 'DownloadString' or action_process_command_line contains 'IEX'

## VALIDATION — Detect Suspicious Adobe Reader Process Start
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'AcroRd32.exe' and action_process_image_name in ('powershell.exe', 'cmd.exe')
| fields agent_hostname, actor_process_image_name, action_process_image_name, action_process_command_line

