# TTP-2026-0299 — Office Process Spawning Suspicious One-Liner
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Microsoft Office Process Spawning PowerShell with Suspicious One-Liner
# severity: high
# Detection of winword.exe or excel.exe spawning powershell.exe with a suspicious command-line pattern

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name = 'winword.exe' or causality_actor_process_image_name = 'excel.exe'
| filter action_process_image_name = 'powershell.exe'
| filter action_command_line contains 'IEX' or action_command_line contains 'DownloadString'
| filter action_command_line contains '192.0.2.50'

## ABIOC — Suspicious PowerShell Execution from Office Process (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: causality_actor_process_image_name
# Behavioral deviation where a Microsoft Office process spawns PowerShell with suspicious command-line arguments indicating possible C2 communication

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name = 'winword.exe' or causality_actor_process_image_name = 'excel.exe'
| filter action_process_image_name = 'powershell.exe'
| filter action_command_line contains 'IEX' or action_command_line contains 'DownloadString'
| filter action_command_line contains '192.0.2.50'

