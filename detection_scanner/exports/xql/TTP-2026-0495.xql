# TTP-2026-0495 — SSH Server Cloning with Shared Host Key
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Multiple SSH Servers With Same Host Key
# severity: high
# Detection of multiple SSH server processes using identical host key fingerprints

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/tmp/ssh_clone/ssh_server'
| filter action_remote_ip != NULL
| comp count() as cnt by action_remote_ip, action_file_path
| filter count() > 1

## ABIOC — SSH Server Cloning Pattern (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Behavioral deviation of multiple SSH servers using same host key across different ports

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter dst_port IN (2222, 2223, 2224)
| filter action_file_path = '/tmp/ssh_clone/host_key'
| comp count() as cnt by action_file_path
| filter count() > 2

## VALIDATION — SSH Server Cloning Detection
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/tmp/ssh_clone/ssh_server'
| comp count() as cnt by action_remote_ip, action_file_path
| filter count() > 1
| fields action_remote_ip, action_file_path, count()

