# TTP-2026-0353 — RDP from Unmanaged Endpoint in Managed Subnet
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — RDP from Unmanaged Endpoint
# severity: high
# Detection of RDP activity originating from an endpoint not recognized as managed within the subnet.

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECT
| filter action_remote_ip != null and dst_port = 3389
| filter actor_process_image_name contains 'rdpclient.exe'
| filter agent_hostname not in (SELECT hostname FROM managed_endpoints)

## ABIOC — Unmanaged RDP Access Pattern (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: RDP connection initiated by unmanaged host
# Detection of RDP access from an IP address not in the known managed endpoint list, within a typically managed subnet.

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECT
| filter action_remote_ip != null and dst_port = 3389
| filter agent_hostname not in (SELECT hostname FROM managed_endpoints)
| filter dst_ip in (SELECT ip FROM managed_subnets)

## VALIDATION — RDP Access from Unmanaged Host
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECT
| filter action_remote_ip != null and dst_port = 3389
| filter agent_hostname not in (SELECT hostname FROM managed_endpoints)
| filter dst_ip in (SELECT ip FROM managed_subnets)

