# TTP-2026-0436 — Windows Endpoint Mimicking Linux C2 Communication
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Windows Process Communication
# severity: high
# Detection of rare Windows process communicating with external host

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'wget' and action_remote_ip = '192.0.2.10'

## ABIOC — Windows Process Communicating to Rare External Host (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'wget'
# Detection of unusual Windows process initiating communication to a rare external IP address

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.10' and actor_process_image_name = 'wget'

## VALIDATION — Detect Rare External Host Communication
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.10'
| filter actor_process_image_name = 'wget'

