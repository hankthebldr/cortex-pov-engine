# TTP-2026-0293 — LOLBIN Process Execution with High Integrity Level
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — LOLBIN Process with High Integrity
# severity: high
# Detection of a legitimate Windows binary (LOLBIN) executed with high integrity privileges

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ('svchost.exe', 'powershell.exe', 'certutil.exe')
| filter actor_process_image_name = 'cmd.exe'
| filter process_integrity_level = 'high'

## ABIOC — Suspicious LOLBIN Execution Chain (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: cmd.exe executing svchost.exe with elevated privileges
# Detects a sequence of legitimate binaries used to execute malicious code with elevated privileges

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ('svchost.exe', 'powershell.exe', 'certutil.exe')
| filter actor_process_image_name = 'cmd.exe'
| filter process_integrity_level = 'high'
| filter causality_actor_process_image_name = 'cmd.exe'
| filter action_file_path contains 'temp'
| filter action_remote_ip = '192.0.2.10'

## VALIDATION — LOLBIN High Integrity Execution Hunt
# purpose: validation
