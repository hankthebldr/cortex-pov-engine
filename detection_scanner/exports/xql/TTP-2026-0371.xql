# TTP-2026-0371 — Persistence via Startup Registry Key Modification
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Script file added to startup-related Registry keys
# severity: high
# Detection of script file added to a startup-related registry key

dataset = xdr_data
| filter event_type = ENUM.REGISTRY
| filter action_file_path = "HKCU\Software\Microsoft\Windows\CurrentVersion\Run"
| filter action_process_image_name = "C:\\Windows\\System32\\reg.exe"
| filter action_file_path contains "script.bat"

## ABIOC — Unusual registry modification followed by script execution (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: registry modification to startup key
# Detection of registry modification to startup folder followed by execution of script file

dataset = xdr_data
| filter event_type = ENUM.REGISTRY and action_file_path = "HKCU\Software\Microsoft\Windows\CurrentVersion\Run"
| join (dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = "C:\\Windows\\System32\\cmd.exe") on causality_actor_process_image_name = actor_process_image_name
| filter action_file_path contains "script.bat"

## VALIDATION — Startup Registry Modification Detection
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.REGISTRY
| filter action_file_path = "HKCU\Software\Microsoft\Windows\CurrentVersion\Run"
| filter action_process_image_name = "C:\\Windows\\System32\\reg.exe"
| filter action_file_path contains "script.bat"

