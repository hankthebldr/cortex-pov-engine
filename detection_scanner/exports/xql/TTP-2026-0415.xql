# TTP-2026-0415 — Persistence via AppleScript Command Execution
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon AppleScript with Persistence Command
# severity: high
# Detection of AppleScript execution containing a command that writes a launch agent for persistence

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'osascript'
| filter action_process_image_name = '/bin/sh'
| filter action_file_path = '/Library/LaunchAgents/com.apple.systemsetup.plist'

## ABIOC — AppleScript Persistence Command Execution (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: osascript process start with shell command
# Behavioral deviation where AppleScript is used to execute shell commands that write persistence mechanisms

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'osascript'
| filter action_process_image_name = '/bin/sh'
| filter action_file_path = '/Library/LaunchAgents/com.apple.systemsetup.plist'

## VALIDATION — AppleScript Persistence Hunt
# purpose: validation
