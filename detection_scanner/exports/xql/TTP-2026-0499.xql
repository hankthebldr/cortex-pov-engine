# TTP-2026-0499 — SSH Brute Force Attack via Hydra
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — SSH Brute Force Process Execution
# severity: high
# Detection of hydra process execution attempting SSH login

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/tmp/ssh_brute/hydra'

## ABIOC — SSH Authentication Brute Force Attempts (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Behavioral deviation from normal SSH login patterns detected by ML

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/tmp/ssh_brute/hydra'
| filter action_remote_ip = '192.0.2.10'
| filter dst_port = 22

## VALIDATION — SSH Brute Force Hunt Query
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/tmp/ssh_brute/hydra'
| filter action_remote_ip = '192.0.2.10'
| filter dst_port = 22

