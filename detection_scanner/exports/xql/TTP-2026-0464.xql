# TTP-2026-0464 — Unprivileged Process Opens Registry Hive for Persistence
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unprivileged Process Opened Registry Hive
# severity: high
# Detection of an unprivileged process opening a registry hive file directly, bypassing normal registry access mechanisms.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'reg.exe'
| filter action_file_path contains 'SOFTWARE' and action_file_path contains 'System32' and action_file_path contains 'config'

## ABIOC — Unprivileged Process Opens Registry Hive (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Behavioral ABIOC that flags when an unprivileged process opens a registry hive file directly, indicating potential persistence or privilege escalation attempt.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'reg.exe'
| filter action_file_path contains 'SOFTWARE' and action_file_path contains 'System32' and action_file_path contains 'config'

