# TTP-2026-0472 — Untrusted Process Contacting LLM API via PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Untrusted Process Contacting LLM API
# severity: high
# Detects when a process not typically associated with LLM interaction contacts an LLM API endpoint

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.10'
| filter causality_actor_process_image_name != 'python3'
| filter causality_actor_process_image_name != 'node'
| filter causality_actor_process_image_name != 'java'
| filter causality_actor_process_image_name != 'curl'

## ABIOC — Unusual PowerShell Process Contacting LLM API (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'powershell.exe'
# Detects when a PowerShell process (uncommon for LLM interaction) contacts an LLM API endpoint

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.10'
| filter actor_process_image_name = 'powershell.exe'
| filter causality_actor_process_image_name != 'python3'
| filter causality_actor_process_image_name != 'node'
| filter causality_actor_process_image_name != 'java'
| filter causality_actor_process_image_name != 'curl'

## VALIDATION — Detect Untrusted Process Contacting LLM API
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.10'
| filter causality_actor_process_image_name != 'python3'
| filter causality_actor_process_image_name != 'node'
| filter causality_actor_process_image_name != 'java'
| filter causality_actor_process_image_name != 'curl'
| filter actor_process_image_name = 'powershell.exe'

