# TTP-2026-0440 — Persistence via Registry Run Key Modification
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon login item persistency was registered or modified
# severity: high
# Detection of registry modifications to the Run key by non-standard processes

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'reg.exe'
| filter action_file_path contains 'Run'
| filter action_file_path contains 'CurrentVersion'

## ABIOC — Uncommon login item persistency behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: registry modification by non-standard process
# Detection of non-standard process modifying Run key with uncommon persistence pattern

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'reg.exe'
| filter action_file_path contains 'Run'
| filter action_file_path contains 'CurrentVersion'
| filter not actor_process_image_name in ('explorer.exe', 'svchost.exe', 'cmd.exe')

## VALIDATION — Hunt for Run key registry modifications
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'reg.exe'
| filter action_file_path contains 'Run'
| filter action_file_path contains 'CurrentVersion'
| comp count() by actor_process_image_name, action_file_path

