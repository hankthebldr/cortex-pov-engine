# TTP-2026-0467 — Unsigned DLL Hijack into Microsoft Process
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unsigned DLL Load into Trusted Process
# severity: high
# Detection of unsigned DLL being loaded into a Microsoft process such as spoolsv.exe

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'spoolsv.exe'
| filter action_file_path contains 'winspool.dll'
| filter action_file_path not contains 'C:\\Windows\\System32\\spool\\drivers\\x64\\1.0.0.0\\winspool.dll'
| filter action_file_path not contains 'C:\\Windows\\System32\\spool\\drivers\\x64\\1.0.0.0\\winspool.dll'

## ABIOC — Suspicious DLL Load into System Process (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Behavioral deviation where a DLL is loaded into a system process from an unexpected path

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'spoolsv.exe'
| filter action_file_path contains 'winspool.dll'
| filter action_file_path not contains 'C:\\Windows\\System32\\spool\\drivers\\x64\\1.0.0.0\\winspool.dll'

## VALIDATION — Process Loading Unsigned DLL
