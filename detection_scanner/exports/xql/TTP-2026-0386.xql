# TTP-2026-0386 — Suspicious Docker Image Download from Unusual Repository
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unusual Docker Pull from Non-Standard Registry
# severity: high
# Detection of docker pull command targeting an IP address instead of a standard registry domain

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'docker' and action_file_path = '/usr/bin/docker'
| filter causality_actor_process_image_name != 'dockerd'
| filter action_file_path contains 'pull'
| filter action_remote_ip matches '192.0.2.0/24'

## ABIOC — Suspicious Docker Pull from Unusual Repository (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: docker pull command targeting non-standard registry
# Detection of a process that pulls a Docker image from an IP address that is not a standard Docker registry

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'docker' and action_file_path = '/usr/bin/docker'
| filter causality_actor_process_image_name != 'dockerd'
| filter action_file_path contains 'pull'
| filter action_remote_ip matches '192.0.2.0/24'

## VALIDATION — Docker Pull from Unusual IP
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'docker' and action_file_path = '/usr/bin/docker'
| filter action_remote_ip matches '192.0.2.0/24'
| filter action_file_path contains 'pull'

