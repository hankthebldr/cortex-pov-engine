# TTP-2026-0190 — Repellent Scorpius Cicada3301 — Share Enum, PsExec Spread, Rclone Exfil, Encryption (T1570 / T1567.002 / T1486)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — MP-031 Share Enumeration Output Written to found_shares.txt
# severity: high
# A process chain that enumerates mounts, filesystems or shares writes a file named found_shares.txt — the share-enumeration output file named in the report.

preset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_CREATE_NEW, ENUM.FILE_WRITE)
| filter action_file_name = "found_shares.txt"
| fields agent_hostname, actor_process_image_name, actor_process_command_line, action_file_path, causality_id

## BIOC — MP-031 Encryptor Copied to Admin Share Path and Run Detached with no_impl key
# severity: critical
# An executable written under a Users/Public directory on a C$-shaped path is started detached with '--no_impl' and '--key' — the report's embedded-PsExec '-s -d <encryptor> --no_impl --key' spread.

preset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_command_line contains "--no_impl" and action_process_image_command_line contains "--key"
| filter action_process_image_path contains "Users/Public" or action_process_image_path contains "Users\\Public"
| fields agent_hostname, action_process_image_path, action_process_image_command_line, causality_actor_process_image_name, causality_id

## BIOC — MP-031 Files Rewritten with kcr5umw Extension and RECOVER DATA Note Dropped
# severity: critical
# One process writes many files ending in .kcr5umw, deletes the originals and drops RECOVER-kcr5umw-DATA.txt in the same tree — the Cicada3301 encryption and note shape on a lateral target.

preset = xdr_data
| filter event_type = ENUM.FILE
| filter action_file_name ~= "\.kcr5umw$" or action_file_name ~= "^RECOVER-.*-DATA\.txt$"
| comp count() as touched, count_distinct(action_file_name) as names by agent_hostname, actor_process_image_name, causality_id
| filter touched >= 5
| fields agent_hostname, actor_process_image_name, causality_id, touched, names

## BIOC — MP-031 Renamed Binary Run as rclone from ProgramData with rclone conf
# severity: high
# A process whose image name is rclone (here a renamed curl, visible by its sha256) runs from a ProgramData-shaped directory that also holds rclone.conf — the report's C:\ProgramData\rclone.exe + rclone.conf staging.

preset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ("rclone", "rclone.exe")
| filter action_process_image_path contains "ProgramData"
| filter action_process_image_command_line contains "rclone.conf" or action_process_image_command_line contains "-T " or action_process_image_command_line contains "rclone/v"
| fields agent_hostname, action_process_image_path, action_process_image_command_line, action_process_image_sha256, causality_id

## BIOC — MP-031 Mass Kill of vmx Named Virtual Machine Processes
# severity: high
# A single command kills several VM-worker-shaped processes (vmx) at once — the hypervisor rendering of the report's 'Get-VM | Stop-VM -Force' stop-every-VM step before encryption.

preset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_STOP
| filter action_process_image_command_line contains "vmx"
| comp count() as killed by agent_hostname, actor_process_image_name, actor_process_command_line, causality_id
| filter killed >= 3
| fields agent_hostname, actor_process_image_name, actor_process_command_line, causality_id, killed

## BIOC — MP-031 VM Snapshot Deletion and Hypervisor Log Truncation
# severity: high
# The same chain deletes VM snapshot files (*.vmsn) under a vmfs/volumes path and truncates hostd/vmkernel/vpxa logs — the report's shadow-copy deletion and event-log clearing on a hypervisor-shaped host.

preset = xdr_data
| filter event_type = ENUM.FILE
| filter (event_sub_type = ENUM.FILE_REMOVE and action_file_name ~= "\.vmsn$" and action_file_path contains "vmfs/volumes") or (event_sub_type = ENUM.FILE_WRITE and action_file_name in ("hostd.log", "vmkernel.log", "vpxa.log"))
| comp count_distinct(event_sub_type) as kinds, count() as events by agent_hostname, causality_id
| filter kinds >= 2
| fields agent_hostname, causality_id, kinds, events

## BIOC — MP-031 Locker Encrypts vmfs Datastore Files to kcr5umw with Ransom Note
# severity: critical
# A script-launched process run with '--no_impl --key -p <vmfs/volumes path>' rewrites .vmdk/.vmx files as .kcr5umw and drops RECOVER-kcr5umw-DATA.txt on the datastore root.

preset = xdr_data
| filter event_type = ENUM.FILE
| filter action_file_path contains "vmfs/volumes"
| filter action_file_name ~= "\.(vmdk|vmx)\.kcr5umw$" or action_file_name = "RECOVER-kcr5umw-DATA.txt"
| comp count() as touched by agent_hostname, causality_actor_process_command_line, causality_id
| filter touched >= 3
| fields agent_hostname, causality_actor_process_command_line, causality_id, touched

## ABIOC — MP-031 Rclone Massive Upload to Rare External Destination (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Learned per-host egress-volume and destination-rarity baseline -> first-seen destination with a multi-GB upload, anchored to the source host (src_host).
# A single session from an internal host uploads tens of GB to an external destination the fleet has never contacted, with process rclone.exe on the EAL record — the report's Rclone exfiltration as NGFW analytics sees it.

dataset = panw_ngfw_traffic_raw
| filter bytes_sent > 10737418240
| filter process_name in ("rclone.exe", "rclone")
| comp sum(bytes_sent) as uploaded by endpoint_device_name, src, dst, dst_hostname
| fields endpoint_device_name, src, dst, dst_hostname, uploaded

## VALIDATION — MP-031 WildFire Verdicts for Cicada3301 Hashes Landed in panw_ngfw_threat_raw
# purpose: validation
# dataset: panw_ngfw_threat_raw

dataset = panw_ngfw_threat_raw
| filter verdict = "malicious"
| filter filedigest in ("8ec114b29c7f2406809337b6c68ab30b0b7f0d1647829d56125e84662b84ea74", "0260258f6f083aff71c7549a6364cb05d54dd27f40ca1145e064353dd2a9e983", "2d73b3aefcfbb47c1a187ddee7a48a21af7c85eb49cbdcb665db07375e36dc33")
| comp count() as verdicts by endpoint_device_name, src, filedigest
| fields endpoint_device_name, src, filedigest, verdicts

## VALIDATION — MP-031 Upload to Report Exfil IP Stitched to the Endpoint Host
# purpose: validation
# dataset: panw_ngfw_traffic_raw

dataset = panw_ngfw_traffic_raw
| filter dst = "91.238.181.238"
| comp sum(bytes_sent) as uploaded by endpoint_device_name, src, user
| fields endpoint_device_name, src, user, uploaded

