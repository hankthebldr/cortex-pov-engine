# TTP-2026-0190 — UAC Bypass via fodhelper.exe Registry Hijack
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — fodhelper UAC Bypass
# severity: high
# Detection of fodhelper.exe starting a PowerShell process with DelegateExecute registry key

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'fodhelper.exe'
| filter action_process_image_name = 'powershell.exe'
| filter causality_actor_process_image_name = 'fodhelper.exe'

## VALIDATION — Registry Hijack Detection
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.REGISTRY
| filter action_file_path = 'HKCU\Software\Classes\ms-settings\Shell\Open\Command'
| filter action_process_image_name = 'fodhelper.exe'

