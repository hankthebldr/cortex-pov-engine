# TTP-2026-0126 — ClickFix Pastejacking: RunMRU-to-explorer.exe-Parented Interpreter Execution ABIOC (T1204.004 / T1059.001 / T1105)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## ABIOC — EDR-016 RunMRU Paste-Execution Seeding an Interpreter Download Cradle (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Learned Run-dialog baseline (users rarely paste a download cradle into Win+R) -> RunMRU value carrying http/curl/powershell tokens -> the explorer-parented interpreter launched from that paste, anchored to the paste event.
# A value under the Windows Run-dialog RunMRU key is written whose data carries a download cradle (http / curl / powershell / mshta tokens). This is the earliest ClickFix seam: the paste-execution the victim performed via Win+R is recorded in the MRU. The ABIOC fires on a RunMRU value that carries remote-fetch content, anchored to the paste that immediately precedes an explorer-parented interpreter, not on any known-bad command string.

dataset = xdr_data
| filter event_type = ENUM.REGISTRY
| filter action_registry_key_name contains "\\Explorer\\RunMRU"
| filter (action_registry_data contains "powershell" or action_registry_data contains "mshta" or action_registry_data contains "curl" or action_registry_data contains "certutil") and (action_registry_data contains "http" or action_registry_data contains "DownloadString" or action_registry_data contains "iwr" or action_registry_data contains "-enc")
| comp count() as runmru_download_cradles by agent_hostname, actor_effective_username
| filter runmru_download_cradles >= 1
| fields agent_hostname, actor_effective_username, runmru_download_cradles

## ABIOC — EDR-016 explorer.exe-Parented Interpreter Launched with Remote-Fetch Arguments (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: RunMRU paste-execution -> explorer.exe (Run-dialog handler, no browser/console parent) -> interpreter with remote-fetch arguments, anchored to the explorer.exe process instance.
# An interpreter (powershell.exe / cmd.exe / mshta.exe / wscript.exe) is parented DIRECTLY by explorer.exe with a command line carrying remote-fetch arguments (http / curl / DownloadString / iwr) and no browser or console-host ancestry. explorer.exe is the Run-dialog handler, so this parentage is the signature of a human paste-execution rather than a script, scheduled task, or console session. The ABIOC scores the deviation-plus-causality, catching a chain in which every binary is legitimate.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = "explorer.exe"
| filter action_process_image_name in ("powershell.exe", "cmd.exe", "mshta.exe", "wscript.exe")
| filter action_process_command_line contains "http" or action_process_command_line contains "curl" or action_process_command_line contains "DownloadString" or action_process_command_line contains "iwr"
| comp count() as paste_exec_launches by agent_hostname, action_process_image_name
| filter paste_exec_launches >= 1
| fields agent_hostname, action_process_image_name, paste_exec_launches

## ABIOC — EDR-016 Interpreter-Spawned LOLBin Fetching a Remote Payload (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: explorer-parented interpreter -> LOLBin downloader spawn (curl/certutil/mshta) fetching a remote .bin payload, anchored to the same paste-execution causality chain.
# The paste-launched interpreter (powershell.exe / cmd.exe / mshta.exe) spawns a living-off-the-land binary (curl.exe, certutil.exe, extrac32.exe, rundll32.exe, msiexec.exe, bitsadmin.exe) whose command line fetches a remote payload — often an encrypted .bin. Every LOLBin is legitimate; the ABIOC fires on an interpreter parented by explorer.exe spawning a downloader LOLBin, anchored to the paste-execution causality chain rather than to a specific payload URL.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ("powershell.exe", "cmd.exe", "mshta.exe")
| filter action_process_image_name in ("curl.exe", "certutil.exe", "extrac32.exe", "rundll32.exe", "msiexec.exe", "bitsadmin.exe")
| filter action_process_command_line contains "http" or action_process_command_line contains "urlcache" or action_process_command_line contains ".bin"
| comp count() as lolbin_remote_fetches by agent_hostname, action_process_image_name
| filter lolbin_remote_fetches >= 1
| fields agent_hostname, action_process_image_name, lolbin_remote_fetches

## VALIDATION — EDR-016 explorer.exe-Parented Interpreter Surfaced in Process Telemetry
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter _time > to_timestamp(current_time() - 900)
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = "explorer.exe"
| filter action_process_image_name in ("powershell.exe", "cmd.exe", "mshta.exe", "wscript.exe")
| comp count() as explorer_interpreter_launches by agent_hostname
| filter explorer_interpreter_launches >= 1
| fields agent_hostname, explorer_interpreter_launches

## VALIDATION — EDR-016 Remote Payload Fetch to Latrodectus C2 Surfaced on the NGFW
# purpose: validation
# dataset: pan_ngfw_traffic

dataset = pan_ngfw_traffic
| filter _time > to_timestamp(current_time() - 900)
| filter app = "web-browsing" or app = "ssl"
| filter dst_host in ("webbs.live", "diab.live", "mhbr.live")
| comp count() as remote_payload_fetches by source_ip, dst_host
| filter remote_payload_fetches >= 1
| fields source_ip, dst_host, remote_payload_fetches

