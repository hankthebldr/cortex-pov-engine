# TTP-2026-0418 — AppleScript Execution to Access Sensitive Application Data via Command Line
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon AppleScript Execution via Command Line
# severity: high
# Detection of osascript process started with unusual parameters or file access

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'osascript'
| filter causality_actor_process_image_name != 'bash' and causality_actor_process_image_name != 'zsh'
| filter action_file_path contains '/tmp/scratch/'

## ABIOC — Suspicious AppleScript Behavior Accessing Sensitive Data (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: osascript process started with file access to sensitive paths
# Detection of AppleScript accessing sensitive application data via command line

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'osascript'
| filter action_file_path contains '/Applications/' or action_file_path contains '/Library/'

## VALIDATION — Hunt for Uncommon AppleScript Execution
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'osascript'
| filter causality_actor_process_image_name != 'bash' and causality_actor_process_image_name != 'zsh'
| filter action_file_path contains '/tmp/scratch/'

