# TTP-2026-0367 — Rundll32.exe with No Command-Line Arguments
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious Rundll32 Execution
# severity: high
# Detection of rundll32.exe process start with no command-line arguments

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'rundll32.exe' and action_process_command_line = ''

