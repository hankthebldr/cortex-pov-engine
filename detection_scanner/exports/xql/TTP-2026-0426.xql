# TTP-2026-0426 — Uncommon Cloud CLI Tool Usage via AWS CLI
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Cloud CLI Process Start
# severity: high
# Detection of AWS CLI being executed from non-standard location

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/tmp/awscli'
| filter actor_process_image_name != 'bash'
| filter actor_process_image_name != 'sh'

## ABIOC — Uncommon Cloud CLI Usage Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# ML-based detection of AWS CLI being used in unexpected way for file upload

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/tmp/awscli'
| filter action_file_path = '/etc/passwd'
| filter action_remote_ip = 's3.amazonaws.com'

## VALIDATION — AWS CLI Process Start with S3 Upload
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/tmp/awscli'
| filter action_file_path = '/etc/passwd'
| filter action_remote_ip = 's3.amazonaws.com'

