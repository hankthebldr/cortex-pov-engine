# TTP-2026-0304 — Mshta.exe Spawned From Browser Process
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Mshta Spawned From Browser
# severity: high
# Detection of mshta.exe being spawned directly from a browser process

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ('chrome.exe', 'firefox.exe', 'iexplore.exe')
| filter action_process_image_name = 'mshta.exe'
| filter causality_actor_process_image_name != 'mshta.exe'

## ABIOC — Browser Process Spawning Mshta (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: browser process initiating mshta execution
# Behavioral deviation where a browser process spawns mshta.exe without prior user interaction

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ('chrome.exe', 'firefox.exe', 'iexplore.exe')
| filter action_process_image_name = 'mshta.exe'
| filter causality_actor_process_image_name != 'mshta.exe'

