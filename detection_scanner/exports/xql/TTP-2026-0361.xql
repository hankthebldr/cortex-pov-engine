# TTP-2026-0361 — Remote PsExec-like command execution via SMB
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — PsExec-like remote process execution
# severity: high
# Detection of process execution using PsExec-like tools

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'psexec.exe' or action_process_image_name = 'wbemexec.exe'
| filter causality_actor_process_image_name = 'net.exe' or causality_actor_process_image_name = 'cmd.exe'

## ABIOC — Remote SMB-based execution (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: psexec.exe process start
# Behavioral deviation from normal SMB usage to execute remote processes

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter dst_ip = '192.0.2.10' and dst_port = 445
| filter action_remote_ip = '192.0.2.10'
| filter causality_actor_process_image_name = 'psexec.exe' or causality_actor_process_image_name = 'wbemexec.exe'

## VALIDATION — Detect PsExec-like execution
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'psexec.exe' or action_process_image_name = 'wbemexec.exe'
| filter causality_actor_process_image_name = 'net.exe' or causality_actor_process_image_name = 'cmd.exe'

