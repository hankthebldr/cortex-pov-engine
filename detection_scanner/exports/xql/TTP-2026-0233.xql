# TTP-2026-0233 — Certificate Enrollment via CertUtil for Persistence
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious CertUtil Usage for Certificate Enrollment
# severity: high
# Detection of certutil process being used with -addstore and -f flags to enroll a certificate

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'certutil.exe'
| filter action_process_command_line contains '-addstore'
| filter action_process_command_line contains '-f'

## ABIOC — Unusual Certificate Enrollment via CertUtil (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: certutil process start with URL cache and certificate store flags
# Behavioral deviation where certutil is used to enroll a certificate after downloading from a remote URL

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'certutil.exe'
| filter action_process_command_line contains '-urlcache'
| filter action_process_command_line contains '-addstore'
| filter action_process_command_line contains '-f'
| filter action_remote_ip = '192.0.2.10'

## VALIDATION — Detect Suspicious CertUtil Usage
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'certutil.exe'
| filter action_process_command_line contains '-addstore'
| filter action_process_command_line contains '-f'
| filter action_remote_ip = '192.0.2.10'

