# TTP-2026-0249 — Uncommon RDP Session via mstsc and PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon RDP Session
# severity: high
# An RDP session initiated from an uncommon source IP or with unusual behavior

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'mstsc.exe'
| filter causality_actor_process_image_name != 'explorer.exe'
| filter action_remote_ip = '192.0.2.10'

## ABIOC — RDP Session with PowerShell Execution (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: RDP session initiated
# RDP session followed by PowerShell execution that downloads and runs a script

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'mstsc.exe'
| filter causality_actor_process_image_name = 'explorer.exe'
| filter action_remote_ip = '192.0.2.10'
| join with process_start_events on actor_process_image_name = action_process_image_name
| filter action_process_image_name = 'powershell.exe'

## VALIDATION — Detect RDP Sessions with PowerShell
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'mstsc.exe'
| filter action_remote_ip = '192.0.2.10'
| join with process_start_events on actor_process_image_name = action_process_image_name
| filter action_process_image_name = 'powershell.exe'
| filter action_file_path contains 'temp'

