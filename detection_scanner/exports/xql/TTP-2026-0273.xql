# TTP-2026-0273 — High Entropy Process Execution via PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — High Entropy Process Start
# severity: high
# Detects execution of a process with high entropy indicative of obfuscation

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_entropy > 7.5

## ABIOC — Uncommon High Entropy Process Execution (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name
# Detects execution of a process with entropy significantly higher than typical benign processes

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_entropy > 7.2

## VALIDATION — High Entropy Process Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_entropy > 7.0
| fields action_process_image_name, action_process_entropy, agent_hostname

