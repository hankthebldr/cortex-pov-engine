# TTP-2026-0149 — TIM Rogue Authenticode Code-Signing Certificate IOC — Vidar+XMRig Malvertising Loader (T1587.002 / T1036.001)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — TIM — Rogue Authenticode Code-Signing Certificate Match on Signed-Binary Execution
# severity: high
# A process executes carrying the fabricated Authenticode signer the campaign uses to sign its loader — the self-signed 'WR3' or cloned 'GlobalSign Atlas R3 DV TLS CA 2026 Q1' issuer (subject justwatch.com / *.bleacherreport.com) with a signature status that is not validly SIGNED because the chain never builds to a trusted root (CA:TRUE, self-signed / cloned-CA). This is the TIM rogue-signer match: it fires on the certificate capability the operator DEVELOPED (T1587.002 / T1036.001), independent of the loader filename, so subject rotation across variants does not evade it. The atomic thumbprint/serial themselves are armed as certificate indicators in the TIM threat_intel feed (validated by the pre-flight XQL), because xdr_data process telemetry exposes signer status/vendor, not a per-certificate SHA1 thumbprint column.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_signature_status != ENUM.SIGNED
| filter action_process_signature_vendor in ("justwatch.com", "*.bleacherreport.com", "WR3", "GlobalSign Atlas R3 DV TLS CA 2026 Q1")
| comp count() as rogue_signed_executions by agent_hostname, action_process_image_name, action_process_signature_vendor, action_process_signature_status
| filter rogue_signed_executions >= 1
| fields agent_hostname, action_process_image_name, action_process_signature_vendor, action_process_signature_status, rogue_signed_executions

## VALIDATION — TIM Pre-flight — Rogue Code-Signing Cert IOCs Ingested Into Threat Intel
# purpose: validation
# dataset: threat_intel

dataset = threat_intel
| filter _time > to_timestamp(current_time() - 86400)
| filter indicator_value in ("ab92f731ab20774dfdb95664ee41a2fbafe2a284", "2f7ef0157d17625c098691cef1ff7d63", "136.243.203.109", "136.243.203.111", "138.199.246.13", "116.203.243.208")
| comp count() as armed_indicators, count_distinct(indicator_type) as indicator_types by feed_source
| filter armed_indicators >= 1
| fields feed_source, indicator_types, armed_indicators

## VALIDATION — TIM IOC Match — Outbound C2 Session to Vidar Exfil IP
# purpose: validation
# dataset: panw_ngfw_traffic_raw

dataset = panw_ngfw_traffic_raw
| filter _time > to_timestamp(current_time() - 3600)
| filter dst_ip in ("136.243.203.109", "136.243.203.111", "138.199.246.13", "116.203.243.208")
| filter dst_port = 443
| comp count() as c2_sessions, sum(bytes_sent) as bytes_exfiltrated by src_ip, dst_ip
| filter c2_sessions >= 1
| fields src_ip, dst_ip, c2_sessions, bytes_exfiltrated

## VALIDATION — TIM Pivot — Distinct Signed Loaders Sharing the Rogue Signer
# purpose: hunt
# dataset: xdr_data

dataset = xdr_data
| filter _time > to_timestamp(current_time() - 604800)
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_signature_status != ENUM.SIGNED
| filter action_process_signature_vendor in ("justwatch.com", "*.bleacherreport.com", "WR3", "GlobalSign Atlas R3 DV TLS CA 2026 Q1")
| comp count_distinct(action_process_sha256) as distinct_loaders, count_distinct(agent_hostname) as affected_hosts by action_process_signature_vendor
| filter distinct_loaders >= 1
| fields action_process_signature_vendor, distinct_loaders, affected_hosts

