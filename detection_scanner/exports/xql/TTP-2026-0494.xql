# TTP-2026-0494 — Wsmprovhost.exe Rare Child Process Attack Chain
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Wsmprovhost.exe Rare Child Process
# severity: high
# Detection of wsmprovhost.exe spawning a rare or unexpected child process

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'wsmprovhost.exe'
| filter action_process_image_name not in ('explorer.exe', 'svchost.exe', 'wmiprvse.exe', 'wsmprovhost.exe')
| filter action_process_image_name not in ('powershell.exe', 'cmd.exe', 'regsvr32.exe')

