# TTP-2026-0390 — ICMP-based Command and Control via Windows
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious ICMP Packet
# severity: high
# Detects ping commands sending data to test-net IP

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'ping.exe'
| filter action_remote_ip = '192.0.2.1'

## ABIOC — PowerShell Ping C2 Activity (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'powershell.exe'
# Detects PowerShell invoking ping to test-net IP for C2

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_image_name = 'ping.exe'
| filter action_remote_ip = '192.0.2.1'

## VALIDATION — Detect ICMP C2 via PowerShell
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_image_name = 'ping.exe'
| filter action_remote_ip = '192.0.2.1'

