# TTP-2026-0218 — Privileged Container Escape via nsenter to Host Namespaces
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — K8s Privileged nsenter Escape
# severity: high
# Detection of nsenter process launched with --target 1 inside a privileged container

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'nsenter'
| filter actor_process_image_name = 'containerd'
| filter action_command_line contains '--target 1'
| filter action_process_image_path = '/usr/bin/nsenter'

## ABIOC — Kubernetes nsenter container escape (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: containerd process launching nsenter with host namespace access
# Behavioral deviation modeled by ML detecting nsenter --target 1 in container context

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'nsenter'
| filter action_command_line contains '--target 1'
| filter actor_process_image_name = 'containerd'
| filter causality_actor_process_image_name = 'kubelet'

## VALIDATION — Detect nsenter with --target 1 in container
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'nsenter'
| filter action_command_line contains '--target 1'
| filter actor_process_image_name = 'containerd'
| fields agent_hostname, action_process_image_name, action_command_line, actor_process_image_name

