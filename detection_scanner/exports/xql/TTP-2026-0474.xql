# TTP-2026-0474 — Unusual AWS Credentials Creation via PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — AWS Credential Creation Process
# severity: high
# Detection of PowerShell process creating AWS credentials

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_process_command_line contains 'New-AWSCredential'
| filter action_file_path contains '.aws/credentials'

## ABIOC — Unusual AWS Credentials Creation (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start_with_unusual_credential_creation
# Detection of PowerShell process creating AWS credentials outside of normal user context

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_process_command_line contains 'New-AWSCredential'
| filter causality_actor_process_image_name != 'explorer.exe'
| filter causality_actor_process_image_name != 'svchost.exe'

## VALIDATION — AWS Credential Creation Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_process_command_line contains 'New-AWSCredential'
| filter action_file_path contains '.aws/credentials'
| comp count() by action_process_image_name, action_file_path

