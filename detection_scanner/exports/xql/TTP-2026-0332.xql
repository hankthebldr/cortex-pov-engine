# TTP-2026-0332 — SMB File Transfer via PsExec with Remote Execution
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rare SMB File Transfer
# severity: high
# Unusual file transfer behavior over SMB protocol

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter dst_port = 445
| filter action_remote_ip != '192.0.2.0/24'
| filter action_file_path != null
| filter actor_process_image_name != 'svchost.exe'

## ABIOC — Unusual SMB File Transfer Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name
# Detection of rare file transfer over SMB protocol from non-system process

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter dst_port = 445
| filter action_remote_ip != '192.0.2.0/24'
| filter action_file_path != null
| filter actor_process_image_name != 'svchost.exe'
| filter actor_process_image_name != 'lsass.exe'

