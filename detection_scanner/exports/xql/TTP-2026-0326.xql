# TTP-2026-0326 — PsExec with Suspicious Command Line Execution
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — PsExec Suspicious CommandLine
# severity: high
# Detection of PsExec being executed with suspicious command line arguments

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'psexec.exe'
| filter actor_process_image_name = 'powershell.exe'
| filter action_command_line contains '-s -d -c'

## ABIOC — PsExec Suspicious CommandLine Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Behavioral deviation indicating PsExec executed with unexpected command line arguments

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'psexec.exe'
| filter actor_process_image_name = 'powershell.exe'
| filter action_command_line contains '-s -d -c'

