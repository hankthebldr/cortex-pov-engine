# TTP-2026-0283 — Windows Service Installation via sc.exe
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — New Windows Service Creation
# severity: high
# Detection of new service creation via sc.exe

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'sc.exe'
| filter action_process_image_name = 'sc.exe'
| filter action_file_path contains 'create'

## ABIOC — Suspicious Service Creation with Non-Standard Binary Path (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Detection of service creation using a binary path not typical for system services

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'sc.exe'
| filter action_file_path contains 'temp'
| filter action_file_path contains 'malware.exe'

## VALIDATION — Detect Service Creation via sc.exe
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'sc.exe'
| filter action_file_path contains 'create'
| comp count() by actor_process_image_name, action_file_path

