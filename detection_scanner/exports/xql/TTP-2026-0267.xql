# TTP-2026-0267 — Windows Endpoint Command Execution via Kubelet Credentials in Pod
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious PowerShell Execution in Pod Context
# severity: high
# PowerShell process started with command line indicating download and execution of malware

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_file_path contains 'malware.exe'

## ABIOC — Unusual Process Start from Kubelet Context (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: kubelet credential usage
# PowerShell process started from within a Kubernetes pod with kubelet credentials

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name contains 'kubelet'
| filter action_process_image_name = 'powershell.exe'

## VALIDATION — Detect PowerShell Execution from Kubelet
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name contains 'kubelet'
| filter action_process_image_name = 'powershell.exe'
| filter action_file_path contains 'malware.exe'

