# TTP-2026-0443 — MOF Compiler Usage for Persistence
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon MOF Compiler Usage
# severity: high
# Detection of mofcomp.exe being invoked with a .mof file that is not part of standard Windows components

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'mofcomp.exe'
| filter action_file_path contains '.mof'
| filter not action_file_path contains 'Windows\System32\wbem'

## ABIOC — Unusual MOF Compilation Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Detection of mofcomp.exe being executed with a .mof file not in standard system paths

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'mofcomp.exe'
| filter action_file_path contains '.mof'
| filter not action_file_path contains 'Windows\System32\wbem'

