# TTP-2026-0171 — Encryption-Less Extortion — Mass Staging, Chunked Egress and a Ransom Note With No Data-Encrypted-For-Impact Event
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Ransom Note Written to Staged Shares With No Preceding Mass File Rename
# severity: critical
# The extortion tell in an encryption-less operation. The note is the only overtly hostile artifact in the whole chain, and it arrives WITHOUT the mass rename or extension change that a ransomware BIOC keys on. Detecting it late is still detecting it late — this fires after the data is already gone, which is precisely why the behavioural staging and egress detections upstream are the ones that matter.

dataset = xdr_data
| filter cortexsim_run_tag = "MP022"
| filter event_type = ENUM.FILE and event_sub_type = ENUM.FILE_CREATE_NEW
| filter action_file_name contains "README-RESTORE" or action_file_name contains "HOW-TO-RECOVER" or action_file_name contains "RESTORE-MY-FILES"
| comp count() as notes, count_distinct(action_file_path) as note_paths by agent_hostname, action_process_username, causality_id
| filter notes >= 1
| sort desc note_paths
| fields agent_hostname, action_process_username, causality_id, note_paths, notes

## ABIOC — Mass Staging Tempo Deviating From a Host's Learned File-Access Envelope (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: The abused remote-access tool session owns the chain: enumeration, staging, egress and the note all descend from it under one causality_id, which is what separates it from the benign archive job running in the same window under a different owner.
# The primary claim. With no encryption event to key on, the signal is tempo and breadth against what this host and this identity normally read: distinct share roots touched, files read per minute, and the collection of those reads into one staging path. Keyed on the causality chain rather than on any file name, because file names are exactly what an encryption-less operation leaves untouched.

dataset = xdr_data
| filter cortexsim_run_tag = "MP022"
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_OPEN, ENUM.FILE_READ)
| comp count() as files_read, count_distinct(action_file_directory) as share_roots, min(_time) as first_read, max(_time) as last_read by agent_hostname, action_process_username, causality_id
| alter window_seconds = timestamp_diff(last_read, first_read, "SECOND")
| filter share_roots >= 3 and files_read >= 25
| sort desc files_read
| fields agent_hostname, action_process_username, causality_id, share_roots, files_read, window_seconds

## ABIOC — Sustained Chunked Egress Held Below the Per-Session Volume Alert Floor (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: The staging process's own network sessions, stitched to the endpoint chain on the host and the staging identity, so the egress is attributable to the collection that produced it rather than floating as an unowned flow.
# The counter to the obvious tuning. Each session is individually small enough that a static per-session byte threshold never trips; the deviation is only visible in the sustained aggregate for one host to one destination over the window. A stack that alerts here on the malicious arm but not on the benign archive job has demonstrated a learned baseline; a stack that alerts on both has demonstrated a threshold.

dataset = panw_ngfw_traffic_raw
| filter cortexsim_run_tag = "MP022"
| filter app in ("ssl", "web-browsing", "cloud-storage", "webdav")
| comp sum(bytes_sent) as total_sent, count() as sessions, max(bytes_sent) as largest_session by source_ip, dest_ip, app
| filter sessions >= 6 and total_sent >= 300000000
| sort desc total_sent
| fields source_ip, dest_ip, app, sessions, largest_session, total_sent

## VALIDATION — High-Value Share Enumeration Burst From a Remote-Access Tool Session
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter _time > to_timestamp(current_time() - 7200)
| filter cortexsim_run_tag = "MP022"
| filter causality_actor_process_image_name in ("anydesk.exe", "screenconnect.exe", "teamviewer.exe", "anydesk")
| comp count_distinct(action_file_directory) as enumerated_shares, count() as list_events by agent_hostname, action_process_username, causality_id
| filter enumerated_shares >= 3
| sort desc enumerated_shares
| fields agent_hostname, action_process_username, causality_id, enumerated_shares, list_events

## VALIDATION — Benign Quarterly Archive Arm Stays Inside Its Learned I/O Envelope
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter _time > to_timestamp(current_time() - 7200)
| filter cortexsim_run_tag = "MP022" and cortexsim_label = "benign"
| filter action_process_username = "svc-archive"
| comp count() as files_read, count_distinct(action_file_directory) as share_roots by agent_hostname, action_process_username, causality_id
| filter files_read >= 20
| sort desc files_read
| fields agent_hostname, action_process_username, causality_id, share_roots, files_read

## VALIDATION — Negative Control — No Data-Encrypted-For-Impact Event in the Run Window
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter _time > to_timestamp(current_time() - 7200)
| filter cortexsim_run_tag = "MP022"
| filter event_type = ENUM.FILE and event_sub_type = ENUM.FILE_RENAME
| comp count() as rename_events, count_distinct(action_file_extension) as new_extensions by agent_hostname, causality_id
| filter rename_events >= 1
| fields agent_hostname, causality_id, rename_events, new_extensions

## VALIDATION — Staging-to-Egress Byte Accounting for the Deviating Identity
# purpose: validation
# dataset: panw_ngfw_traffic_raw

dataset = panw_ngfw_traffic_raw
| filter _time > to_timestamp(current_time() - 7200)
| filter cortexsim_run_tag = "MP022"
| comp sum(bytes_sent) as egressed_bytes, count() as sessions, count_distinct(dest_ip) as destinations by source_ip
| filter egressed_bytes >= 300000000
| sort desc egressed_bytes
| fields source_ip, destinations, sessions, egressed_bytes

## VALIDATION — Cloud-Storage Egress Destinations First Seen for This Host
# purpose: hunt
# dataset: panw_ngfw_traffic_raw

dataset = panw_ngfw_traffic_raw
| filter _time > to_timestamp(current_time() - 7200)
| filter cortexsim_run_tag = "MP022"
| filter app in ("cloud-storage", "webdav", "ssl")
| comp sum(bytes_sent) as sent, min(_time) as first_seen by source_ip, dest_ip, dest_fqdn
| sort desc sent
| limit 50
| fields source_ip, dest_ip, dest_fqdn, first_seen, sent

