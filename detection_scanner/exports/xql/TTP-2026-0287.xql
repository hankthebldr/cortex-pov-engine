# TTP-2026-0287 — Kerberos Pre-Auth Failures via Password Spraying
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Kerberos Pre-Auth Failures by User and Host
# severity: high
# Detects multiple Kerberos pre-authentication failures from a single host for different users, indicating credential spraying behavior

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.100' and dst_port = 88
| filter action_process_image_name = 'lsass.exe'
| comp count() as cnt by actor_process_image_name, action_remote_ip, dst_port
| comp count() as cnt by > 5
| comp 5m

## ABIOC — Kerberos Pre-Auth Failure Pattern (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Multiple failed Kerberos pre-auth attempts
# Detects repeated Kerberos pre-auth failures from a single host for multiple distinct users, modeling credential spraying behavior

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.100' and dst_port = 88
| filter action_process_image_name = 'lsass.exe'
| comp count() as cnt by actor_process_image_name, action_remote_ip, dst_port
| comp count() as cnt by > 3
| comp 5m

## VALIDATION — Kerberos Pre-Auth Failures Hunt
# purpose: validation
