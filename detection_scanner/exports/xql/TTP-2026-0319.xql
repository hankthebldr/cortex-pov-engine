# TTP-2026-0319 — Malicious .NET Compilation via Commonly Abused Process
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Possible malicious .NET compilation started by a commonly abused process
# severity: high
# Detection of csc.exe execution initiated by a commonly abused process like PowerShell or cmd.exe

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ('powershell.exe', 'cmd.exe') and action_process_image_name = 'csc.exe'

## ABIOC — Unusual .NET compilation by PowerShell (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'powershell.exe'
# Detection of csc.exe being invoked from PowerShell with suspicious parameters

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe' and action_process_image_name = 'csc.exe'
| filter action_process_command_line contains 'csc.exe' and action_process_command_line contains '/target:exe'

## VALIDATION — Hunt for .NET compilation via PowerShell
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe' and action_process_image_name = 'csc.exe'
| fields actor_process_image_name, action_process_image_name, action_process_command_line

