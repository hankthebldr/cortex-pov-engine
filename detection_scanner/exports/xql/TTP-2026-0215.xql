# TTP-2026-0215 — ELF Padding with dd to Evade Hash/Size Detection
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Possible Binary Padding Using dd
# severity: high
# Detection of dd command being used to append null bytes to an ELF binary

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/bin/dd'
| filter action_process_command_line contains 'conv=notrunc'

