# TTP-2026-0497 — Unusual SSH Tunneling to External Host
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rare Process Created SSH Session to Uncommon Host
# severity: high
# Detection of a rare process initiating an SSH session to an external IP not typically seen in the environment

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name contains 'ssh'
| filter action_remote_ip not in (SELECT DISTINCT dst_ip FROM xdr_data WHERE event_type = ENUM.NETWORK)
| filter actor_process_image_name not in ('sshd', 'systemd', 'cron')

## ABIOC — SSH Session from Rare Process to Uncommon External IP (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name
# Behavioral deviation where a rare process initiates SSH connection to an uncommon external host

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name contains 'ssh'
| filter action_remote_ip not in (SELECT DISTINCT dst_ip FROM xdr_data WHERE event_type = ENUM.NETWORK)
| filter actor_process_image_name not in ('sshd', 'systemd', 'cron')

## VALIDATION — SSH Sessions to Uncommon IPs
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK and network_direction = ENUM.OUTBOUND
| filter dst_port = 22
| filter dst_ip not in (SELECT DISTINCT dst_ip FROM xdr_data WHERE event_type = ENUM.NETWORK AND dst_port = 22)
| filter action_process_image_name contains 'ssh'
| filter actor_process_image_name not in ('sshd', 'systemd', 'cron')

