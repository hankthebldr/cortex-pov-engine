# TTP-2026-0160 — Azure Service-Principal Token Abuse from an Unknown Tenant (Identity-Owned ITDR Causality Chain)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Azure Service Principal Token Abuse via Off-Baseline IP
# severity: high
# Detection of a service principal token replayed from an RFC 5737 documentation-range IP address (203.0.113.201) indicating potential token abuse from unknown tenant.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = "python3" and action_process_image_name = "python3"
| filter action_file_path contains "eal_simulator"
| filter action_remote_ip = "203.0.113.201"
| filter actor_effective_username = "system"
| filter causality_actor_process_image_name = "bash"

## BIOC — Cross-Tenant Azure Control-Plane Access Denied
# severity: high
# Detection of a denied Azure control-plane access attempt where the tenant ID of the requesting identity does not match the target tenant, indicating cross-tenant access abuse.

dataset = xdr_data
| filter event_type = ENUM.CLOUD_API_CALL
| filter identity_claims_tenantid != tenantid and result_type = "Failure"
| filter identity_claims_idtyp = "app"
| filter identity_claims_appidacr = "2"
| filter caller_ip_address = "203.0.113.201"

## ABIOC — ITDR-018 Unusual Resource Access By An Azure Application Deviating From Learned Baseline (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Learned per-service-principal resource-access profile (stable resourceId set) -> the same identity.claims.appid fanning out across resources absent from that profile (distinct_resources beyond the learned baseline); the impact tail bound to the abused workload identity.
# ABIOC 'Unusual resource access by Azure application'. Once its token is replayed, the same service principal fans out across many resourceId values it has never touched. The ABIOC anchors on the SP's learned resource-access profile (the small, stable set of resourceId values the application normally calls) and fires on the DEVIATION — a burst across distinct resources beyond that baseline — not on any single resource being sensitive. This is the impact tail of the chain, bound back to the same identity.claims.appid the remote-token-use analytics alert surfaced.

dataset = msft_azure_audit
| alter token_idtyp = json_extract_scalar(identity, "$.claims.idtyp"), app_id = json_extract_scalar(identity, "$.claims.appid")
| filter token_idtyp = "app"
| filter operationName = "MICROSOFT.STORAGE/STORAGEACCOUNTS/LISTKEYS/ACTION"
| comp count() as access_events, count_distinct(resourceId) as distinct_resources, values(resourceId) as resources by app_id
| filter distinct_resources >= 3
| sort desc distinct_resources
| fields app_id, resources, distinct_resources, access_events

## VALIDATION — ITDR-018 Remote Usage Of An Azure Service Principal Token From Off-Baseline Infrastructure
# purpose: hunt
# dataset: msft_azure_audit

dataset = msft_azure_audit
| alter token_idtyp = json_extract_scalar(identity, "$.claims.idtyp"), token_acr = json_extract_scalar(identity, "$.claims.appidacr"), app_id = json_extract_scalar(identity, "$.claims.appid")
| filter token_idtyp = "app" and token_acr = "2"
| filter callerIpAddress in ("203.0.113.201")
| comp count() as token_uses, count_distinct(callerIpAddress) as source_ip_count, values(callerIpAddress) as source_ips, values(operationName) as operations by app_id
| filter token_uses >= 1
| fields app_id, source_ips, source_ip_count, operations, token_uses

## VALIDATION — ITDR-018 Attempted Azure Application Access From An Unknown Home Tenant
# purpose: hunt
# dataset: msft_azure_audit

dataset = msft_azure_audit
| alter token_idtyp = json_extract_scalar(identity, "$.claims.idtyp"), app_id = json_extract_scalar(identity, "$.claims.appid"), home_tenant = json_extract_scalar(identity, "$.claims['http://schemas.microsoft.com/identity/claims/tenantid']")
| filter token_idtyp = "app"
| filter home_tenant != tenantId and resultType = "Failure"
| comp count() as cross_tenant_attempts, values(home_tenant) as source_tenants, values(operationName) as denied_operations by app_id, tenantId
| filter cross_tenant_attempts >= 1
| fields app_id, tenantId, source_tenants, denied_operations, cross_tenant_attempts

## VALIDATION — ITDR-018 Validate Azure Service Principal Token Events Landed
# purpose: validation
# dataset: msft_azure_audit

dataset = msft_azure_audit
| filter _time > to_timestamp(current_time() - 900)
| alter token_idtyp = json_extract_scalar(identity, "$.claims.idtyp"), app_id = json_extract_scalar(identity, "$.claims.appid")
| filter token_idtyp = "app"
| comp count() as sp_audit_events, values(operationName) as operations by app_id, callerIpAddress
| filter sp_audit_events >= 1
| fields app_id, callerIpAddress, operations, sp_audit_events

