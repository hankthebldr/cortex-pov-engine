# TTP-2026-0338 — Rare Process Execution by User - Suspicious PowerShell Usage
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rare PowerShell Execution by User
# severity: high
# Detection of PowerShell being executed by a user not typically using it

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter actor_process_image_name != 'explorer.exe'
| filter actor_process_image_name != 'cmd.exe'
| filter actor_process_image_name != 'svchost.exe'

## ABIOC — Unusual PowerShell Usage Pattern (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: user process execution
# Detects deviation from normal user behavior when launching PowerShell processes

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter actor_process_image_name != 'explorer.exe'
| filter actor_process_image_name != 'cmd.exe'
| filter actor_process_image_name != 'svchost.exe'
| filter causality_actor_process_image_name != 'powershell.exe'

## VALIDATION — PowerShell Process Starts
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter actor_process_image_name != 'explorer.exe'
| filter actor_process_image_name != 'cmd.exe'
| filter actor_process_image_name != 'svchost.exe'

