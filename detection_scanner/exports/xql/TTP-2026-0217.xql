# TTP-2026-0217 — Linux Endpoint: Adding Execution Privileges via chmod +x
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Adding execution privileges
# severity: high
# Detection of chmod +x being executed on a file in /tmp

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/bin/chmod' and action_file_path like '/tmp/%'
| filter action_process_command_line like '%+x%'

## ABIOC — Adding execution privileges (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name = '/bin/chmod' and action_file_path like '/tmp/%'
# Machine learning model detecting anomalous chmod +x usage on files in /tmp

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/bin/chmod' and action_file_path like '/tmp/%'
| filter action_process_command_line like '%+x%'

## VALIDATION — Detect chmod +x on /tmp files
