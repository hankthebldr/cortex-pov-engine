# TTP-2026-0264 — Persistence via WMI Event Consumer with mshta at Startup
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Process Execution by System Binary
# severity: high
# Detection of mshta.exe execution initiated by a Windows system binary like svchost.exe

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'svchost.exe' and action_process_image_name = 'mshta.exe'
| filter action_process_image_name not in ('explorer.exe', 'svchost.exe', 'wmiprvse.exe')

## ABIOC — Early Startup Execution by System Binary (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'svchost.exe' and action_process_image_name = 'mshta.exe'
# Behavioral deviation where mshta.exe is executed by a system binary during early startup

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'svchost.exe' and action_process_image_name = 'mshta.exe'
| filter action_process_image_name not in ('explorer.exe', 'svchost.exe', 'wmiprvse.exe')
| filter timestamp > '2023-01-01T00:00:00Z'

## VALIDATION — Detect WMI Event Consumer Creation
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.WMI and event_sub_type = ENUM.WMI_EVENT_CONSUMER_CREATE
| filter action_process_image_name = 'mshta.exe'
| filter actor_process_image_name = 'svchost.exe'

