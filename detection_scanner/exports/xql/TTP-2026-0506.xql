# TTP-2026-0506 — Uncommon SSH Session with Malware Delivery
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon SSH Session
# severity: high
# SSH session initiated from an IP address not typically seen for SSH connections

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECTION_START
| filter action_remote_ip != '192.0.2.50'
| filter dst_port = 22
| filter actor_process_image_name = 'sshd'

## ABIOC — Uncommon SSH Session with File Execution (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: SSH session to external IP
# SSH session followed by execution of a file from a temporary directory

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECTION_START
| filter action_remote_ip != '192.0.2.50'
| filter dst_port = 22
| join with process_start on actor_process_image_name
| filter action_process_image_name contains '/tmp/'

## VALIDATION — SSH Sessions to Uncommon IPs
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECTION_START
| filter dst_port = 22
| filter action_remote_ip != '192.0.2.50'
| comp count() as cnt by action_remote_ip
| comp count() as cnt by

