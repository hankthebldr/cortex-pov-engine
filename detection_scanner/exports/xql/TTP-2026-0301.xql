# TTP-2026-0301 — Office Process Spawning Conhost via Macro Execution
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Microsoft Office spawns conhost
# severity: high
# Detection of WINWORD.exe or EXCEL.exe spawning conhost.exe

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'WINWORD.EXE' or actor_process_image_name = 'EXCEL.EXE'
| filter action_process_image_name = 'conhost.exe'

## ABIOC — Office Macro Execution with Conhost (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: macro execution via Office process
# Behavioral deviation where Office application spawns conhost.exe after macro execution

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'WINWORD.EXE' or actor_process_image_name = 'EXCEL.EXE'
| filter action_process_image_name = 'conhost.exe'
| filter causality_actor_process_image_name = 'wscript.exe' or causality_actor_process_image_name = 'powershell.exe'

## VALIDATION — Detect Office Spawn Conhost
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'WINWORD.EXE' or actor_process_image_name = 'EXCEL.EXE'
| filter action_process_image_name = 'conhost.exe'
| comp count() as cnt by actor_process_image_name, action_process_image_name
| comp count() as cnt by

