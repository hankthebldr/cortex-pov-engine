# TTP-2026-0188 — TGR-STA-1030 Shadow Campaigns — Diaoyu Lure to Cobalt Strike C2 and ShadowGuard eBPF Rootkit (Unit 42 stitched chain)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — MP-029 Archive-extracted executable runs beside a zero-byte pic1.png decoy
# severity: medium
# A process whose image path carries the lure name (organisatsiooni) starts from a user-writable temp directory, launched by the shell that just expanded the archive (Expand-Archive / python zipfile). Single-event: the zero-byte pic1.png that Diaoyu requires beside it is checked by the step-01 validation query, not by this BIOC. Keys on the lure layout, independent of the loader hash.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_path contains "organisatsiooni"
| filter action_process_image_path contains "cortexsim-mp-029" or action_process_image_path contains "\\Temp\\" or action_process_image_path contains "/tmp/"
| filter actor_process_image_name in ("powershell.exe", "pwsh.exe", "bash", "sh", "python3")
| fields _time, agent_hostname, actor_process_image_name, action_process_image_path, action_process_image_command_line, causality_actor_process_image_name

## BIOC — MP-029 Diaoyu security-product process-name discovery
# severity: medium
# A process in the lure lineage enumerates running processes for the five security-product images Diaoyu checks (Avp.exe, SentryEye.exe, EPSecurityService.exe, SentinelUI.exe, NortonSecurity.exe) and queries display resolution (Diaoyu requires a horizontal resolution of at least 1440).

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_command_line contains "SentinelUI" or action_process_image_command_line contains "NortonSecurity" or action_process_image_command_line contains "EPSecurityService" or action_process_image_command_line contains "SentryEye" or action_process_image_command_line contains "Avp"
| filter actor_process_image_name in ("powershell.exe", "pwsh.exe", "tasklist.exe", "bash", "grep", "pgrep")
| fields _time, agent_hostname, actor_process_image_name, action_process_image_command_line, causality_actor_process_image_name

## BIOC — MP-029 Image-named payload staged into a lure execution directory
# severity: high
# The lure lineage downloads files with image extensions over HTTP on the padeqav/WordPress wp-includes/images URI shape into its own execution directory, then rewrites one as a non-image file and hashes it — the Diaoyu stage pull from GitHub that ends in a Cobalt Strike payload.

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_WRITE, ENUM.FILE_CREATE_NEW)
| filter action_file_name in ("admin-bar-sprite.png", "Windows.jpg", "Linux.jpg", "Windows.bin", "Linux.bin")
| filter action_file_path contains "cortexsim-mp-029" or action_file_path contains "\\Temp\\" or action_file_path contains "/tmp/"
| fields _time, agent_hostname, actor_process_image_name, action_file_path, causality_actor_process_image_name

## BIOC — MP-029 ShadowGuard custom kill signal allow-list manipulation
# severity: high
# A root process executes kill with signal 900 or 901 — the ShadowGuard eBPF rootkit's allow-list add/remove commands — after probing /sys/fs/bpf and the sys_enter_kill tracepoint.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = "kill"
| filter action_process_image_command_line contains "-900" or action_process_image_command_line contains "-901"
| fields _time, agent_hostname, actor_effective_username, action_process_image_command_line, causality_actor_process_image_name

## BIOC — MP-029 ShadowGuard swsecret hidden-artifact creation
# severity: high
# A root process creates a file or directory whose name starts with swsecret — ShadowGuard hides every file or directory with that name.

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_CREATE_NEW, ENUM.FILE_WRITE)
| filter action_file_name contains "swsecret" or action_file_path contains "swsecret"
| fields _time, agent_hostname, actor_effective_username, actor_process_image_name, action_file_path

## ABIOC — MP-029 Recurring beacon to a rare TGR-STA-1030 C2 domain (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Learned per-host NGFW egress baseline -> recurring sessions to a fleet-rare domain, anchored to src / endpoint_device_name (the run host).
# The run host produces a tight recurring burst of small HTTPS sessions to servgate.me, a domain rare across the fleet — the Cobalt Strike / VShell beacon shape. Auto-tuned NGFW EAL ABIOC on recurring cadence plus destination rarity.

dataset = panw_ngfw_traffic_raw
| filter dst_domain = "servgate.me" or dst = "138.197.44.208"
| comp count() as sessions, avg(bytes_sent) as avg_sent by src, endpoint_device_name, dst_domain
| filter sessions >= 5
| fields src, endpoint_device_name, dst_domain, sessions, avg_sent

## ABIOC — MP-029 Rare process SSH session to a leased relay VPS (behavioral-ML, causality-anchored)
# severity: medium
# behavioral_profile: statistical
# causality_anchor: Learned per-process SSH baseline on the source endpoint -> first SSH session to an uncommon external host, anchored to src / endpoint_device_name.
# A process that rarely opens SSH creates a port-22 session from the run host to an uncommon external VPS — the leased relay hop the report describes for TGR-STA-1030.

dataset = panw_ngfw_traffic_raw
| filter app = "ssh" and dst_port = 22
| filter dst_domain = "zamstats.me" or dst = "157.245.194.54"
| comp count() as ssh_sessions by src, endpoint_device_name, dst
| fields src, endpoint_device_name, dst, ssh_sessions

## VALIDATION — MP-029 Lure execution lineage validation in xdr_data
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter _time > to_timestamp(current_time() - 3600)
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START and action_process_image_path contains "organisatsiooni"
| join type = inner (dataset = xdr_data | filter _time > to_timestamp(current_time() - 3600) | filter event_type = ENUM.FILE and action_file_name = "pic1.png" and action_file_size = 0 | fields agent_hostname as decoy_host, action_file_path as decoy_path) as decoy agent_hostname = decoy.decoy_host
| comp count() as lure_events, values(decoy_path) as decoy_paths by agent_hostname
| filter lure_events >= 1
| fields agent_hostname, lure_events, decoy_paths

## VALIDATION — MP-029 Report C2 domain lookups validation in xdr_data
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter _time > to_timestamp(current_time() - 3600)
| filter dns_query_name in ("abwxjp5.me", "msonline.help", "servgate.me", "zamstats.me")
| comp count_distinct(dns_query_name) as domains by agent_hostname
| filter domains >= 1
| fields agent_hostname, domains

## VALIDATION — MP-029 WildFire threat logs carry report hashes on the run host
# purpose: validation
# dataset: panw_ngfw_threat_raw

dataset = panw_ngfw_threat_raw
| filter _time > to_timestamp(current_time() - 3600)
| filter filedigest in ("66ec547b97072828534d43022d766e06c17fc1cafe47fbd9d1ffc22e2d52a9c0", "23ee251df3f9c46661b33061035e9f6291894ebe070497ff9365d6ef2966f7fe", "5175b1720fe3bc568f7857b72b960260ad3982f41366ce3372c04424396df6fe")
| comp count() as verdicts by src, endpoint_device_name, filedigest
| fields src, endpoint_device_name, filedigest, verdicts

## VALIDATION — MP-029 ShadowGuard behaviour validation in xdr_data
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter _time > to_timestamp(current_time() - 3600)
| filter action_process_image_command_line contains "kill -90" or action_file_name contains "swsecret"
| comp count() as shadowguard_events by agent_hostname
| filter shadowguard_events >= 1
| fields agent_hostname, shadowguard_events

## VALIDATION — MP-029 C2 and relay sessions landed in panw_ngfw_traffic_raw
# purpose: validation
# dataset: panw_ngfw_traffic_raw

dataset = panw_ngfw_traffic_raw
| filter _time > to_timestamp(current_time() - 3600)
| filter dst in ("138.197.44.208", "157.245.194.54") or dst_domain in ("servgate.me", "zamstats.me")
| comp count() as sessions by src, endpoint_device_name, dst_domain
| fields src, endpoint_device_name, dst_domain, sessions

