# TTP-2026-0188 — Uncommon Command on ESXi Virtualization Host — Hypervisor CLI
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## VALIDATION — ESXi Uncommon Hypervisor-CLI Command on the Syslog Feed
# purpose: validation
# dataset: esxi_syslog

dataset = esxi_syslog
| filter command ~= "esxcli system account add|esxcli system permission set|system syslog config set|system coredump|vim-cmd vmsvc/power.off|\.vmdk|pty.spawn"
| comp count() as hits by agent_hostname, user, command
| sort desc hits

## VALIDATION — ESXi Backdoor Account Add Followed by Syslog Disable
# purpose: hunt
# dataset: esxi_syslog

dataset = esxi_syslog
| filter command contains "esxcli system account add" or command contains "syslog config set --loghost"
| comp count_distinct(command) as stages by agent_hostname, user
| filter stages >= 2

