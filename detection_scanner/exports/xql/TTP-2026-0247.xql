# TTP-2026-0247 — Abnormal User Login to Domain Controller via Kerberoasting
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unusual Process Execution from Temp Directory
# severity: high
# Detection of process execution from temporary directory with Kerberoasting behavior

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name contains '/tmp/' and action_process_image_name contains 'kerberoast'
| filter actor_process_image_name = 'lsass.exe' or actor_process_image_name = 'cmd.exe'

## ABIOC — Abnormal User Login to Domain Controller (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Detection of user login to domain controller with unusual timing or context

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.50' and dst_port = 88
| filter actor_process_image_name = 'lsass.exe'
| filter causality_actor_process_image_name = 'svchost.exe'

## VALIDATION — Kerberoasting Network Activity
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.50' and dst_port = 88
| filter actor_process_image_name = 'lsass.exe'

