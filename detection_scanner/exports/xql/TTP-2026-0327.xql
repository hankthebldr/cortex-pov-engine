# TTP-2026-0327 — Suspicious Access to Advertising Domains via PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unusual PowerShell Network Access
# severity: high
# PowerShell process making network connections to advertising domains

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_remote_ip in ('192.0.2.10', '192.0.2.11')

## ABIOC — Rare PowerShell to Advertising Domain Access (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name
# PowerShell process accessing advertising domains outside of normal behavior

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_process_image_name = 'powershell.exe'
| filter action_remote_ip in ('192.0.2.10', '192.0.2.11')
| filter agent_hostname not in ('normal-host-01', 'normal-host-02')

## VALIDATION — PowerShell Network Access to Advertising Domains
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_process_image_name = 'powershell.exe'
| filter action_remote_ip in ('192.0.2.10', '192.0.2.11')
| comp count() as cnt by agent_hostname, action_remote_ip
| comp count() as cnt by

