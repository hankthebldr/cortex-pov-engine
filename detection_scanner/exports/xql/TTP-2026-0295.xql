# TTP-2026-0295 — Massive Upload to Rare Storage Domain
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unusual File Upload to Rare Storage Domain
# severity: high
# Detects when a process uploads files to a rarely used storage domain

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_OUTBOUND
| filter action_remote_ip = '192.0.2.100'
| filter action_file_path contains 'data.zip'

## ABIOC — Massive Upload to Rare Storage Domain (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'powershell.exe'
# Detects unusual upload behavior to rare storage domains based on ML profile

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_OUTBOUND
| filter action_remote_ip = '192.0.2.100'
| filter action_file_path contains 'data.zip'

## VALIDATION — Detect Rare Storage Uploads
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_OUTBOUND
| filter action_remote_ip = '192.0.2.100'
| filter action_file_path contains 'data.zip'
| comp count() by action_remote_ip

