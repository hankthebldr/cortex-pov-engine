# TTP-2026-0478 — Password-Protected Archive with Unusual Compression Pattern
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unusual Archive Password Usage
# severity: high
# Detection of zip extraction with a non-standard password length or pattern

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'unzip' and action_process_command_line contains '-P'
| filter action_process_command_line matches '123456789'

