# TTP-2026-0219 — Privileged Container Recon with Interactive Shell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious process execution in a privileged container
# severity: high
# Process execution inside a privileged container with host-recon tools

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = '/tmp/recon-tool'
| filter causality_actor_process_image_name contains 'privileged'

## ABIOC — Suspicious process execution in a privileged container (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start_in_privileged_container
# Behavioral deviation of process execution inside a privileged container context

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = '/tmp/recon-tool'
| filter causality_actor_process_image_name contains 'privileged'
| filter action_remote_ip = '192.0.2.10'

