# TTP-2026-0496 — SSH Tunneling to Cloud Resource via Rare Process
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rare Process SSH to Cloud Resource
# severity: high
# Detection of a rare or unknown process initiating an SSH session to a cloud IP address

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name not in ('/usr/bin/ssh', '/usr/bin/sftp', '/usr/bin/scp')
| filter action_remote_ip in ('192.0.2.100', '192.0.2.1')

## ABIOC — Unusual SSH Process to Cloud IP (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name
# Behavioral deviation where a process not typically used for SSH connects to a cloud IP address

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_process_image_name not in ('/usr/bin/ssh', '/usr/bin/sftp', '/usr/bin/scp')
| filter action_remote_ip in ('192.0.2.100', '192.0.2.1')
| filter network_protocol = 'TCP' and dst_port = 22

## VALIDATION — SSH Tunneling to Cloud IPs
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip in ('192.0.2.100', '192.0.2.1')
| filter network_protocol = 'TCP' and dst_port = 22
| filter action_process_image_name not in ('/usr/bin/ssh', '/usr/bin/scp')
| comp count() by action_process_image_name, action_remote_ip

