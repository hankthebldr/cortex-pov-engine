# TTP-2026-0286 — Kerberos Pre-Auth Failures via AS-REP Roasting
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Kerberos AS-REP Failure by Host
# severity: high
# Detects multiple failed Kerberos AS-REP requests from a single host

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.100' and dst_port = 88 and action_process_image_name = 'python3'
| comp count() as cnt by agent_hostname
| comp count() as cnt by > 5

## ABIOC — Kerberos Pre-Auth Failure Pattern (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_remote_ip = '192.0.2.100' and dst_port = 88
# Detects unusual Kerberos pre-authentication failures from a single host in a short time window

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.100' and dst_port = 88
| comp count() as cnt by agent_hostname
| comp count() as cnt by > 3
| comp 1m

## VALIDATION — Kerberos AS-REP Failure Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.100' and dst_port = 88
| comp count() as cnt by agent_hostname
| comp count() as cnt by > 5

