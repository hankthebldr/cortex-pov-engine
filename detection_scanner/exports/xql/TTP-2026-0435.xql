# TTP-2026-0435 — Persistence via Registry Run Key Modification
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Launch Daemon persistency was registered or modified
# severity: high
# Detection of registry modifications to run keys that are not typical for the system

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'reg.exe'
| filter action_file_path contains 'HKCU\Software\Microsoft\Windows\CurrentVersion\Run'

## ABIOC — Uncommon Launch Daemon persistency was registered or modified (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: registry modification to run key
# Behavioral deviation based on registry modification that is not commonly seen in benign processes

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'reg.exe'
| filter action_file_path contains 'HKCU\Software\Microsoft\Windows\CurrentVersion\Run'

