# TTP-2026-0425 — Clearing Shell History via Windows Command Prompt
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Shell History Clearing
# severity: high
# Detection of process attempting to delete or clear shell history files in Windows

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'cmd.exe'
| filter action_command_line contains 'del' and action_command_line contains 'ConsoleHost_history.txt'

## ABIOC — Uncommon Shell History Clearing Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Detection of an atypical process behavior that attempts to delete shell history files, which is often associated with malicious activity

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'cmd.exe'
| filter action_command_line contains 'del' and action_command_line contains 'ConsoleHost_history.txt'

