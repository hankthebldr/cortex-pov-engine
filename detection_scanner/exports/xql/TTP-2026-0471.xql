# TTP-2026-0471 — Unsigned Process from Temporary Directory
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unsigned Process from Temp Directory
# severity: high
# Detection of unsigned process execution from a temporary directory

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name contains '/tmp/' and actor_process_image_name not contains '.signed'
| filter actor_process_image_name not contains 'systemd'
| filter actor_process_image_name not contains 'bash'

## ABIOC — Unsigned Process Execution from Temp Path (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Behavioral deviation where unsigned binary is executed from a temporary path

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name contains '/tmp/'
| filter actor_process_image_name not contains '.signed'
| filter actor_process_image_name not contains 'systemd'
| filter actor_process_image_name not contains 'bash'

## VALIDATION — Unsigned Process from Temp Directory Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name contains '/tmp/' and actor_process_image_name not contains '.signed'
| filter actor_process_image_name not contains 'systemd'
| filter actor_process_image_name not contains 'bash'
| comp count() by actor_process_image_name

