# TTP-2026-0376 — Signed Process Performing Unpopular Injection
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Signed Process Injection Anomaly
# severity: high
# Detection of injection behavior by a signed process that is not typically used for such activity

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'cmd.exe' and action_process_image_name = 'svchost.exe'
| filter causality_actor_process_image_name = 'svchost.exe' and action_file_path = '/tmp/evil.exe'

## ABIOC — Unpopular Injection by Signed Process (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process injection by signed binary
# Behavioral deviation where a signed legitimate process performs injection behavior not typically associated with it

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'cmd.exe' and action_process_image_name = 'svchost.exe'
| filter causality_actor_process_image_name = 'svchost.exe' and action_file_path = '/tmp/evil.exe'

