# TTP-2026-0281 — Suspicious HTTP Request with Encoded Command Execution
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — HTTP Request to Suspicious IP with Encoded Command
# severity: high
# Detects HTTP request to a known suspicious IP with encoded command in user-agent or URL

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.50'
| filter action_protocol = ENUM.HTTP
| filter action_user_agent contains 'encoded'
| filter action_url contains 'cmd'

## ABIOC — Suspicious Process Execution After HTTP Download (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = '/tmp/.tmpfile'
# Detects execution of a process downloaded via HTTP from a suspicious IP

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name contains '.tmpfile'
| filter action_remote_ip = '192.0.2.50'

## VALIDATION — Hunt for Suspicious HTTP Requests
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.50'
| filter action_protocol = ENUM.HTTP
| filter action_user_agent contains 'encoded'
| comp count by action_url, action_remote_ip

