# TTP-2026-0259 — Conhost Spawning Suspicious Cmd Process
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Conhost Spawning Cmd with Suspicious Args
# severity: high
# Detection of conhost.exe spawning cmd.exe with suspicious command-line arguments

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'conhost.exe' and action_process_image_name = 'cmd.exe'
| filter action_process_command_line contains 'powershell' or action_process_command_line contains 'iex'

## ABIOC — Suspicious Cmd Execution via Conhost (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'conhost.exe'
# Behavioral deviation where conhost.exe spawns cmd.exe with PowerShell execution flags

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'conhost.exe' and action_process_image_name = 'cmd.exe'
| filter action_process_command_line contains 'powershell' or action_process_command_line contains 'iex'

