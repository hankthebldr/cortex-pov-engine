# TTP-2026-0311 — NTLM Brute Force on Service Account
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — NTLM Brute Force on Service Account
# severity: high
# Multiple failed NTLM authentication attempts using a service account

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.100'
| filter dst_port = 445
| filter action_process_image_name = 'net.exe'
| filter causality_actor_process_image_name = 'cmd.exe'
| comp count() as cnt by by actor_process_image_name

## ABIOC — NTLM Brute Force Pattern (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: cmd.exe executing net.exe to connect to target IP
# Behavioral deviation indicating repeated failed authentication attempts using service account

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.100'
| filter dst_port = 445
| filter action_process_image_name = 'net.exe'
| filter causality_actor_process_image_name = 'cmd.exe'
| comp count() as cnt by by actor_process_image_name
| filter count > 3

## VALIDATION — Detect NTLM Brute Force Attempts
