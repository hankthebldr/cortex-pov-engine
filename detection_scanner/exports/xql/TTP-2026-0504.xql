# TTP-2026-0504 — Suspicious sshpass Usage for Credential Theft
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious sshpass command execution
# severity: high
# Detection of sshpass being executed with hardcoded credentials

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/tmp/sshpass'
| filter actor_process_image_name contains 'bash'
| filter action_process_command_line contains '-p'

## ABIOC — sshpass with hardcoded password (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name = '/tmp/sshpass'
# Behavioral deviation indicating use of sshpass with hardcoded credentials for remote access

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/tmp/sshpass'
| filter action_process_command_line contains '-p'
| filter actor_process_image_name contains 'bash'

## VALIDATION — Detect sshpass usage with password
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/tmp/sshpass'
| filter action_process_command_line contains '-p'
| filter actor_process_image_name contains 'bash'

