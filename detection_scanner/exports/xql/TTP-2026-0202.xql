# TTP-2026-0202 — WMIEXEC-style Command Execution via WMI
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — WMI Command Execution
# severity: high
# Detection of cmd.exe execution under WmiPrvSE process

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'WmiPrvSE.exe' and action_process_image_name = 'cmd.exe'

## ABIOC — Command Execution via WMI (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: WmiPrvSE process spawning cmd.exe
# Behavioral deviation of cmd.exe process spawning under WmiPrvSE with ADMIN$ redirection

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'WmiPrvSE.exe' and action_process_image_name = 'cmd.exe'
| filter action_file_path contains 'ADMIN$'

## VALIDATION — WMI Command Execution Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'WmiPrvSE.exe' and action_process_image_name = 'cmd.exe'
| filter action_file_path contains 'ADMIN$'

