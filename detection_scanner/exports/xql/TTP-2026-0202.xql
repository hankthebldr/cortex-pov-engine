# TTP-2026-0202 — OpenClaw ClawHub Malicious Skill — Padded README, base64 curl|bash Dropper and Developer-Credential Theft
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — KOI-011 Dropped Shell Reads Multiple Developer Credential Files
# severity: high
# A shell dropped by the OpenClaw skill prerequisite reads three or more distinct developer credential-named files (SSH private key, cloud credentials, npm token, .env secrets, the agent's own ~/.claude.json) in one window under the agent causality chain. A productivity skill that reads this set is stealing, not assisting. The threshold is three distinct paths to keep a single settings read quiet; the decoy run yields five (.ssh/id_rsa, .aws/credentials, .npmrc, .env, .claude.json). Keep routine agent/editor config reads out of the credential-name list so a launch that reads only config does not satisfy the threshold.

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_OPEN, ENUM.FILE_READ)
| filter action_process_image_name in ("sh", "bash", "dash", "cat", "python3", "perl")
| filter action_file_path contains_any (".ssh/id_rsa", "id_ed25519", ".aws/credentials", ".npmrc", ".env", ".claude.json", ".config/gcloud/credentials")
| comp count_distinct(action_file_path) as cred_files by agent_hostname, actor_causality_id, action_process_image_name
| filter cred_files >= 3
| fields agent_hostname, actor_causality_id, action_process_image_name, cred_files

## ABIOC — KOI-011 Base64 Decode Of Agent Skill Prerequisite Block (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: The OpenClaw agent runtime (Causality Group Owner) and its actor_causality_id; the deviation is a base64-decode of an encoded shell command sourced from a marketplace skill prerequisite, against the baseline of agent lineages that decode nothing.
# Behavioral-ML deviation (the built-in 'Uncommon Linux shell command execution' analytics): a process in the AI-agent lineage runs base64 -d on a blob lifted from a marketplace skill's prerequisite block. A productivity skill has no reason to carry a base64-encoded shell command; decoding one in the agent chain is the OpenClaw dropper's reveal step.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = "base64"
| filter action_process_image_command_line contains_any ("-d", "--decode")
| comp count() as decodes by agent_hostname, actor_causality_id, causality_actor_process_image_name, action_process_image_command_line
| filter decodes >= 1
| fields agent_hostname, actor_causality_id, causality_actor_process_image_name, action_process_image_command_line, decodes

## ABIOC — KOI-011 Curl Pipe To Bash Dropper From Agent Lineage (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: The OpenClaw agent runtime (Causality Group Owner) and its actor_causality_id; the deviation is a curl/wget fetch of a non-registry URL piped into a shell in the same causality chain, against the baseline of agent lineages that never pipe a download into an interpreter.
# Behavioral-ML deviation (the built-in 'Uncommon Linux shell command execution' analytics): a curl (or wget) fetch of a remote URL is piped straight into a shell under the AI-agent lineage — the curl|bash LOLBIN ingress the OpenClaw prerequisite block performs. The fetch targets a host outside any package registry or marketplace CDN; in the lab it is a non-resolving canary, so curl fails and nothing is downloaded, but the process shape and the DNS lookup are the signal.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ("curl", "wget")
| filter action_process_image_command_line contains_any ("http://", "https://")
| join type = inner (
    dataset = xdr_data
    | filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
    | filter action_process_image_name in ("bash", "sh", "dash")
    | fields actor_causality_id as shell_cid, agent_hostname as shell_host
) as sib shell_cid = actor_causality_id and shell_host = agent_hostname
| comp count() as fetches by agent_hostname, actor_causality_id, causality_actor_process_image_name, action_process_image_command_line
| filter fetches >= 1
| fields agent_hostname, actor_causality_id, causality_actor_process_image_name, action_process_image_command_line, fetches

## VALIDATION — KOI-011 Oversized Marketplace Skill README Created Under Agent Skills Dir
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 1800
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_CREATE_NEW, ENUM.FILE_WRITE)
| filter action_file_path contains "/.openclaw/skills/" and action_file_name = "README.md"
| fields _time, agent_hostname, actor_causality_id, actor_process_image_name, action_file_path, action_file_size

## VALIDATION — KOI-011 Stolen Credentials Archived Into Staging Tarball
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 1800
| filter (event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_CREATE_NEW, ENUM.FILE_WRITE) and action_file_path contains "/.cache/openclaw-setup/loot.tgz")
   or (event_type = ENUM.PROCESS and action_process_image_name = "tar" and action_process_image_command_line contains "loot")
| fields _time, agent_hostname, actor_causality_id, action_process_image_name, action_file_path, action_process_image_command_line

## VALIDATION — KOI-011 Dropper DNS And Egress To Non Marketplace Setup Host
# purpose: hunt
# dataset: xdr_data

dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 1800
| filter event_type = ENUM.NETWORK
| filter actor_process_image_name in ("curl", "wget", "node", "bash", "sh")
| filter dst_action_external_hostname in ("download.setup-service.com", "install.app-distribution.net", "laosji.net") or action_external_hostname in ("download.setup-service.com", "install.app-distribution.net", "laosji.net")
| fields _time, agent_hostname, actor_causality_id, actor_process_image_name, dst_action_external_hostname, action_remote_ip, action_external_port

## VALIDATION — KOI-011 Loot Beacon To C2 Or Telegram Bot API
# purpose: hunt
# dataset: xdr_data

dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 1800
| filter event_type = ENUM.NETWORK
| filter actor_process_image_name in ("curl", "wget", "node", "bash", "sh")
| filter action_remote_ip = "91.92.242.30" or dst_action_external_hostname = "api.telegram.org" or action_external_hostname = "api.telegram.org"
| filter action_total_upload > 0
| fields _time, agent_hostname, actor_causality_id, actor_process_image_name, dst_action_external_hostname, action_remote_ip, action_external_port, action_total_upload

## VALIDATION — KOI-011 Skill Prerequisite References Paste Site Redirect
# purpose: hunt
# dataset: xdr_data

dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 3600
| filter event_type = ENUM.NETWORK
| filter dst_action_external_hostname in ("rentry.co", "glot.io") or action_external_hostname in ("rentry.co", "glot.io")
| comp count() as hits by agent_hostname, actor_causality_id, actor_process_image_name, dst_action_external_hostname
| filter hits >= 1
| fields agent_hostname, actor_causality_id, actor_process_image_name, dst_action_external_hostname, hits

