# TTP-2026-0394 — NTLM Authentication with Machine Account
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious NTLM authentication with machine account
# severity: high
# Detects NTLM authentication attempts using a machine account

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'cmd.exe'
| filter action_remote_ip = '192.0.2.10'
| filter action_file_path = 'C:\\Windows\\System32\\net.exe'
| filter causality_actor_process_image_name = 'net.exe'

## ABIOC — Suspicious NTLM authentication with machine account (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: cmd.exe process initiating network connection to domain controller
# Behavioral deviation detected when a process attempts to authenticate with a machine account over network

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.10'
| filter dst_port = 445
| filter causality_actor_process_image_name = 'cmd.exe'

## VALIDATION — Detect NTLM authentication with machine account
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.10'
| filter dst_port = 445
| filter causality_actor_process_image_name = 'cmd.exe'
| filter action_file_path = 'C:\\Windows\\System32\\net.exe'

