# TTP-2026-0412 — FSRVP Protocol Usage for Lateral Movement
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious FSRVP Usage
# severity: high
# Detection of vssadmin.exe being invoked with shadow creation commands on Windows systems

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'vssadmin.exe'
| filter action_process_command_line contains 'create shadow'

## ABIOC — Suspicious FSRVP Usage (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: vssadmin.exe process start with shadow creation command
# Behavioral deviation where vssadmin.exe is used to create shadow copies on remote systems

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'vssadmin.exe'
| filter action_process_command_line contains 'create shadow'
| filter action_remote_ip = '192.0.2.10'

## VALIDATION — VSS Admin Shadow Creation
