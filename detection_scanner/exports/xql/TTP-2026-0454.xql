# TTP-2026-0454 — Uncommon Remote Service Start via sc.exe
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Remote Service Start via sc.exe
# severity: high
# Detection of sc.exe being used to start a remote service on a non-standard endpoint

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'sc.exe'
| filter action_remote_ip = '192.0.2.10'
| filter action_file_path contains 'malware.exe'

## ABIOC — Uncommon Remote Service Start via sc.exe (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'sc.exe'
# Behavioral ABIOC that flags remote service starts via sc.exe as anomalous behavior

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'sc.exe'
| filter action_remote_ip = '192.0.2.10'
| filter action_file_path contains 'malware.exe'

