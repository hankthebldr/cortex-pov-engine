dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_process_command_line contains 'Add-Type'
| filter action_process_command_line contains 'malware.dll'

