# TTP-2026-0272 — High Entropy Module Load via PowerShell with C2 Communication
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Globally uncommon high entropy module was loaded
# severity: high
# Detection of a DLL module with high entropy loaded into memory, indicating potential obfuscation or encryption

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_process_command_line contains 'Add-Type'
| filter action_process_command_line contains 'malware.dll'

## ABIOC — High Entropy Module Load Behavior (behavioral-ML, causality-anchored)
# severity: high
