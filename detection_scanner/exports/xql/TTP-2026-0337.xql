# TTP-2026-0337 — AppleScript Execution of Suspicious Process
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rare Process Executed by AppleScript
# severity: high
# Detection of a process being executed by osascript, which is uncommon and potentially malicious

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'osascript'
| filter action_process_image_name != 'osascript'

## ABIOC — Unusual Process Start via AppleScript (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: osascript executing external binary
# Detection of an atypical process start initiated through osascript, indicating possible abuse of scripting frameworks

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'osascript'
| filter action_process_image_name != 'osascript'

