# TTP-2026-0228 — Windows Process Connecting to Rare External Host
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Process Connected to Rare External Host
# severity: high
# A process connects to an IP address that is rarely seen in the environment

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECT
| filter action_remote_ip in (select remote_ip from xdr_data where event_type = ENUM.NETWORK_CONNECTION group by remote_ip having count() < 5)
| filter causality_actor_process_image_name != ''

## ABIOC — Rare Network Connection Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_remote_ip
# Detection of a process connecting to an IP address that is rarely seen in the environment, indicating potential C2 communication

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECT
| filter action_remote_ip in (select remote_ip from xdr_data where event_type = ENUM.NETWORK_CONNECTION group by remote_ip having count() < 5)
| filter causality_actor_process_image_name != ''

## VALIDATION — Rare External Host Connection Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECT
| filter action_remote_ip in (select remote_ip from xdr_data where event_type = ENUM.NETWORK_CONNECTION group by remote_ip having count() < 5)
| comp count() as cnt by action_remote_ip, causality_actor_process_image_name
| comp count() as cnt by agent_hostname 

