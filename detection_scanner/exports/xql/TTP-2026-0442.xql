# TTP-2026-0442 — Windows Command Execution via PowerShell with C2 Communication
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unusual PowerShell Command Execution
# severity: high
# PowerShell process executing commands with hidden window and network activity

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter actor_process_image_name = 'explorer.exe'
| filter action_process_command_line contains 'WindowStyle Hidden'
| filter action_process_command_line contains 'Invoke-WebRequest' or action_process_command_line contains 'Start-Process'

## ABIOC — Suspicious PowerShell Network Activity (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: PowerShell process execution with network activity
# PowerShell process performing network communication with C2 after downloading payload

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_process_command_line contains 'TCPClient' or action_process_command_line contains 'WebClient'
| filter action_process_command_line contains '192.0.2.50'

## VALIDATION — PowerShell Download and Execute
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_process_command_line contains 'Invoke-WebRequest' and action_process_command_line contains 'Start-Process'
| filter action_process_command_line contains '192.0.2.10'

