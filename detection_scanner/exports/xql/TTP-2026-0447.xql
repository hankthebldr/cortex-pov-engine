# TTP-2026-0447 — Uncommon Network Connection via Newly Created Actor
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Network Connection Under Untrusted Actor
# severity: high
# Detects network activity originating from a newly created process under an untrusted causality actor

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name = '/tmp/.system/evil'
| filter action_remote_ip != '127.0.0.1'
| filter action_remote_ip != '0.0.0.0'
| filter action_remote_ip != '::'
| filter action_remote_ip != '192.0.2.0/24'
| filter action_remote_ip != '10.0.0.0/8'
| filter action_remote_ip != '172.16.0.0/12'
| filter action_remote_ip != '192.168.0.0/16'

## ABIOC — Newly Created Process Initiating Outbound Network Connection (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: causality_actor_process_image_name
# Detects a new process initiating a network connection to an external IP address, flagged as anomalous due to causality context

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_remote_ip != '127.0.0.1'
| filter action_remote_ip != '0.0.0.0'
| filter action_remote_ip != '::'
| filter action_remote_ip != '192.0.2.0/24'
| filter action_remote_ip != '10.0.0.0/8'
| filter action_remote_ip != '172.16.0.0/12'
| filter action_remote_ip != '192.168.0.0/16'

## VALIDATION — Hunt for Uncommon Network Connections Under New Actors
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name like '/tmp/.system/%'
| filter action_remote_ip != '127.0.0.1'
| filter action_remote_ip != '0.0.0.0'
| filter action_remote_ip != '::'
| filter action_remote_ip != '192.0.2.0/24'
| filter action_remote_ip != '10.0.0.0/8'
| filter action_remote_ip != '172.16.0.0/12'
| filter action_remote_ip != '192.168.0.0/16'
| comp count() by action_remote_ip, causality_actor_process_image_name

