# TTP-2026-0382 — Suspicious certutil usage for C2 communication
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious certutil command line
# severity: high
# Detection of certutil being invoked with -urlcache, -split, and -f flags to download and decode files

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'certutil.exe'
| filter action_process_command_line contains '-urlcache' and action_process_command_line contains '-split' and action_process_command_line contains '-f'

## ABIOC — Suspicious certutil usage for C2 (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name = 'certutil.exe'
# Behavioral deviation where certutil is used to download and decode files from remote C2 servers

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'certutil.exe'
| filter action_process_command_line contains '-urlcache' and action_process_command_line contains '-split' and action_process_command_line contains '-f'
| filter action_remote_ip = '192.0.2.100'

## VALIDATION — Detect certutil C2 usage
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'certutil.exe'
| filter action_process_command_line contains '-urlcache' and action_process_command_line contains '-split' and action_process_command_line contains '-f'
| filter action_remote_ip = '192.0.2.100'

