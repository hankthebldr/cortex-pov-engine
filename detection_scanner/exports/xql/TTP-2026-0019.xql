# TTP-2026-0019 — Prisma Browser — Sideloaded Risky Extension Install (T1176)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Prisma Browser — sideloaded extension blocked by managed-extension policy
# severity: high
# Prisma Browser — sideloaded extension blocked by managed-extension policy. An unsigned/sideloaded extension install attempt is denied by managed-browser policy and logged with outcome=blocked.

dataset = prisma_browser_events
| filter action = "extension-install"
| filter install_source in ("sideload", "crx", "developer-mode")
| filter outcome = "blocked"
| filter extension_id != null

## VALIDATION — Code scan — extension manifest declares <all_urls> + cookies + webRequest + webRequestBlocking
# purpose: validation
# dataset: koi_code_scan_events

dataset = koi_code_scan_events
| filter _time > to_timestamp(current_time() - 1800)
| filter artifact_type = "browser-extension"
| filter manifest_host_permissions contains "<all_urls>"
| filter manifest_permissions contains "cookies" and manifest_permissions contains "webRequest"
| fields _time, artifact_path, extension_id, manifest_host_permissions, manifest_permissions
| sort desc _time

## VALIDATION — Prisma Browser — extension permission risk score exceeds threshold
# purpose: validation
# dataset: prisma_browser_events

dataset = prisma_browser_events
| filter _time > to_timestamp(current_time() - 1800)
| filter action = "extension-install"
| filter extension_permission_risk_score >= 70
| fields _time, user, extension_id, extension_permission_risk_score, outcome
| sort desc _time

## VALIDATION — KOI — extension manifest signature does not match approved publisher list
# purpose: validation
# dataset: koi_code_scan_events

dataset = koi_code_scan_events
| filter _time > to_timestamp(current_time() - 1800)
| filter artifact_type = "browser-extension"
| filter publisher_approved = false or signature_valid = false
| fields _time, extension_id, publisher, publisher_approved, signature_valid
| sort desc _time

## VALIDATION — Browser-attacker JSONL records install_extension outcome=blocked
# purpose: validation
# dataset: prisma_browser_events

dataset = prisma_browser_events
| filter _time > to_timestamp(current_time() - 1800)
| filter campaign_id = "BC-BROWSER-003"
| filter action = "extension-install" and outcome = "blocked"
| fields _time, campaign_id, action, extension_id, outcome, cortex_canary
| sort desc _time

