# TTP-2026-0458 — Uncommon Signed Process Execution via Scheduled Task
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Signed Process Execution by Scheduled Task
# severity: high
# Detection of signed binary execution triggered by a scheduled task

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'C:\\Windows\\System32\\schtasks.exe'
| filter action_process_image_name contains 'cmd.exe'
| filter action_process_image_name contains 'powershell.exe'
| filter action_process_image_name contains 'C:\\Windows\\System32\\'

## ABIOC — Suspicious Scheduled Task Execution with Signed Binary (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'C:\\Windows\\System32\\schtasks.exe'
# Detection of signed binary execution initiated by a scheduled task, flagged as anomalous behavior

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'C:\\Windows\\System32\\schtasks.exe'
| filter action_process_image_name contains 'cmd.exe'
| filter action_process_image_name contains 'powershell.exe'
| filter action_process_image_name contains 'C:\\Windows\\System32\\'
| filter action_process_image_name contains 'a1b2c3d4e5f67890123456789012345678901234567890123456789012345678'

## VALIDATION — Scheduled Task Triggered Process Execution
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'C:\\Windows\\System32\\schtasks.exe'
| filter action_process_image_name contains 'cmd.exe'
| filter action_process_image_name contains 'powershell.exe'

