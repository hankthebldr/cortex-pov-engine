# TTP-2026-0044 — Backdoored PyPI Package With Import-Time Subprocess (T1195.002)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — KOI-003 PyPI Package Import Time Subprocess Spawn Post Install Hook
# severity: high
# Code scan — package __init__.py contains subprocess.run on import (post-install hook pattern). A python interpreter spawns a child process immediately on package import — the import-time subprocess shape a SAST/EDR control must flag.

preset = xdr_data
| filter event_type = ENUM.PROCESS
| filter event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name in ("python", "python3", "pip", "pip3")
| filter actor_process_image_name in ("python", "python3")
| filter action_process_image_command_line contains_any (".aws/credentials", "urllib.request", "urlopen", "-c")

## BIOC — KOI-003 Cortex Cloud SCA SBOM Digest Matches Known Bad Fingerprint
# severity: medium
# Cortex Cloud SCA — SBOM correlates package digest with known-bad fingerprint. The SCA/SBOM scan surfaces the typosquat package by name in the build toolchain command line, matching a known-bad fingerprint.

preset = xdr_data
| filter event_type = ENUM.PROCESS
| filter event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ("pip", "pip3", "python", "python3", "twistcli", "cortexcloud", "syft")
| filter action_process_image_command_line contains "mcp-server-helpers"

## VALIDATION — KOI-003 Backdoored PyPI Package Name Typosquats Canonical Helper
# purpose: validation
# dataset: xdr_data

preset = xdr_data
| filter _time > to_timestamp(current_time() - 1800)
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_command_line contains "mcp-server-helpers"
| fields _time, agent_hostname, actor_effective_username, actor_process_image_name, action_process_image_command_line

## VALIDATION — KOI-003 Outbound HTTPS To Non Canonical PyPI Mirror With Pip User Agent
# purpose: validation
# dataset: xdr_data

preset = xdr_data
| filter _time > to_timestamp(current_time() - 1800)
| filter event_type = ENUM.NETWORK
| filter dst_action_external_hostname contains "cortexsim-canary" or dns_query_name contains "cortexsim-canary"
| filter action_external_port = 443
| filter http_req_user_agent contains_any ("pip", "python-requests", "python-urllib") or actor_process_image_name in ("pip", "pip3", "python", "python3")
| fields _time, agent_hostname, causality_actor_process_image_name, causality_id, actor_process_image_name, actor_process_instance_id, dst_action_external_hostname, http_req_user_agent

## VALIDATION — KOI-003 PyPI Mirror Domain Matches Typosquat Of PyPI Org
# purpose: validation
# dataset: xdr_data

preset = xdr_data
| filter _time > to_timestamp(current_time() - 1800)
| filter event_type = ENUM.NETWORK
| filter dst_action_external_hostname contains "cortexsim-canary"
| filter action_external_url contains "/simple" or action_app_id_transitions contains "pypi"
| fields _time, agent_hostname, actor_process_image_name, dst_action_external_hostname, action_external_url

## VALIDATION — KOI-003 Cortex Cloud SCA Package Fails Publisher And Post Install Policy
# purpose: validation
# dataset: xdr_data

preset = xdr_data
| filter _time > to_timestamp(current_time() - 1800)
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ("pip", "pip3", "twistcli", "cortexcloud", "syft", "grep")
| filter action_process_image_command_line contains_any ("mcp-server-helpers", "subprocess", "__init__")
| fields _time, agent_hostname, actor_process_image_name, action_process_image_command_line

