# TTP-2026-0468 — Unsigned DLL Side-Loading via Malicious Process Execution
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unsigned DLL Side-Load
# severity: high
# Detection of unsigned DLLs loaded by legitimate processes

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'calc.exe'
| filter action_file_path contains 'temp\malicious.dll'
| filter action_file_path not in (whitelisted_paths)

