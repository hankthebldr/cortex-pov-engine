# TTP-2026-0393 — AWS SSM Agent Network Connection via PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious Network Connection from SSM Agent
# severity: high
# Detects outbound network connections initiated by the SSM agent process

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter causality_actor_process_image_name = 'ssmagent.exe'
| filter action_remote_ip = '192.0.2.100'
| filter dst_port = 80

## ABIOC — SSM Agent PowerShell Execution (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: ssmagent.exe executing powershell.exe
# Behavioral deviation where SSM agent spawns PowerShell with suspicious command line arguments

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name = 'ssmagent.exe'
| filter action_process_image_name = 'powershell.exe'
| filter action_process_command_line contains '-NoP -W Hidden -Exec Bypass'

## VALIDATION — Network Connection from SSM Agent
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter causality_actor_process_image_name = 'ssmagent.exe'
| filter action_remote_ip = '192.0.2.100'
| filter dst_port = 80

