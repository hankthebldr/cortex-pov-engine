# TTP-2026-0438 — Linux Shell Command Execution via Uncommon Interpreter
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Shell Command Execution
# severity: high
# Detection of shell commands executed via uncommon interpreters like perl or awk

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ('perl', 'awk', 'python') and actor_process_image_name = 'bash'
| filter action_command_line contains 'system' or action_command_line contains 'exec'

## ABIOC — Unusual Perl/Awk Command Execution (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'bash' and action_process_image_name in ('perl', 'awk')
# Behavioral deviation where shell commands are executed via uncommon interpreters like perl or awk

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ('perl', 'awk') and actor_process_image_name = 'bash'
| filter action_command_line contains 'system' or action_command_line contains 'exec'

## VALIDATION — Uncommon Shell Interpreter Usage
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ('perl', 'awk', 'python') and actor_process_image_name = 'bash'
| filter action_command_line contains 'system' or action_command_line contains 'exec'
| comp count() by action_process_image_name, action_command_line

