# TTP-2026-0445 — Uncommon Net Group Command Execution via Windows Endpoint
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Net Group Command Execution
# severity: high
# Detection of net.exe being executed with group enumeration arguments not seen in normal operations

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'net.exe'
| filter action_file_path contains 'net.exe'
| filter action_command_line contains 'group' and action_command_line contains '/domain'

## ABIOC — Behavioral Net Group Command Deviation (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_command_line
# ML-based anomaly detection of net.exe usage with group enumeration that deviates from baseline behavior

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'net.exe'
| filter action_command_line contains 'group' and action_command_line contains '/domain'
| filter not in (action_command_line, ["net group 'Domain Admins' /domain"])

## VALIDATION — Hunt for Unusual Net Group Commands
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'net.exe'
| filter action_command_line contains 'group' and action_command_line contains '/domain'
| filter not in (action_command_line, ["net group 'Domain Admins' /domain"])

