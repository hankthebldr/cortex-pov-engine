# TTP-2026-0323 — PowerShell Download and Execute via Command Line
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — PowerShell Download Command Line
# severity: high
# PowerShell process with command line containing DownloadFile or Invoke-WebRequest

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_command_line contains 'DownloadFile' or action_process_command_line contains 'Invoke-WebRequest'

## ABIOC — PowerShell Download and Execute (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'powershell.exe'
# PowerShell process with download and execution behavior in command line

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_command_line contains 'DownloadFile' and action_process_command_line contains 'Start-Process'

## VALIDATION — PowerShell Download Activity
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_command_line contains 'DownloadFile' or action_process_command_line contains 'Invoke-WebRequest'
| fields agent_hostname, actor_process_image_name, action_process_command_line

