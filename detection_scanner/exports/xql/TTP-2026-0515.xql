# TTP-2026-0515 — Automated Linux Privilege Escalation via Staged Traitor Binary
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Payload-Shelf Tool traitor-amd64 Executed From a Writable Path by a Service Account
# severity: high
# A non-root service account executes traitor-amd64 from /tmp/traitor-amd64 — a privilege-escalation/container-breakout tool staged into a writable path, distinct from normal admin tooling.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_path contains "/tmp/traitor-amd64" or action_process_image_path contains "/tmp/traitor-amd64"
| filter actor_effective_username != "root"
| comp count() as execs by agent_hostname, actor_effective_username, actor_process_image_path
| filter execs >= 1

## ABIOC — First-Seen Execution of a Privesc/Escape Tool From /tmp on This Host (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: payload-shelf file-write of /tmp/traitor-amd64 -> chmod +x -> first execution of traitor-amd64 by a service-account shell
# A host that has never run traitor-amd64 suddenly executes it from a writable path moments after the file is staged — the stage→chmod→exec chain of a deployed offensive tool.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name in ("sh","bash") and action_process_image_path contains "traitor-amd64"
| comp count() as first_runs by agent_hostname, action_process_image_path

## VALIDATION — Staged traitor-amd64 Execution on the Endpoint Feed
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_path contains "traitor-amd64"
| fields agent_hostname, actor_effective_username, action_process_image_path, action_process_command_line

