# TTP-2026-0351 — WinRM Session via PowerShell with C2 Communication
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rare WinRM Session
# severity: high
# Unusual PowerShell process initiating WinRM session to non-standard host

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_image_name = 'powershell.exe'
| filter causality_actor_process_image_name = 'powershell.exe'
| filter action_file_path contains 'WinRM'
| filter dst_ip = '192.0.2.10'

## ABIOC — Unusual PowerShell WinRM Session (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: WinRM session initiated by PowerShell
# PowerShell process initiating WinRM session with C2 communication

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_remote_ip = '192.0.2.50'
| filter dst_port = 8080

## VALIDATION — Detect Rare WinRM Sessions
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_remote_ip = '192.0.2.10'
| filter dst_port = 5985
| filter action_file_path contains 'WinRM'

