# TTP-2026-0260 — GitHub-based Command and Control with Rare URL Containment
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Contained Process Execution with Rare GitHub URL
# severity: high
# Process execution initiated from a contained environment with a rare GitHub URL

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = '/bin/bash'
| filter action_file_path = '/tmp/evil/payload.exe'
| filter causality_actor_process_image_name = '/bin/bash'
| filter action_remote_ip = '192.0.2.1'

## ABIOC — Rare GitHub URL Containment (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = '/bin/bash'
# Execution of process from a contained environment using a rare GitHub URL

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_remote_ip = '192.0.2.1'
| filter action_file_path = '/tmp/evil/payload.exe'
| filter causality_actor_process_image_name = '/bin/bash'

