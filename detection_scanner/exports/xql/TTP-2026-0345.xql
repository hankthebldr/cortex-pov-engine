# TTP-2026-0345 — SMB Session to Remote Host via PsExec
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rare SMB Session to Remote Host
# severity: high
# Detection of an SMB session initiated to a remote host that is not typical for the host

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip != '192.0.2.0/24'
| filter dst_port = 445
| filter actor_process_image_name = 'psexec.exe'
| filter causality_actor_process_image_name != 'svchost.exe'

## ABIOC — SMB Session Initiated by PsExec (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'psexec.exe'
# Behavioral ABIOC that flags an SMB session initiated by PsExec process, which is unusual for typical host behavior

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip != '192.0.2.0/24'
| filter dst_port = 445
| filter actor_process_image_name = 'psexec.exe'
| filter causality_actor_process_image_name != 'svchost.exe'

