# TTP-2026-0196 — Linux Credential Theft via Browser Data Extraction
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — NonBrowserAccessToLoginData
# severity: high
# Detects non-browser processes reading Chrome/Edge Login Data or Local State files

dataset = xdr_data
| filter event_type = ENUM.FILE_ACCESS
| filter action_file_path contains 'Login Data' or action_file_path contains 'Local State'
| filter actor_process_image_name != 'chrome' and actor_process_image_name != 'firefox' and actor_process_image_name != 'edge'
| filter causality_actor_process_image_name != 'chrome' and causality_actor_process_image_name != 'firefox' and causality_actor_process_image_name != 'edge'

## VALIDATION — BrowserCredentialAccessHunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.FILE_ACCESS
| filter action_file_path contains 'Login Data' or action_file_path contains 'Local State'
| filter actor_process_image_name != 'chrome' and actor_process_image_name != 'firefox' and actor_process_image_name != 'edge'
| comp count() as cnt by actor_process_image_name, action_file_path
| comp count() as cnt by

