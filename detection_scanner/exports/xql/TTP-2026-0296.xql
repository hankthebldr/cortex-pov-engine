# TTP-2026-0296 — Memory Dumping via comsvcs.dll
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Memory Dumping via comsvcs.dll
# severity: high
# Detection of rundll32.exe loading comsvcs.dll to perform memory dumping

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'rundll32.exe'
| filter causality_actor_process_image_name = 'msiexec.exe'
| filter action_file_path contains 'comsvcs.dll'

