# TTP-2026-0342 — RDP Session to Remote Host with Credential Theft
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rare RDP Session to Remote Host
# severity: high
# Detection of an RDP session to a remote host that is not typical for the user or host

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECTION_ESTABLISHED
| filter action_process_image_name = 'mstsc.exe'
| filter dst_port = 3389
| filter action_remote_ip = '192.0.2.10'
| filter agent_hostname != 'RDP-TEST-HOST'
| filter not (agent_hostname in ('RDP-TEST-HOST', 'RDP-DEV-HOST'))

## ABIOC — Unusual RDP Session with Credential Extraction (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: RDP session to remote host
# RDP session followed by credential extraction commands

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECTION_ESTABLISHED
| filter action_process_image_name = 'mstsc.exe'
| filter dst_port = 3389
| filter action_remote_ip = '192.0.2.10'
| filter agent_hostname != 'RDP-TEST-HOST'
| filter not (agent_hostname in ('RDP-TEST-HOST', 'RDP-DEV-HOST'))
| join (dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'cmd.exe'
| filter action_file_path contains 'user.txt') on causality_actor_process_image_name = action_process_image_name

## VALIDATION — Detect RDP Sessions to Non-Standard Hosts
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECTION_ESTABLISHED
| filter action_process_image_name = 'mstsc.exe'
| filter dst_port = 3389
| filter action_remote_ip = '192.0.2.10'
| filter agent_hostname != 'RDP-TEST-HOST'
| filter not (agent_hostname in ('RDP-TEST-HOST', 'RDP-DEV-HOST'))

