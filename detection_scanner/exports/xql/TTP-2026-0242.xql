# TTP-2026-0242 — RDP Brute Force and Lateral Movement
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Multiple RDP Connections to Different Hosts
# severity: high
# Detection of multiple RDP connections to different hosts within a short time window

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and action_remote_ip != null and dst_port = 3389
| comp count() as cnt by action_remote_ip
| comp count() as cnt by agent_hostname | filter count() > 5

## ABIOC — Abnormal RDP Connections to Multiple Hosts (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: network-connection
# Behavioral deviation where RDP connections are made to multiple hosts in rapid succession, indicating lateral movement

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and action_remote_ip != null and dst_port = 3389
| comp count() as cnt by action_remote_ip
| comp count() as cnt by agent_hostname | filter count() > 5

## VALIDATION — RDP Connection Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and dst_port = 3389
| comp count() as cnt by action_remote_ip
| comp count() as cnt by agent_hostname | filter count() > 5

