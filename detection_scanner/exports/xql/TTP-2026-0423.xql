# TTP-2026-0423 — Uncommon AppleScript with Discovery Command via Command Line
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon AppleScript Discovery Execution
# severity: high
# Detection of AppleScript execution with discovery-related commands

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'osascript'
| filter action_file_path contains 'script.scpt'
| filter causality_actor_process_image_name = 'bash' or causality_actor_process_image_name = 'sh'

## ABIOC — AppleScript Discovery Command Execution (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: osascript process execution
# Behavioral deviation of AppleScript execution with discovery commands via command line

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'osascript'
| filter action_file_path contains 'script.scpt'
| filter causality_actor_process_image_name = 'bash' or causality_actor_process_image_name = 'sh'
| filter actor_process_image_name = 'bash'
| filter action_file_path contains '.scpt'

## VALIDATION — AppleScript Discovery Command Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'osascript'
| filter action_file_path contains 'script.scpt'
| filter causality_actor_process_image_name = 'bash' or causality_actor_process_image_name = 'sh'
| comp count() by action_process_image_name, action_file_path, causality_actor_process_image_name

