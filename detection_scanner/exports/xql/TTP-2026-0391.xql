# TTP-2026-0391 — Smurf Attack via ICMP Flooding
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious ICMP Traffic
# severity: high
# Detection of ICMP echo requests sent to broadcast address with large payload size

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.1'
| filter dst_port = 1
| filter action_protocol = ENUM.ICMP
| filter action_bytes > 1000

## ABIOC — ICMP Broadcast Flooding (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name = 'ping.exe'
# Behavioral deviation detected when ICMP echo requests are sent to broadcast address with large payloads

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip like '255.255.255.255'
| filter action_protocol = ENUM.ICMP
| filter action_bytes > 1000
| filter action_process_image_name = 'ping.exe'

## VALIDATION — Hunt for Smurf-like ICMP Traffic
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_protocol = ENUM.ICMP
| filter action_remote_ip like '255.255.255.255'
| filter action_bytes > 1000
| comp count() by action_process_image_name

