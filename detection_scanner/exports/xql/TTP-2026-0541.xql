# TTP-2026-0541 — Offensive Tooling: sqlmap (adapter-deployed)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Sqlmap Executed by a Service Account on the Endpoint
# severity: high
# A non-interactive service account runs sqlmap — an offensive TOOL-SQLMAP-wired tool not part of normal operations on this host.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_path contains "sqlmap" or action_process_command_line contains "sqlmap"
| comp count() as runs by agent_hostname, actor_effective_username
| filter runs >= 1

## ABIOC — First-Seen Execution of sqlmap on This Host (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: adapter deploy/stage of sqlmap -> first execution by a service-account shell
# A host that has never run sqlmap executes it shortly after it is staged/installed — the deploy-then-run chain of an offensive tool.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_command_line contains "sqlmap"
| comp count() as first_runs by agent_hostname

## VALIDATION — Sqlmap Execution Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_command_line contains "sqlmap"
| fields agent_hostname, actor_effective_username, action_process_image_name, action_process_command_line

