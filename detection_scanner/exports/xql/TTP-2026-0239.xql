# TTP-2026-0239 — TOR Network Communication via Uncommon Port
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — TOR Process Start with Uncommon Port
# severity: high
# Detection of TOR process starting with communication on non-standard port

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = '/tmp/scratch/tor_binary'
| filter dst_port = 9050

## ABIOC — Abnormal TOR Network Communication (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name
# Detection of TOR process communicating through an uncommon port

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.1'
| filter dst_port = 9050
| filter action_process_image_name = '/tmp/scratch/tor_binary'

## VALIDATION — TOR Communication Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.1'
| filter dst_port = 9050
| filter action_process_image_name = '/tmp/scratch/tor_binary'

