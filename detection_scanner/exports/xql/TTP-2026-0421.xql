# TTP-2026-0421 — Uncommon AppleScript Execution via Command Line to External Server
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon AppleScript Execution via Command Line
# severity: high
# Detection of osascript executed from command-line interface with no visible terminal context

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'osascript'
| filter causality_actor_process_image_name != 'bash' and causality_actor_process_image_name != 'zsh'
| filter action_file_path = '/tmp/script.scpt'

## ABIOC — Suspicious AppleScript Process Start from CLI (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: osascript process start from non-terminal context
# Behavioral deviation where osascript is invoked directly from CLI without terminal context

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'osascript'
| filter causality_actor_process_image_name not in ('bash', 'zsh', 'sh')

## VALIDATION — Detect osascript from CLI
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'osascript'
| filter causality_actor_process_image_name not in ('bash', 'zsh', 'sh')
| fields agent_hostname, action_process_image_name, causality_actor_process_image_name

