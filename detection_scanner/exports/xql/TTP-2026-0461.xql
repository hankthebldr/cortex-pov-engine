# TTP-2026-0461 — Uncommon VNC Server Communication via Windows Endpoint
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon VNC Server Process Start
# severity: high
# Detection of VNC server executable being started on Windows endpoint

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'vncserver.exe'

## ABIOC — Uncommon VNC Server Network Communication (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start_vncserver
# Detection of outbound network connection from VNC server process to external IP

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_CONNECT
| filter action_remote_ip = '192.0.2.1' and dst_port = 5900

## VALIDATION — VNC Server Process Execution Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'vncserver.exe'
| fields actor_process_image_name, action_process_image_name, agent_hostname

## VALIDATION — VNC Server Network Connection Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_CONNECT
| filter dst_port = 5900 and action_remote_ip = '192.0.2.1'
| fields dst_ip, dst_port, action_remote_ip, agent_hostname

