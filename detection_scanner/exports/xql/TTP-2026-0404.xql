# TTP-2026-0404 — RunOnce Parent Process Attack
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious RunOnce Parent Process
# severity: high
# Detects execution of a process from a RunOnce registry key with an unexpected parent process

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name = 'explorer.exe' and action_process_image_name = 'cmd.exe'
| filter action_file_path contains 'RunOnce'

## ABIOC — RunOnce Execution with Suspicious Parent (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: explorer.exe launching cmd.exe from RunOnce
# Detects execution via RunOnce registry with parent process that is not typically associated with such activity

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name = 'explorer.exe'
| filter action_file_path contains 'RunOnce'

## VALIDATION — RunOnce Registry Modifications
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.REGISTRY and action_file_path contains 'RunOnce'
| filter action_process_image_name = 'reg.exe'

