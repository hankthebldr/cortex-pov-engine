# TTP-2026-0192 — Process Hollowing via svchost.exe
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Process Hollowing - Parent-Child Mismatch
# severity: high
# Detects when a process is created with a parent process image name that does not match the child's actual image.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'svchost.exe'
| filter action_process_image_name != 'svchost.exe'
| filter action_file_path contains 'VirtualAllocEx'
| filter action_file_path contains 'WriteProcessMemory'
| filter action_file_path contains 'SetThreadContext'

## VALIDATION — Process Hollowing Hunt Query
# purpose: validation
