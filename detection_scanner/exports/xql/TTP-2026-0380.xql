# TTP-2026-0380 — Suspicious Authentication Package Registration via Regsvr32
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious Authentication Package Registration
# severity: high
# Detection of a process registering an authentication package via regsvr32

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'regsvr32.exe'
| filter action_command_line contains 'C:\\temp\\malicious.dll'

## ABIOC — Suspicious Authentication Package Registration Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Behavioral deviation detected when regsvr32 registers an authentication package

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'regsvr32.exe'
| filter action_command_line contains 'C:\\temp\\malicious.dll'

## VALIDATION — Detect Suspicious Regsvr32 Usage
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'regsvr32.exe'
| filter action_command_line contains 'C:\\temp\\malicious.dll'
| filter action_remote_ip = '192.0.2.1'

