# TTP-2026-0553 — Linux Archive-Then-SSH Exfiltration Attempt — tar and gzip Archive Handed to scp and Piped to ssh (.invalid host, fails by design)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## VALIDATION — EDR-027 Decoy Tree Written Under Hidden Var Tmp Staging Directory
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 3600
| filter (event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_CREATE_NEW, ENUM.FILE_WRITE) and action_file_path contains "/var/tmp/.cortexsim-sshexfil/stage/") or (event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START and action_process_image_name = "dd" and action_process_image_command_line contains "/var/tmp/.cortexsim-sshexfil/stage/blobs/")
| fields _time, agent_hostname, actor_causality_id, actor_process_image_name, event_sub_type, action_file_path, action_process_image_command_line

## VALIDATION — EDR-027 Tar Creates Gzip Archive Of The Staging Tree
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 3600
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = "tar" and action_process_image_command_line contains "-czf"
| filter action_process_image_command_line contains "/var/tmp/.cortexsim-sshexfil/out/collect-stage.tar.gz"
| fields _time, agent_hostname, actor_causality_id, causality_actor_process_image_name, actor_process_image_name, action_process_image_command_line

## VALIDATION — EDR-027 Scp Started With The Archive And A Remote Destination
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 3600
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = "scp" and action_process_image_command_line contains "/var/tmp/.cortexsim-sshexfil/out/collect-stage.tar.gz"
| filter action_process_image_command_line contains "cortexsim-canary.invalid"
| fields _time, agent_hostname, actor_causality_id, causality_actor_process_image_name, actor_process_image_name, action_process_image_command_line

## VALIDATION — EDR-027 Ssh Started With A Remote Archive Write Fed By A Tar Pipe
# purpose: validation
