## VALIDATION — EDR-027 Rm Deletes The Archive After The Attempt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 3600
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = "rm" and action_process_image_command_line contains "/var/tmp/.cortexsim-sshexfil/out/collect-stage.tar.gz"
| fields _time, agent_hostname, actor_causality_id, causality_actor_process_image_name, actor_process_image_name, action_process_image_command_line

## VALIDATION — EDR-027 Hunt — SSH Client Starts That Name A Compressed Archive, Per Host (any Linux endpoint; this chain yields scp and ssh rows)
# purpose: hunt
# dataset: xdr_data

dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 604800
| filter agent_os_type = ENUM.AGENT_OS_LINUX
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ("scp", "sftp", "ssh")
| filter action_process_image_command_line ~= "[.](tar[.]gz|tgz|tar[.]bz2|tbz2|tar[.]xz|txz|tar[.]zst|zip|7z|gz)([^A-Za-z0-9]|$)"
| comp count() as starts, min(_time) as first_seen, max(_time) as last_seen by agent_hostname, action_process_image_name
| sort desc starts

## VALIDATION — EDR-027 Hunt — SSH Client Network Rows On Port 22 (the leg a real transfer adds; this chain produces no row by design)
# purpose: hunt
# dataset: xdr_data

dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 604800
| filter agent_os_type = ENUM.AGENT_OS_LINUX
| filter event_type = ENUM.NETWORK
| filter actor_process_image_name in ("ssh", "scp", "sftp") and action_remote_port = 22
| fields _time, agent_hostname, actor_causality_id, actor_process_image_name, actor_process_command_line, action_remote_ip, action_remote_port

## VALIDATION — EDR-027 Chain Read-Back — Every Process Start That Names The Sandbox Or The Canary Host, In Order
# purpose: investigation
# dataset: xdr_data

dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 3600
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_command_line contains "/var/tmp/.cortexsim-sshexfil" or action_process_image_command_line contains "cortexsim-canary.invalid"
| fields _time, agent_hostname, actor_causality_id, causality_actor_process_image_name, actor_process_image_name, action_process_image_name, action_process_image_command_line
| sort asc _time

## VALIDATION — EDR-027 Investigation — Gzip -9 Of The Collected File (not declared: no event recorded on the lab endpoint)
# purpose: investigation
# dataset: xdr_data

// Not declared: in both lab runs on pov-target-01 (2026-11-14) the agent recorded no event for this gzip start, so this query returned 0 rows and a row on it would read fail on a healthy tenant.
dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 3600
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = "gzip" and action_process_image_command_line contains "-9"
| filter action_process_image_command_line contains "/var/tmp/.cortexsim-sshexfil/out/ledger-all.csv"
| fields _time, agent_hostname, actor_causality_id, causality_actor_process_image_name, actor_process_image_name, action_process_image_command_line

