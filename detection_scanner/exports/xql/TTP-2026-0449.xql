# TTP-2026-0449 — Node.js Package Communication to External Host
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Node.js package initiated communication
# severity: high
# Detection of Node.js process starting and connecting to external host

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'node'
| filter action_remote_ip = '192.0.2.10'

## ABIOC — Uncommon Node.js package initiated communication (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: node process start with outbound connection
# Behavioral deviation where Node.js package initiates communication to external host

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'node'
| filter action_remote_ip = '192.0.2.10'

## VALIDATION — Node.js outbound communication
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_process_image_name = 'node'
| filter action_remote_ip = '192.0.2.10'

