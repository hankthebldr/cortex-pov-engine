# TTP-2026-0362 — Remote service command execution from uncommon source
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unusual PsExec execution
# severity: high
# Execution of psexec.exe from an IP address not typically seen in the environment

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'psexec.exe'
| filter action_remote_ip != '192.0.2.10'
| filter action_remote_ip != '192.0.2.11'
| filter action_remote_ip != '192.0.2.12'

## ABIOC — Remote service command execution from uncommon source (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: psexec.exe process start
# Execution of a remote service command from a source IP address not typically seen in the environment

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip != '192.0.2.10'
| filter action_remote_ip != '192.0.2.11'
| filter action_remote_ip != '192.0.2.12'
| filter action_remote_ip != '192.0.2.13'
| filter action_remote_ip != '192.0.2.14'

## VALIDATION — Unusual PsExec execution detection
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'psexec.exe'
| filter action_remote_ip != '192.0.2.10'
| filter action_remote_ip != '192.0.2.11'
| filter action_remote_ip != '192.0.2.12'
| filter action_remote_ip != '192.0.2.13'
| filter action_remote_ip != '192.0.2.14'

