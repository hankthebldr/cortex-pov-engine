# TTP-2026-0201 — npm Supply-Chain Compromise on a Linux Developer Endpoint — Preinstall-Hook Credential Theft via a Phantom-Squatted Package
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — KOI-010 Multi Credential File Read Under npm Node CGO
# severity: high
# Three or more distinct developer credential-named files (SSH private keys, .npmrc token, AWS credentials, .env, agent MCP config, .git/config) are read in one window by a process in the npm/node install causality chain. An install-hook descendant that reads this set is stealing, not building. Card-only deployable content: not declared as a scenario expectation, so a tenant without it deployed is never scored a MISS; the equivalent behavioural ABIOC is the declared, agent-raised twin.

dataset = xdr_data
| filter event_type = ENUM.FILE
| filter event_sub_type in (ENUM.FILE_OPEN, ENUM.FILE_READ)
| filter causality_actor_process_image_name in ("npm", "node")
| filter action_file_path contains_any (".ssh/id_rsa", ".ssh/id_ed25519", ".npmrc", ".aws/credentials", ".env", ".claude/mcp.json", ".claude.json", ".kiro/settings/mcp.json", ".git/config", ".git-credentials")
| comp count_distinct(action_file_path) as secret_files_read, values(action_file_path) as paths by agent_hostname, actor_causality_id, causality_actor_process_instance_id, actor_process_image_name
| filter secret_files_read >= 3
| fields agent_hostname, actor_causality_id, causality_actor_process_instance_id, actor_process_image_name, paths, secret_files_read

## BIOC — KOI-010 Credential Archive Egress From npm Install Lineage
# severity: high
# A process in the npm/node install causality chain uploads bytes to the campaign's dead-drop / C2 hosts (or the lab's non-resolving placeholder). Card-only HUNT content: it needs a firewall/sink in path, so it is not declared as a scenario expectation and a sink-less run is never scored against it.

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter causality_actor_process_image_name in ("npm", "node", "curl")
| filter action_external_hostname in ("cortexsim-koi010.invalid", "audit.checkmarx.cx") or dst_action_external_hostname in ("cortexsim-koi010.invalid", "audit.checkmarx.cx")
| filter action_total_upload > 0
| comp sum(action_total_upload) as bytes_out by agent_hostname, actor_causality_id, action_external_hostname
| filter bytes_out > 0
| fields agent_hostname, actor_causality_id, action_external_hostname, bytes_out

## ABIOC — KOI-010 Uncommon Shell Command Execution Under npm Install Hook Lineage (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: The npm/node install process (Causality Group Owner) and its causality_actor_process_instance_id; the deviation is an uncommon install-time exec (node setup.mjs from the preinstall hook) against the baseline of package installs that spawn no interpreters.
# Behavioral-ML deviation (the built-in 'uncommon Linux shell command execution' analytic, scoped to causality): the npm/node install process spawns a child exec that is anomalous for the npm/node install causality on this host — node running an install-time script (setup.mjs) out of the preinstall hook. Package installs rarely spawn arbitrary interpreters; a first-seen package doing it at install time is the lifecycle-hook detonation shape.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name in ("npm", "node", "npm-cli.js") or actor_process_image_name in ("npm", "node")
| filter action_process_image_command_line contains_any ("setup.mjs", "preinstall", "postinstall", "bun run index.js")
| comp count() as uncommon_execs, values(action_process_image_command_line) as child_cmdlines by agent_hostname, actor_causality_id, causality_actor_process_image_name, causality_actor_process_instance_id
| filter uncommon_execs >= 1
| fields agent_hostname, actor_causality_id, causality_actor_process_image_name, causality_actor_process_instance_id, child_cmdlines, uncommon_execs

## ABIOC — KOI-010 npm Install Hook Descendant Reads Multiple Developer Credential Files (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: The npm/node install process (Causality Group Owner); the deviation is an install-hook descendant reading a multi-credential set in one window against the baseline of installs that read only package metadata.
# Behavioral credential-access verdict: a descendant of the npm/node install lineage reads three or more distinct developer credential-named files (SSH keys, .npmrc token, AWS credentials, .env, agent MCP config, .git/config) in one window. An install hook that reads this set is harvesting, not resolving dependencies.

dataset = xdr_data
| filter event_type = ENUM.FILE
| filter event_sub_type in (ENUM.FILE_OPEN, ENUM.FILE_READ)
| filter causality_actor_process_image_name in ("npm", "node")
| filter action_file_path contains_any (".ssh/id_", ".npmrc", ".aws/credentials", ".env", ".claude/mcp.json", ".claude.json", ".kiro/settings/mcp.json", ".git/config", ".git-credentials")
| comp count_distinct(action_file_path) as secret_files_read, values(action_file_path) as paths by agent_hostname, actor_causality_id, causality_actor_process_instance_id
| filter secret_files_read >= 3
| fields agent_hostname, actor_causality_id, causality_actor_process_instance_id, paths, secret_files_read

## VALIDATION — KOI-010 Malicious npm Package With Preinstall Lifecycle Hook Created On Developer Endpoint
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 1800
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_CREATE_NEW, ENUM.FILE_WRITE)
| filter action_file_path contains "/.cache/koi010-pkg/" and action_file_name in ("package.json", "setup.mjs", "harvest.mjs")
| fields _time, agent_hostname, actor_causality_id, actor_process_image_name, action_file_path

