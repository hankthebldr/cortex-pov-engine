# TTP-2026-0201 — PsExec Lateral Movement via Remote Service Creation
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — PsExec Remote Process Execution
# severity: high
# Detection of PsExec process starting with remote service execution

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'psexec.exe'
| filter action_process_image_name = 'cmd.exe'
| filter action_remote_ip != null

## ABIOC — Attempt to execute a command on a remote host using PsExec (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: PsExec process start with remote IP
# Detection of PsExec creating a remote service and executing a command

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'psexec.exe'
| filter action_remote_ip = '192.0.2.10'
| filter action_process_image_name = 'cmd.exe'

## VALIDATION — PsExec Remote Execution Detection
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'psexec.exe'
| filter action_remote_ip != null
| filter action_process_image_name = 'cmd.exe'
| fields agent_hostname, actor_process_image_name, action_remote_ip, action_process_image_name

