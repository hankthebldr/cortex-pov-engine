# TTP-2026-0205 — Windows Service Creation with Rare Binary Path for Persistence
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Service Binary Path
# severity: high
# Detection of a service being started with a binary path that is not commonly seen in enterprise environments

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'sc.exe'
| filter action_file_path contains 'C:\\temp\\malware\\malware.exe'
| filter action_file_path not in (known_service_paths)

## ABIOC — An uncommon service was started (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_file_path
# Detection of a new service being started with a binary path that deviates from typical service binaries

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'sc.exe'
| filter action_file_path not in (known_service_paths)
| filter action_file_path contains 'C:\\temp\\malware\\malware.exe'

## VALIDATION — Uncommon Service Start Detection
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'sc.exe'
| filter action_file_path not in (known_service_paths)
| filter action_file_path contains 'C:\\temp\\malware\\malware.exe'
| fields agent_hostname, action_file_path, action_process_image_name

