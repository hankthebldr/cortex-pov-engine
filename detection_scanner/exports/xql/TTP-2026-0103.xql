# TTP-2026-0103 — Cloud Workload IAM Usage Anomaly — Cortex Analytics Behavioral IOC (ABIOC) (T1078.004 / T1580)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## ABIOC — CDR-016 Anomalous IAM API-Call Rate Spike from Baselined Workload Role (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Learned workload-identity usage baseline (a few API calls per hour) -> assumed-role session -> API-call-rate spike from a source IP/user-agent new for this identity, anchored to the originating session.
# A cloud workload identity whose learned Cortex baseline is a narrow set of API calls at a low, steady rate suddenly issues a burst of calls well above its learned rate within a short window. ABIOC anchors the deviation to the causality chain (assumed-role session -> call-rate spike from a source/agent new for this identity) rather than to any known-bad API name, catching post-compromise credential abuse a static rule keyed on a specific action would miss.

dataset = cloud_audit_logs
| filter cloud_provider = "AWS" and identity_type = "AssumedRole"
| filter _time > to_timestamp(current_time() - 300)
| comp count() as call_count by identity_name, caller_ip
| filter call_count >= 30
| sort desc call_count
| fields identity_name, caller_ip, call_count

## ABIOC — CDR-016 New-Action-Set Deviation from Learned IAM Usage Baseline (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Assumed-role session -> fan-out of Discovery/IAM actions that diverge from the role's learned action set, anchored to the session that first exhibited the new actions.
# A workload role whose learned action set is a small, stable list of application API calls suddenly invokes Discovery and IAM actions it has never used in its learned profile. Every action is a legitimate AWS call; the ABIOC fires on the new-action-set deviation from the identity's learned behavior, anchored to the assumed-role session that issued them.

dataset = cloud_audit_logs
| filter cloud_provider = "AWS" and identity_type = "AssumedRole"
| filter operation_name in ("GetCallerIdentity", "ListUsers", "ListRoles", "DescribeInstances", "ListBuckets")
| comp count_distinct(operation_name) as new_actions by identity_name, caller_ip
| filter new_actions >= 3
| sort desc new_actions
| fields identity_name, caller_ip, new_actions

## VALIDATION — CDR-016 Workload Role IAM Baseline Learned
# purpose: validation
# dataset: cloud_audit_logs

dataset = cloud_audit_logs
| filter _time > to_timestamp(current_time() - 900)
| filter cloud_provider = "AWS" and identity_type = "AssumedRole"
| comp count_distinct(operation_name) as baseline_actions by identity_name
| filter baseline_actions >= 1
| fields identity_name, baseline_actions

## VALIDATION — CDR-016 New-Action Deviation Surfaced in Cloud Audit Log
# purpose: validation
# dataset: cloud_audit_logs

dataset = cloud_audit_logs
| filter _time > to_timestamp(current_time() - 900)
| filter cloud_provider = "AWS" and identity_type = "AssumedRole"
| filter operation_name in ("GetCallerIdentity", "ListUsers", "ListRoles", "DescribeInstances", "ListBuckets")
| comp count() as deviation_calls by identity_name
| filter deviation_calls >= 1
| fields identity_name, deviation_calls

