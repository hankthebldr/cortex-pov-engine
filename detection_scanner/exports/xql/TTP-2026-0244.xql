# TTP-2026-0244 — Windows Endpoint: Abnormal Recurring Communications to Rare Domain
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Process Start with Execution Policy Bypass
# severity: high
# Detects PowerShell starting with -ExecutionPolicy Bypass

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe' and action_process_image_name = 'powershell.exe'
| filter action_process_command_line contains '-ExecutionPolicy Bypass'

## ABIOC — Abnormal Recurring Communications to Rare Domain (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name = 'powershell.exe' and action_process_command_line contains 'DownloadFile'
# Detects recurring outbound network connections to a rare domain

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.10'
| filter dst_port = 80
| filter action_process_image_name = 'powershell.exe'
| filter action_process_command_line contains 'DownloadFile'
| comp by action_remote_ip, action_process_image_name, dst_port
| comp count() as cnt by > 1

## VALIDATION — Hunt for PowerShell with Execution Policy Bypass
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_command_line contains '-ExecutionPolicy Bypass'
| comp count() as cnt by action_process_command_line, action_process_image_name
| comp count() as cnt by

