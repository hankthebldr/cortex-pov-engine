# TTP-2026-0227 — Windows Process Connecting to Rare Cloud Resource
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Process connecting to rare cloud resource
# severity: high
# Detects a process connecting to an IP address that is not commonly seen in the environment

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip in (SELECT remote_ip FROM rare_cloud_ips)
| filter action_process_image_name != 'System'
| filter causality_actor_process_image_name != 'System'

## ABIOC — Rare cloud resource connection (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_remote_ip
# Detects behavioral deviation when a process connects to a rare cloud resource IP address

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip in (SELECT remote_ip FROM rare_cloud_ips)
| filter action_process_image_name != 'System'
| filter causality_actor_process_image_name != 'System'

## VALIDATION — Rare cloud resource connections
