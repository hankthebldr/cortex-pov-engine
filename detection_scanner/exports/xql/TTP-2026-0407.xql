# TTP-2026-0407 — Suspicious setspn.exe Execution via PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious setspn.exe execution
# severity: high
# Detection of setspn.exe being executed with suspicious parameters to enumerate service accounts

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'setspn.exe'
| filter causality_actor_process_image_name = 'powershell.exe'
| filter action_file_path contains 'setspn.exe'

