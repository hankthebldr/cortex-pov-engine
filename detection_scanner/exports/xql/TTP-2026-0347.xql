# TTP-2026-0347 — Windows Attack Using Rare Process Behavior to Divide Files by Size
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rare Windows Process Divided Files by Size
# severity: high
# Detection of Windows process splitting files by size, an uncommon behavior in Windows environments.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_image_name = 'powershell.exe'
| filter action_file_path contains 'split'
| filter action_file_path contains 'size'

## ABIOC — Rare Windows Process Splitting Files by Size (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: powershell.exe invoking file split operations
# Behavioral deviation where a Windows process is observed splitting a file by size, which is rare in typical Windows environments.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_image_name = 'powershell.exe'
| filter action_file_path contains 'split'
| filter action_file_path contains 'size'

## VALIDATION — Detect Rare File Splitting Behavior
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_file_path contains 'split'
| filter action_file_path contains 'size'
| comp count() as cnt by action_file_path
| comp count() as cnt by

