# TTP-2026-0298 — Office Process Injection via PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Office Injects Code into Process
# severity: high
# Microsoft Office launches a process that injects code into another process

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'winword.exe' or actor_process_image_name = 'excel.exe'
| filter action_process_image_name != 'winword.exe' and action_process_image_name != 'excel.exe'
| filter causality_actor_process_image_name = 'winword.exe' or causality_actor_process_image_name = 'excel.exe'

## ABIOC — Office Process Injection Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Office process initiating injection
# Office application launching a process with code injection behavior

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'winword.exe' or actor_process_image_name = 'excel.exe'
| filter action_process_image_name != 'winword.exe' and action_process_image_name != 'excel.exe'
| filter causality_actor_process_image_name = 'winword.exe' or causality_actor_process_image_name = 'excel.exe'

