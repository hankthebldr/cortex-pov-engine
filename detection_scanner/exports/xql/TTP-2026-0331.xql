# TTP-2026-0331 — Unsigned Process Communicating Over Email Ports to External Server
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rare communication over email ports to external email server by unsigned process
# severity: high
# Detection of unsigned process making outbound connection to email port 25

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name != 'signed.exe'
| filter action_remote_ip in ('192.0.2.1') and dst_port = 25
| filter causality_actor_process_image_name != 'signed.exe'

## ABIOC — Unsigned process connecting to email port 25 (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name
# Behavioral deviation where unsigned process makes outbound connection to email port 25

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter dst_port = 25
| filter action_process_image_name != 'signed.exe'
| filter action_remote_ip in ('192.0.2.1')

## VALIDATION — Detect unsigned process connecting to email port
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter dst_port = 25
| filter action_process_image_name != 'signed.exe'
| filter action_remote_ip in ('192.0.2.1')
| comp count() by action_process_image_name, dst_ip, dst_port

