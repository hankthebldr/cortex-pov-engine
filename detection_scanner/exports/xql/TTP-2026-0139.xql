dataset = cloud_audit_logs
| filter _time > to_timestamp(current_time() - 1800)
| filter cloud_provider = "GCP"
| filter principal_email contains "gcp-sa-aiplatform-re.iam.gserviceaccount.com"
| filter method_name in ("storage.objects.list", "storage.objects.get", "storage.buckets.list")
| comp count() as reads by principal_email, caller_project, resource_project
| filter reads >= 1
| fields principal_email, caller_project, resource_project, reads

## VALIDATION — AISPM-007 P4SA Artifact Registry Private Reasoning-Engine Image Pull
# purpose: validation
# dataset: cloud_audit_logs

dataset = cloud_audit_logs
| filter _time > to_timestamp(current_time() - 1800)
| filter cloud_provider = "GCP"
| filter principal_email contains "gcp-sa-aiplatform-re.iam.gserviceaccount.com"
| filter method_name in ("artifactregistry.dockerimages.get", "artifactregistry.dockerimages.list")
| filter resource_name contains "cloud-aiplatform-private"
| comp count() as image_pulls by principal_email, resource_name
| filter image_pulls >= 1
| fields principal_email, resource_name, image_pulls

## VALIDATION — AISPM-007 Over-Privileged Vertex AI P4SA Default Grant Posture Finding
# purpose: validation
# dataset: ai_spm_findings

dataset = ai_spm_findings
| filter _time > to_timestamp(current_time() - 1800)
| filter finding_type = "over_privileged_service_agent" and ai_service = "vertex_ai"
| filter subcategory = "p4sa_default_grant_excessive_scope"
| comp count() as findings by resource_name, principal_email
| filter findings >= 1
| fields resource_name, principal_email, findings

