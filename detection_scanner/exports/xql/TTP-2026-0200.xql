# TTP-2026-0200 — Akira (Howling Scorpius) Linux-Host Kill Chain — Real On-Host File Encryption
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — EDR-025 Rapid Mass File Rewrite With Uniform Akira Extension
# severity: medium
# Hunting / operator-installable content (NOT a declared SIM-EDR-025 expectation — the lab tenant has 0 queryable custom BIOCs). One process creates many files that all take a single new extension while deleting the originals — the encryptor fingerprint. If installed in a tenant, create it with EXACTLY this name at Medium. CortexSim never writes it to the tenant. Category: impact.

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_CREATE_NEW, ENUM.FILE_WRITE)
| filter action_file_path ~= "[.]akira(new|ranges)?$"
| comp count() as encrypted_files, count_distinct(action_file_path) as distinct_paths by agent_hostname, actor_causality_id, causality_actor_process_image_name
| filter encrypted_files >= 10

## BIOC — EDR-025 Akira Ransom Note Written Across Directories
# severity: medium
# Hunting / operator-installable content (NOT a declared SIM-EDR-025 expectation). The same causality chain drops the Akira ransom note into multiple directories. If installed, create it with EXACTLY this name at Medium. CortexSim never writes it to the tenant. Category: impact.

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_CREATE_NEW, ENUM.FILE_WRITE)
| filter action_file_name in ("akira_readme.txt", "akiranew.txt", "powerranges.txt")
| comp count_distinct(action_file_directory) as dirs by agent_hostname, actor_causality_id
| filter dirs >= 2

## BIOC — EDR-025 Backup Deletion Co-Occurring With Mass Encryption
# severity: medium
# Hunting / operator-installable content (NOT a declared SIM-EDR-025 expectation). rm removing backup/snapshot artefacts — recovery inhibition that the correlation fuses with the encryption on the same host. If installed, create it with EXACTLY this name at Medium. CortexSim never writes it to the tenant. Category: impact.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name in ("rm", "shred", "unlink")
| filter action_process_image_command_line ~= "(backup|snapshot|[.]img|[.]bak)"

## ABIOC — Suspicious access to shadow file (behavioral-ML, causality-anchored)
# severity: low
# behavioral_profile: statistical
# causality_anchor: The unpopular process opening /etc/shadow (here cat) and its causality chain; how rarely that process touches shadow across the tenant decides whether it fires.
# PANW built-in XDR Analytics BIOC (Low; Low issues never create or join a case). The same built-in was observed on pov-target-01 2026-11-11 (issues 1500417, 1500418) on useradd and chpasswd, mapped by the tenant to T1003. The name is the built-in alert name verbatim so the matcher keys on it. In SIM-EDR-025 the reader is `cat` — a distinct unpopular process opening /etc/shadow. The logic below approximates the trigger for hunting; it is not the built-in's code. Rarity-judged: it may read missed where this process/file pair is already baselined on the host.

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type = ENUM.FILE_OPEN
| filter action_file_path = "/etc/shadow"
| filter actor_process_image_name in ("cat", "less", "more", "head", "tail", "cp", "dd", "python3", "perl")

## VALIDATION — EDR-025 Mass Akira-Extension Encryption By One Causality Chain
# purpose: hunt
# dataset: xdr_data

dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 3600
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_CREATE_NEW, ENUM.FILE_WRITE)
| filter action_file_path ~= "[.]akira(new|ranges)?$"
| comp count() as encrypted_files, min(_time) as first_file, max(_time) as last_file by agent_hostname, agent_id, actor_causality_id, causality_actor_process_image_name
| filter encrypted_files >= 10
| fields agent_hostname, agent_id, actor_causality_id, causality_actor_process_image_name, encrypted_files, first_file, last_file

## VALIDATION — EDR-025 openssl Symmetric Encryption Of The Staged Victim Tree
# purpose: hunt
# dataset: xdr_data

dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 3600
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = "openssl"
| filter action_process_image_command_line contains "enc -aes-256-cbc" and action_process_image_command_line contains ".akira"
| fields _time, agent_hostname, actor_causality_id, causality_actor_process_image_name, action_process_image_command_line

## VALIDATION — EDR-025 Shadow Read Then Mass Encryption On One Host
# purpose: hunt
# dataset: xdr_data

dataset = xdr_data
| filter timestamp_diff(current_time(), _time, "SECOND") < 3600
| alter leg = if(event_type = ENUM.FILE and event_sub_type = ENUM.FILE_OPEN and action_file_path = "/etc/shadow", "shadow", if(event_type = ENUM.FILE and action_file_path ~= "[.]akira(new|ranges)?$", "encrypt", "other"))
| filter leg in ("shadow", "encrypt")
| comp count_distinct(leg) as legs, count() as events by agent_hostname, agent_id
| filter legs >= 2

