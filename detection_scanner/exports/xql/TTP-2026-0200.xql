# TTP-2026-0200 — Rarely-Active Host Conducts Lateral RDP Sweep
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Abnormal RDP Connection Behavior
# severity: high
# Detection of RDP connections from a rarely-seen host to multiple internal hosts within a short time window

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and dst_port = 3389
| filter actor_process_image_name = "rdesktop.exe"
| filter agent_hostname not in ("known-host-1", "known-host-2")
| comp count() as cnt by agent_hostname, dst_ip
| comp count() as connection_count
| filter connection_count > 5

## ABIOC — Abnormal RDP connections to multiple hosts from a rarely seen host (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: RDP connection to multiple hosts from rarely-seen host
# ML-based detection of RDP connections initiated by an infrequently active host to multiple internal IPs

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and dst_port = 3389
| filter agent_hostname not in ("known-host-1", "known-host-2")
| comp count() as cnt by agent_hostname
| comp count() as rdp_count
| filter rdp_count > 5
| filter agent_hostname in ("rarely-active-host")

## VALIDATION — Detect RDP sweep from rarely active host
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and dst_port = 3389
| filter agent_hostname not in ("known-host-1", "known-host-2")
| comp count() as cnt by agent_hostname, dst_ip
| comp count() as connection_count
| filter connection_count > 5

