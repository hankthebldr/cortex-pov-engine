# TTP-2026-0476 — Azure AD Sync Module Load via Suspicious Process Injection
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unusual Azure AD Sync Module Load
# severity: high
# Detection of unexpected module loading into a process during Azure AD sync behavior

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'rundll32.exe'
| filter action_file_path contains 'syncmodule.dll'

## ABIOC — Suspicious Process Injection with Azure AD Module (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: powershell.exe launching rundll32.exe with syncmodule.dll
# Detection of process injection behavior using a module typically associated with Azure AD sync

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'rundll32.exe'
| filter action_file_path contains 'syncmodule.dll'
| filter causality_actor_process_image_name = 'powershell.exe'

## VALIDATION — Detect Suspicious Azure AD Module Load
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'rundll32.exe'
| filter action_file_path contains 'syncmodule.dll'
| filter actor_process_image_name = 'powershell.exe'

