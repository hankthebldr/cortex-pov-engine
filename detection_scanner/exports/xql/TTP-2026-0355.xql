# TTP-2026-0355 — Recurring Access to Rare IP via PowerShell Download and Execution
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — RecurringAccessToRareIP
# severity: high
# Process accessing rare IP address multiple times within short period

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip in (select distinct action_remote_ip from xdr_data where event_type = ENUM.NETWORK_CONNECTION group by action_remote_ip having count() < 5)
| filter timestamp > now() - 30m
| comp count() as cnt by action_remote_ip, actor_process_image_name
| filter count() > 2

## ABIOC — RecurringAccessToRareIPBehavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name
# Behavioral deviation indicating repeated access to rare IP addresses by a process

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip in (select distinct action_remote_ip from xdr_data where event_type = ENUM.NETWORK_CONNECTION group by action_remote_ip having count() < 5)
| filter timestamp > now() - 30m
| comp count() as cnt by action_remote_ip, actor_process_image_name
| filter count() > 2

