# TTP-2026-0194 — Windows regsvr32 Squiblydoo Proxy Execution via COM Scriptlet
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Regsvr32 with Remote Scriptlet
# severity: high
# Detection of regsvr32 being invoked with /i: parameter pointing to an HTTP URL

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'regsvr32.exe'
| filter action_process_command_line contains '/i:http://'
| filter action_process_command_line contains 'scrobj.dll'

## VALIDATION — Regsvr32 Proxy Execution Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'regsvr32.exe'
| filter action_process_command_line contains '/i:http://'
| filter action_process_command_line contains 'scrobj.dll'
| fields actor_process_image_name, action_process_command_line, agent_hostname

