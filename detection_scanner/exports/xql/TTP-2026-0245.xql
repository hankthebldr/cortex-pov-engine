# TTP-2026-0245 — SMB Brute Force via WMI and PsExec to Multiple Hosts
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Abnormal SMB activity to multiple hosts
# severity: high
# Detection of multiple SMB connections to different hosts within a short time window

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter dst_port = 445
| filter action_remote_ip in ('192.0.2.10', '192.0.2.11', '192.0.2.12')
| comp count() as cnt by action_remote_ip
| comp count() as cnt by agent_hostname > 3

## ABIOC — Multiple SMB connections to different hosts (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: SMB connection to multiple hosts
# Behavioral deviation showing multiple distinct SMB connection attempts to different hosts in rapid succession

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter dst_port = 445
| filter action_remote_ip in ('192.0.2.10', '192.0.2.11', '192.0.2.12')
| comp count() as cnt by agent_hostname, action_remote_ip
| comp count() as cnt by agent_hostname > 3

## VALIDATION — Detect SMB brute force activity
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter dst_port = 445
| filter action_remote_ip in ('192.0.2.10', '192.0.2.11', '192.0.2.12')
| comp count() as cnt by agent_hostname
| comp count() as cnt by agent_hostname > 3

