# TTP-2026-0209 — Rare Local Administrator Login on Windows Endpoint
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rare Local Admin Login
# severity: high
# Interactive logon with a local admin account not seen on host

dataset = xdr_data
| filter event_type = ENUM.AUTHENTICATION and event_sub_type = ENUM.AUTH_LOGIN
| filter actor_user_name = 'Administrator' and actor_user_domain = 'LOCAL'
| filter not in(actor_user_name, (select distinct actor_user_name from xdr_data where event_type = ENUM.AUTHENTICATION and event_sub_type = ENUM.AUTH_LOGIN and agent_hostname = 'target-host'))

## ABIOC — A rare local administrator login (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name
# Detection of interactive login with local admin account not seen on this host

dataset = xdr_data
| filter event_type = ENUM.AUTHENTICATION and event_sub_type = ENUM.AUTH_LOGIN
| filter actor_user_name = 'Administrator' and actor_user_domain = 'LOCAL'
| filter not in(actor_user_name, (select distinct actor_user_name from xdr_data where event_type = ENUM.AUTHENTICATION and event_sub_type = ENUM.AUTH_LOGIN and agent_hostname = 'target-host'))

