# TTP-2026-0430 — Uncommon Driver Loaded via PowerShell and Sysinternals
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Driver Load
# severity: high
# Detection of an unusual driver being loaded by a non-system process

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name != 'services.exe' and actor_process_image_name != 'lsass.exe'
| filter action_process_image_name = 'cmd.exe' and action_file_path contains 'driver.sys'

## ABIOC — Suspicious Driver Load via PowerShell (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'powershell.exe'
# PowerShell downloading and executing a driver file in a non-standard location

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_file_path contains 'driver.sys'

## VALIDATION — Detect Suspicious Driver Load
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_file_path contains 'driver.sys'

