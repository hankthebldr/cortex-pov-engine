# TTP-2026-0318 — Kerberos Relay Attack via SMB and LSASS Dumping
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unusual SMB Connection to IPC$ Share
# severity: high
# Detection of SMB connection to IPC$ share with no user context

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.100'
| filter dst_port = 445
| filter action_process_image_name != 'svchost.exe'
| filter causality_actor_process_image_name = 'net.exe'

## ABIOC — LSASS Memory Dumping Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Detection of LSASS process being executed with unusual flags or in an abnormal context

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'lsass.exe'
| filter actor_process_image_name != 'services.exe'
| filter actor_process_image_name != 'svchost.exe'

## VALIDATION — SMB Connection to IPC$ Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip = '192.0.2.100'
| filter dst_port = 445
| filter action_process_image_name != 'svchost.exe'
| filter causality_actor_process_image_name = 'net.exe'
| comp count() as cnt by action_remote_ip, action_process_image_name
| comp count() as cnt by

