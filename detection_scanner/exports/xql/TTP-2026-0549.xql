# TTP-2026-0549 — Offensive Tooling: theharvester (adapter-deployed)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Theharvester Executed by a Service Account on the Endpoint
# severity: high
# A non-interactive service account runs theharvester — an offensive TOOL-THEHARVESTER-wired tool not part of normal operations on this host.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_path contains "theharvester" or action_process_command_line contains "theharvester"
| comp count() as runs by agent_hostname, actor_effective_username
| filter runs >= 1

## ABIOC — First-Seen Execution of theharvester on This Host (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: adapter deploy/stage of theharvester -> first execution by a service-account shell
# A host that has never run theharvester executes it shortly after it is staged/installed — the deploy-then-run chain of an offensive tool.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_command_line contains "theharvester"
| comp count() as first_runs by agent_hostname

## VALIDATION — Theharvester Execution Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_command_line contains "theharvester"
| fields agent_hostname, actor_effective_username, action_process_image_name, action_process_command_line

