# TTP-2026-0213 — Setuid Privilege Escalation via chmod u+s on Shell Binary
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Setuid Bit Manipulation
# severity: high
# Detection of chmod command setting setuid bit on executable files

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'chmod' and action_file_path contains 'shell' and action_command_line contains 'u+s'

## ABIOC — Setuid and Setgid file bit manipulation (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: chmod u+s on executable file
# Behavioral deviation detected when setuid/setgid bits are manipulated on files in writable paths

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type = ENUM.FILE_MODIFY
| filter action_file_path contains '/tmp/scratch/shell' and action_command_line contains 'u+s'

## VALIDATION — Setuid File Bit Manipulation Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type = ENUM.FILE_MODIFY
| filter action_command_line contains 'u+s' and action_file_path contains '/tmp/scratch/'

