# TTP-2026-0328 — Rare AppID usage to rare destination with PowerShell and C2
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Rare AppID usage to rare destination
# severity: high
# Detection of rare application ID usage to a rare destination IP

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| comp count() as events by agent_hostname, agent_hostname
| sort desc events

## ABIOC — PowerShell download to rare IP (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: powershell.exe downloading file from rare IP
# Behavioral deviation of PowerShell downloading from rare IP

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_image_name = 'powershell.exe'
| filter action_file_path like '%DownloadFile%'
| comp count() as events by actor_process_image_name, agent_hostname
| sort desc events

## VALIDATION — Detect rare IP usage from PowerShell
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter causality_actor_process_image_name = 'powershell.exe'
| comp count() as events by actor_process_image_name, agent_hostname
| sort desc events

