# TTP-2026-0284 — Interactive Login by Service Account
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Interactive Login by Service Account
# severity: high
# Detection of interactive login using a service account

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'winlogon.exe' and action_process_image_name = 'cmd.exe'

## ABIOC — Service Account Interactive Login (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: winlogon.exe launching command prompt
# Behavioral deviation indicating interactive login via service account

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'winlogon.exe' and action_process_image_name = 'cmd.exe'

## VALIDATION — Detect Interactive Login via Service Account
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'winlogon.exe' and action_process_image_name = 'cmd.exe'
| fields agent_hostname, actor_process_image_name, action_process_image_name

