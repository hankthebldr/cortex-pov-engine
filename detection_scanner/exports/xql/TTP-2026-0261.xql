# TTP-2026-0261 — WMIC User Discovery and Lateral Movement
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Discovery of host users via WMIC
# severity: high
# Detection of WMIC execution with user enumeration arguments

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'wmic.exe'
| filter action_process_command_line contains 'useraccount get'

## ABIOC — Suspicious WMIC command line with user enumeration (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'wmic.exe'
# Behavioral deviation detected when WMIC is launched with user account enumeration parameters

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'wmic.exe'
| filter action_process_command_line contains 'useraccount get'

## VALIDATION — WMIC User Discovery Detection
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'wmic.exe'
| filter action_process_command_line contains 'useraccount get'
| fields agent_hostname, actor_process_image_name, action_process_command_line

