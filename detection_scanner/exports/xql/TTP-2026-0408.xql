# TTP-2026-0408 — Domain Controller SMB Connection via DCSync
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious SMB Connection from Domain Controller
# severity: high
# Detects an SMB connection initiated from a domain controller to a remote IP address

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip != '192.0.2.0/24'
| filter dst_port = 445
| filter actor_process_image_name = 'lsass.exe' or actor_process_image_name = 'net.exe'
| filter causality_actor_process_image_name = 'dcdomaincontroller.exe'

## ABIOC — DCSync SMB Connection Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: SMB connection initiated from domain controller
# Behavioral deviation indicating an SMB connection initiated from a domain controller to a non-local IP address

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter action_remote_ip != '192.0.2.0/24'
| filter dst_port = 445
| filter actor_process_image_name = 'lsass.exe' or actor_process_image_name = 'net.exe'
| filter causality_actor_process_image_name = 'dcdomaincontroller.exe'

## VALIDATION — Detect SMB from DC
