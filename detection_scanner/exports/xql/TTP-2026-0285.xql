# TTP-2026-0285 — JavaScript Runtime Reading Git Authentication Tokens
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — JS Runtime Reading Git Credentials
# severity: high
# A JavaScript runtime process attempts to read files in the .git directory, which is indicative of credential harvesting.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'node'
| filter action_file_path contains '.git'
| filter action_file_path contains 'credentials'

## ABIOC — Suspicious JS Runtime File Access (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: node process accessing .git/credentials
# Behavioral deviation where a JavaScript runtime process accesses Git credential files, which is not typical for normal JS execution.

dataset = xdr_data
| filter event_type = ENUM.FILE_ACCESS
| filter actor_process_image_name = 'node'
| filter action_file_path contains '.git'
| filter action_file_path contains 'credentials'

## VALIDATION — Detect JS Runtime Reading Git Credentials
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.FILE_ACCESS
| filter actor_process_image_name = 'node'
| filter action_file_path contains '.git'
| filter action_file_path contains 'credentials'

