# TTP-2026-0405 — Suspicious RunOnce.exe Parent Process Behavior
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious runonce.exe parent process
# severity: high
# Detection of a process launched by runonce.exe, which is often used for malicious persistence or execution

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'runonce.exe'
| filter action_process_image_name != 'runonce.exe'

## ABIOC — Suspicious RunOnce.exe Parent Process Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'runonce.exe'
# Behavioral deviation where RunOnce.exe is the parent of an executable, indicating possible malicious persistence or execution

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'runonce.exe'
| filter action_process_image_name != 'runonce.exe'

## VALIDATION — Hunt for Suspicious RunOnce Parent
# purpose: validation
