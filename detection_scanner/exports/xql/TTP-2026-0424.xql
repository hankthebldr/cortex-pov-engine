# TTP-2026-0424 — Uncommon ARP Cache Listing via arp.exe
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon ARP Cache Listing
# severity: high
# Detection of arp.exe being invoked with flags that indicate network reconnaissance or enumeration

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'C:\\Windows\\System32\\arp.exe'
| filter action_process_command_line contains '-a' or action_process_command_line contains '-g' or action_process_command_line contains '-d'

## ABIOC — Uncommon ARP Cache Listing Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Detection of arp.exe being executed with flags that indicate network reconnaissance or enumeration in an unusual context

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'C:\\Windows\\System32\\arp.exe'
| filter action_process_command_line contains '-a' or action_process_command_line contains '-g' or action_process_command_line contains '-d'

