# TTP-2026-0509 — SSH Brute Force on the Linux Syslog Auth Feed
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## VALIDATION — SSH Failed-Password Burst From One Source
# purpose: validation
# dataset: linux_syslog

dataset = linux_syslog
| filter process = "sshd" and message contains "Failed password"
| comp count() as fails by src_ip, host
| filter fails >= 5

## VALIDATION — SSH Brute Force Followed by an Accepted Login
# purpose: validation
# dataset: linux_syslog

dataset = linux_syslog
| filter process = "sshd"
| comp count() as attempts by src_ip, host
| filter attempts >= 5

