# TTP-2026-0243 — RDP Session from Rare Host with Credential Theft
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Abnormal RDP Session
# severity: high
# RDP session initiated from a rarely seen host to a target

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECTION_ESTABLISHED
| filter action_remote_ip not in (SELECT DISTINCT action_remote_ip FROM xdr_data WHERE event_type = ENUM.NETWORK_CONNECTION AND dst_port = 3389 AND event_time > now() - 30d)
| filter dst_port = 3389

## ABIOC — RDP Session with Remote Execution (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: RDP session initiation
# Detection of RDP session followed by execution of remote command

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECTION_ESTABLISHED
| filter dst_port = 3389
| join with (dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'psexec.exe') on causality_actor_process_image_name = action_process_image_name
| filter event_time_diff < 300

## VALIDATION — Detect Rare Host RDP Sessions
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION and event_sub_type = ENUM.NETWORK_CONNECTION_ESTABLISHED
| filter dst_port = 3389
| filter action_remote_ip not in (SELECT DISTINCT action_remote_ip FROM xdr_data WHERE event_type = ENUM.NETWORK_CONNECTION AND dst_port = 3389 AND event_time > now() - 30d)
| comp count() by action_remote_ip, dst_ip

