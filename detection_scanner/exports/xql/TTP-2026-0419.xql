# TTP-2026-0419 — AppleScript Clipboard and Screenshot Capture via Command Line
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon AppleScript Execution via CLI
# severity: high
# Detection of AppleScript execution initiated from command-line interface, which is unusual for typical user behavior.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'bash' and action_process_image_name = 'osascript'
| filter action_process_command_line contains 'osascript'

## ABIOC — Uncommon AppleScript Designed to Capture Screen or Clipboard Data (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: osascript process started from CLI
# Behavioral deviation detected when AppleScript is executed from command line to capture clipboard or screen data.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'bash' and action_process_image_name = 'osascript'
| filter action_process_command_line contains 'clipboard' or action_process_command_line contains 'screenshot'

## VALIDATION — Detect AppleScript Execution from CLI
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'bash' and action_process_image_name = 'osascript'
| filter action_process_command_line contains 'osascript'

