# TTP-2026-0248 — Uncommon RDP Session from Managed Host
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon RDP Session from Managed Host
# severity: high
# Detection of an RDP session initiated from a managed host to a remote target, which is not typical behavior for managed systems.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = '/tmp/rdp_client'
| filter action_remote_ip = '192.0.2.10'
| filter dst_port = 3389

## ABIOC — Uncommon RDP Session from Managed Host (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: RDP session initiation from managed host
# Behavioral deviation detected when a managed host initiates an RDP session to a remote IP, which is not part of normal operations.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = '/tmp/rdp_client'
| filter action_remote_ip = '192.0.2.10'
| filter dst_port = 3389

## VALIDATION — Detect RDP Sessions from Managed Hosts
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
