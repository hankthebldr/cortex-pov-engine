# TTP-2026-0252 — AppleScript Interpreter Dynamic Library Loaded into Process
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — AppleScript Interpreter Dynamic Library Loaded
# severity: high
# Detection of dynamic library loading into osascript process

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'osascript'
| filter action_process_image_name = 'osascript'
| filter action_file_path contains '.dylib'

## ABIOC — AppleScript Dynamic Library Loading Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: osascript process start with dynamic library load
# Detects when osascript loads a dynamic library, indicating potential code injection or malicious AppleScript execution

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'osascript'
| filter action_file_path contains '.dylib'

## VALIDATION — Detect AppleScript Dynamic Library Load
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'osascript'
| filter action_file_path contains '.dylib'
| comp count() by actor_process_image_name, action_file_path

