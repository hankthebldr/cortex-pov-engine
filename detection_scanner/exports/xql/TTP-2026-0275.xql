# TTP-2026-0275 — Signed Process Injection via PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Injection from Signed Process
# severity: high
# Detection of injection behavior from a signed Windows process like powershell.exe

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_image_name != 'powershell.exe'
| filter action_process_image_name = 'svchost.exe'

## ABIOC — Behavioral Injection Anomaly (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'powershell.exe'
# Detection of anomalous injection behavior from a signed process

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_image_name = 'svchost.exe'
| filter causality_actor_process_image_name != 'powershell.exe'

## VALIDATION — Signed Process Injection Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
