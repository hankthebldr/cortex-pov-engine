# TTP-2026-0354 — Recurring DNS queries to rare domain for C2 communication
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Recurring DNS access to rare domain
# severity: high
# Detects repeated DNS queries to a domain with low historical lookup count

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_DNS_QUERY
| filter action_remote_ip = '192.0.2.1'
| filter action_domain_name = 'rare-domain-123.com'
| comp count() as cnt by action_domain_name
| comp count() as cnt by agent_hostname > 3

## ABIOC — Recurring DNS access to rare domain (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_domain_name
# Behavioral deviation indicating repeated DNS lookups to a domain with low historical access

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_DNS_QUERY
| filter action_remote_ip = '192.0.2.1'
| filter action_domain_name = 'rare-domain-123.com'
| comp count() as cnt by action_domain_name
| comp count() as cnt by agent_hostname > 3

## VALIDATION — Detect rare domain access pattern
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK and event_sub_type = ENUM.NETWORK_DNS_QUERY
| filter action_domain_name = 'rare-domain-123.com'
| comp count() as cnt by action_domain_name
| comp count() as cnt by agent_hostname > 3
| fields action_domain_name, count()

