# TTP-2026-0460 — Uncommon User Management via net command
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon user management via net command
# severity: high
# Detection of net user command execution with administrative privileges

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'net.exe'
| filter action_command_line contains 'user'
| filter action_command_line contains '/add'
| filter action_command_line contains 'administrators'

## ABIOC — Uncommon user management via net command (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name = 'net.exe'
# Behavioral deviation in user management using net.exe with administrative commands

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'net.exe'
| filter action_command_line contains 'user'
| filter action_command_line contains '/add'
| filter action_command_line contains 'administrators'

