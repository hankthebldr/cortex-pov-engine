# TTP-2026-0422 — AppleScript Defense-Evasion via Command Line
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon AppleScript with Defense-Evasion Command
# severity: high
# Detection of AppleScript process that executes a command with potential defense-evasion behavior

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'osascript'
| filter action_process_image_name = 'sh'
| filter action_file_path contains 'do shell script'

## ABIOC — Uncommon AppleScript with Potential Defense-Evasion Command (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: osascript process launching shell command
# Behavioral deviation where AppleScript is used to execute shell commands potentially for defense evasion

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'osascript'
| filter action_process_image_name = 'sh'
| filter action_file_path contains 'do shell script'

