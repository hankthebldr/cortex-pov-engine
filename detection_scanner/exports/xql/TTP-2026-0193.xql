# TTP-2026-0193 — Windows Ransomware Precursor - Shadow Copy Deletion and Recovery Disable
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — VSSAdmin Shadow Copy Deletion
# severity: high
# Detection of vssadmin.exe deleting shadow copies

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'vssadmin.exe' and action_command_line contains 'delete shadows'
| filter action_command_line contains '/all /quiet'

## BIOC — BCDEdit Recovery Disable
# severity: high
# Detection of bcdedit.exe disabling system recovery

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'bcdedit.exe' and action_command_line contains 'recoveryenabled no'

## BIOC — WBAdmin Catalog Delete
# severity: high
# Detection of wbadmin.exe deleting recovery catalog

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'wbadmin.exe' and action_command_line contains 'delete catalog'
| filter action_command_line contains '-quiet'

## VALIDATION — Shadow Copy Deletion Detection
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'vssadmin.exe' and action_command_line contains 'delete shadows'
| filter action_command_line contains '/all /quiet'
| fields agent_hostname, action_process_image_name, action_command_line

## VALIDATION — Recovery Disable Detection
# purpose: validation
