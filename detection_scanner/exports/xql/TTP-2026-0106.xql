# TTP-2026-0106 — Edge-Appliance Telemetry Collapse + WebVPN-Session C2 on Cisco ASA/FTD (ArcaneDoor / LINE VIPER)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Cisco ASA WebVPN Client Authentication Session From Modeled Peer IP
# severity: high
# A genuine single-event BIOC: matches each Cisco ASA WebVPN client-authentication session-start (message id 716001) event that carries a modeled peer IP — the LINE VIPER C2-over-WebVPN channel, which blends into legitimate SSL-VPN logins. It reads the WebVPN modeling rule's normalized xdm.event.id and xdm.source.ipv4 fields rather than re-parsing the raw syslog line, so the substrate is load-bearing. A BIOC matches one event and cannot express a per-window count threshold; the beacon cadence (many sessions from one peer in a short window) is supplied by the CR-NDR-0010 correlation rule, not by this BIOC.

dataset = cisco_asa_raw
| filter xdm.event.id = "716001"
| filter xdm.source.ipv4 != null
| fields xdm.source.ipv4, xdm.source.user.username, xdm.event.id, _time

## VALIDATION — Cisco ASA Syslog Ingestion Across Severity Levels ASA 1 to 7
# purpose: validation
# dataset: cisco_asa_raw

dataset = cisco_asa_raw
| filter _time > to_timestamp(current_time() - 86400)
| filter asa_severity != null
| comp count() as log_count by asa_severity
| sort asc asa_severity
| fields asa_severity, log_count

## VALIDATION — Cisco ASA Informational and Debug Log Volume Collapse
# purpose: hunt
# dataset: cisco_asa_raw

dataset = cisco_asa_raw
| filter _time > to_timestamp(current_time() - 86400) and _time < to_timestamp(current_time() - 3600)
| filter asa_severity in ("6", "7")
| comp count() as baseline_volume by asa_severity
| alter baseline_hourly = baseline_volume / 23
| join type = left (dataset = cisco_asa_raw | filter _time > to_timestamp(current_time() - 3600) | filter asa_severity in ("6", "7") | comp count() as recent_volume by asa_severity) as recent recent.asa_severity = asa_severity
| alter recent_volume = if(recent_volume = null, 0, recent_volume)
| filter recent_volume < baseline_hourly * 0.5
| sort asc asa_severity
| fields asa_severity, baseline_volume, baseline_hourly, recent_volume

