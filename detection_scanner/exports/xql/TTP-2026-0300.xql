# TTP-2026-0300 — Office Process Spawning Abused Child Process
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Microsoft Office spawns PowerShell
# severity: high
# Detection of winword.exe or excel.exe spawning powershell.exe

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'winword.exe' and action_process_image_name = 'powershell.exe'

## ABIOC — Office process spawns commonly abused process (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'winword.exe' and action_process_image_name = 'powershell.exe'
# Detection of Microsoft Office applications spawning PowerShell, WMI, or other commonly abused processes

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ('winword.exe', 'excel.exe') and action_process_image_name in ('powershell.exe', 'wmi.exe', 'wmic.exe')

## VALIDATION — Detect Office spawning PowerShell
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ('winword.exe', 'excel.exe') and action_process_image_name = 'powershell.exe'
| fields actor_process_image_name, action_process_image_name, agent_hostname

