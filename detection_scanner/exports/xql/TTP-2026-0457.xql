# TTP-2026-0457 — Uncommon Service Stop Operation via sc.exe
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Service Stop Operation
# severity: high
# Detection of sc.exe stopping a service that is not typically stopped by normal user activity

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'sc.exe' and action_file_path contains 'stop'
| filter causality_actor_process_image_name != 'services.exe'
| filter causality_actor_process_image_name != 'svchost.exe'

## ABIOC — Suspicious Service Stop via sc.exe (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_image_name = 'sc.exe' and action_file_path contains 'stop'
# Detection of service stop operations initiated by sc.exe that are not part of standard system behavior

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'sc.exe' and action_file_path contains 'stop'
| filter causality_actor_process_image_name != 'services.exe' and causality_actor_process_image_name != 'svchost.exe'

## VALIDATION — Detect Uncommon Service Stop
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'sc.exe' and action_file_path contains 'stop'
| filter causality_actor_process_image_name != 'services.exe' and causality_actor_process_image_name != 'svchost.exe'
| filter agent_hostname = 'WIN-ABC123'

