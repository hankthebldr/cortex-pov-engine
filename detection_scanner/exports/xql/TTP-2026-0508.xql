# TTP-2026-0508 — SSH Proxy Tunneling for Lateral Movement
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — SSH Proxy Command Execution
# severity: high
# Detection of SSH process starting with ProxyCommand argument

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'ssh' and action_process_image_name = 'nc'
| filter action_file_path contains 'ProxyCommand'

## ABIOC — Unusual SSH Proxy Activity (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: SSH process starting with proxy command
# SSH process with proxy command that resembles known attack patterns

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'ssh' and action_process_image_name = 'nc'
| filter action_file_path contains 'ProxyCommand'
| filter action_remote_ip = '192.0.2.10'

## VALIDATION — SSH Proxy Command Hunt
