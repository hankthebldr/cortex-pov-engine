# TTP-2026-0543 — Offensive Tooling: ffuf (adapter-deployed)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Ffuf Executed by a Service Account on the Endpoint
# severity: high
# A non-interactive service account runs ffuf — an offensive TOOL-FFUF-wired tool not part of normal operations on this host.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_path contains "ffuf" or action_process_command_line contains "ffuf"
| comp count() as runs by agent_hostname, actor_effective_username
| filter runs >= 1

## ABIOC — First-Seen Execution of ffuf on This Host (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: adapter deploy/stage of ffuf -> first execution by a service-account shell
# A host that has never run ffuf executes it shortly after it is staged/installed — the deploy-then-run chain of an offensive tool.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_command_line contains "ffuf"
| comp count() as first_runs by agent_hostname

## VALIDATION — Ffuf Execution Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_command_line contains "ffuf"
| fields agent_hostname, actor_effective_username, action_process_image_name, action_process_command_line

