# TTP-2026-0360 — Remote Command Execution via WMIC.exe
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — WMIC Remote Command Execution
# severity: high
# Detection of wmic.exe being invoked with command-line arguments that indicate remote command execution or process creation

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'wmic.exe'
| filter action_process_command_line contains 'win32_process call create'
| filter action_process_command_line contains 'powershell.exe'

## ABIOC — Suspicious WMIC Process Start (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: action_process_command_line
# Behavioral deviation detected when wmic.exe is launched with command-line parameters suggesting remote execution or process creation

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'wmic.exe'
| filter action_process_command_line contains 'win32_process call create'

