# TTP-2026-0231 — DLL Hijacking via Uncommon Vendor Signed DLL in Microsoft Process
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Vendor Signed DLL Loaded into Microsoft Process
# severity: high
# Detection of a DLL signed by an uncommon vendor loaded into a Microsoft process such as regsvr32.exe

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'C:\\Windows\\System32\\regsvr32.exe'
| filter action_file_path contains 'hijack.dll'
| filter action_file_path contains 'Temp'
| filter causality_actor_process_image_name = 'C:\\Windows\\System32\\regsvr32.exe'

## ABIOC — Suspicious DLL Load in Microsoft Process (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Behavioral deviation where an uncommonly signed DLL is loaded into a Microsoft process

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'C:\\Windows\\System32\\regsvr32.exe'
| filter action_file_path contains 'hijack.dll'
| filter causality_actor_process_image_name = 'C:\\Windows\\System32\\regsvr32.exe'

