# TTP-2026-0370 — Screensaver Execution from Temporary Directory
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Screensaver Process Executed from Users or Temp Folder
# severity: high
# Detection of .scr file execution from a temporary or user directory

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'scrcons.exe'
| filter action_file_path contains 'Temp'
| filter action_file_path contains '.scr'

## ABIOC — Suspicious Screensaver Execution (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Behavioral deviation where a screensaver is executed from a temporary directory without user interaction

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'scrcons.exe'
| filter action_file_path contains 'Temp'
| filter causality_actor_process_image_name != 'explorer.exe'

## VALIDATION — Detect Suspicious SCR Execution
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'scrcons.exe'
| filter action_file_path contains 'Temp'
| filter action_file_path contains '.scr'

