# TTP-2026-0448 — Uncommon Network Connection from Untrusted Causality Actor
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Uncommon Network Connection Under Untrusted Causality Actor
# severity: high
# Detects a process that initiates a network connection under an untrusted causality actor.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter causality_actor_process_image_name not in ('/usr/bin/bash', '/bin/sh', '/usr/sbin/sshd')
| filter action_remote_ip in ('192.0.2.1', '192.0.2.2', '192.0.2.3')
| filter action_process_image_name like '/tmp/%'

## ABIOC — Uncommon Network Connection from Untrusted Causality Actor (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: causality_actor_process_image_name
# Detects a process initiating a network connection under an untrusted causality actor using machine learning behavior profiling.

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter causality_actor_process_image_name not in ('/usr/bin/bash', '/bin/sh', '/usr/sbin/sshd')
| filter action_remote_ip in ('192.0.2.1', '192.0.2.2', '192.0.2.3')
| filter action_process_image_name like '/tmp/%'

## VALIDATION — Hunt Uncommon Network Connections
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK_CONNECTION
| filter causality_actor_process_image_name not in ('/usr/bin/bash', '/bin/sh', '/usr/sbin/sshd')
| filter action_remote_ip in ('192.0.2.1', '192.0.2.2', '192.0.2.3')
| filter action_process_image_name like '/tmp/%'

