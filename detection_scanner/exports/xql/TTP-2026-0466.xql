# TTP-2026-0466 — Unsigned Process Injection via PowerShell
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Unsigned and Unpopular Process Injection
# severity: high
# Detection of unsigned and unpopular process performing injection

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_process_image_name = 'evil.exe'
| filter causality_actor_process_image_name != 'explorer.exe'
| filter action_file_path contains '/tmp/evil.exe'

