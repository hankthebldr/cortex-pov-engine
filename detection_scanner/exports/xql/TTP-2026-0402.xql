# TTP-2026-0402 — Suspicious Process Spawned by wininit.exe
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious Process Spawned by wininit.exe
# severity: high
# Detection of a process spawned by wininit.exe, which is typically not a legitimate parent for arbitrary processes.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'wininit.exe'
| filter action_process_image_name != 'svchost.exe' and action_process_image_name != 'lsass.exe'
| filter action_process_image_name != 'explorer.exe'

## ABIOC — Suspicious Process Spawned by wininit.exe (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: wininit.exe process spawning
# Behavioral deviation indicating a process spawned by wininit.exe, which is not typical in normal Windows operation.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'wininit.exe'
| filter action_process_image_name != 'svchost.exe' and action_process_image_name != 'lsass.exe'
| filter action_process_image_name != 'explorer.exe'

