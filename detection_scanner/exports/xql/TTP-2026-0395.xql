# TTP-2026-0395 — Suspicious PowerShell Command Line Execution
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious PowerShell CommandLine
# severity: high
# PowerShell process with command line containing suspicious parameters such as -WindowStyle Hidden and direct execution of .exe files

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_command_line contains '-WindowStyle Hidden'
| filter action_command_line contains 'Start-Process'
| filter action_command_line contains '.exe'

## ABIOC — Suspicious PowerShell Command Line (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Behavioral deviation modeled on PowerShell command lines that contain suspicious parameters and direct execution of .exe files without invoking typical PowerShell cmdlets

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_command_line contains '-WindowStyle Hidden'
| filter action_command_line contains 'Start-Process'
| filter action_command_line contains '.exe'

