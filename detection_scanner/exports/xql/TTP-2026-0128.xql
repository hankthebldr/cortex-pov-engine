# TTP-2026-0128 — Unencrypted-Snapshot / KMS-Gap Posture Finding Correlated to Cross-Account Snapshot Export (T1537 / T1578.001 / T1552.005 / T1530)
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## ABIOC — CSPM-004 Impossible Travel by Cloud Compute Identity (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: Learned per-role region baseline (the set of regions an EC2 instance role has historically called from) -> IMDS-minted assumed-role credential -> a snapshot-export control-plane call (ModifySnapshotAttribute / CopySnapshot / CreateSnapshot) issued from a region NOT in that learned baseline, diverging from the baseline while co-occurring with a sensitive export action, anchored to the instance-metadata credential lineage.
# An EC2 instance role whose credentials were minted at the Instance Metadata endpoint issues a snapshot-export control-plane call (ModifySnapshotAttribute / CopySnapshot / CreateSnapshot) from a region that is NOT in the role's learned region baseline. Routine cross-region and global-service traffic (STS, IAM, CloudFront, Route53, cross-region S3/DynamoDB) is deliberately excluded: the ABIOC fires only when an off-baseline-region call co-occurs with a sensitive snapshot-export action by the same IMDS-minted identity — never on a bare region mismatch, which for a compute role calling global services is normal. Every individual API call is legitimate in isolation; the ABIOC fires on the rarity-plus-co-occurrence deviation from the compute identity's learned home-region baseline and anchors it to the IMDS credential lineage, catching the off-region actor behind the snapshot export that a static rule keyed on one API name would miss.

dataset = cloud_audit_logs
| filter _time > to_timestamp(current_time() - 3600)
| filter cloud_provider = "AWS"
| filter user_identity_type = "AssumedRole" and credential_source = "ec2-instance-metadata"
| filter event_name in ("ModifySnapshotAttribute", "CopySnapshot", "CreateSnapshot")
| filter aws_region != instance_home_region and region_in_role_baseline = false
| comp count() as sensitive_new_region_calls, values(event_name) as export_actions by user_identity_arn, src_ip, aws_region
| sort desc sensitive_new_region_calls
| fields user_identity_arn, src_ip, aws_region, export_actions, sensitive_new_region_calls

## VALIDATION — CSPM-004 Unencrypted Snapshot KMS-Gap Posture Finding
# purpose: validation
# dataset: cortex_cloud_posture

dataset = cortex_cloud_posture
| filter _time > to_timestamp(current_time() - 3600)
| filter cloud_provider = "AWS" and resource_type = "aws_ebs_snapshot"
| filter tags contains "CortexSimSnapshotExfil"
| filter compliance_state = "drifted" and finding_class in ("snapshot-unencrypted", "snapshot-no-customer-managed-key")
| comp count() as finding_rows by snapshot_id, finding_class
| sort desc finding_rows
| fields snapshot_id, finding_class, finding_rows

## VALIDATION — CSPM-004 Cross-Account Snapshot Share via ModifySnapshotAttribute
# purpose: validation
# dataset: cloud_audit_logs

dataset = cloud_audit_logs
| filter _time > to_timestamp(current_time() - 3600)
| filter cloud_provider = "AWS" and event_source = "ec2.amazonaws.com"
| filter event_name = "ModifySnapshotAttribute" and attribute_type = "createVolumePermission" and operation_type = "add"
| filter request_add_account_id != "" and request_add_account_id != owner_account_id
| comp count() as external_shares by snapshot_id, request_add_account_id, user_identity_arn
| filter external_shares >= 1
| sort desc external_shares
| fields snapshot_id, request_add_account_id, user_identity_arn, external_shares

## VALIDATION — CSPM-004 Snapshot Copy to Foreign Region
# purpose: validation
# dataset: cloud_audit_logs

dataset = cloud_audit_logs
| filter _time > to_timestamp(current_time() - 3600)
| filter cloud_provider = "AWS" and event_source = "ec2.amazonaws.com"
| filter event_name in ("CopySnapshot", "CreateSnapshot")
| filter aws_region != home_region
| comp count() as cross_region_copies by snapshot_id, aws_region, user_identity_arn
| filter cross_region_copies >= 1
| sort desc cross_region_copies
| fields snapshot_id, aws_region, user_identity_arn, cross_region_copies

## VALIDATION — CSPM-004 Compute Identity Operating Outside Home Region
# purpose: validation
# dataset: cloud_audit_logs

dataset = cloud_audit_logs
| filter _time > to_timestamp(current_time() - 3600)
| filter cloud_provider = "AWS"
| filter user_identity_type = "AssumedRole" and credential_source = "ec2-instance-metadata"
| filter event_name in ("ModifySnapshotAttribute", "CopySnapshot", "CreateSnapshot")
| filter aws_region != instance_home_region and region_in_role_baseline = false
| comp count() as off_region_export_calls, values(aws_region) as new_regions by user_identity_arn, src_ip
| sort desc off_region_export_calls
| fields user_identity_arn, src_ip, new_regions, off_region_export_calls

## VALIDATION — CSPM-004 Snapshot Export Coverage Reconciliation
# purpose: validation
# dataset: cloud_audit_logs

dataset = cloud_audit_logs
| filter _time > to_timestamp(current_time() - 3600)
| filter cloud_provider = "AWS" and event_source = "ec2.amazonaws.com"
| filter event_name in ("ModifySnapshotAttribute", "CopySnapshot", "CreateSnapshot")
| filter snapshot_id != ""
| comp count_distinct(event_name) as export_action_classes by snapshot_id, user_identity_arn
| filter export_action_classes >= 1
| sort desc export_action_classes
| fields snapshot_id, user_identity_arn, export_action_classes

