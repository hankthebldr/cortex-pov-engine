# TTP-2026-0410 — Windows Scheduled Task Execution via schtasks
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious Scheduled Task Creation
# severity: high
# Creation of a scheduled task with hidden PowerShell execution

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'schtasks.exe'
| filter actor_process_image_name = 'cmd.exe'
| filter action_file_path contains 'malware.exe'

## ABIOC — Suspicious Scheduled Task Execution (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start
# Execution of a scheduled task that downloads and runs a binary from a remote C2 server

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'powershell.exe'
| filter action_file_path contains 'malware.exe'
| filter action_remote_ip = '192.0.2.100'

## VALIDATION — Scheduled Task Creation Hunt
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter action_process_image_name = 'schtasks.exe'
| filter actor_process_image_name = 'cmd.exe'
| filter action_file_path contains 'malware.exe'
| comp count() by agent_hostname, action_process_image_name

