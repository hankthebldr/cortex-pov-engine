# TTP-2026-0280 — Signed Process Exploiting Uncommon Root-Domain Port Combination
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Globally Uncommon Root-Domain Port Combination from Signed Process
# severity: high
# Detection of a signed process initiating a network connection to a root domain with an uncommon port combination.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'cmd.exe'
| filter action_remote_ip = '192.0.2.10'
| filter dst_port = 443
| filter action_file_path contains 'cmd.exe'
| filter causality_actor_process_image_name = 'cmd.exe'

## ABIOC — Unusual Port Usage from Signed Process (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: actor_process_image_name = 'cmd.exe'
# Behavioral deviation where a signed process connects to a test-net IP on an uncommon port.

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.10'
| filter dst_port = 443
| filter actor_process_image_name = 'cmd.exe'
| filter action_file_path contains 'cmd.exe'

## VALIDATION — Detect Signed Process with Uncommon Port Connection
# purpose: validation
# dataset: xdr_data

dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter action_remote_ip = '192.0.2.10'
| filter dst_port = 443
| filter actor_process_image_name = 'cmd.exe'
| filter action_file_path contains 'cmd.exe'
| filter causality_actor_process_image_name = 'cmd.exe'

