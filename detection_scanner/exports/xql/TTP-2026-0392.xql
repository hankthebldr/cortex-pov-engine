# TTP-2026-0392 — Direct Syscall Module Load via Reflective Injection
# XQL paste-buffer generated by detection_scanner/scripts/export_artifacts.py

## BIOC — Suspicious Module Load using Direct Syscall
# severity: high
# Detection of a process loading a module using direct syscall techniques, bypassing EDR hooks.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_file_path contains 'malicious.dll'
| filter causality_actor_process_image_name = 'powershell.exe'

## ABIOC — Direct Syscall Module Load Behavior (behavioral-ML, causality-anchored)
# severity: high
# behavioral_profile: machine-learning
# causality_anchor: process_start_with_dll_load
# Behavioral deviation detected when a process loads a module using direct syscall without standard Windows API calls.

dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name = 'powershell.exe'
| filter action_file_path contains 'malicious.dll'
| filter causality_actor_process_image_name = 'powershell.exe'

