# TTP-2026-0106 — Edge-Appliance Telemetry Collapse + WebVPN-Session C2 on Cisco ASA/FTD (ArcaneDoor / LINE VIPER)
# XDM modeling-rule paste-buffer (normalization substrate) generated by detection_scanner/scripts/export_artifacts.py

## MODELING RULE — Cisco ASA Syslog Severity and Message ID XDM Normalization (XDM normalization substrate)
# raw source dataset: cisco_asa_raw
# vendor/product: Cisco / ASA / FTD
# XDM fields populated: xdm.observer.vendor, xdm.observer.product, xdm.event.id, xdm.source.ipv4
# Parses the raw Cisco ASA/FTD syslog line into addressable fields. It extracts the severity level (0-7) and numeric message id from the '%ASA-<sev>-<id>' preamble, the source IP, and the leading syslog timestamp, so the high-volume Informational (6) and Debug (7) levels become countable and the baseline/recent windows become separable in _time — the substrate the absence-of-signal collapse hunt and the ingestion-validation XQL both run on (they read asa_severity rather than re-parsing _raw_log). A modeling rule does not fire; it makes the appliance telemetry analytics-grade so a detection can. Field mapping: _raw_log '%ASA-<sev>' -> asa_severity (the 0-7 syslog level kept as a non-XDM enrichment field, NOT forced into the xdm.alert.severity enum, which is Informational/Low/Medium/High/Critical and would be a type mismatch); _raw_log '%ASA-<sev>-<id>' -> xdm.event.id; _raw_log 'IP <addr>' -> xdm.source.ipv4; leading timestamp -> _time; constant Cisco/ASA -> xdm.observer.vendor / xdm.observer.product.

[MODEL: dataset = cisco_asa_raw]
| alter asa_timestamp = arrayindex(regextract(_raw_log, "([A-Z][a-z]{2} \d{2} \d{4} \d{2}:\d{2}:\d{2})"), 0)
| alter asa_severity = arrayindex(regextract(_raw_log, "%(?:PIX|ASA|FTD)-([0-7])-\d{3,7}"), 0)
| alter asa_message_id = arrayindex(regextract(_raw_log, "%(?:PIX|ASA|FTD)-[0-7]-(\d{3,7})"), 0)
| alter asa_source_ip = arrayindex(regextract(_raw_log, "IP <([0-9.]+)>"), 0)
| alter _time = parse_timestamp("%b %d %Y %H:%M:%S", asa_timestamp)
| alter xdm.observer.vendor = "Cisco"
| alter xdm.observer.product = "ASA"
| alter xdm.event.id = asa_message_id
| alter xdm.source.ipv4 = asa_source_ip
| filter asa_severity != null

## MODELING RULE — Cisco ASA WebVPN Client Authentication Session XDM Normalization (XDM normalization substrate)
# raw source dataset: cisco_asa_raw
# vendor/product: Cisco / ASA / FTD
# XDM fields populated: xdm.source.user.username, xdm.source.ipv4, xdm.event.id, xdm.network.application_protocol
# Parses the Cisco ASA WebVPN / SSL-VPN session syslog messages (716001 session started, 716002 session terminated, and related 722xxx/113004 SVC/AAA events) into addressable identity and network fields — the WebVPN user, group, and peer IP — so the single-event WebVPN session-start BIOC can key on the modeled xdm.source.ipv4 and xdm.event.id rather than re-parsing raw text. Field mapping: _raw_log 'User <name>' -> xdm.source.user.username; _raw_log 'Group <name>' -> webvpn_group (kept as a non-XDM enrichment field — XDM has no VPN tunnel-group path, so this is deliberately not mapped to a fabricated xdm.network.session.tunnel_group); _raw_log 'IP <addr>' -> xdm.source.ipv4; _raw_log '%ASA-<sev>-<id>' -> xdm.event.id; constant HTTPS -> xdm.network.application_protocol (the transport the WebVPN portal runs over).

[MODEL: dataset = cisco_asa_raw]
| alter asa_message_id = arrayindex(regextract(_raw_log, "%(?:PIX|ASA|FTD)-[0-7]-(\d{3,7})"), 0)
| filter asa_message_id in ("716001", "716002", "716038", "722022", "722023", "722051", "113004")
| alter webvpn_user = arrayindex(regextract(_raw_log, "User <([^>]+)>"), 0)
| alter webvpn_group = arrayindex(regextract(_raw_log, "Group <([^>]+)>"), 0)
| alter webvpn_peer_ip = arrayindex(regextract(_raw_log, "IP <([0-9.]+)>"), 0)
| alter xdm.source.user.username = webvpn_user
| alter xdm.source.ipv4 = webvpn_peer_ip
| alter xdm.event.id = asa_message_id
| alter xdm.network.application_protocol = "HTTPS"
| filter webvpn_peer_ip != null

