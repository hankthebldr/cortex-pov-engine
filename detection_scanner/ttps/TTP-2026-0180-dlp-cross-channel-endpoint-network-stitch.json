  "identity": {
    "name": "Cross-Channel DLP: Local SQL Database Staging Correlated to Network Exfiltration",
    "summary": "Attacker creates local SQL dump containing users and PII, compresses it into a binary payload, and immediately initiates high-speed egress over HTTP/S.",
    "description": "Multi-stage exfiltration operations often begin on endpoints with database extraction and conclude over network egress channels. Cortex XSIAM correlation engine connects local filesystem staging with network socket connections, aggregating isolated signals into a single high-priority data exfiltration incident.",
    "severity": "critical",
    "confidence": "high"
  },
