# Written by povengine-setup. Do not edit: the installer replaces this file.
[Unit]
Description=POVengine SimCore
Requires=povengine-engine.service
After=povengine-engine.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/opt/povengine/engine/docker -H unix:///run/povengine/docker.sock rm -f povengine-simcore
ExecStart=/opt/povengine/engine/docker -H unix:///run/povengine/docker.sock run -d --name povengine-simcore --network host --restart unless-stopped --env-file /etc/povengine/simcore.env -v /var/lib/povengine/data:/app/data cortex-pov-engine-simcore:1.3.0
ExecStop=/opt/povengine/engine/docker -H unix:///run/povengine/docker.sock stop -t 15 povengine-simcore

[Install]
WantedBy=multi-user.target
